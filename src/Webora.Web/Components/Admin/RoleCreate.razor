@page "/admin/roles/create"
@attribute [HasPermission(Permissions.Roles.Create)]
@rendermode InteractiveServer
@inject IRoleAdminService RoleAdmin
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Admin_Roles_Create"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.PageTitle">@L["Admin_Roles_Create"]</FluentLabel>
    <FluentAnchor Href="admin/roles" Appearance="Appearance.Hypertext">&laquo; @L["Admin_Roles_Title"]</FluentAnchor>

    @if (!string.IsNullOrEmpty(_error))
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="false">
            @_error
        </FluentMessageBar>
    }

    <FluentTextField @bind-Value="_name" Label="@L["Admin_Roles_Name"]" Style="max-width:480px" />

    <FluentLabel Typo="Typography.H4">@L["Admin_Roles_Permissions"]</FluentLabel>
    <PermissionEditor Catalog="RoleAdmin.PermissionCatalog" Selected="_selected" />

    <FluentButton OnClick="CreateAsync" Appearance="Appearance.Accent">@L["Admin_Roles_Create"]</FluentButton>
</FluentStack>

@code {
    private string? _name;
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private string? _error;

    private async Task CreateAsync()
    {
        _error = null;
        var result = await RoleAdmin.CreateAsync(_name ?? string.Empty, _selected.ToArray());
        if (result.Succeeded)
        {
            Nav.NavigateTo("admin/roles");
            return;
        }

        _error = string.Join(" ", result.Errors);
    }
}
