@inject IStringLocalizer<SharedResource> L

<FluentGrid Spacing="3">
    @foreach (var group in Catalog)
    {
        <FluentGridItem xs="12" md="4">
            <FluentLabel Typo="Typography.Subject">@group.Name</FluentLabel>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                @foreach (var permission in group.Permissions)
                {
                    <FluentCheckbox Label="@permission"
                                    Value="@Selected.Contains(permission)"
                                    ValueChanged="@(c => Toggle(permission, c))"
                                    Disabled="@Disabled" />
                }
            </FluentStack>
        </FluentGridItem>
    }
</FluentGrid>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PermissionGroup> Catalog { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<string> Selected { get; set; } = new(StringComparer.Ordinal);
    [Parameter] public bool Disabled { get; set; }

    private void Toggle(string permission, bool selected)
    {
        if (selected)
        {
            Selected.Add(permission);
        }
        else
        {
            Selected.Remove(permission);
        }
    }
}
