@page "/admin/roles/{Id:guid}"
@attribute [HasPermission(Permissions.Roles.View)]
@rendermode InteractiveServer
@inject IRoleAdminService RoleAdmin
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Admin_RoleEdit_Title"]</PageTitle>

<h1>@L["Admin_RoleEdit_Title"]</h1>

<p><a href="admin/roles">&laquo; @L["Admin_Roles_Title"]</a></p>

@if (_detail is null)
{
    <p class="text-muted">@(_loaded ? L["Admin_Roles_NotFound"] : L["Admin_Loading"])</p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success" role="alert">@_message</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <div class="d-flex align-items-center gap-2 mb-3">
        <div class="form-floating" style="max-width:480px;flex:1">
            <input class="form-control" id="role-name" placeholder="@L["Admin_Roles_Name"]" @bind="_name" disabled="@_detail.IsDefault" />
            <label for="role-name">@L["Admin_Roles_Name"]</label>
        </div>
        @if (_detail.IsDefault)
        {
            <span class="badge bg-info text-dark">@L["Admin_Roles_Default"]</span>
        }
        else
        {
            <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Edit)" Context="rename">
                <button class="btn btn-outline-secondary" @onclick="RenameAsync">@L["Admin_RoleEdit_Rename"]</button>
            </AuthorizeView>
        }
    </div>

    <h2 class="h5">@L["Admin_Roles_Permissions"]</h2>
    @if (_readOnly)
    {
        <p class="text-muted">@L["Admin_RoleEdit_AdminAll"]</p>
    }
    <PermissionEditor Catalog="RoleAdmin.PermissionCatalog" Selected="_selected" Disabled="_readOnly" />

    @if (!_readOnly)
    {
        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Edit)" Context="savePerms">
            <button class="btn btn-primary" @onclick="SavePermissionsAsync">@L["Admin_Save"]</button>
        </AuthorizeView>
    }

    @if (!_detail.IsDefault)
    {
        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Delete)" Context="delete">
            <h2 class="h5 mt-4">@L["Admin_UserEdit_DangerZone"]</h2>
            @if (_confirmDelete)
            {
                <div class="alert alert-danger">
                    <p>@L["Admin_RoleEdit_DeleteConfirm"]</p>
                    <button class="btn btn-danger me-2" @onclick="DeleteAsync">@L["Admin_RoleEdit_DeleteYes"]</button>
                    <button class="btn btn-outline-secondary" @onclick="() => _confirmDelete = false">@L["Admin_Cancel"]</button>
                </div>
            }
            else
            {
                <button class="btn btn-outline-danger" @onclick="() => _confirmDelete = true">@L["Admin_RoleEdit_Delete"]</button>
            }
        </AuthorizeView>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private RoleDetail? _detail;
    private bool _loaded;
    private string? _name;
    private bool _readOnly;
    private HashSet<string> _selected = new(StringComparer.Ordinal);
    private bool _confirmDelete;
    private string? _message;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _detail = await RoleAdmin.GetAsync(Id);
        _loaded = true;
        if (_detail is not null)
        {
            _name = _detail.Name;
            _selected = _detail.Permissions.ToHashSet(StringComparer.Ordinal);
            _readOnly = string.Equals(_detail.Name, Roles.Administrator, StringComparison.Ordinal);
        }
    }

    private async Task RenameAsync() =>
        await RunAsync(() => RoleAdmin.RenameAsync(Id, _name ?? string.Empty), L["Admin_RoleEdit_Renamed"]);

    private async Task SavePermissionsAsync() =>
        await RunAsync(() => RoleAdmin.SetPermissionsAsync(Id, _selected.ToArray()), L["Admin_RoleEdit_PermsSaved"]);

    private async Task DeleteAsync()
    {
        var result = await RoleAdmin.DeleteAsync(Id);
        if (result.Succeeded)
        {
            Nav.NavigateTo("admin/roles");
            return;
        }

        _confirmDelete = false;
        _error = string.Join(" ", result.Errors);
    }

    private async Task RunAsync(Func<Task<AccountResult>> action, string successMessage)
    {
        _message = _error = null;
        var result = await action();
        if (result.Succeeded)
        {
            _message = successMessage;
            await LoadAsync();
        }
        else
        {
            _error = string.Join(" ", result.Errors);
        }
    }
}
