@page "/admin/users/{Id:guid}"
@attribute [HasPermission(Permissions.Users.View)]
@rendermode InteractiveServer
@inject IUserAdminService UserAdmin
@inject IRoleAdminService RoleAdmin
@inject IAccountService AccountService
@inject IUserLocationService UserLocation
@inject UserManager<ApplicationUser> UserManager
@inject ISiteSettingsService SiteSettings
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Admin_UserEdit_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.PageTitle">@L["Admin_UserEdit_Title"]</FluentLabel>
    <FluentAnchor Href="admin/users" Appearance="Appearance.Hypertext">&laquo; @L["Admin_Users_Title"]</FluentAnchor>

    @if (_detail is null)
    {
        @if (_loaded)
        {
            <FluentLabel Typo="Typography.Body">@L["Admin_Users_NotFound"]</FluentLabel>
        }
        else
        {
            <FluentProgressRing />
        }
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar">@_message</FluentMessageBar>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@_error</FluentMessageBar>
        }

        <FluentCard>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="12" md="3"><strong>@L["Admin_Users_Email"]</strong></FluentGridItem>
                <FluentGridItem xs="12" md="9">@_detail.Email @(_detail.EmailConfirmed ? "" : $"({L["Admin_Users_Unconfirmed"]})")</FluentGridItem>

                <FluentGridItem xs="12" md="3"><strong>@L["Admin_Users_Name"]</strong></FluentGridItem>
                <FluentGridItem xs="12" md="9">@(string.IsNullOrWhiteSpace(_detail.DisplayName) ? "—" : _detail.DisplayName)</FluentGridItem>

                <FluentGridItem xs="12" md="3"><strong>@L["Admin_Users_Phone"]</strong></FluentGridItem>
                <FluentGridItem xs="12" md="9">@(_detail.PhoneNumber ?? "—")</FluentGridItem>

                <FluentGridItem xs="12" md="3"><strong>@L["Admin_Users_Status"]</strong></FluentGridItem>
                <FluentGridItem xs="12" md="9">
                    <StatusBadge Status="_detail.Status" />
                    @if (_detail.StatusChangedAtUtc is { } changed)
                    {
                        <small style="color:var(--neutral-foreground-hint); margin-left:8px">@Fmt(changed)</small>
                    }
                    @if (!string.IsNullOrWhiteSpace(_detail.StatusReason))
                    {
                        <div><small style="color:var(--neutral-foreground-hint)">@_detail.StatusReason</small></div>
                    }
                </FluentGridItem>
            </FluentGrid>
        </FluentCard>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.ManageIncentives)" Context="commute">
            <FluentLabel Typo="Typography.H4">@L["Admin_UserEdit_Commute"]</FluentLabel>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
                <FluentLabel Typo="Typography.Body">
                    @(string.IsNullOrWhiteSpace(_home.Address) ? L["Admin_UserEdit_NoHome"] : _home.Address)
                    @if (_home.DistanceKm is { } km)
                    {
                        <span> · @km.ToString("0.0") km</span>
                    }
                </FluentLabel>
                @if (!string.IsNullOrWhiteSpace(_home.Address))
                {
                    @if (_home.Verified)
                    {
                        <FluentBadge Appearance="Appearance.Accent" Fill="success">@L["Admin_UserEdit_HomeVerified"]</FluentBadge>
                        <FluentButton OnClick="() => SetVerifiedAsync(false)" Appearance="Appearance.Outline">@L["Admin_UserEdit_HomeUnverify"]</FluentButton>
                    }
                    else
                    {
                        <FluentBadge Appearance="Appearance.Accent" Fill="warning">@L["Admin_UserEdit_HomeUnverified"]</FluentBadge>
                        <FluentButton OnClick="() => SetVerifiedAsync(true)" Appearance="Appearance.Accent">@L["Admin_UserEdit_HomeVerify"]</FluentButton>
                    }
                }
            </FluentStack>
        </AuthorizeView>

        <FluentLabel Typo="Typography.H4">@L["Admin_UserEdit_Roles"]</FluentLabel>
        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="16">
            @foreach (var role in _allRoles)
            {
                <FluentCheckbox Label="@role"
                                Value="@_selectedRoles.Contains(role)"
                                ValueChanged="@(c => ToggleRole(role, c))" />
            }
        </FluentStack>
        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Users.Edit)" Context="editRoles">
            <FluentButton OnClick="SaveRolesAsync" Appearance="Appearance.Accent">@L["Admin_Save"]</FluentButton>
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Users.Edit)" Context="status">
            <FluentLabel Typo="Typography.H4">@L["Admin_UserEdit_StatusActions"]</FluentLabel>
            @if (_isSelf)
            {
                <FluentLabel Typo="Typography.Body">@L["Admin_UserEdit_SelfNoStatus"]</FluentLabel>
            }
            else if (_detail.Status == AccountStatus.Blocked)
            {
                <FluentButton OnClick="UnblockAsync" Appearance="Appearance.Accent">@L["Admin_UserEdit_Unblock"]</FluentButton>
            }
            else
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="max-width:480px">
                    <FluentTextField @bind-Value="_blockReason"
                                     Placeholder="@L["Admin_UserEdit_BlockReason"]"
                                     Style="flex:1" />
                    <FluentButton OnClick="BlockAsync" Appearance="Appearance.Accent" Style="background:var(--error-rest);color:var(--neutral-fill-rest)">
                        @L["Admin_UserEdit_Block"]
                    </FluentButton>
                </FluentStack>
            }
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Users.Delete)" Context="delete">
            @if (!_isSelf)
            {
                <FluentLabel Typo="Typography.H4">@L["Admin_UserEdit_DangerZone"]</FluentLabel>
                @if (_confirmDelete)
                {
                    <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="false">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                            <span>@L["Admin_UserEdit_DeleteConfirm"]</span>
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                                <FluentButton OnClick="DeleteAsync" Appearance="Appearance.Accent">
                                    @L["Admin_UserEdit_DeleteYes"]
                                </FluentButton>
                                <FluentButton OnClick="() => _confirmDelete = false" Appearance="Appearance.Outline">
                                    @L["Admin_Cancel"]
                                </FluentButton>
                            </FluentStack>
                        </FluentStack>
                    </FluentMessageBar>
                }
                else
                {
                    <FluentButton OnClick="() => _confirmDelete = true" Appearance="Appearance.Outline">
                        @L["Admin_UserEdit_Delete"]
                    </FluentButton>
                }
            }
        </AuthorizeView>

        <FluentLabel Typo="Typography.H4">@L["Admin_UserEdit_Audit"]</FluentLabel>
        @if (_audit.Count == 0)
        {
            <FluentLabel Typo="Typography.Body">@L["Admin_UserEdit_NoAudit"]</FluentLabel>
        }
        else
        {
            <FluentDataGrid Items="@_audit.AsQueryable()" TGridItem="AccountAuditEntry"
                            GridTemplateColumns="1fr 1fr 1fr 2fr">
                <TemplateColumn Title="@L["Admin_UserEdit_AuditWhen"]">@Fmt(context.OccurredAtUtc)</TemplateColumn>
                <PropertyColumn Property="@(e => e.Type)" Title="@L["Admin_UserEdit_AuditEvent"]" />
                <PropertyColumn Property="@(e => e.Actor)" Title="@L["Admin_UserEdit_AuditActor"]" />
                <TemplateColumn Title="@L["Admin_UserEdit_AuditDetail"]">@(context.Detail ?? "—")</TemplateColumn>
            </FluentDataGrid>
        }
    }
</FluentStack>

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private UserDetail? _detail;
    private bool _loaded;
    private Guid _adminId;
    private bool _isSelf;
    private IReadOnlyList<string> _allRoles = [];
    private HashSet<string> _selectedRoles = new(StringComparer.Ordinal);
    private IReadOnlyList<AccountAuditEntry> _audit = [];
    private UserHomeDto _home = new(null, null, false);
    private string? _blockReason;
    private bool _confirmDelete;
    private string? _message;
    private string? _error;
    private TimeZoneInfo _tz = TimeZoneInfo.Local;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        var admin = await UserManager.GetUserAsync(state.User);
        _adminId = admin?.Id ?? Guid.Empty;
        _allRoles = (await RoleAdmin.ListAsync()).Select(r => r.Name).ToArray();
        _tz = await SiteSettings.GetTimeZoneAsync();
        await LoadAsync();
    }

    private string Fmt(DateTimeOffset utc) => TimeZoneInfo.ConvertTime(utc, _tz).ToString("g");

    private async Task LoadAsync()
    {
        _detail = await UserAdmin.GetAsync(Id);
        _loaded = true;
        if (_detail is not null)
        {
            _isSelf = _detail.Id == _adminId;
            _selectedRoles = _detail.Roles.ToHashSet(StringComparer.Ordinal);
            _audit = await AccountService.GetAuditTrailAsync(Id);
            _home = await UserLocation.GetHomeAsync(Id);
        }
    }

    private async Task SetVerifiedAsync(bool verified)
    {
        _message = _error = null;
        var result = await UserLocation.SetHomeVerifiedAsync(Id, verified);
        if (result.Succeeded)
        {
            _message = L["Admin_UserEdit_HomeSaved"];
            await LoadAsync();
        }
        else
        {
            _error = L[result.Errors.FirstOrDefault() ?? string.Empty];
        }
    }

    private void ToggleRole(string role, bool selected)
    {
        if (selected)
        {
            _selectedRoles.Add(role);
        }
        else
        {
            _selectedRoles.Remove(role);
        }
    }

    private async Task SaveRolesAsync() =>
        await RunAsync(() => UserAdmin.SetRolesAsync(Id, _selectedRoles.ToArray(), _adminId), L["Admin_UserEdit_RolesSaved"]);

    private async Task BlockAsync() =>
        await RunAsync(() => AccountService.BlockAsync(Id, _adminId, string.IsNullOrWhiteSpace(_blockReason) ? null : _blockReason), L["Admin_UserEdit_Blocked"]);

    private async Task UnblockAsync() =>
        await RunAsync(() => AccountService.UnblockAsync(Id, _adminId), L["Admin_UserEdit_Unblocked"]);

    private async Task DeleteAsync()
    {
        var result = await UserAdmin.DeleteAsync(Id, _adminId);
        if (result.Succeeded)
        {
            Nav.NavigateTo("admin/users");
            return;
        }

        _confirmDelete = false;
        _error = string.Join(" ", result.Errors);
    }

    private async Task RunAsync(Func<Task<AccountResult>> action, string successMessage)
    {
        _message = _error = null;
        var result = await action();
        if (result.Succeeded)
        {
            _message = successMessage;
            await LoadAsync();
        }
        else
        {
            _error = string.Join(" ", result.Errors);
        }
    }
}
