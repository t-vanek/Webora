@page "/admin/parking/settings"
@attribute [HasPermission(Permissions.Parking.ManageIncentives)]
@rendermode InteractiveServer
@inject IParkingSettingsService SettingsService
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Parking_Settings_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.PageTitle">@L["Parking_Settings_Title"]</FluentLabel>
    <FluentLabel Typo="Typography.Body">@L["Parking_Settings_Intro"]</FluentLabel>

    @if (_form is null)
    {
        <FluentProgressRing />
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar">@_message</FluentMessageBar>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@L[_error]</FluentMessageBar>
        }

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="20" Style="max-width:720px">
            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_PointsSection"]</FluentLabel>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="12" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.ReleasePoints" Min="0"
                                       Label="@L["Parking_Settings_ReleasePoints"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="12" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.OffPeakBonusPoints" Min="0"
                                       Label="@L["Parking_Settings_OffPeakBonus"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="12" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.NoShowPenaltyPoints" Min="0"
                                       Label="@L["Parking_Settings_NoShowPenalty"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_PeakSection"]</FluentLabel>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="3">
                    <FluentLabel Typo="Typography.Body">@L["Parking_Settings_PeakStart"]</FluentLabel>
                    <input type="time" @bind="_form.PeakStart" class="parking-input" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentLabel Typo="Typography.Body">@L["Parking_Settings_PeakEnd"]</FluentLabel>
                    <input type="time" @bind="_form.PeakEnd" class="parking-input" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_TimingSection"]</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_MinutesHelp"]</FluentLabel>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.ReleaseCutoffMinutes" Min="0"
                                       Label="@L["Parking_Settings_ReleaseCutoff"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.NoShowGraceMinutes" Min="0"
                                       Label="@L["Parking_Settings_NoShowGrace"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.ReminderLeadMinutes" Min="0"
                                       Label="@L["Parking_Settings_ReminderLead"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.SweepIntervalMinutes" Min="1"
                                       Label="@L["Parking_Settings_SweepInterval"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_ResidentSection"]</FluentLabel>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="3">
                    <FluentLabel Typo="Typography.Body">@L["Parking_Settings_ResidentHoldUntil"]</FluentLabel>
                    <input type="time" @bind="_form.ResidentHoldUntil" class="parking-input" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.ResidentReleasePointsPerHour" Min="0"
                                       Label="@L["Parking_Settings_ResidentPointsPerHour"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.ResidentReleaseMaxPoints" Min="0"
                                       Label="@L["Parking_Settings_ResidentMaxPoints"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.ResidentMaxShareAllowance" Min="0"
                                       Label="@L["Parking_Settings_ResidentMaxAllowance"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.ResidentSharePercentPerAllowance" Min="0"
                                       Label="@L["Parking_Settings_ResidentPercentPerAllowance"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.ResidentWastedShareClawbackPercent" Min="0" Max="100"
                                       Label="@L["Parking_Settings_ResidentClawback"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_DistanceSection"]</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_DistanceHelp"]</FluentLabel>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="double?" @bind-Value="_form.LotLatitude" Step="0.0001"
                                       Label="@L["Parking_Settings_LotLat"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="double?" @bind-Value="_form.LotLongitude" Step="0.0001"
                                       Label="@L["Parking_Settings_LotLon"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="2">
                    <FluentNumberField TValue="int" @bind-Value="_form.SharedTakenBasePoints" Min="0"
                                       Label="@L["Parking_Settings_TakenBase"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="2">
                    <FluentNumberField TValue="int" @bind-Value="_form.SharedTakenReferenceKm" Min="1"
                                       Label="@L["Parking_Settings_TakenRefKm"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="2">
                    <FluentNumberField TValue="int" @bind-Value="_form.SharedTakenMaxMultiplier" Min="1"
                                       Label="@L["Parking_Settings_TakenMaxMult"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_LimitsSection"]</FluentLabel>
            <FluentSwitch @bind-Value="_form.AutoVerifyHomeAddress" Label="@L["Parking_Settings_AutoVerify"]" />
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.AutoVerifyMaxDistanceKm" Min="0"
                                       Label="@L["Parking_Settings_AutoVerifyMaxKm"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.MaxRewardedReleasesPerDay" Min="0"
                                       Label="@L["Parking_Settings_MaxReleasesPerDay"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.MaxReleaseRangeDays" Min="1" Max="366"
                                       Label="@L["Parking_Settings_MaxRangeDays"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_EconomySection"]</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_EconomyHelp"]</FluentLabel>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.BaseReservationCost" Min="0"
                                       Label="@L["Parking_Settings_BaseCost"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.PeakPricePercent" Min="100"
                                       Label="@L["Parking_Settings_PeakPercent"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.OccupancyPricePercent" Min="0"
                                       Label="@L["Parking_Settings_OccupancyPercent"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.MaxReservationCost" Min="0"
                                       Label="@L["Parking_Settings_MaxCost"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.MonthlyCreditAllowance" Min="0"
                                       Label="@L["Parking_Settings_MonthlyAllowance"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.QueueOfferMinutes" Min="1"
                                       Label="@L["Parking_Settings_QueueOfferMinutes"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_QueuePenaltySection"]</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_QueuePenaltyHelp"]</FluentLabel>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.QueueNoShowPenaltyPoints" Min="0"
                                       Label="@L["Parking_Settings_QueueNoShowPoints"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.QueueNoShowCreditPenalty" Min="0"
                                       Label="@L["Parking_Settings_QueueNoShowCredits"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.QueueNoShowBanDays" Min="0"
                                       Label="@L["Parking_Settings_QueueNoShowBanDays"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.QueueNoShowAllowancePenalty" Min="0"
                                       Label="@L["Parking_Settings_QueueNoShowAllowance"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_DemandRewardSection"]</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_DemandRewardHelp"]</FluentLabel>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.DemandReleaseOccupancyPercent" Min="0"
                                       Label="@L["Parking_Settings_DemandOccupancyPercent"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.DemandReleaseQueueBonus" Min="0"
                                       Label="@L["Parking_Settings_DemandQueueBonus"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.MaxReleaseReward" Min="0"
                                       Label="@L["Parking_Settings_MaxReleaseReward"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_LoyaltySection"]</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_LoyaltyHelp"]</FluentLabel>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.StreakBonusPerLevel" Min="0"
                                       Label="@L["Parking_Settings_StreakBonusPerLevel"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.StreakBonusCap" Min="0"
                                       Label="@L["Parking_Settings_StreakBonusCap"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.TierSilverPoints" Min="0"
                                       Label="@L["Parking_Settings_TierSilver"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.TierGoldPoints" Min="0"
                                       Label="@L["Parking_Settings_TierGold"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.TierPlatinumPoints" Min="0"
                                       Label="@L["Parking_Settings_TierPlatinum"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.ReputationDecayPercent" Min="0" Max="100"
                                       Label="@L["Parking_Settings_ReputationDecayPercent"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.ReputationDecayIntervalDays" Min="1"
                                       Label="@L["Parking_Settings_ReputationDecayInterval"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_TierPerksSection"]</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_TierPerksHelp"]</FluentLabel>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.QueuePriorityPerTier" Min="0"
                                       Label="@L["Parking_Settings_QueuePriorityPerTier"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.TierAllowanceBonus" Min="0"
                                       Label="@L["Parking_Settings_TierAllowanceBonus"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.TierDiscountPercent" Min="0" Max="30"
                                       Label="@L["Parking_Settings_TierDiscountPercent"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_AdaptiveSection"]</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_AdaptiveHelp"]</FluentLabel>
            <FluentSwitch @bind-Value="_form.AdaptivePricingEnabled" Label="@L["Parking_Settings_AdaptiveEnabled"]" />
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.AdaptiveTargetOccupancyPercent" Min="1" Max="100"
                                       Label="@L["Parking_Settings_AdaptiveTarget"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.AdaptiveIntervalMinutes" Min="1"
                                       Label="@L["Parking_Settings_AdaptiveInterval"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.AdaptiveGainPercent" Min="0"
                                       Label="@L["Parking_Settings_AdaptiveGain"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.AdaptiveDeadbandPercent" Min="0" Max="100"
                                       Label="@L["Parking_Settings_AdaptiveDeadband"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.AdaptiveStepMaxPercent" Min="0"
                                       Label="@L["Parking_Settings_AdaptiveStepMax"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.AdaptivePeakMinPercent" Min="100"
                                       Label="@L["Parking_Settings_AdaptivePeakMin"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.AdaptivePeakMaxPercent" Min="100"
                                       Label="@L["Parking_Settings_AdaptivePeakMax"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_TrustSection"]</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_TrustHelp"]</FluentLabel>
            <FluentSwitch @bind-Value="_form.TrustEnabled" Label="@L["Parking_Settings_TrustEnabled"]" />
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.TrustIntervalHours" Min="1"
                                       Label="@L["Parking_Settings_TrustInterval"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="4">
                    <FluentNumberField TValue="int" @bind-Value="_form.TrustedBadgeThreshold" Min="0" Max="100"
                                       Label="@L["Parking_Settings_TrustThreshold"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>

            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_CollusionSection"]</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_CollusionHelp"]</FluentLabel>
            <FluentSwitch @bind-Value="_form.AntiCollusionEnabled" Label="@L["Parking_Settings_CollusionEnabled"]" />
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.CollusionMinInteractions" Min="2"
                                       Label="@L["Parking_Settings_CollusionMin"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.CollusionConcentrationPercent" Min="1" Max="100"
                                       Label="@L["Parking_Settings_CollusionConcentration"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.MaxPairTrustWeight" Min="1"
                                       Label="@L["Parking_Settings_MaxPairTrustWeight"]" Style="width:100%" />
                </FluentGridItem>
                <FluentGridItem xs="6" md="3">
                    <FluentNumberField TValue="int" @bind-Value="_form.CollusionScanIntervalHours" Min="1"
                                       Label="@L["Parking_Settings_CollusionInterval"]" Style="width:100%" />
                </FluentGridItem>
            </FluentGrid>
            <FluentAnchor Href="/admin/parking/collusion" Appearance="Appearance.Hypertext">@L["Parking_Settings_CollusionReviewLink"]</FluentAnchor>

            <FluentButton OnClick="SaveAsync" Appearance="Appearance.Accent">@L["Parking_Settings_Save"]</FluentButton>
        </FluentStack>
    }
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private SettingsForm? _form;
    private Guid _adminId;
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        var admin = await UserManager.GetUserAsync(state.User);
        _adminId = admin?.Id ?? Guid.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var s = await SettingsService.GetAsync();
        _form = new SettingsForm
        {
            ReleasePoints = s.ReleasePoints,
            OffPeakBonusPoints = s.OffPeakBonusPoints,
            NoShowPenaltyPoints = s.NoShowPenaltyPoints,
            ReleaseCutoffMinutes = (int)s.ReleaseCutoff.TotalMinutes,
            NoShowGraceMinutes = (int)s.NoShowGracePeriod.TotalMinutes,
            ReminderLeadMinutes = (int)s.ReminderLeadTime.TotalMinutes,
            SweepIntervalMinutes = (int)s.SweepInterval.TotalMinutes,
            PeakStart = s.PeakStart,
            PeakEnd = s.PeakEnd,
            ResidentHoldUntil = s.ResidentHoldUntil,
            ResidentReleasePointsPerHour = s.ResidentReleasePointsPerHour,
            ResidentReleaseMaxPoints = s.ResidentReleaseMaxPoints,
            ResidentMaxShareAllowance = s.ResidentMaxShareAllowance,
            ResidentSharePercentPerAllowance = s.ResidentSharePercentPerAllowance,
            ResidentWastedShareClawbackPercent = s.ResidentWastedShareClawbackPercent,
            LotLatitude = s.LotLatitude,
            LotLongitude = s.LotLongitude,
            SharedTakenBasePoints = s.SharedTakenBasePoints,
            SharedTakenReferenceKm = s.SharedTakenReferenceKm,
            SharedTakenMaxMultiplier = s.SharedTakenMaxMultiplier,
            AutoVerifyHomeAddress = s.AutoVerifyHomeAddress,
            AutoVerifyMaxDistanceKm = s.AutoVerifyMaxDistanceKm,
            MaxRewardedReleasesPerDay = s.MaxRewardedReleasesPerDay,
            MaxReleaseRangeDays = s.MaxReleaseRangeDays,
            BaseReservationCost = s.BaseReservationCost,
            PeakPricePercent = s.PeakPricePercent,
            OccupancyPricePercent = s.OccupancyPricePercent,
            MaxReservationCost = s.MaxReservationCost,
            MonthlyCreditAllowance = s.MonthlyCreditAllowance,
            QueueOfferMinutes = s.QueueOfferMinutes,
            QueueNoShowPenaltyPoints = s.QueueNoShowPenaltyPoints,
            QueueNoShowCreditPenalty = s.QueueNoShowCreditPenalty,
            QueueNoShowBanDays = s.QueueNoShowBanDays,
            QueueNoShowAllowancePenalty = s.QueueNoShowAllowancePenalty,
            DemandReleaseOccupancyPercent = s.DemandReleaseOccupancyPercent,
            DemandReleaseQueueBonus = s.DemandReleaseQueueBonus,
            MaxReleaseReward = s.MaxReleaseReward,
            StreakBonusPerLevel = s.StreakBonusPerLevel,
            StreakBonusCap = s.StreakBonusCap,
            TierSilverPoints = s.TierSilverPoints,
            TierGoldPoints = s.TierGoldPoints,
            TierPlatinumPoints = s.TierPlatinumPoints,
            QueuePriorityPerTier = s.QueuePriorityPerTier,
            TierAllowanceBonus = s.TierAllowanceBonus,
            TierDiscountPercent = s.TierDiscountPercent,
            ReputationDecayPercent = s.ReputationDecayPercent,
            ReputationDecayIntervalDays = s.ReputationDecayIntervalDays,
            AdaptivePricingEnabled = s.AdaptivePricingEnabled,
            AdaptiveTargetOccupancyPercent = s.AdaptiveTargetOccupancyPercent,
            AdaptiveGainPercent = s.AdaptiveGainPercent,
            AdaptiveDeadbandPercent = s.AdaptiveDeadbandPercent,
            AdaptiveStepMaxPercent = s.AdaptiveStepMaxPercent,
            AdaptivePeakMinPercent = s.AdaptivePeakMinPercent,
            AdaptivePeakMaxPercent = s.AdaptivePeakMaxPercent,
            AdaptiveIntervalMinutes = s.AdaptiveIntervalMinutes,
            TrustEnabled = s.TrustEnabled,
            TrustIntervalHours = s.TrustIntervalHours,
            TrustedBadgeThreshold = s.TrustedBadgeThreshold,
            MaxPairTrustWeight = s.MaxPairTrustWeight,
            AntiCollusionEnabled = s.AntiCollusionEnabled,
            CollusionMinInteractions = s.CollusionMinInteractions,
            CollusionConcentrationPercent = s.CollusionConcentrationPercent,
            CollusionScanIntervalHours = s.CollusionScanIntervalHours,
        };
    }

    private async Task SaveAsync()
    {
        _message = _error = null;
        var dto = new ParkingSettingsDto(
            _form!.ReleasePoints, _form.OffPeakBonusPoints, _form.NoShowPenaltyPoints,
            TimeSpan.FromMinutes(_form.ReleaseCutoffMinutes),
            TimeSpan.FromMinutes(_form.NoShowGraceMinutes),
            TimeSpan.FromMinutes(_form.ReminderLeadMinutes),
            _form.PeakStart, _form.PeakEnd,
            TimeSpan.FromMinutes(_form.SweepIntervalMinutes),
            _form.ResidentHoldUntil,
            _form.ResidentReleasePointsPerHour,
            _form.ResidentReleaseMaxPoints,
            _form.ResidentMaxShareAllowance,
            _form.ResidentSharePercentPerAllowance,
            _form.ResidentWastedShareClawbackPercent,
            _form.LotLatitude,
            _form.LotLongitude,
            _form.SharedTakenBasePoints,
            _form.SharedTakenReferenceKm,
            _form.SharedTakenMaxMultiplier,
            _form.AutoVerifyHomeAddress,
