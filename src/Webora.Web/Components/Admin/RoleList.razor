@page "/admin/roles"
@attribute [HasPermission(Permissions.Roles.View)]
@rendermode InteractiveServer
@inject IRoleAdminService RoleAdmin
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Admin_Roles_Title"]</PageTitle>

<h1>@L["Admin_Roles_Title"]</h1>

<div class="mb-3">
    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Create)" Context="create">
        <a class="btn btn-primary" href="admin/roles/create">@L["Admin_Roles_Create"]</a>
    </AuthorizeView>
</div>

@if (_roles is null)
{
    <p>@L["Admin_Loading"]</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>@L["Admin_Roles_Name"]</th>
                <th>@L["Admin_Roles_Permissions"]</th>
                <th>@L["Admin_Roles_Users"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in _roles)
            {
                <tr>
                    <td>
                        @role.Name
                        @if (role.IsDefault)
                        {
                            <span class="badge bg-info text-dark ms-1">@L["Admin_Roles_Default"]</span>
                        }
                    </td>
                    <td>@role.PermissionCount</td>
                    <td>@role.UserCount</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="@($"admin/roles/{role.Id}")">@L["Admin_Manage"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<RoleSummary>? _roles;

    protected override async Task OnInitializedAsync() => _roles = await RoleAdmin.ListAsync();
}
