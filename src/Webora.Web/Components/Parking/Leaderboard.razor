@page "/parking/leaderboard"
@attribute [HasPermission(Permissions.Parking.ViewLeaderboard)]
@rendermode InteractiveServer
@inject IIncentiveService Incentives
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Parking_Leaderboard_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <FluentLabel Typo="Typography.PageTitle">@L["Parking_Leaderboard_Title"]</FluentLabel>
    <FluentLabel Typo="Typography.Body">@L["Parking_Leaderboard_Intro"]</FluentLabel>

    @if (_score is not null)
    {
        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                <FluentLabel Typo="Typography.Subject">@L["Parking_MyScore"]</FluentLabel>
                <FluentLabel Typo="Typography.H3">@_score.Points @L["Parking_Points"]</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
                    <FluentBadge Appearance="Appearance.Accent">@L[$"Parking_Tier_{_score.Tier}"]</FluentBadge>
                    <FluentLabel Typo="Typography.Body">@L["Parking_MyStreak"]: <strong>@_score.CompletionStreak</strong></FluentLabel>
                </FluentStack>
                <FluentLabel Typo="Typography.Body">@L["Parking_MyCredits"]: <strong>@_score.Credits</strong> @L["Parking_Credits"]</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="24" Wrap="true">
                    <FluentLabel Typo="Typography.Body">@L["Parking_Stat_Released"]: @_score.ReservationsReleased</FluentLabel>
                    <FluentLabel Typo="Typography.Body">@L["Parking_Stat_OffPeak"]: @_score.OffPeakReservations</FluentLabel>
                    <FluentLabel Typo="Typography.Body">@L["Parking_Stat_Completed"]: @_score.ReservationsCompleted</FluentLabel>
                    <FluentLabel Typo="Typography.Body">@L["Parking_Stat_NoShows"]: @_score.NoShows</FluentLabel>
                </FluentStack>
                @if (_score.Badges.Count > 0)
                {
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                        @foreach (var badge in _score.Badges)
                        {
                            <FluentBadge Appearance="Appearance.Accent">@L[$"Parking_Badge_{badge}"]</FluentBadge>
                        }
                    </FluentStack>
                }
            </FluentStack>
        </FluentCard>
    }

    @if (_peer is not null)
    {
        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                <FluentLabel Typo="Typography.Subject">@L["Parking_Team_Mine"]: <strong>@_peer.Department</strong></FluentLabel>
                <FluentLabel Typo="Typography.Body">@L["Parking_Team_Rank", _peer.RankInTeam, _peer.TeamSize]</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="24" Wrap="true">
                    <FluentLabel Typo="Typography.Body">@L["Parking_Points"]: <strong>@_peer.MyPoints</strong> · @L["Parking_Team_Avg"]: @_peer.TeamAveragePoints</FluentLabel>
                    <FluentLabel Typo="Typography.Body">@L["Parking_Stat_OffPeak"]: <strong>@_peer.MyOffPeak</strong> · @L["Parking_Team_Avg"]: @_peer.TeamAverageOffPeak</FluentLabel>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    }

    @if (_leaderboard is null)
    {
        <FluentProgressRing />
    }
    else if (_leaderboard.Count == 0)
    {
        <FluentLabel Typo="Typography.Body">@L["Parking_Leaderboard_Empty"]</FluentLabel>
    }
    else
    {
        <FluentDataGrid Items="@_leaderboard.AsQueryable()" TGridItem="LeaderboardEntryDto"
                        GridTemplateColumns="auto 2fr 1fr 1fr 1fr 2fr">
            <PropertyColumn Property="@(e => e.Rank)" Title="@L["Parking_Rank"]" />
            <PropertyColumn Property="@(e => e.DisplayName)" Title="@L["Parking_Name"]" />
            <PropertyColumn Property="@(e => e.Points)" Title="@L["Parking_Points"]" />
            <PropertyColumn Property="@(e => e.ReservationsReleased)" Title="@L["Parking_Stat_Released"]" />
            <PropertyColumn Property="@(e => e.OffPeakReservations)" Title="@L["Parking_Stat_OffPeak"]" />
            <TemplateColumn Title="@L["Parking_Badges"]">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4" Wrap="true">
                    @foreach (var badge in context.Badges)
                    {
                        <FluentBadge>@L[$"Parking_Badge_{badge}"]</FluentBadge>
                    }
                </FluentStack>
            </TemplateColumn>
        </FluentDataGrid>
    }

    @if (_teams is { Count: > 0 })
    {
        <FluentLabel Typo="Typography.Subject">@L["Parking_Team_Leaderboard"]</FluentLabel>
        <FluentDataGrid Items="@_teams.AsQueryable()" TGridItem="TeamLeaderboardEntryDto"
                        GridTemplateColumns="auto 2fr 1fr 1fr 1fr">
            <PropertyColumn Property="@(t => t.Rank)" Title="@L["Parking_Rank"]" />
            <PropertyColumn Property="@(t => t.Department)" Title="@L["Parking_Team_Name"]" />
            <PropertyColumn Property="@(t => t.MemberCount)" Title="@L["Parking_Team_Members"]" />
            <PropertyColumn Property="@(t => t.AveragePoints)" Title="@L["Parking_Team_AvgPoints"]" />
            <PropertyColumn Property="@(t => t.AverageOffPeak)" Title="@L["Parking_Stat_OffPeak"]" />
        </FluentDataGrid>
    }
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ParkerScoreDto? _score;
    private IReadOnlyList<LeaderboardEntryDto>? _leaderboard;
    private IReadOnlyList<TeamLeaderboardEntryDto>? _teams;
    private PeerComparisonDto? _peer;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is not null)
        {
            _score = await Incentives.GetScoreAsync(user.Id);
            _peer = await Incentives.GetPeerComparisonAsync(user.Id);
        }

        _leaderboard = await Incentives.GetLeaderboardAsync();
        _teams = await Incentives.GetTeamLeaderboardAsync();
    }
}
