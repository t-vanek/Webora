@page "/account/deactivate"
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject IAccountService AccountService
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Deactivate_Title"]</PageTitle>

<h1>@L["Deactivate_Title"]</h1>

<p>@L["Deactivate_Intro"]</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<EditForm Model="this" method="post" OnValidSubmit="Submit" FormName="deactivate">
    <button type="submit" class="btn btn-danger">@L["Deactivate_Submit"]</button>
</EditForm>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? _error;

    private async Task Submit()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            _error = L["Common_AccountNotFound"];
            return;
        }

        var result = await AccountService.DeactivateAsync(user.Id, "self-service");
        if (!result.Succeeded)
        {
            _error = string.Join(" ", result.Errors);
            return;
        }

        await SignInManager.SignOutAsync();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}
