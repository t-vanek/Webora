@page "/account/deactivate"
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject IAccountService AccountService
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Deactivate_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:640px">
    <FluentLabel Typo="Typography.PageTitle">@L["Deactivate_Title"]</FluentLabel>
    <FluentLabel Typo="Typography.Body">@L["Deactivate_Intro"]</FluentLabel>

    @if (!string.IsNullOrEmpty(_error))
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="false">
            @_error
        </FluentMessageBar>
    }

    <EditForm Model="this" method="post" OnValidSubmit="Submit" FormName="deactivate">
        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Outline"
                      Style="background:var(--error-rest);color:var(--neutral-fill-rest)">
            @L["Deactivate_Submit"]
        </FluentButton>
    </EditForm>
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? _error;

    private async Task Submit()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            _error = L["Common_AccountNotFound"];
            return;
        }

        var result = await AccountService.DeactivateAsync(user.Id, "self-service");
        if (!result.Succeeded)
        {
            _error = string.Join(" ", result.Errors);
            return;
        }

        await SignInManager.SignOutAsync();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}
