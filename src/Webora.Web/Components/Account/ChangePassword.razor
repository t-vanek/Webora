@page "/account/change-password"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject IAccountService AccountService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ChangePassword_Title"]</PageTitle>

<FluentCard Style="max-width:480px">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.H3">@L["ChangePassword_Title"]</FluentLabel>

        @if (_succeeded)
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="false">
                @L["ChangePassword_Success"]
            </FluentMessageBar>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="change-password">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="false">
                        @_error
                    </FluentMessageBar>
                }
                <FluentTextField Name="Input.CurrentPassword"
                                 @bind-Value="Input.CurrentPassword"
                                 Label="@L["Field_CurrentPassword"]"
                                 TextFieldType="TextFieldType.Password"
                                 AutoComplete="current-password"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.CurrentPassword" />
                <FluentTextField Name="Input.NewPassword"
                                 @bind-Value="Input.NewPassword"
                                 Label="@L["Field_NewPassword"]"
                                 TextFieldType="TextFieldType.Password"
                                 AutoComplete="new-password"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.NewPassword" />
                <FluentTextField Name="Input.ConfirmPassword"
                                 @bind-Value="Input.ConfirmPassword"
                                 Label="@L["Field_ConfirmPassword"]"
                                 TextFieldType="TextFieldType.Password"
                                 AutoComplete="new-password"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%">
                    @L["ChangePassword_Submit"]
                </FluentButton>
            </EditForm>
        }
    </FluentStack>
</FluentCard>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    private bool _succeeded;
    private string? _error;

    private async Task Submit()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            _error = L["Common_AccountNotFound"];
            return;
        }

        var result = await AccountService.ChangePasswordAsync(user.Id, Input.CurrentPassword, Input.NewPassword);
        if (result.Succeeded)
        {
            _succeeded = true;
            return;
        }

        _error = string.Join(" ", result.Errors);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Required))]
        [DataType(DataType.Password)]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Required))]
        [StringLength(100, MinimumLength = 8, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Length))]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.ConfirmPassword_Mismatch))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
