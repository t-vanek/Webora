@*  Wrapper that turns each action into its own static-SSR EditForm post. The page can therefore
    sit at the default render mode (no SignalR circuit), and each button has its own [SupplyParameterFromForm]
    handler via FormName. FluentButton with Type="Submit" triggers the parent form's native POST.  *@
<EditForm Model="this" method="post" OnValidSubmit="OnSubmit" FormName="@FormName">
    <FluentButton Type="ButtonType.Submit" Appearance="@Appearance" Style="@Style">
        @Label
    </FluentButton>
</EditForm>

@code {
    [Parameter, EditorRequired] public string FormName { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public Appearance Appearance { get; set; } = Appearance.Outline;

    [Parameter] public string? Style { get; set; }

    [Parameter] public EventCallback OnSubmit { get; set; }
}
