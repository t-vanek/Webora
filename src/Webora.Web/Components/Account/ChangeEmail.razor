@page "/account/change-email"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject IAccountService AccountService

<PageTitle>Změna e-mailu</PageTitle>

<h1>Změna e-mailu</h1>

@if (_submitted)
{
    <div class="alert alert-success" role="alert">
        Na adresu <strong>@Input.NewEmail</strong> jsme poslali potvrzovací odkaz. Změna se projeví po jeho potvrzení.
    </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="change-email">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.NewEmail" class="form-control" autocomplete="email" placeholder="email@example.com" />
                    <label>Nový e-mail</label>
                    <ValidationMessage For="() => Input.NewEmail" />
                </div>
                <button type="submit" class="btn btn-primary">Poslat potvrzení</button>
            </EditForm>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    private bool _submitted;
    private string? _error;

    private async Task Submit()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            _error = "Účet nenalezen.";
            return;
        }

        var result = await AccountService.RequestEmailChangeAsync(user.Id, Input.NewEmail);
        if (result.Succeeded)
        {
            _submitted = true;
            return;
        }

        _error = string.Join(" ", result.Errors);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Zadejte nový e-mail.")]
        [EmailAddress]
        public string NewEmail { get; set; } = string.Empty;
    }
}
