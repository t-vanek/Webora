@page "/account/change-email"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject IAccountService AccountService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ChangeEmail_Title"]</PageTitle>

<h1>@L["ChangeEmail_Title"]</h1>

@if (_submitted)
{
    <div class="alert alert-success" role="alert">@L["ChangeEmail_Success"]</div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="change-email">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.NewEmail" class="form-control" autocomplete="email" placeholder="email@example.com" />
                    <label>@L["Field_NewEmail"]</label>
                    <ValidationMessage For="() => Input.NewEmail" />
                </div>
                <button type="submit" class="btn btn-primary">@L["ChangeEmail_Submit"]</button>
            </EditForm>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    private bool _submitted;
    private string? _error;

    private async Task Submit()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            _error = L["Common_AccountNotFound"];
            return;
        }

        var result = await AccountService.RequestEmailChangeAsync(user.Id, Input.NewEmail);
        if (result.Succeeded)
        {
            _submitted = true;
            return;
        }

        _error = string.Join(" ", result.Errors);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Required))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Invalid))]
        public string NewEmail { get; set; } = string.Empty;
    }
}
