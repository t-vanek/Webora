@page "/logout"
@using Webora.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Logout_Title"]</PageTitle>

<h1>@L["Logout_Title"]</h1>

<AuthorizeView Context="auth">
    <Authorized>
        <EditForm Model="this" method="post" OnValidSubmit="LogoutUser" FormName="logout">
            <p>@L["Logout_Confirm"]</p>
            <button type="submit" class="btn btn-primary">@L["Logout_Submit"]</button>
        </EditForm>
    </Authorized>
    <NotAuthorized>
        <p>@L["Logout_NotSignedIn"]</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task LogoutUser()
    {
        await SignInManager.SignOutAsync();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}
