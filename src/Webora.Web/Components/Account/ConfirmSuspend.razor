@page "/account/confirm-suspend"
@inject IAccountService AccountService
@inject SignInManager<ApplicationUser> SignInManager

<PageTitle>Uspání účtu</PageTitle>

<h1>Uspání účtu</h1>

@if (_succeeded is null)
{
    <p>Ověřuji…</p>
}
else if (_succeeded == true)
{
    <div class="alert alert-success" role="alert">
        Účet byl uspán. Obnovit jej můžete přes <a href="account/forgot-reactivation">obnovení účtu</a>.
    </div>
}
else
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@code {
    [SupplyParameterFromQuery] private Guid UserId { get; set; }
    [SupplyParameterFromQuery] private string? Token { get; set; }

    private bool? _succeeded;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (UserId == Guid.Empty || string.IsNullOrEmpty(Token))
        {
            _succeeded = false;
            _error = "Neplatný odkaz pro uspání účtu.";
            return;
        }

        var result = await AccountService.ConfirmSuspendAsync(UserId, Token);
        _succeeded = result.Succeeded;
        _error = result.Succeeded ? null : string.Join(" ", result.Errors);

        if (result.Succeeded)
        {
            await SignInManager.SignOutAsync();
        }
    }
}
