@page "/account/reset-password"
@using System.ComponentModel.DataAnnotations
@inject IAccountService AccountService

<PageTitle>Obnovení hesla</PageTitle>

<h1>Obnovení hesla</h1>

@if (_succeeded)
{
    <div class="alert alert-success" role="alert">
        Heslo bylo změněno. Nyní se můžete <a href="login">přihlásit</a>.
    </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="reset-password">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password" placeholder="heslo" />
                    <label>Nové heslo</label>
                    <ValidationMessage For="() => Input.Password" />
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="heslo" />
                    <label>Heslo znovu</label>
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Změnit heslo</button>
            </EditForm>
        </div>
    </div>
}

@code {
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    [SupplyParameterFromQuery] private string? Email { get; set; }
    [SupplyParameterFromQuery] private string? Token { get; set; }

    private bool _succeeded;
    private string? _error;

    private async Task Submit()
    {
        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            _error = "Neplatný odkaz pro obnovení hesla.";
            return;
        }

        var result = await AccountService.ResetPasswordAsync(Email, Token, Input.Password);
        if (result.Succeeded)
        {
            _succeeded = true;
            return;
        }

        _error = string.Join(" ", result.Errors);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Zadejte heslo.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Heslo musí mít alespoň 8 znaků.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Hesla se neshodují.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
