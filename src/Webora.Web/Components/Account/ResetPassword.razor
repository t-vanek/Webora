@page "/account/reset-password"
@using System.ComponentModel.DataAnnotations
@inject IAccountService AccountService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ResetPassword_Title"]</PageTitle>

<FluentCard Style="max-width:480px">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.H3">@L["ResetPassword_Title"]</FluentLabel>

        @if (_succeeded)
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="false">
                @L["ResetPassword_Success"]
                <FluentAnchor Href="login" Appearance="Appearance.Hypertext">@L["Common_SignIn"]</FluentAnchor>.
            </FluentMessageBar>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="reset-password">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="false">
                        @_error
                    </FluentMessageBar>
                }
                <FluentTextField Name="Input.Password"
                                 @bind-Value="Input.Password"
                                 Label="@L["Field_NewPassword"]"
                                 TextFieldType="TextFieldType.Password"
                                 AutoComplete="new-password"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.Password" />
                <FluentTextField Name="Input.ConfirmPassword"
                                 @bind-Value="Input.ConfirmPassword"
                                 Label="@L["Field_ConfirmPassword"]"
                                 TextFieldType="TextFieldType.Password"
                                 AutoComplete="new-password"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%; margin-top:12px">
                    @L["ResetPassword_Submit"]
                </FluentButton>
            </EditForm>
        }
    </FluentStack>
</FluentCard>

@code {
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    [SupplyParameterFromQuery] private string? Email { get; set; }
    [SupplyParameterFromQuery] private string? Token { get; set; }

    private bool _succeeded;
    private string? _error;

    private async Task Submit()
    {
        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            _error = L["ResetPassword_Invalid"];
            return;
        }

        var result = await AccountService.ResetPasswordAsync(Email, Token, Input.Password);
        if (result.Succeeded)
        {
            _succeeded = true;
            return;
        }

        _error = string.Join(" ", result.Errors);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Required))]
        [StringLength(100, MinimumLength = 8, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Length))]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.ConfirmPassword_Mismatch))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
