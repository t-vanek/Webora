@page "/account/forgot-password"
@using System.ComponentModel.DataAnnotations
@inject IAccountService AccountService

<PageTitle>Zapomenuté heslo</PageTitle>

<h1>Zapomenuté heslo</h1>

@if (_submitted)
{
    <div class="alert alert-success" role="alert">
        Pokud účet s touto adresou existuje, poslali jsme na něj odkaz pro obnovení hesla.
    </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="forgot-password">
                <DataAnnotationsValidator />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" placeholder="email@example.com" />
                    <label>E-mail</label>
                    <ValidationMessage For="() => Input.Email" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Poslat odkaz</button>
            </EditForm>
        </div>
    </div>
}

@code {
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    private bool _submitted;

    private async Task Submit()
    {
        await AccountService.RequestPasswordResetAsync(Input.Email);
        _submitted = true;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Zadejte e-mail.")]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
