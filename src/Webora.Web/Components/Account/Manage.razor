@page "/account/manage"
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Manage_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.PageTitle">@L["Manage_Title"]</FluentLabel>

    @if (_user is not null)
    {
        <FluentCard Style="max-width:640px">
            <FluentGrid Spacing="3">
                <FluentGridItem xs="12" md="3"><strong>@L["Manage_Name"]</strong></FluentGridItem>
                <FluentGridItem xs="12" md="9">@(string.IsNullOrWhiteSpace(_user.DisplayName) ? "—" : _user.DisplayName)</FluentGridItem>

                <FluentGridItem xs="12" md="3"><strong>@L["Manage_Email"]</strong></FluentGridItem>
                <FluentGridItem xs="12" md="9">@_user.Email</FluentGridItem>

                <FluentGridItem xs="12" md="3"><strong>@L["Manage_Phone"]</strong></FluentGridItem>
                <FluentGridItem xs="12" md="9">@(_user.PhoneNumber ?? "—")</FluentGridItem>

                <FluentGridItem xs="12" md="3"><strong>@L["Manage_Status"]</strong></FluentGridItem>
                <FluentGridItem xs="12" md="9">@_user.Status</FluentGridItem>
            </FluentGrid>
        </FluentCard>

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="max-width:420px">
            <FluentAnchor Href="account/change-password" Appearance="Appearance.Neutral" Style="width:100%">@L["Manage_ChangePassword"]</FluentAnchor>
            <FluentAnchor Href="account/change-email" Appearance="Appearance.Neutral" Style="width:100%">@L["Manage_ChangeEmail"]</FluentAnchor>
            <FluentAnchor Href="account/change-phone" Appearance="Appearance.Neutral" Style="width:100%">@L["Manage_ChangePhone"]</FluentAnchor>
            <FluentAnchor Href="account/suspend" Appearance="Appearance.Neutral" Style="width:100%">@L["Manage_Suspend"]</FluentAnchor>
            <FluentAnchor Href="account/deactivate" Appearance="Appearance.Outline" Style="width:100%">@L["Manage_Deactivate"]</FluentAnchor>
        </FluentStack>
    }
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ApplicationUser? _user;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        _user = await UserManager.GetUserAsync(state.User);
    }
}
