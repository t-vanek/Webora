@page "/account/manage"
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Manage_Title"]</PageTitle>

<h1>@L["Manage_Title"]</h1>

@if (_user is not null)
{
    <dl class="row">
        <dt class="col-sm-3">@L["Manage_Name"]</dt>
        <dd class="col-sm-9">@_user.DisplayName</dd>
        <dt class="col-sm-3">@L["Manage_Email"]</dt>
        <dd class="col-sm-9">@_user.Email</dd>
        <dt class="col-sm-3">@L["Manage_Phone"]</dt>
        <dd class="col-sm-9">@(_user.PhoneNumber ?? "—")</dd>
        <dt class="col-sm-3">@L["Manage_Status"]</dt>
        <dd class="col-sm-9">@_user.Status</dd>
    </dl>

    <div class="list-group" style="max-width:420px;">
        <a class="list-group-item list-group-item-action" href="account/change-password">@L["Manage_ChangePassword"]</a>
        <a class="list-group-item list-group-item-action" href="account/change-email">@L["Manage_ChangeEmail"]</a>
        <a class="list-group-item list-group-item-action" href="account/change-phone">@L["Manage_ChangePhone"]</a>
        <a class="list-group-item list-group-item-action" href="account/suspend">@L["Manage_Suspend"]</a>
        <a class="list-group-item list-group-item-action list-group-item-danger" href="account/deactivate">@L["Manage_Deactivate"]</a>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ApplicationUser? _user;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        _user = await UserManager.GetUserAsync(state.User);
    }
}
