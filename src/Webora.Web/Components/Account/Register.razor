@page "/register"
@using System.ComponentModel.DataAnnotations
@inject IAccountService AccountService
@inject ILogger<Register> Logger

<PageTitle>Registrace</PageTitle>

<h1>Registrace</h1>

@if (_registered)
{
    <div class="alert alert-success" role="alert">
        Účet byl vytvořen. Na <strong>@Input.Email</strong> jsme poslali aktivační odkaz —
        po jeho potvrzení se budete moci přihlásit.
    </div>
}
else
{
    <div class="row">
        <div class="col-md-5">
            <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.DisplayName" class="form-control" autocomplete="name" placeholder="Jméno" />
                    <label>Zobrazované jméno</label>
                </div>
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" placeholder="email@example.com" />
                    <label>E-mail</label>
                    <ValidationMessage For="() => Input.Email" />
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password" placeholder="heslo" />
                    <label>Heslo</label>
                    <ValidationMessage For="() => Input.Password" />
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="heslo" />
                    <label>Heslo znovu</label>
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Vytvořit účet</button>
            </EditForm>
        </div>
    </div>
}

@code {
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    private bool _registered;
    private string? _error;

    private async Task RegisterUser()
    {
        var result = await AccountService.RegisterAsync(Input.Email, Input.Password, Input.DisplayName);
        if (result.Succeeded)
        {
            Logger.LogInformation("Registered account {Email}", Input.Email);
            _registered = true;
            return;
        }

        _error = string.Join(" ", result.Errors);
    }

    private sealed class InputModel
    {
        public string? DisplayName { get; set; }

        [Required(ErrorMessage = "Zadejte e-mail.")]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Zadejte heslo.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Heslo musí mít alespoň 8 znaků.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Hesla se neshodují.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
