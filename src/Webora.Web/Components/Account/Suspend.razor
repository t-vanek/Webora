@page "/account/suspend"
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject IAccountService AccountService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Suspend_Title"]</PageTitle>

<h1>@L["Suspend_Title"]</h1>

<p>@L["Suspend_Intro"]</p>

@if (_submitted)
{
    <div class="alert alert-success" role="alert">@L["Suspend_Success"]</div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    <EditForm Model="this" method="post" OnValidSubmit="Submit" FormName="suspend">
        <button type="submit" class="btn btn-warning">@L["Suspend_Submit"]</button>
    </EditForm>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _submitted;
    private string? _error;

    private async Task Submit()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            _error = L["Common_AccountNotFound"];
            return;
        }

        var result = await AccountService.RequestSuspendAsync(user.Id);
        if (result.Succeeded)
        {
            _submitted = true;
            return;
        }

        _error = string.Join(" ", result.Errors);
    }
}
