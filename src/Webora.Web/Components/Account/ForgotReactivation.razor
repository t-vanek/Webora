@page "/account/forgot-reactivation"
@using System.ComponentModel.DataAnnotations
@inject IAccountService AccountService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ForgotReactivation_Title"]</PageTitle>

<h1>@L["ForgotReactivation_Title"]</h1>

<p>@L["ForgotReactivation_Intro"]</p>

@if (_submitted)
{
    <div class="alert alert-success" role="alert">@L["ForgotReactivation_Success"]</div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="forgot-reactivation">
                <DataAnnotationsValidator />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" placeholder="email@example.com" />
                    <label>@L["Field_Email"]</label>
                    <ValidationMessage For="() => Input.Email" />
                </div>
                <button type="submit" class="btn btn-primary w-100">@L["ForgotReactivation_Submit"]</button>
            </EditForm>
        </div>
    </div>
}

@code {
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    private bool _submitted;

    private async Task Submit()
    {
        await AccountService.RequestReactivationAsync(Input.Email);
        _submitted = true;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Required))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Invalid))]
        public string Email { get; set; } = string.Empty;
    }
}
