@page "/account/profile"
@attribute [Authorize]
@using Webora.Application.Notifications
@using Webora.Domain.Notifications
@inject UserManager<ApplicationUser> UserManager
@inject INotificationService NotificationService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Profile_Title"]</PageTitle>

<h1>@L["Profile_Title"]</h1>

<AuthorizeView Context="auth">
    <Authorized>
        <p>@L["Profile_SignedInAs"] <strong>@auth.User.Identity?.Name</strong></p>

        <h2 class="h5 mt-4">@L["Profile_NotificationSettings"]</h2>
        <div class="mb-2">
            <span class="me-2">@L["Profile_Status"]:</span>
            @if (_prefs.IsCurrentlyMuted)
            {
                <span class="badge bg-warning text-dark">
                    @(_prefs.Muted ? L["Profile_StatusMuted"] : L["Profile_StatusMutedUntil", _prefs.MutedUntilUtc?.LocalDateTime.ToString("g") ?? ""])
                </span>
            }
            else
            {
                <span class="badge bg-success">@L["Profile_StatusActive"]</span>
            }
            <span class="ms-3 me-2">@L["Profile_Scope"]:</span>
            <span class="badge bg-secondary">@(_prefs.Scope == NotificationScope.SelfServiceOnly ? L["Profile_ScopeSelfService"] : L["Profile_ScopeAll"])</span>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-2">
            <MuteButton FormName="mute-1h" Label="@L["Profile_Mute1h"]" OnSubmit="() => MuteForAsync(TimeSpan.FromHours(1))" />
            <MuteButton FormName="mute-8h" Label="@L["Profile_Mute8h"]" OnSubmit="() => MuteForAsync(TimeSpan.FromHours(8))" />
            <MuteButton FormName="mute-tomorrow" Label="@L["Profile_MuteTomorrow"]" OnSubmit="MuteUntilTomorrowAsync" />
            <MuteButton FormName="mute-all" Label="@L["Profile_MuteCompletely"]" Css="btn-warning" OnSubmit="MuteCompletelyAsync" />
            @if (_prefs.IsCurrentlyMuted)
            {
                <MuteButton FormName="unmute" Label="@L["Profile_Unmute"]" Css="btn-outline-success" OnSubmit="UnmuteAsync" />
            }
        </div>
        <div class="d-flex flex-wrap gap-2 mb-2">
            <MuteButton FormName="scope-self" Label="@L["Profile_ScopeSetSelf"]" Css="btn-outline-secondary" OnSubmit="() => SetScopeAsync(NotificationScope.SelfServiceOnly)" />
            <MuteButton FormName="scope-all" Label="@L["Profile_ScopeSetAll"]" Css="btn-outline-secondary" OnSubmit="() => SetScopeAsync(NotificationScope.All)" />
        </div>

        <div class="d-flex align-items-center gap-2 mt-4">
            <h2 class="h5 mb-0">@L["Profile_Notifications"]</h2>
            @if (_notifications.Any(n => !n.IsRead))
            {
                <span class="badge bg-primary">@L["Profile_Unread", _notifications.Count(n => !n.IsRead)]</span>
                <EditForm Model="this" method="post" OnValidSubmit="MarkAllRead" FormName="mark-all-read" class="ms-auto">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Profile_MarkAllRead"]</button>
                </EditForm>
            }
        </div>

        @if (_notifications.Count == 0)
        {
            <p class="text-muted">@L["Profile_NoNotifications"]</p>
        }
        else
        {
            <ul class="list-group mt-2" style="max-width:640px;">
                @foreach (var n in _notifications)
                {
                    <li class="list-group-item @(n.IsRead ? "" : "list-group-item-light")">
                        <div class="d-flex justify-content-between">
                            <strong>@n.Title @LevelBadge(n.Level)</strong>
                            <small class="text-muted">@n.CreatedAtUtc.LocalDateTime.ToString("g")</small>
                        </div>
                        <div>@n.Message</div>
                    </li>
                }
            </ul>
        }

        <h2 class="h5 mt-4">@L["Profile_Claims"]</h2>
        <ul>
            @foreach (var claim in auth.User.Claims)
            {
                <li><code>@claim.Type</code> = @claim.Value</li>
            }
        </ul>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<NotificationDto> _notifications = [];
    private NotificationPreferencesDto _prefs = new(false, null, false, NotificationScope.All);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task<Guid?> CurrentUserIdAsync()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        return user?.Id;
    }

    private async Task ReloadAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            _notifications = await NotificationService.GetAsync(userId);
            _prefs = await NotificationService.GetPreferencesAsync(userId);
        }
    }

    private async Task MarkAllRead()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await NotificationService.MarkAllReadAsync(userId);
            await ReloadAsync();
        }
    }

    private async Task MuteForAsync(TimeSpan duration)
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await NotificationService.MuteUntilAsync(userId, DateTimeOffset.UtcNow.Add(duration));
            await ReloadAsync();
        }
    }

    private async Task MuteUntilTomorrowAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            var tomorrow = new DateTimeOffset(DateTime.Today.AddDays(1), DateTimeOffset.Now.Offset);
            await NotificationService.MuteUntilAsync(userId, tomorrow);
            await ReloadAsync();
        }
    }

    private async Task MuteCompletelyAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await NotificationService.MuteAsync(userId);
            await ReloadAsync();
        }
    }

    private async Task UnmuteAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await NotificationService.UnmuteAsync(userId);
            await ReloadAsync();
        }
    }

    private async Task SetScopeAsync(NotificationScope scope)
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await NotificationService.SetScopeAsync(userId, scope);
            await ReloadAsync();
        }
    }

    private RenderFragment LevelBadge(NotificationLevel level) => builder =>
    {
        var (css, key) = level switch
        {
            NotificationLevel.Security => ("bg-danger", "Notification_Level_Security"),
            NotificationLevel.Warning => ("bg-warning text-dark", "Notification_Level_Warning"),
            _ => ("bg-secondary", "Notification_Level_Info"),
        };
        builder.AddMarkupContent(0, $"<span class=\"badge {css} ms-1\">{System.Net.WebUtility.HtmlEncode(L[key])}</span>");
    };
}
