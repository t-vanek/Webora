@page "/account/confirm-reactivation"
@inject IAccountService AccountService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ConfirmReactivation_Title"]</PageTitle>

<h1>@L["ConfirmReactivation_Title"]</h1>

@if (_succeeded is null)
{
    <p>@L["Common_Verifying"]</p>
}
else if (_succeeded == true)
{
    <div class="alert alert-success" role="alert">
        @L["ConfirmReactivation_Success"] <a href="login">@L["Common_SignIn"]</a>.
    </div>
}
else
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@code {
    [SupplyParameterFromQuery] private Guid UserId { get; set; }
    [SupplyParameterFromQuery] private string? Token { get; set; }

    private bool? _succeeded;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (UserId == Guid.Empty || string.IsNullOrEmpty(Token))
        {
            _succeeded = false;
            _error = L["ConfirmReactivation_Invalid"];
            return;
        }

        var result = await AccountService.ConfirmReactivationAsync(UserId, Token);
        _succeeded = result.Succeeded;
        _error = result.Succeeded ? null : string.Join(" ", result.Errors);
    }
}
