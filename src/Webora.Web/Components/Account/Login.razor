@page "/login"
@using System.ComponentModel.DataAnnotations
@using Webora.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject ILogger<Login> Logger
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Login_Title"]</PageTitle>

@*  Static SSR — SignInManager.PasswordSignInAsync writes the auth cookie via the request
    HttpContext, which is only available during a real form post. Fluent text fields work here
    because they're form-associated custom elements; the explicit Name attribute on each one
    tells the browser what key to submit under, matching the [SupplyParameterFromForm] property
    paths.  *@
<FluentCard Style="max-width:480px">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.H3">@L["Login_Title"]</FluentLabel>

        <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="false">
                    @_errorMessage
                </FluentMessageBar>
            }
            <FluentTextField Name="Input.Email"
                             @bind-Value="Input.Email"
                             Label="@L["Login_Email"]"
                             AutoComplete="username"
                             Placeholder="email@example.com"
                             Style="width:100%" />
            <ValidationMessage For="() => Input.Email" />
            <FluentTextField Name="Input.Password"
                             @bind-Value="Input.Password"
                             Label="@L["Login_Password"]"
                             TextFieldType="TextFieldType.Password"
                             AutoComplete="current-password"
                             Style="width:100%" />
            <ValidationMessage For="() => Input.Password" />
            @*  Experiment: FluentCheckbox on a static-SSR form. Unlike <InputCheckbox>, which
                injects a hidden companion input so the false state always shows up in the form
                data, a web-component checkbox submits its value only when checked. That's fine
                here specifically because RememberMe defaults to false on the server: unchecked
                → key absent from form data → Blazor binds false, which is exactly what we want.
                Don't reuse this trick on forms where the default isn't false — those still need
                <InputCheckbox> for the round-trip to work.  *@
            <FluentCheckbox Name="Input.RememberMe"
                            @bind-Value="Input.RememberMe"
                            Label="@L["Login_Remember"]"
                            Style="margin-bottom:12px" />
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%">
                @L["Login_Submit"]
            </FluentButton>
        </EditForm>

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
            <FluentAnchor Href="register" Appearance="Appearance.Hypertext">@L["Login_CreateAccount"]</FluentAnchor>
            <FluentAnchor Href="account/forgot-password" Appearance="Appearance.Hypertext">@L["Login_ForgotPassword"]</FluentAnchor>
            <FluentAnchor Href="account/forgot-reactivation" Appearance="Appearance.Hypertext">@L["Login_Reactivate"]</FluentAnchor>
        </FluentStack>
    </FluentStack>
</FluentCard>

@code {
    // Initializer is required so the form renders on GET; the form supplies a non-null value on POST.
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? _errorMessage;

    private async Task LoginUser()
    {
        var result = await SignInManager.PasswordSignInAsync(
            Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: false);

        if (result.Succeeded)
        {
            Logger.LogInformation("User {Email} logged in.", Input.Email);
            NavigationManager.NavigateTo(GetLocalReturnUrl());
            return;
        }

        _errorMessage = result.IsLockedOut ? L["Login_LockedOut"] : L["Login_Invalid"];
    }

    // Guards against open-redirect: only relative, non-protocol-relative paths are honoured.
    private string GetLocalReturnUrl()
    {
        if (string.IsNullOrEmpty(ReturnUrl) || ReturnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            return "/";
        }

        return ReturnUrl.StartsWith('/') ? ReturnUrl : "/" + ReturnUrl;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Required))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Invalid))]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Required))]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
