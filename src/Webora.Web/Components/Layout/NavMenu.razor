@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Webora.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @L["Nav_Home"]
            </NavLink>
        </div>

        @if (_canAdminUsers || _canAdminRoles || _canSettings)
        {
            <div class="nav-item px-3 mt-2">
                <small class="text-light text-uppercase">@L["Nav_Administration"]</small>
            </div>
            @if (_canAdminUsers)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/users">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> @L["Nav_AdminUsers"]
                    </NavLink>
                </div>
            }
            @if (_canAdminRoles)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/roles">
                        <span class="bi bi-shield-lock-nav-menu" aria-hidden="true"></span> @L["Nav_AdminRoles"]
                    </NavLink>
                </div>
            }
            @if (_canSettings)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/settings">
                        <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> @L["Nav_AdminSettings"]
                    </NavLink>
                </div>
            }
        }

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account/manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="logout">
                        <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> @L["Nav_Logout"]
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> @L["Nav_Login"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">
                        <span class="bi bi-person-plus-nav-menu" aria-hidden="true"></span> @L["Nav_Register"]
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <div class="nav-item px-3 mt-2">
            <small class="text-light">@L["Language"]:</small>
            <a class="nav-link d-inline p-0 ms-1" href="@CultureUrl("cs")">CS</a>
            <span class="text-light">|</span>
            <a class="nav-link d-inline p-0" href="@CultureUrl("en")">EN</a>
        </div>
    </nav>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _canAdminUsers;
    private bool _canAdminRoles;
    private bool _canSettings;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _canAdminUsers = user.HasClaim(WeboraClaimTypes.Permission, Permissions.Users.View);
            _canAdminRoles = user.HasClaim(WeboraClaimTypes.Permission, Permissions.Roles.View);
            _canSettings = user.HasClaim(WeboraClaimTypes.Permission, Permissions.Settings.View);
        }
    }

    private string CultureUrl(string culture)
    {
        var relative = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        return $"/culture/set?culture={culture}&redirectUri={Uri.EscapeDataString(relative)}";
    }
}
