@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject IStringLocalizer<SharedResource> L

<FluentNavMenu Width="250" Collapsible="true" Title="@L["Nav_Menu"]">
    <FluentNavLink Href="" Match="NavLinkMatch.All"
                   Icon="@(new Icons.Regular.Size20.Home())">
        @L["Nav_Home"]
    </FluentNavLink>

    @if (_canAdminUsers || _canAdminRoles || _canSettings)
    {
        <FluentNavGroup Title="@L["Nav_Administration"]" Expanded="true">
            @if (_canAdminUsers)
            {
                <FluentNavLink Href="admin/users" Icon="@(new Icons.Regular.Size20.People())">
                    @L["Nav_AdminUsers"]
                </FluentNavLink>
            }
            @if (_canAdminRoles)
            {
                <FluentNavLink Href="admin/roles" Icon="@(new Icons.Regular.Size20.ShieldKeyhole())">
                    @L["Nav_AdminRoles"]
                </FluentNavLink>
            }
            @if (_canSettings)
            {
                <FluentNavLink Href="admin/settings" Icon="@(new Icons.Regular.Size20.Settings())">
                    @L["Nav_AdminSettings"]
                </FluentNavLink>
            }
        </FluentNavGroup>
    }

    @* Login / Register moved to the header in MainLayout — sidebar only shows account links
       once the user is signed in. *@
    <AuthorizeView>
        <Authorized>
            <FluentNavLink Href="account/manage" Icon="@(new Icons.Regular.Size20.Person())">
                @context.User.Identity?.Name
            </FluentNavLink>
            <FluentNavLink Href="logout" Icon="@(new Icons.Regular.Size20.SignOut())">
                @L["Nav_Logout"]
            </FluentNavLink>
        </Authorized>
    </AuthorizeView>
</FluentNavMenu>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _canAdminUsers;
    private bool _canAdminRoles;
    private bool _canSettings;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _canAdminUsers = user.HasClaim(WeboraClaimTypes.Permission, Permissions.Users.View);
            _canAdminRoles = user.HasClaim(WeboraClaimTypes.Permission, Permissions.Roles.View);
            _canSettings = user.HasClaim(WeboraClaimTypes.Permission, Permissions.Settings.View);
        }
    }
}
