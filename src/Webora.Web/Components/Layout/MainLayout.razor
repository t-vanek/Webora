@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center gap-3">
            <NotificationBell @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))" />
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">@L["Layout_About"]</a>
            <ThemeToggle @rendermode="InteractiveServer" />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@* Fluent UI providers live as interactive islands so dialogs, toasts and menus work even when the
   hosting page is statically rendered. Pages or admin forms that already run InteractiveServer can
   call IDialogService / IToastService and the matching provider here will render the result. The
   <ThemeToggle /> in the top-row also owns the FluentDesignTheme component that emits the design
   tokens onto the document. *@
<FluentToastProvider @rendermode="InteractiveServer" />
<FluentDialogProvider @rendermode="InteractiveServer" />
<FluentTooltipProvider @rendermode="InteractiveServer" />
<FluentMessageBarProvider @rendermode="InteractiveServer" />
<FluentMenuProvider @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet>
    @L["Layout_Error"]
    <a href="." class="reload">@L["Layout_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
