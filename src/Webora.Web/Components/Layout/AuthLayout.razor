@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L
@inject ISiteSettingsService SiteSettings

@*  AuthLayout is the no-sidebar variant of MainLayout used by the Login and Register pages.
    The full sidebar makes no sense there — the user can't navigate anywhere useful before signing
    in — so the layout collapses to just the header + the page body. The header keeps the brand and
    a Login/Register switch so the two sister pages can still flip between each other.  *@
<FluentLayout>
    <FluentHeader>
        <a href="" class="brand-link">@_siteName</a>
        <FluentSpacer />
        <AuthorizeView>
            <NotAuthorized>
                <a href="login" class="header-nav-link">@L["Nav_Login"]</a>
                <a href="register" class="header-nav-link">@L["Nav_Register"]</a>
            </NotAuthorized>
        </AuthorizeView>
        <ThemeToggle @rendermode="InteractiveServer" />
    </FluentHeader>

    <FluentBodyContent Class="body-content" Style="padding:1.5rem; overflow:auto">
        @Body
    </FluentBodyContent>
</FluentLayout>

@* Same provider set as MainLayout so dialogs/toasts/etc. still work from the auth pages. *@
<FluentToastProvider @rendermode="InteractiveServer" />
<FluentDialogProvider @rendermode="InteractiveServer" />
<FluentTooltipProvider @rendermode="InteractiveServer" />
<FluentMessageBarProvider @rendermode="InteractiveServer" />
<FluentMenuProvider @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet>
    @L["Layout_Error"]
    <a href="." class="reload">@L["Layout_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _siteName = "Webora";

    protected override async Task OnInitializedAsync() =>
        _siteName = (await SiteSettings.GetIdentityAsync()).Name ?? "Webora";
}
