<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.PageTitle">@L["Home_Title"]</FluentLabel>
    <FluentLabel Typo="Typography.Body">@L["Home_Welcome"]</FluentLabel>
</FluentStack>
