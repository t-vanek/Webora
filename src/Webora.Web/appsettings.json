    "Redis": "localhost:6379",
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "IdentitySeed": {
    "AdminEmail": "admin@webora.local",
    "AdminPassword": "Admin123$",
    "AdminDisplayName": "Administrator"
  },
  "Account": {
    "BaseUrl": "https://localhost:7048"
  },
  "Parking": {
    "ReleasePoints": 10,
    "OffPeakBonusPoints": 5,
    "NoShowPenaltyPoints": 20,
    "ReleaseCutoff": "01:00:00",
    "NoShowGracePeriod": "00:30:00",
    "ReminderLeadTime": "00:05:00",
    "PeakStart": "07:30:00",
    "PeakEnd": "10:00:00",
    "SweepInterval": "00:05:00"
  },
  "ForwardedHeaders": {
    "TrustAllProxies": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 2525,
    "Security": "None",
    "Authentication": "None",
    "SenderEmail": "no-reply@webora.local",
    "SenderName": "Webora",
    "OAuth2": {
      "TokenEndpoint": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scope": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
