@using D3Parking.Web.Hosting
@using D3Parking.Application.Settings
@inject IHttpContextAccessor HttpContextAccessor
@inject ISiteSettingsService SiteSettings

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="@PageCharset" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (!string.IsNullOrWhiteSpace(_description))
    {
        <meta name="description" content="@_description" />
    }
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["D3Parking.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#023444" />
    <link rel="apple-touch-icon" sizes="180x180" href="icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="@_siteName" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script>
        window.d3parkingGetCulture = () => {
            const match = document.cookie.match(/\.AspNetCore\.Culture=([^;]+)/);
            if (!match) return null;
            const value = decodeURIComponent(match[1]);
            const uic = value.split('|').find(part => part.startsWith('uic='));
            return uic ? uic.substring(4) : null;
        };
    </script>
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private string? _description;
    private string _siteName = "D3Parking";

    protected override async Task OnInitializedAsync()
    {
        var identity = await SiteSettings.GetIdentityAsync();
        _description = identity.Description;
        _siteName = string.IsNullOrWhiteSpace(identity.Name) ? "D3Parking" : identity.Name;
    }

    private string PageCharset =>
        HttpContextAccessor.HttpContext?.Items[CharsetMiddleware.HttpContextItemKey] as string ?? "utf-8";
}
