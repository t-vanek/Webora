@page "/logout"
@using D3Parking.Infrastructure.Identity
@using D3Parking.Application.Identity
@using D3Parking.Web.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IEntraSettingsService EntraSettings
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Logout_Title"]</PageTitle>

@*  Static SSR form post: SignInManager.SignOutAsync writes the cookie clear via HttpContext during
    the real POST, just like the login flow does. The Fluent chrome wraps the form; the submit
    remains a native form post triggered by FluentButton type="submit".  *@
<FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:640px">
    <FluentLabel Typo="Typography.PageTitle">@L["Logout_Title"]</FluentLabel>

    <AuthorizeView Context="auth">
        <Authorized>
            @* data-push-unsubscribe: app.js před odesláním zruší push subscription tohoto
               prohlížeče, aby sdílený počítač nezobrazoval notifikace odhlášeného uživatele. *@
            <EditForm Model="this" method="post" OnValidSubmit="LogoutUser" FormName="logout" data-push-unsubscribe>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                    <FluentLabel Typo="Typography.Body">@L["Logout_Confirm"]</FluentLabel>
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">@L["Logout_Submit"]</FluentButton>
                </FluentStack>
            </EditForm>
        </Authorized>
        <NotAuthorized>
            <FluentLabel Typo="Typography.Body">@L["Logout_NotSignedIn"]</FluentLabel>
        </NotAuthorized>
    </AuthorizeView>
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private async Task LogoutUser()
    {
        // A federated session has two halves and this page only owns one. The endpoint ends both:
        // the local cookie here, then the directory session at Entra. Local accounts take the
        // short path — there is nothing else to end, and no reason to leave the site.
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is not null && user.IsFederated
            && (await EntraSettings.GetEffectiveAsync()).IsSignInConfigured)
        {
            NavigationManager.NavigateTo(ExternalSignInEndpoints.SignOutPath, forceLoad: true);
            return;
        }

        await SignInManager.SignOutAsync();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}
