@page "/account/forgot-reactivation"
@using System.ComponentModel.DataAnnotations
@inject IAccountService AccountService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ForgotReactivation_Title"]</PageTitle>

<FluentCard Style="max-width:480px">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.H3">@L["ForgotReactivation_Title"]</FluentLabel>
        <FluentLabel Typo="Typography.Body">@L["ForgotReactivation_Intro"]</FluentLabel>

        @*  Static SSR feedback: FluentMessageBar renders nothing without an interactive
            circuit, so the submitted state arrives as a redirect query value
            (post-redirect-get) rendered through the global auth-alert styles.  *@
        @if (!string.IsNullOrEmpty(_info))
        {
            <div class="auth-alert auth-alert--success" role="status">
                <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="currentColor" />
                <span>@L[_info]</span>
            </div>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="forgot-reactivation">
                <DataAnnotationsValidator />
                <FluentTextField Name="Input.Email"
                                 @bind-Value="Input.Email"
                                 Label="@L["Field_Email"]"
                                 AutoComplete="username"
                                 Placeholder="email@example.com"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.Email" />
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%; margin-top:12px">
                    @L["ForgotReactivation_Submit"]
                </FluentButton>
            </EditForm>
        }
    </FluentStack>
</FluentCard>

@code {
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    // Post-redirect-get feedback (see the markup note above the alert). The property must
    // be public — static SSR does not bind [SupplyParameterFromQuery] to private ones.
    [SupplyParameterFromQuery(Name = "info")] public string? Info { get; set; }

    private string? _info;

    // The value arrives on an open URL parameter, so it only passes through as the one
    // success key the redirect here actually emits.
    protected override void OnInitialized()
    {
        if (Info == "ForgotReactivation_Success")
        {
            _info = Info;
        }
    }

    // NavigateTo does not interrupt a static SSR handler (no exception since .NET 10), so
    // the redirect must stay the handler's last real work.
    private async Task Submit()
    {
        await AccountService.RequestReactivationAsync(Input.Email);
        Nav.NavigateTo("account/forgot-reactivation?info=" + Uri.EscapeDataString("ForgotReactivation_Success"));
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Required))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Invalid))]
        public string Email { get; set; } = string.Empty;
    }
}
