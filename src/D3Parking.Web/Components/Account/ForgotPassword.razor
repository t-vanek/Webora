@page "/account/forgot-password"
@using System.ComponentModel.DataAnnotations
@inject IAccountService AccountService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ForgotPassword_Title"]</PageTitle>

<FluentCard Style="max-width:480px">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.H3">@L["ForgotPassword_Title"]</FluentLabel>

        @if (_submitted)
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="false">
                @L["ForgotPassword_Success"]
            </FluentMessageBar>
        }
        else
        {
            @*  Experiment: FluentTextField on a static-SSR form. FluentTextField is a
                form-associated custom element (via FAST's ElementInternals support), so
                an explicit Name should make the value round-trip through the form post
                the same way <InputText> does. ForgotPassword is the safest pilot: single
                field, idempotent server action, no auth side-effect.

                If this breaks at runtime (empty Input.Email on POST), revert this file
                and keep using <InputText> across the other static-SSR forms.  *@
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="forgot-password">
                <DataAnnotationsValidator />
                <FluentTextField Name="Input.Email"
                                 @bind-Value="Input.Email"
                                 Label="@L["Field_Email"]"
                                 AutoComplete="username"
                                 Placeholder="email@example.com"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.Email" />
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%; margin-top:12px">
                    @L["ForgotPassword_Submit"]
                </FluentButton>
            </EditForm>
        }
    </FluentStack>
</FluentCard>

@code {
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    private bool _submitted;

    private async Task Submit()
    {
        await AccountService.RequestPasswordResetAsync(Input.Email);
        _submitted = true;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Required))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Invalid))]
        public string Email { get; set; } = string.Empty;
    }
}
