@page "/account/reset-password"
@using System.ComponentModel.DataAnnotations
@inject IAccountService AccountService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ResetPassword_Title"]</PageTitle>

<FluentCard Style="max-width:480px">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.H3">@L["ResetPassword_Title"]</FluentLabel>

        @*  Static SSR feedback: FluentMessageBar renders nothing without an interactive
            circuit, so every POST outcome arrives as a redirect query value
            (post-redirect-get) rendered through the global auth-alert styles.  *@
        @if (!string.IsNullOrEmpty(Info))
        {
            <div class="auth-alert auth-alert--success" role="status">
                <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="currentColor" />
                <span>@L[Info] <FluentAnchor Href="login" Appearance="Appearance.Hypertext">@L["Common_SignIn"]</FluentAnchor>.</span>
            </div>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="reset-password">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="auth-alert auth-alert--error" role="alert">
                        <FluentIcon Value="@(new Icons.Filled.Size20.ErrorCircle())" Color="Color.Custom" CustomColor="currentColor" />
                        <span>@L[Error]</span>
                    </div>
                }
                <FluentTextField Name="Input.Password"
                                 @bind-Value="Input.Password"
                                 Label="@L["Field_NewPassword"]"
                                 TextFieldType="TextFieldType.Password"
                                 AutoComplete="new-password"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.Password" />
                <FluentTextField Name="Input.ConfirmPassword"
                                 @bind-Value="Input.ConfirmPassword"
                                 Label="@L["Field_ConfirmPassword"]"
                                 TextFieldType="TextFieldType.Password"
                                 AutoComplete="new-password"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%; margin-top:12px">
                    @L["ResetPassword_Submit"]
                </FluentButton>
            </EditForm>
        }
    </FluentStack>
</FluentCard>

@code {
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    [SupplyParameterFromQuery] private string? Email { get; set; }
    [SupplyParameterFromQuery] private string? Token { get; set; }

    // Post-redirect-get feedback (see the markup note above the alerts). The properties must
    // be public — static SSR does not bind [SupplyParameterFromQuery] to private ones.
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "info")] public string? Info { get; set; }

    private async Task Submit()
    {
        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            Redirect(error: "ResetPassword_Invalid");
            return;
        }

        var result = await AccountService.ResetPasswordAsync(Email, Token, Input.Password);
        if (result.Succeeded)
        {
            Redirect(info: "ResetPassword_Success");
            return;
        }

        Redirect(error: string.Join(" ", result.Errors));
    }

    // NavigateTo does not interrupt a static SSR handler (no exception since .NET 10), so the
    // caller keeps running to the end of its method — the redirect must stay its last real work.
    // A failed attempt keeps the link's email and token in the query so the user can retry;
    // success drops them — the form is gone and the token is spent.
    private void Redirect(string? error = null, string? info = null)
    {
        var query = !string.IsNullOrEmpty(error)
            ? "?email=" + Uri.EscapeDataString(Email ?? string.Empty)
                + "&token=" + Uri.EscapeDataString(Token ?? string.Empty)
                + "&error=" + Uri.EscapeDataString(error)
            : !string.IsNullOrEmpty(info) ? "?info=" + Uri.EscapeDataString(info)
            : string.Empty;
        Nav.NavigateTo("account/reset-password" + query);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Required))]
        [StringLength(100, MinimumLength = 8, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Length))]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.ConfirmPassword_Mismatch))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
