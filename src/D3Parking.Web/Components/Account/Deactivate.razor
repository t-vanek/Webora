@page "/account/deactivate"
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject IAccountService AccountService
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Deactivate_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:640px">
    <FluentLabel Typo="Typography.PageTitle">@L["Deactivate_Title"]</FluentLabel>
    <FluentLabel Typo="Typography.Body">@L["Deactivate_Intro"]</FluentLabel>

    @*  Static SSR feedback: FluentMessageBar renders nothing without an interactive
        circuit, so a failed POST comes back as a redirect query value (post-redirect-get)
        rendered through the global auth-alert styles. Success signs out and leaves.  *@
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="auth-alert auth-alert--error" role="alert">
            <FluentIcon Value="@(new Icons.Filled.Size20.ErrorCircle())" Color="Color.Custom" CustomColor="currentColor" />
            <span>@L[Error]</span>
        </div>
    }

    <EditForm Model="this" method="post" OnValidSubmit="Submit" FormName="deactivate">
        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Outline"
                      Style="background:var(--error-rest);color:var(--neutral-fill-rest)">
            @L["Deactivate_Submit"]
        </FluentButton>
    </EditForm>
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // Post-redirect-get feedback (see the markup note above the alert). The property must
    // be public — static SSR does not bind [SupplyParameterFromQuery] to private ones.
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }

    private async Task Submit()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            RedirectWithError("Common_AccountNotFound");
            return;
        }

        var result = await AccountService.DeactivateAsync(user.Id, "self-service");
        if (!result.Succeeded)
        {
            RedirectWithError(string.Join(" ", result.Errors));
            return;
        }

        await SignInManager.SignOutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }

    // NavigateTo does not interrupt a static SSR handler (no exception since .NET 10), so the
    // caller keeps running to the end of its method — the redirect must stay its last real work.
    private void RedirectWithError(string error)
        => Nav.NavigateTo("account/deactivate?error=" + Uri.EscapeDataString(error));
}
