@page "/account/profile"
@attribute [Authorize]
@using D3Parking.Application.Notifications
@using D3Parking.Contracts.Notifications
@using D3Parking.Domain.Notifications
@inject UserManager<ApplicationUser> UserManager
@inject INotificationService NotificationService
@inject ISiteSettingsService SiteSettings
@inject IUserLocationService UserLocation
@inject IFleetService Fleet
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Profile_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.PageTitle">@L["Profile_Title"]</FluentLabel>

    <AuthorizeView Context="auth">
        <Authorized>
            <FluentLabel Typo="Typography.Body">
                @L["Profile_SignedInAs"] <strong>@auth.User.Identity?.Name</strong>
            </FluentLabel>

            @*  Static SSR feedback: FluentMessageBar renders nothing without an interactive
                circuit, and state a POST handler mutates outside the submitting form never
                reaches the response. Every handler therefore finishes with a redirect
                (post-redirect-get) carrying its message in the query string, rendered here.
                Values are resource keys where the source provides them; already-localised
                identity descriptions pass through the localizer unchanged.  *@
            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="auth-alert auth-alert--error" role="alert">
                    <FluentIcon Value="@(new Icons.Filled.Size20.ErrorCircle())" Color="Color.Custom" CustomColor="currentColor" />
                    <span>@L[Error]</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Info))
            {
                <div class="auth-alert auth-alert--success" role="status">
                    <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="currentColor" />
                    <span>@L[Info]</span>
                </div>
            }

            <FluentCard Class="profile-section">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                    <FluentLabel Typo="Typography.Subject">@L["Profile_CommuteTitle"]</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Profile_CommuteHelp"]</FluentLabel>
                    @if (_home.DistanceKm is { } km)
                    {
                        <FluentLabel Typo="Typography.Body">
                            @L["Profile_CommuteDistance"]: <strong>@km.ToString("0.0") km</strong>
                            @if (!_home.Verified)
                            {
                                <FluentBadge Appearance="Appearance.Accent" Fill="warning" Style="margin-left:8px">@L["Profile_CommutePending"]</FluentBadge>
                            }
                        </FluentLabel>
                    }
                    <EditForm Model="HomeInput" method="post" OnValidSubmit="SaveHomeAsync" FormName="home-address">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Bottom" Wrap="true">
                            <FluentTextField Name="HomeInput.Address" @bind-Value="HomeInput.Address"
                                             Label="@L["Profile_HomeAddress"]" Style="width:360px" />
                            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">@L["Profile_SaveAddress"]</FluentButton>
                        </FluentStack>
                    </EditForm>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral"><small>@L["Profile_CommutePrivacy"]</small></FluentLabel>
                    @if (!string.IsNullOrWhiteSpace(_home.Address))
                    {
                        <MuteButton FormName="home-remove" Label="@L["Profile_RemoveAddress"]"
                                    Appearance="Appearance.Outline" OnSubmit="RemoveHomeAsync" />
                    }
                </FluentStack>
            </FluentCard>

            <FluentCard Class="profile-section">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                    <FluentLabel Typo="Typography.Subject">@L["Profile_TeamTitle"]</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Profile_TeamHelp"]</FluentLabel>
                    <EditForm Model="TeamInput" method="post" OnValidSubmit="SaveDepartmentAsync" FormName="department">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Bottom" Wrap="true">
                            @* Maxlength mirrors the nvarchar(128) column: without it an oversized
                               value only fails at SaveChanges — an unhandled 500 instead of a message. *@
                            <FluentTextField Name="TeamInput.Department" @bind-Value="TeamInput.Department"
                                             Label="@L["Profile_Team"]" Style="width:360px" Maxlength="128" />
                            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">@L["Profile_SaveTeam"]</FluentButton>
                        </FluentStack>
                    </EditForm>
                </FluentStack>
            </FluentCard>

            <FluentCard Class="profile-section">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                    <FluentLabel Typo="Typography.Subject">@L["Profile_VehicleTitle"]</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Profile_VehicleHelp"]</FluentLabel>
                    <EditForm Model="VehicleInput" method="post" OnValidSubmit="SavePlateAsync" FormName="vehicle">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Bottom" Wrap="true">
                            <FluentTextField Name="VehicleInput.Plate" @bind-Value="VehicleInput.Plate" Maxlength="16"
                                             Label="@L["Profile_VehiclePlate"]" Style="width:240px" />
                            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">@L["Profile_SaveVehicle"]</FluentButton>
                        </FluentStack>
                    </EditForm>

                    @* Fleet pairing. NoPlate/NoMatch render nothing — a private car has no
                       business seeing fleet mechanics. NotPairable stays deliberately vague
                       (see VehiclePairingState) and points at the administrator. *@
                    @switch (_pairing.State)
                    {
                        case VehiclePairingState.Paired:
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                                    <FluentBadge Appearance="Appearance.Accent" Fill="success">@L["Profile_Vehicle_PairedBadge"]</FluentBadge>
                                    <FluentLabel Typo="Typography.Body">@L["Profile_Vehicle_Paired", PairedVehicleLabel]</FluentLabel>
                                </FluentStack>
                                @if (_pairing.SpotCode is { } pairedSpot)
                                {
                                    <FluentLabel Typo="Typography.Body"><strong>@L["Profile_Vehicle_PairedSpot", pairedSpot]</strong></FluentLabel>
                                }
                                <FluentLabel Typo="Typography.Body" Color="Color.Neutral"><small>@L["Profile_Vehicle_PairedHint"]</small></FluentLabel>
                            </FluentStack>
                            break;

                        case VehiclePairingState.CodeRequired:
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                <FluentLabel Typo="Typography.Body">@L["Profile_Vehicle_FleetMatch", PairedVehicleLabel]</FluentLabel>
                                @if (_pairing.SpotCode is { } pairableSpot)
                                {
                                    <FluentLabel Typo="Typography.Body">@L["Profile_Vehicle_SpotInfo", pairableSpot]</FluentLabel>
                                }
                                <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Profile_Vehicle_CodeIntro"]</FluentLabel>
                                <MuteButton FormName="pairing-code" Appearance="Appearance.Accent"
                                            Label="@(_pairing.CodeSentAtUtc is null ? L["Profile_Vehicle_SendCode"] : L["Profile_Vehicle_ResendCode"])"
                                            OnSubmit="SendPairingCodeAsync" />
                                @if (_pairing.CodeSentAtUtc is not null)
                                {
                                    <EditForm Model="CodeInput" method="post" OnValidSubmit="ConfirmPairingAsync" FormName="pairing-confirm">
                                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Bottom" Wrap="true">
                                            <FluentTextField Name="CodeInput.Code" @bind-Value="CodeInput.Code" Maxlength="8"
                                                             Label="@L["Profile_Vehicle_Code"]" Style="width:160px" />
                                            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">@L["Profile_Vehicle_ConfirmCode"]</FluentButton>
                                        </FluentStack>
                                    </EditForm>
                                }
                            </FluentStack>
                            break;

                        case VehiclePairingState.NotPairable:
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Profile_Vehicle_NotPairable"]</FluentLabel>
                            break;
                    }
                </FluentStack>
            </FluentCard>

            <FluentCard Class="profile-section">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                    <FluentLabel Typo="Typography.Subject">@L["Profile_NotificationSettings"]</FluentLabel>

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Body">@L["Profile_Status"]:</FluentLabel>
                        @if (_prefs.IsCurrentlyMuted)
                        {
                            <FluentBadge Appearance="Appearance.Accent" Fill="warning">
                                @(_prefs.Muted ? L["Profile_StatusMuted"] : L["Profile_StatusMutedUntil", _prefs.MutedUntilUtc is { } until ? Fmt(until) : ""])
                            </FluentBadge>
                        }
                        else
                        {
                            <FluentBadge Appearance="Appearance.Accent" Fill="success">@L["Profile_StatusActive"]</FluentBadge>
                        }
                        <FluentLabel Typo="Typography.Body" Style="margin-left:12px">@L["Profile_Scope"]:</FluentLabel>
                        <FluentBadge Appearance="Appearance.Neutral">
                            @(_prefs.Scope == NotificationScope.SelfServiceOnly ? L["Profile_ScopeSelfService"] : L["Profile_ScopeAll"])
                        </FluentBadge>
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8">
                        <MuteButton FormName="mute-1h" Label="@L["Profile_Mute1h"]"
                                    OnSubmit="() => MuteForAsync(TimeSpan.FromHours(1))" />
                        <MuteButton FormName="mute-8h" Label="@L["Profile_Mute8h"]"
                                    OnSubmit="() => MuteForAsync(TimeSpan.FromHours(8))" />
                        <MuteButton FormName="mute-tomorrow" Label="@L["Profile_MuteTomorrow"]"
                                    OnSubmit="MuteUntilTomorrowAsync" />
                        <MuteButton FormName="mute-all" Label="@L["Profile_MuteCompletely"]"
                                    Style="background:var(--warning-rest);color:var(--neutral-foreground-rest)"
                                    OnSubmit="MuteCompletelyAsync" />
                        @if (_prefs.IsCurrentlyMuted)
                        {
                            <MuteButton FormName="unmute" Label="@L["Profile_Unmute"]"
                                        Style="background:var(--success-rest);color:var(--neutral-fill-rest)"
                                        OnSubmit="UnmuteAsync" />
                        }
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8">
                        <MuteButton FormName="scope-self" Label="@L["Profile_ScopeSetSelf"]"
                                    Appearance="Appearance.Neutral"
                                    OnSubmit="() => SetScopeAsync(NotificationScope.SelfServiceOnly)" />
                        <MuteButton FormName="scope-all" Label="@L["Profile_ScopeSetAll"]"
                                    Appearance="Appearance.Neutral"
                                    OnSubmit="() => SetScopeAsync(NotificationScope.All)" />
                    </FluentStack>

                    @* The availability tips are the one non-transactional category, so they get
                       their own switch — turning them off must not cost any real notification. *@
                    <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Body">@L["Profile_AvailabilityTips"]:</FluentLabel>
                        <FluentBadge Appearance="Appearance.Neutral">
                            @(_prefs.AllowAvailability ? L["Profile_AvailabilityOn"] : L["Profile_AvailabilityOff"])
                        </FluentBadge>
                        <MuteButton FormName="availability-toggle"
                                    Label="@(_prefs.AllowAvailability ? L["Profile_AvailabilityTurnOff"] : L["Profile_AvailabilityTurnOn"])"
                                    Appearance="Appearance.Neutral"
                                    OnSubmit="ToggleAvailabilityAsync" />
                    </FluentStack>
                </FluentStack>
            </FluentCard>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                <FluentLabel Typo="Typography.H4">@L["Profile_Notifications"]</FluentLabel>
                @if (_notifications.Any(n => !n.IsRead))
                {
                    <FluentBadge Appearance="Appearance.Accent">
                        @L["Profile_Unread", _notifications.Count(n => !n.IsRead)]
                    </FluentBadge>
                    <FluentSpacer />
                    <MuteButton FormName="mark-all-read"
                                Label="@L["Profile_MarkAllRead"]"
                                Appearance="Appearance.Neutral"
                                OnSubmit="MarkAllRead" />
                }
            </FluentStack>

            @if (_notifications.Count == 0)
            {
                <div class="empty-state">@L["Profile_NoNotifications"]</div>
            }
            else
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="max-width:680px">
                    @foreach (var n in _notifications)
                    {
                        <FluentCard Class="@($"notif-card notif-card--{LevelClass(n.Level)}")" Style="@(n.IsRead ? null : "background:var(--neutral-layer-2)")">
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                                    <strong>@n.Title</strong>
                                    @LevelBadge(n.Level)
                                    <FluentSpacer />
                                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                                        <small>@Fmt(n.CreatedAtUtc)</small>
                                    </FluentLabel>
                                </FluentStack>
                                <FluentLabel Typo="Typography.Body">@n.Message</FluentLabel>
                            </FluentStack>
                        </FluentCard>
                    }
                </FluentStack>
            }

            <details class="claims">
                <summary>@L["Profile_Claims"]</summary>
                <ul>
                    @foreach (var claim in auth.User.Claims)
                    {
                        <li><code>@claim.Type</code> = @claim.Value</li>
                    }
                </ul>
            </details>
        </Authorized>
    </AuthorizeView>
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<NotificationDto> _notifications = [];
    private NotificationPreferencesDto _prefs = new(false, null, false, NotificationScope.All, AllowAvailability: true);
    private TimeZoneInfo _tz = TimeZoneInfo.Local;

#pragma warning disable BL0008
    [SupplyParameterFromForm(FormName = "home-address")] private HomeFormModel HomeInput { get; set; } = new();
    [SupplyParameterFromForm(FormName = "department")] private TeamFormModel TeamInput { get; set; } = new();
    [SupplyParameterFromForm(FormName = "vehicle")] private VehicleFormModel VehicleInput { get; set; } = new();
    [SupplyParameterFromForm(FormName = "pairing-confirm")] private PairingCodeModel CodeInput { get; set; } = new();
#pragma warning restore BL0008
    // Post-redirect-get feedback (see the markup note above the alerts). The properties must
    // be public — static SSR does not bind [SupplyParameterFromQuery] to private ones.
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "info")] public string? Info { get; set; }

    private UserHomeDto _home = new(null, null, false);
    private PairingStatusDto _pairing = new(VehiclePairingState.NoPlate, null, null, null, null);

    private string PairedVehicleLabel => _pairing.VehicleName is { Length: > 0 } name
        ? $"{_pairing.VehiclePlate} ({name})"
        : _pairing.VehiclePlate ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _tz = await SiteSettings.GetTimeZoneAsync();
        await ReloadAsync();
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is not null)
        {
            _home = await UserLocation.GetHomeAsync(user.Id);
            HomeInput.Address ??= _home.Address;
            TeamInput.Department ??= user.Department;
            VehicleInput.Plate ??= user.LicensePlate;
            _pairing = await Fleet.GetMyPairingStatusAsync(user.Id);
        }
    }

    private async Task SaveDepartmentAsync()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is not null)
        {
            user.Department = string.IsNullOrWhiteSpace(TeamInput.Department) ? null : TeamInput.Department.Trim();
            ReportSave(await UserManager.UpdateAsync(user));
        }
    }

    // A silently discarded IdentityResult made every failed save look like a success (the page
    // just re-rendered) — finish every save with the redirect that carries the outcome instead.
    private void ReportSave(IdentityResult result)
        => Redirect(error: result.Succeeded ? null : string.Join(" ", result.Errors.Select(e => e.Description)));

    // NavigateTo does not interrupt a static SSR handler (no exception since .NET 10), so the
    // caller keeps running to the end of its method — the redirect must stay its last real work.
    private void Redirect(string? error = null, string? info = null)
    {
        var query = !string.IsNullOrEmpty(error) ? "?error=" + Uri.EscapeDataString(error)
            : !string.IsNullOrEmpty(info) ? "?info=" + Uri.EscapeDataString(info)
            : string.Empty;
        Nav.NavigateTo("account/profile" + query);
    }

    private sealed class TeamFormModel
    {
        public string? Department { get; set; }
    }

    private async Task SavePlateAsync()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is not null)
        {
            // Stored upper-cased as typed; the admin matching ignores spacing and dashes anyway.
            user.LicensePlate = string.IsNullOrWhiteSpace(VehicleInput.Plate)
                ? null
                : VehicleInput.Plate.Trim().ToUpperInvariant();
            var saved = await UserManager.UpdateAsync(user);
            if (saved.Succeeded)
            {
                // A changed plate may sever an existing fleet pairing (and the residency it
                // carried); the redirected GET then shows where the user stands.
                await Fleet.SyncUserPlateAsync(user.Id);
            }

            ReportSave(saved);
        }
    }

    private async Task SendPairingCodeAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            var result = await Fleet.RequestPairingCodeAsync(userId);
            if (result.Succeeded)
            {
                Redirect(info: "Profile_Vehicle_CodeSent");
            }
            else
            {
                Redirect(error: result.Errors.FirstOrDefault());
            }
        }
    }

    private async Task ConfirmPairingAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            var result = await Fleet.ConfirmPairingAsync(userId, CodeInput.Code ?? string.Empty);
            Redirect(error: result.Succeeded ? null : result.Errors.FirstOrDefault());
        }
    }

    private sealed class VehicleFormModel
    {
        public string? Plate { get; set; }
    }

    private sealed class PairingCodeModel
    {
        public string? Code { get; set; }
    }

    private async Task SaveHomeAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            var result = await UserLocation.SetHomeAddressAsync(userId, HomeInput.Address);
            Redirect(error: result.Succeeded ? null : result.Errors.FirstOrDefault());
        }
    }

    private async Task RemoveHomeAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await UserLocation.SetHomeAddressAsync(userId, null);
            Redirect();
        }
    }

    private sealed class HomeFormModel
    {
        public string? Address { get; set; }
    }

    private string Fmt(DateTimeOffset utc) => TimeZoneInfo.ConvertTime(utc, _tz).ToString("g");

    private async Task<Guid?> CurrentUserIdAsync()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        return user?.Id;
    }

    private async Task ReloadAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            _notifications = await NotificationService.GetAsync(userId);
            _prefs = await NotificationService.GetPreferencesAsync(userId);
        }
    }

    private async Task MarkAllRead()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await NotificationService.MarkAllReadAsync(userId);
            await ReloadAsync();
        }
    }

    private async Task ToggleAvailabilityAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await NotificationService.SetAvailabilityOptInAsync(userId, !_prefs.AllowAvailability);
            await ReloadAsync();
        }
    }

    private async Task MuteForAsync(TimeSpan duration)
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await NotificationService.MuteUntilAsync(userId, DateTimeOffset.UtcNow.Add(duration));
            await ReloadAsync();
        }
    }

    private async Task MuteUntilTomorrowAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            // Start of the next local day at the site's time zone, sent as the UTC instant it maps to.
            var tomorrow = SiteTime.Day(SiteTime.Today(DateTimeOffset.UtcNow, _tz).AddDays(1), _tz).Start;
            await NotificationService.MuteUntilAsync(userId, tomorrow);
            await ReloadAsync();
        }
    }

    private async Task MuteCompletelyAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await NotificationService.MuteAsync(userId);
            await ReloadAsync();
        }
    }

    private async Task UnmuteAsync()
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await NotificationService.UnmuteAsync(userId);
            await ReloadAsync();
        }
    }

    private async Task SetScopeAsync(NotificationScope scope)
    {
        if (await CurrentUserIdAsync() is { } userId)
        {
            await NotificationService.SetScopeAsync(userId, scope);
            await ReloadAsync();
        }
    }

    private static string LevelClass(NotificationLevel level) => level switch
    {
        NotificationLevel.Security => "security",
        NotificationLevel.Warning => "warning",
        _ => "info",
    };

    private RenderFragment LevelBadge(NotificationLevel level) => __builder =>
    {
        var (fill, key) = level switch
        {
            NotificationLevel.Security => ("danger", "Notification_Level_Security"),
            NotificationLevel.Warning => ("warning", "Notification_Level_Warning"),
            _ => ("neutral", "Notification_Level_Info"),
        };

        <FluentBadge Appearance="Appearance.Accent" Fill="@fill">@L[key]</FluentBadge>
    };
}
