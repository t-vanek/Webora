@page "/account/change-password"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject IAccountService AccountService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ChangePassword_Title"]</PageTitle>

<FluentCard Style="max-width:480px">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.H3">@L["ChangePassword_Title"]</FluentLabel>

        @*  Static SSR feedback: FluentMessageBar renders nothing without an interactive
            circuit, so every POST outcome arrives as a redirect query value
            (post-redirect-get) rendered through the global auth-alert styles. Values are
            resource keys where the source provides them; already-localised identity
            descriptions pass through the localizer unchanged.  *@
        @if (!string.IsNullOrEmpty(_info))
        {
            <div class="auth-alert auth-alert--success" role="status">
                <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="currentColor" />
                <span>@L[_info]</span>
            </div>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="change-password">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="auth-alert auth-alert--error" role="alert">
                        <FluentIcon Value="@(new Icons.Filled.Size20.ErrorCircle())" Color="Color.Custom" CustomColor="currentColor" />
                        <span>@L[_error]</span>
                    </div>
                }
                <FluentTextField Name="Input.CurrentPassword"
                                 @bind-Value="Input.CurrentPassword"
                                 Label="@L["Field_CurrentPassword"]"
                                 TextFieldType="TextFieldType.Password"
                                 AutoComplete="current-password"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.CurrentPassword" />
                <FluentTextField Name="Input.NewPassword"
                                 @bind-Value="Input.NewPassword"
                                 Label="@L["Field_NewPassword"]"
                                 TextFieldType="TextFieldType.Password"
                                 AutoComplete="new-password"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.NewPassword" />
                <FluentTextField Name="Input.ConfirmPassword"
                                 @bind-Value="Input.ConfirmPassword"
                                 Label="@L["Field_ConfirmPassword"]"
                                 TextFieldType="TextFieldType.Password"
                                 AutoComplete="new-password"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%">
                    @L["ChangePassword_Submit"]
                </FluentButton>
            </EditForm>
        }
    </FluentStack>
</FluentCard>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    // Post-redirect-get feedback (see the markup note above the alerts). The properties must
    // be public — static SSR does not bind [SupplyParameterFromQuery] to private ones.
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "info")] public string? Info { get; set; }

    private string? _error;
    private string? _info;

    // The values arrive on an open URL parameter, so they only pass through when they look
    // like what the redirects here actually emit: this page's one success key, and error
    // text capped to a plausible length.
    protected override void OnInitialized()
    {
        if (Info == "ChangePassword_Success")
        {
            _info = Info;
        }

        if (!string.IsNullOrWhiteSpace(Error))
        {
            _error = Error.Length <= 300 ? Error : Error[..300];
        }
    }

    private async Task Submit()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            Redirect(error: "Common_AccountNotFound");
            return;
        }

        var result = await AccountService.ChangePasswordAsync(user.Id, Input.CurrentPassword, Input.NewPassword);
        if (result.Succeeded)
        {
            Redirect(info: "ChangePassword_Success");
            return;
        }

        Redirect(error: string.Join(" ", result.Errors));
    }

    // NavigateTo does not interrupt a static SSR handler (no exception since .NET 10), so the
    // caller keeps running to the end of its method — the redirect must stay its last real work.
    private void Redirect(string? error = null, string? info = null)
    {
        var query = !string.IsNullOrEmpty(error) ? "?error=" + Uri.EscapeDataString(error)
            : !string.IsNullOrEmpty(info) ? "?info=" + Uri.EscapeDataString(info)
            : string.Empty;
        Nav.NavigateTo("account/change-password" + query);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Required))]
        [DataType(DataType.Password)]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Required))]
        [StringLength(100, MinimumLength = 8, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Length))]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.ConfirmPassword_Mismatch))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
