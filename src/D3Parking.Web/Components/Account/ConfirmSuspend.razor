@page "/account/confirm-suspend"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using static OpenIddict.Abstractions.OpenIddictConstants
@inject IAccountService AccountService
@inject SignInManager<ApplicationUser> SignInManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ConfirmSuspend_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:640px">
    <FluentLabel Typo="Typography.PageTitle">@L["ConfirmSuspend_Title"]</FluentLabel>

    @*  Static SSR: FluentMessageBar renders nothing without an interactive circuit, and this
        outcome is the whole page — the emailed link would land on blank space. The global
        auth-alert divs render everywhere.  *@
    @if (_succeeded is null)
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
            <FluentProgressRing />
            <FluentLabel Typo="Typography.Body">@L["Common_Verifying"]</FluentLabel>
        </FluentStack>
    }
    else if (_succeeded == true)
    {
        <div class="auth-alert auth-alert--success" role="status">
            <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="currentColor" />
            <span>@L["ConfirmSuspend_Success"] <FluentAnchor Href="account/forgot-reactivation" Appearance="Appearance.Hypertext">@L["Common_RestoreLink"]</FluentAnchor>.</span>
        </div>
    }
    else
    {
        <div class="auth-alert auth-alert--error" role="alert">
            <FluentIcon Value="@(new Icons.Filled.Size20.ErrorCircle())" Color="Color.Custom" CustomColor="currentColor" />
            <span>@_error</span>
        </div>
    }
</FluentStack>

@code {
    [SupplyParameterFromQuery] private Guid UserId { get; set; }
    [SupplyParameterFromQuery] private string? Token { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool? _succeeded;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (UserId == Guid.Empty || string.IsNullOrEmpty(Token))
        {
            _succeeded = false;
            _error = L["ConfirmSuspend_Invalid"];
            return;
        }

        var result = await AccountService.ConfirmSuspendAsync(UserId, Token);
        _succeeded = result.Succeeded;
        _error = result.Succeeded ? null : string.Join(" ", result.Errors);

        if (result.Succeeded && AuthState is not null)
        {
            // Sign out only when this browser's session belongs to the suspended account — the
            // link can be opened while somebody else is signed in (shared machine), and ending
            // their unrelated session would be pure collateral damage.
            var state = await AuthState;
            if (state.User.FindFirstValue(Claims.Subject) == UserId.ToString())
            {
                await SignInManager.SignOutAsync();
            }
        }
    }
}
