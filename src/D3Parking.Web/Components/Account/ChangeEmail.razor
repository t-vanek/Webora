@page "/account/change-email"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject IAccountService AccountService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ChangeEmail_Title"]</PageTitle>

<FluentCard Style="max-width:480px">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.H3">@L["ChangeEmail_Title"]</FluentLabel>

        @*  Static SSR feedback: FluentMessageBar renders nothing without an interactive
            circuit, so every POST outcome arrives as a redirect query value
            (post-redirect-get) rendered through the global auth-alert styles. Values are
            resource keys where the source provides them; already-localised identity
            descriptions pass through the localizer unchanged.  *@
        @if (!string.IsNullOrEmpty(Info))
        {
            <div class="auth-alert auth-alert--success" role="status">
                <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="currentColor" />
                <span>@L[Info]</span>
            </div>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="change-email">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="auth-alert auth-alert--error" role="alert">
                        <FluentIcon Value="@(new Icons.Filled.Size20.ErrorCircle())" Color="Color.Custom" CustomColor="currentColor" />
                        <span>@L[Error]</span>
                    </div>
                }
                <FluentTextField Name="Input.NewEmail"
                                 @bind-Value="Input.NewEmail"
                                 Label="@L["Field_NewEmail"]"
                                 AutoComplete="email"
                                 Placeholder="email@example.com"
                                 Style="width:100%" />
                <ValidationMessage For="() => Input.NewEmail" />
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%">
                    @L["ChangeEmail_Submit"]
                </FluentButton>
            </EditForm>
        }
    </FluentStack>
</FluentCard>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    // Post-redirect-get feedback (see the markup note above the alerts). The properties must
    // be public — static SSR does not bind [SupplyParameterFromQuery] to private ones.
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "info")] public string? Info { get; set; }

    private async Task Submit()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            Redirect(error: "Common_AccountNotFound");
            return;
        }

        var result = await AccountService.RequestEmailChangeAsync(user.Id, Input.NewEmail);
        if (result.Succeeded)
        {
            Redirect(info: "ChangeEmail_Success");
            return;
        }

        Redirect(error: string.Join(" ", result.Errors));
    }

    // NavigateTo does not interrupt a static SSR handler (no exception since .NET 10), so the
    // caller keeps running to the end of its method — the redirect must stay its last real work.
    private void Redirect(string? error = null, string? info = null)
    {
        var query = !string.IsNullOrEmpty(error) ? "?error=" + Uri.EscapeDataString(error)
            : !string.IsNullOrEmpty(info) ? "?info=" + Uri.EscapeDataString(info)
            : string.Empty;
        Nav.NavigateTo("account/change-email" + query);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Required))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Invalid))]
        public string NewEmail { get; set; } = string.Empty;
    }
}
