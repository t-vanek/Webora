@page "/account/change-phone"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject IAccountService AccountService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ChangePhone_Title"]</PageTitle>

<FluentCard Class="auth-form-card">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.H3">@L["ChangePhone_Title"]</FluentLabel>

        @*  Static SSR feedback: FluentMessageBar renders nothing without an interactive
            circuit. The two-step flow round-trips the pending phone number through the
            form post (never the URL), so in-flow feedback renders in the same request as
            plain auth-alert divs; only the terminal outcome redirects (post-redirect-get). *@
        @if (!string.IsNullOrEmpty(_info))
        {
            <div class="auth-alert auth-alert--success" role="status">
                <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="currentColor" />
                <span>@L[_info]</span>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="auth-alert auth-alert--error" role="alert">
                    <FluentIcon Value="@(new Icons.Filled.Size20.ErrorCircle())" Color="Color.Custom" CustomColor="currentColor" />
                    <span>@_error</span>
                </div>
            }

            <EditForm Model="RequestInput" method="post" OnValidSubmit="RequestCode" FormName="phone-request">
                <DataAnnotationsValidator />
                <FluentTextField Name="RequestInput.NewPhoneNumber"
                                 @bind-Value="RequestInput.NewPhoneNumber"
                                 Label="@L["Field_NewPhone"]"
                                 AutoComplete="tel"
                                 Placeholder="+420…"
                                 Style="width:100%" />
                <ValidationMessage For="() => RequestInput.NewPhoneNumber" />
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Outline" Style="margin-top:12px">
                    @L["ChangePhone_RequestSubmit"]
                </FluentButton>
            </EditForm>

            @if (_codeSent || !string.IsNullOrEmpty(ConfirmInput.NewPhoneNumber))
            {
                <FluentDivider />
                <div class="auth-alert auth-alert--success" role="status">
                    <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="currentColor" />
                    <span>@L["ChangePhone_CodeSent"]</span>
                </div>
                <EditForm Model="ConfirmInput" method="post" OnValidSubmit="ConfirmCode" FormName="phone-confirm">
                    <DataAnnotationsValidator />
                    @*  Hidden plumbing: the second EditForm needs to know which phone the
                        confirmation code applies to. The hidden input survives the round-trip
                        because static-SSR form binding only cares about the name attribute.  *@
                    <input type="hidden" name="ConfirmInput.NewPhoneNumber" value="@ConfirmInput.NewPhoneNumber" />
                    <FluentTextField Name="ConfirmInput.Code"
                                     @bind-Value="ConfirmInput.Code"
                                     Label="@L["Field_Code"]"
                                     Placeholder="kód"
                                     Style="width:100%" />
                    <ValidationMessage For="() => ConfirmInput.Code" />
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%; margin-top:12px">
                        @L["ChangePhone_ConfirmSubmit"]
                    </FluentButton>
                </EditForm>
            }
        }
    </FluentStack>
</FluentCard>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

#pragma warning disable BL0008
    [SupplyParameterFromForm(FormName = "phone-request")]
    private RequestModel RequestInput { get; set; } = new();

    [SupplyParameterFromForm(FormName = "phone-confirm")]
    private ConfirmModel ConfirmInput { get; set; } = new();
#pragma warning restore BL0008

    private bool _codeSent;
    private string? _error;

    // Post-redirect-get feedback for the terminal outcome only (see the markup note above
    // the alerts). The property must be public — static SSR does not bind
    // [SupplyParameterFromQuery] to private ones.
    [SupplyParameterFromQuery(Name = "info")] public string? Info { get; set; }

    private string? _info;

    // The value arrives on an open URL parameter, so it only passes through as the one
    // success key the confirm redirect actually emits.
    protected override void OnInitialized()
    {
        if (Info == "ChangePhone_Success")
        {
            _info = Info;
        }
    }

    private async Task<ApplicationUser?> CurrentUserAsync()
    {
        var state = await AuthState!;
        return await UserManager.GetUserAsync(state.User);
    }

    private async Task RequestCode()
    {
        var user = await CurrentUserAsync();
        if (user is null)
        {
            _error = L["Common_AccountNotFound"];
            return;
        }

        var result = await AccountService.RequestPhoneChangeAsync(user.Id, RequestInput.NewPhoneNumber);
        if (result.Succeeded)
        {
            ConfirmInput.NewPhoneNumber = RequestInput.NewPhoneNumber;
            _codeSent = true;
            return;
        }

        _error = string.Join(" ", result.Errors);
    }

    private async Task ConfirmCode()
    {
        var user = await CurrentUserAsync();
        if (user is null)
        {
            _error = L["Common_AccountNotFound"];
            return;
        }

        var result = await AccountService.ConfirmPhoneChangeAsync(user.Id, ConfirmInput.NewPhoneNumber, ConfirmInput.Code);
        if (result.Succeeded)
        {
            // NavigateTo does not interrupt a static SSR handler (no exception since
            // .NET 10) — the redirect must stay the handler's last real work.
            Nav.NavigateTo("account/change-phone?info=" + Uri.EscapeDataString("ChangePhone_Success"));
            return;
        }

        _error = string.Join(" ", result.Errors);
    }

    private sealed class RequestModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Phone_Required))]
        [Phone(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Phone_Invalid))]
        public string NewPhoneNumber { get; set; } = string.Empty;
    }

    private sealed class ConfirmModel
    {
        public string NewPhoneNumber { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Code_Required))]
        public string Code { get; set; } = string.Empty;
    }
}
