@page "/account/suspend"
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject IAccountService AccountService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Suspend_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:640px">
    <FluentLabel Typo="Typography.PageTitle">@L["Suspend_Title"]</FluentLabel>
    <FluentLabel Typo="Typography.Body">@L["Suspend_Intro"]</FluentLabel>

    @if (_submitted)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="false">
            @L["Suspend_Success"]
        </FluentMessageBar>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="false">
                @_error
            </FluentMessageBar>
        }
        <EditForm Model="this" method="post" OnValidSubmit="Submit" FormName="suspend">
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Outline"
                          Style="background:var(--warning-rest);color:var(--neutral-foreground-rest)">
                @L["Suspend_Submit"]
            </FluentButton>
        </EditForm>
    }
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _submitted;
    private string? _error;

    private async Task Submit()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            _error = L["Common_AccountNotFound"];
            return;
        }

        var result = await AccountService.RequestSuspendAsync(user.Id);
        if (result.Succeeded)
        {
            _submitted = true;
            return;
        }

        _error = string.Join(" ", result.Errors);
    }
}
