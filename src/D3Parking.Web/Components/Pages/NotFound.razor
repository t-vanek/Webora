@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NotFound_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:640px">
    <FluentLabel Typo="Typography.PageTitle">@L["NotFound_Title"]</FluentLabel>
    <FluentLabel Typo="Typography.Body">@L["NotFound_Message"]</FluentLabel>
    <FluentAnchor Href="" Appearance="Appearance.Hypertext">@L["NotFound_Home"]</FluentAnchor>
</FluentStack>
