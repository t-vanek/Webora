@page "/"
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResource> L
@inject IReservationService Reservations
@inject IIncentiveService Incentives
@inject IResidentSpotService ResidentSpots
@inject IOversightService Oversight
@inject IParkingSettingsService ParkingSettings
@inject ISiteSettingsService SiteSettings
@inject UserManager<ApplicationUser> UserManager

@* Signed in, the home page is a "today" dashboard, not just a launcher: the states that need
   attention — today's reservation, a time-boxed queue offer, a resident's held spot — surface
   here with their primary action attached, because forcing a hop to /parking wastes exactly the
   minutes the queue offer is counting down. Cards render only when they have something to say.

   Signed out, it is a landing page instead: with the sidebar gone for anonymous visitors the
   full width belongs to a hero with both CTAs, the three product pillars and a short "how it
   works" — everything a colleague deciding whether to register needs, no dashboard chrome. *@

<PageTitle>@L["Home_Title"]</PageTitle>

@if (!_signedIn)
{
    <div class="landing">
        <section class="landing-hero">
            <div class="landing-hero__content">
                <span class="landing-hero__eyebrow">@L["Home_Title"]</span>
                <h1 class="landing-hero__title">@L["Landing_Headline"]</h1>
                <p class="landing-hero__lead">@L["Landing_Lead"]</p>
                <div class="landing-hero__actions">
                    <a href="login" class="landing-btn landing-btn--primary">
                        <FluentIcon Value="@(new Icons.Regular.Size20.PersonAccounts())" Color="Color.Custom" CustomColor="currentColor" />
                        @L["Landing_CtaLogin"]
                    </a>
                    <a href="register" class="landing-btn landing-btn--ghost">
                        <FluentIcon Value="@(new Icons.Regular.Size20.PersonAdd())" Color="Color.Custom" CustomColor="currentColor" />
                        @L["Landing_CtaRegister"]
                    </a>
                </div>
            </div>
        </section>

        <section class="landing-features" aria-label="@L["Landing_FeaturesTitle"]">
            <div class="landing-feature">
                <span class="landing-feature__ic landing-feature__ic--reserve">
                    <FluentIcon Value="@(new Icons.Regular.Size24.VehicleCar())" Color="Color.Custom" CustomColor="currentColor" />
                </span>
                <h2 class="landing-feature__title">@L["Landing_Feature1_Title"]</h2>
                <p class="landing-feature__desc">@L["Landing_Feature1_Desc"]</p>
            </div>
            <div class="landing-feature">
                <span class="landing-feature__ic landing-feature__ic--credits">
                    <FluentIcon Value="@(new Icons.Regular.Size24.Money())" Color="Color.Custom" CustomColor="currentColor" />
                </span>
                <h2 class="landing-feature__title">@L["Landing_Feature2_Title"]</h2>
                <p class="landing-feature__desc">@L["Landing_Feature2_Desc"]</p>
            </div>
            <div class="landing-feature">
                <span class="landing-feature__ic landing-feature__ic--board">
                    <FluentIcon Value="@(new Icons.Regular.Size24.Trophy())" Color="Color.Custom" CustomColor="currentColor" />
                </span>
                <h2 class="landing-feature__title">@L["Landing_Feature3_Title"]</h2>
                <p class="landing-feature__desc">@L["Landing_Feature3_Desc"]</p>
            </div>
        </section>

        <section class="landing-steps">
            <h2 class="landing-steps__title">@L["Landing_HowTitle"]</h2>
            <ol class="landing-steps__list">
                <li class="landing-step">
                    <span class="landing-step__num" aria-hidden="true">1</span>
                    <h3 class="landing-step__title">@L["Landing_Step1_Title"]</h3>
                    <p class="landing-step__desc">@L["Landing_Step1_Desc"]</p>
                </li>
                <li class="landing-step">
                    <span class="landing-step__num" aria-hidden="true">2</span>
                    <h3 class="landing-step__title">@L["Landing_Step2_Title"]</h3>
                    <p class="landing-step__desc">@L["Landing_Step2_Desc"]</p>
                </li>
                <li class="landing-step">
                    <span class="landing-step__num" aria-hidden="true">3</span>
                    <h3 class="landing-step__title">@L["Landing_Step3_Title"]</h3>
                    <p class="landing-step__desc">@L["Landing_Step3_Desc"]</p>
                </li>
            </ol>
        </section>

        <section class="landing-cta">
            <h2 class="landing-cta__title">@L["Landing_FinalTitle"]</h2>
            <a href="register" class="landing-btn landing-btn--primary">@L["Landing_CtaRegister"]</a>
        </section>
    </div>
    return;
}

<div class="home">
    <section class="home-hero home-hero--slim">
        <div class="home-hero__content">
            <h1 class="home-hero__title">@L["Home_Title"]</h1>
            <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.Reserve)">
                <Authorized>
                    <a href="parking" class="home-hero__cta">
                        <FluentIcon Value="@(new Icons.Regular.Size20.VehicleCar())" Color="Color.Custom" CustomColor="currentColor" />
                        @L["Nav_ParkingReserve"]
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </section>

    @if (_showOrientationMap)
    {
        <div class="parking-map-modal" role="dialog" aria-modal="true" aria-labelledby="home-parking-map-title">
            <div class="parking-map-modal__surface">
                <div class="parking-map-modal__head">
                    <div>
                        <span class="parking-map-modal__eyebrow">@L["Parking_Map_OrientationEyebrow"]</span>
                        <h2 id="home-parking-map-title">@L["Parking_Map_OrientationTitle"]</h2>
                        <p>@L["Home_Map_ModalHelp"]</p>
                    </div>
                    <FluentButton Appearance="Appearance.Stealth" OnClick="CloseOrientationMapAsync"
                                  aria-label="@L["Parking_Map_Close"]">
                        @L["Parking_Map_Close"]
                    </FluentButton>
                </div>
                <div class="parking-map-modal__tools">
                    <FluentAnchor Href="@OrientationMapUrl" Target="_blank" Appearance="Appearance.Hypertext">
                        @L["Parking_Map_Open"]
                    </FluentAnchor>
                </div>
                <div class="parking-map-modal__viewport">
                    <img src="@OrientationMapUrl" alt="@L["Parking_Map_ImageAlt"]" />
                </div>
            </div>
        </div>
    }

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">
            @L[_error]
        </FluentMessageBar>
    }

    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.View)" Context="mapAccess">
        @if (_hasOrientationMap)
        {
            <section class="home-map-panel" aria-labelledby="home-map-title">
                <span class="home-map-panel__icon">
                    <FluentIcon Value="@(new Icons.Regular.Size24.Map())" Color="Color.Custom" CustomColor="currentColor" />
                </span>
                <div class="home-map-panel__text">
                    <h2 id="home-map-title">@L["Home_Map_Title"]</h2>
                    <p>@L["Home_Map_Desc"]</p>
                </div>
                <div class="home-map-panel__actions">
                    <FluentButton Appearance="Appearance.Accent" OnClick="OpenOrientationMapAsync">
                        @L["Parking_Map_Show"]
                    </FluentButton>
                    <FluentAnchor Href="@OrientationMapUrl" Target="_blank" Appearance="Appearance.Hypertext">
                        @L["Parking_Map_Open"]
                    </FluentAnchor>
                </div>
            </section>
        }
    </AuthorizeView>

    @* Parking.View is the "takes part in the lot" baseline. An account without it — an auditor, a
       user manager brought in from outside — gets the administration it was given and no standing
       of its own to show. *@
    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.View)" Context="lot">
    @if (_reservation is not null || _queueEntry is not null || _ownedSpot is not null || _score is not null)
    {
        <h2 class="home-section">@L["Home_Today"]</h2>
        <div class="today-grid">
            @if (_reservation is { } r)
            {
                <div class="today-card today-card--reserve">
                    <span class="today-card__label">@L["Home_NextReservation"]</span>
                    <span class="today-card__value">@r.SpotCode · @Local(r.StartUtc, "g") – @Local(r.EndUtc, "t")</span>
                    <span class="today-card__meta">@L[$"Parking_State_{r.Status}"]</span>
                    <span class="today-card__actions">
                        @if (r.Status == ReservationStatus.Reserved)
                        {
                            <FluentButton Disabled="@_actionBusy" Appearance="Appearance.Stealth" OnClick="() => RunAsync(() => Reservations.ReleaseAsync(_userId, r.Id))">@L["Parking_Release"]</FluentButton>
                        }
                    </span>
                </div>
            }

            @if (_queueEntry is { } q)
            {
                <div class="today-card today-card--queue">
                    <span class="today-card__label">@L[q.Status == QueueEntryStatus.Offered ? "Home_QueueOffer" : "Parking_Queue_MyQueue"]</span>
                    @if (q.Status == QueueEntryStatus.Offered)
                    {
                        <span class="today-card__value">@L["Parking_Queue_OfferedSpot"]: @q.OfferedSpotCode</span>
                        <span class="today-card__meta">
                            @if (q.OfferExpiresAtUtc is { } exp)
                            {
                                @L["Home_OfferExpiresAt", Local(exp, "t")]
                            }
                        </span>
                        <span class="today-card__actions">
                            <FluentButton Disabled="@_actionBusy" Appearance="Appearance.Accent" OnClick="() => RunAsync(() => Reservations.ClaimQueueOfferAsync(_userId, q.Id))">@L["Parking_Queue_Claim"]</FluentButton>
                            <FluentButton Disabled="@_actionBusy" Appearance="Appearance.Stealth" OnClick="() => RunAsync(() => Reservations.LeaveQueueAsync(_userId, q.Id))">@L["Parking_Queue_Leave"]</FluentButton>
                        </span>
                    }
                    else
                    {
                        <span class="today-card__value">@Local(q.StartUtc, "g") – @Local(q.EndUtc, "t")</span>
                        <span class="today-card__meta">@L["Parking_Queue_Position"]: @q.Position</span>
                        <span class="today-card__actions">
                            <FluentButton Disabled="@_actionBusy" Appearance="Appearance.Stealth" OnClick="() => RunAsync(() => Reservations.LeaveQueueAsync(_userId, q.Id))">@L["Parking_Queue_Leave"]</FluentButton>
                        </span>
                    }
                </div>
            }

            @if (_ownedSpot is { } s)
            {
                <div class="today-card today-card--resident">
                    <span class="today-card__label">@L["Parking_Owned_Title"]</span>
                    <span class="today-card__value">@s.Code</span>
                    <span class="today-card__meta">@L[$"Parking_OwnedState_{s.TodayState}"]</span>
                    @if (s.TodayState == OwnedSpotDayState.Held)
                    {
                        <span class="today-card__actions">
                            <FluentButton Disabled="@_actionBusy" Appearance="Appearance.Stealth" OnClick="ReleaseOwnedTodayAsync">@L["Parking_Owned_Release"]</FluentButton>
                        </span>
                    }
                    else if (s.TodayState is OwnedSpotDayState.SharedFree or OwnedSpotDayState.SharedTaken)
                    {
                        <span class="today-card__actions">
                            <FluentButton Disabled="@_actionBusy" Appearance="Appearance.Accent" OnClick="ReclaimOwnedTodayAsync">@L["Parking_Owned_Reclaim"]</FluentButton>
                        </span>
                    }
                </div>
            }

            @if (_score is { } sc)
            {
                <a href="parking/leaderboard" class="today-card today-card--wallet">
                    <span class="today-card__label">@(_creditsEnabled ? L["Home_Wallet"] : L["Parking_MyScore"])</span>
                    <span class="today-card__value">
                        @if (_creditsEnabled)
                        {
                            @sc.Credits @L["Parking_Credits"] <text> · </text>
                        }
                        @sc.Points @L["Parking_Points"]
                    </span>
                    <span class="today-card__meta">@L["Home_WalletDetail", L[$"Parking_Tier_{sc.Tier}"].Value, sc.CompletionStreak]</span>
                </a>
            }
        </div>
    }
    </AuthorizeView>

    <AuthorizeView Context="auth">
        <Authorized>
            <h2 class="home-section">@L["Home_QuickActions"]</h2>
            <div class="home-grid">
                <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.Reserve)">
            <a href="parking" class="home-tile">
                <span class="home-tile__ic home-tile__ic--reserve"><FluentIcon Value="@(new Icons.Regular.Size24.VehicleCar())" Color="Color.Custom" CustomColor="currentColor" /></span>
                <span class="home-tile__title">@L["Nav_ParkingReserve"]</span>
                <span class="home-tile__desc">@L["Home_Card_Reserve"]</span>
            </a>
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.ViewLeaderboard)">
            <a href="parking/leaderboard" class="home-tile">
                <span class="home-tile__ic home-tile__ic--board"><FluentIcon Value="@(new Icons.Regular.Size24.Trophy())" Color="Color.Custom" CustomColor="currentColor" /></span>
                <span class="home-tile__title">@L["Nav_ParkingLeaderboard"]</span>
                <span class="home-tile__desc">@L["Home_Card_Leaderboard"]</span>
            </a>
        </AuthorizeView>

        <a href="help" class="home-tile">
            <span class="home-tile__ic home-tile__ic--board"><FluentIcon Value="@(new Icons.Regular.Size24.QuestionCircle())" Color="Color.Custom" CustomColor="currentColor" /></span>
            <span class="home-tile__title">@L["Nav_Help"]</span>
            <span class="home-tile__desc">@L["Home_Card_Help"]</span>
        </a>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.ManageSpots)">
            <a href="admin/parking/spots" class="home-tile">
                <span class="home-tile__ic home-tile__ic--spots"><FluentIcon Value="@(new Icons.Regular.Size24.Map())" Color="Color.Custom" CustomColor="currentColor" /></span>
                <span class="home-tile__title">@L["Nav_AdminParking"]</span>
                <span class="home-tile__desc">@L["Home_Card_Spots"]</span>
            </a>
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.ViewAnalytics)">
            <a href="admin/parking/dashboard" class="home-tile">
                <span class="home-tile__ic home-tile__ic--analytics"><FluentIcon Value="@(new Icons.Regular.Size24.DataTrending())" Color="Color.Custom" CustomColor="currentColor" /></span>
                <span class="home-tile__title">@L["Nav_AdminLot"]</span>
                <span class="home-tile__desc">@L["Home_Card_Analytics"]</span>
            </a>
        </AuthorizeView>

        @* The one tile that carries a number: the desk is the only admin screen with a queue
           behind it, and how long that queue is decides whether it needs opening today. *@
        @if (_openCases > 0)
        {
            <a href="admin/parking/oversight" class="home-tile">
                <span class="home-tile__ic home-tile__ic--spots"><FluentIcon Value="@(new Icons.Regular.Size24.ClipboardTask())" Color="Color.Custom" CustomColor="currentColor" /></span>
                <span class="home-tile__title">
                    @L["Nav_AdminOversight"]
                    <span class="count-chip">@_openCases</span>
                </span>
                <span class="home-tile__desc">@L["Home_Card_Oversight", _openCases]</span>
            </a>
        }

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.ManageIncentives)">
            <a href="admin/parking/settings" class="home-tile">
                <span class="home-tile__ic home-tile__ic--rules"><FluentIcon Value="@(new Icons.Regular.Size24.Options())" Color="Color.Custom" CustomColor="currentColor" /></span>
                <span class="home-tile__title">@L["Nav_AdminParkingSettings"]</span>
                <span class="home-tile__desc">@L["Home_Card_Rules"]</span>
            </a>
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Users.View)">
            <a href="admin/users" class="home-tile">
                <span class="home-tile__ic home-tile__ic--users"><FluentIcon Value="@(new Icons.Regular.Size24.People())" Color="Color.Custom" CustomColor="currentColor" /></span>
                <span class="home-tile__title">@L["Nav_AdminUsers"]</span>
                <span class="home-tile__desc">@L["Home_Card_Users"]</span>
            </a>
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.View)">
            <a href="admin/roles" class="home-tile">
                <span class="home-tile__ic home-tile__ic--roles"><FluentIcon Value="@(new Icons.Regular.Size24.ShieldKeyhole())" Color="Color.Custom" CustomColor="currentColor" /></span>
                <span class="home-tile__title">@L["Nav_AdminRoles"]</span>
                <span class="home-tile__desc">@L["Home_Card_Roles"]</span>
            </a>
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Audit.View)">
            <a href="admin/audit" class="home-tile">
                <span class="home-tile__ic home-tile__ic--audit"><FluentIcon Value="@(new Icons.Regular.Size24.History())" Color="Color.Custom" CustomColor="currentColor" /></span>
                <span class="home-tile__title">@L["Nav_AdminAudit"]</span>
                <span class="home-tile__desc">@L["Home_Card_Audit"]</span>
            </a>
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Settings.View)">
            <a href="admin/settings" class="home-tile">
                <span class="home-tile__ic home-tile__ic--settings"><FluentIcon Value="@(new Icons.Regular.Size24.Settings())" Color="Color.Custom" CustomColor="currentColor" /></span>
                <span class="home-tile__title">@L["Nav_AdminSettings"]</span>
                <span class="home-tile__desc">@L["Home_Card_Settings"]</span>
            </a>
                </AuthorizeView>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Guid _userId;
    private bool _signedIn;
    private string? _error;
    private TimeZoneInfo _tz = TimeZoneInfo.Utc;
    private bool _hasOrientationMap;
    private bool _showOrientationMap;

    private int _openCases;
    private ReservationDto? _reservation;
    private QueueEntryDto? _queueEntry;
    private OwnedSpotDto? _ownedSpot;
    private ParkerScoreDto? _score;
    private bool _creditsEnabled;
    private string OrientationMapUrl => "/api/parking/orientation-map";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
        {
            return;
        }

        var user = (await AuthState).User;
        _signedIn = user.Identity?.IsAuthenticated == true;

        // Claims only — no UserManager DB round-trip. This runs in the layout's render path, and
        // the dashboard queries below each use their own pooled context (see WalletChip).
        // Before the parker guard below: a reviewer who never books anything still has a desk.
        if (_signedIn)
        {
            if (user.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Parking.View))
            {
                _hasOrientationMap = await ParkingSettings.GetOrientationMapAsync() is not null;
            }

            var scope = OversightScope.From(
                user.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Parking.ReviewMismatches),
                user.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Parking.ReviewCollusion),
                user.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Parking.ManageSpots));
            _openCases = scope.IsEmpty ? 0 : await Oversight.GetOpenCountAsync(scope);
        }

        if (!_signedIn
            || !user.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Parking.Reserve)
            || !Guid.TryParse(UserManager.GetUserId(user), out _userId))
        {
            return;
        }

        var timeZone = SiteSettings.GetTimeZoneAsync();
        var policy = ParkingSettings.GetPolicyAsync();
        await Task.WhenAll(timeZone, policy);
        _tz = timeZone.Result;
        _creditsEnabled = policy.Result.CreditsEnabled;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // The soonest actionable booking: the service lists newest-first, so re-sort ascending.
        var upcoming = await Reservations.GetMyReservationsAsync(_userId, upcomingOnly: true);
        _reservation = upcoming.OrderBy(r => r.StartUtc).FirstOrDefault();

        // A live offer beats a waiting entry — it is the time-boxed one.
        var queue = await Reservations.GetMyQueueAsync(_userId);
        _queueEntry = queue.FirstOrDefault(q => q.Status == QueueEntryStatus.Offered)
            ?? queue.FirstOrDefault(q => q.Status == QueueEntryStatus.Waiting);

        _ownedSpot = await ResidentSpots.GetMyOwnedSpotAsync(_userId);
        _score = await Incentives.GetScoreAsync(_userId);
    }

    // Single-flight: every dashboard action funnels through here, so the guard covers a
    // double-click on any of them — the second click must not run against already-changed state.
    private bool _actionBusy;

    private async Task RunAsync(Func<Task<ParkingResult>> action)
    {
        if (_actionBusy)
        {
            return;
        }

        _actionBusy = true;
        try
        {
            _error = null;
            var result = await action();
            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault();
            }

            await LoadAsync();
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private Task ReclaimOwnedTodayAsync()
    {
        var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, _tz).DateTime);
        return RunAsync(() => ResidentSpots.ReclaimAsync(_userId, today, today));
    }

    private Task ReleaseOwnedTodayAsync()
    {
        var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, _tz).DateTime);
        return RunAsync(() => ResidentSpots.ReleaseAsync(_userId, today, today));
    }

    private Task OpenOrientationMapAsync()
    {
        _showOrientationMap = true;
        return Task.CompletedTask;
    }

    private Task CloseOrientationMapAsync()
    {
        _showOrientationMap = false;
        return Task.CompletedTask;
    }

    private string Local(DateTimeOffset utc, string format) =>
        TimeZoneInfo.ConvertTime(utc, _tz).ToString(format);
}
