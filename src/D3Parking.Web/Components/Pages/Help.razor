@page "/help"
@using System.Globalization
@* Parking users only: the page renders the live pricing, reward and anti-abuse configuration —
   the navigation offers it inside the permissioned parking section, and the admin chapters
   below are additionally gated per permission. *@
@attribute [HasPermission(Permissions.Parking.View)]
@using D3Parking.Domain.Parking.Incentives
@using D3Parking.Web.Authorization
@inject IParkingSettingsService ParkingSettings
@inject IResidentSpotService ResidentSpots
@inject IParkingSpotService Spots
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Help_Title"]</PageTitle>

@* Uživatelská nápověda. Statické SSR — je to čtený text, žádná interaktivita není potřeba
   (rozbalování řeší nativní <details>), takže stránka nezabírá circuit a funguje i bez JS.

   Obsah se řídí ŽIVOU konfigurací: čísla (ceny, body, lhůty, prahy úrovní) se berou z aktuální
   policy a sekce vypnutých funkcí se vůbec nevykreslí. Nápověda, která slibuje odměny, jež má
   admin vypnuté, je horší než žádná. Sekce pro správce navíc respektují oprávnění. *@
<FluentStack Class="page-shell page-shell--readable" Orientation="Orientation.Vertical" VerticalGap="16">
    <div class="admin-head__titles">
        <FluentLabel Typo="Typography.PageTitle">@L["Help_Title"]</FluentLabel>
        <p class="admin-head__intro">@L["Help_Intro"]</p>
    </div>

    @if (_policy is { } policy)
    {
        <details class="help-item" open>
            <summary class="help-item__q">@L["Help_Reserve_Q"]</summary>
            <div class="help-item__a">
                <p>@L[_charged ? "Help_Reserve_A1_Paid" : "Help_Reserve_A1_Free"]</p>
                <p>@(policy.WeeklyReservationLimitEnabled
                        ? L["Help_Reserve_PlannerRules_NoLastMinute", policy.ReservationHorizonDays, policy.WeeklyReservationLimit]
                    : L["Help_Reserve_PlannerRules_NoLimit", policy.ReservationHorizonDays])</p>
                <p>@L["Parking_Planner_AllowedWeekdays", FormatAllowedWeekdays(policy.AllowedReservationWeekdays)]</p>
                @if (policy.HolidayCalendarRegion != HolidayCalendarRegion.None)
                {
                    <p>@L[policy.PublicHolidayReservationsAllowed
                        ? "Parking_Planner_PublicHolidaysAllowed"
                        : "Parking_Planner_PublicHolidaysBlocked"]</p>
                }
                <p>@L["Help_Reserve_A2_Free"]</p>
                <figure class="help-demo">
                    <picture>
                        <source media="(prefers-reduced-motion: reduce)" srcset="/images/help/reservation.png" />
                        <img class="help-demo__image"
                             src="/images/help/reservation.gif"
                             width="960"
                             height="540"
                             loading="lazy"
                             decoding="async"
                             alt="@L["Help_Animation_Reserve_Alt"]" />
                    </picture>
                    <figcaption>@L["Help_Animation_Reserve_Caption"]</figcaption>
                </figure>
            </div>
        </details>

        @if (_charged)
        {
            <details class="help-item">
                <summary class="help-item__q">@L["Help_Credits_Q"]</summary>
                <div class="help-item__a">
                    <p>@L["Help_Credits_A1", Credits(policy.BaseReservationCost), BudgetPeriod(policy.BudgetRenewalPeriod)]</p>
                    <ul>
                        <li>@L["Help_Credits_Fixed"]</li>
                        @if (policy.MonthlyCreditAllowance > 0 || policy.TierAllowanceBonus > 0)
                        {
                            <li>
                                @(policy.TierAllowanceBonus > 0
                                    ? L["Help_Credits_Li1_Tiered", Credits(policy.MonthlyCreditAllowance), Credits(policy.TierAllowanceBonus), BudgetPeriod(policy.BudgetRenewalPeriod)]
                                    : L["Help_Credits_Li1", Credits(policy.MonthlyCreditAllowance), BudgetPeriod(policy.BudgetRenewalPeriod)])
                            </li>
                        }
                        <li>@L["Help_Credits_Li2"]</li>
                        <li>@L["Help_Credits_Li3"]</li>
                    </ul>
                </div>
            </details>
        }

        @if (_pointsOn)
        {
            <details class="help-item">
                <summary class="help-item__q">@L["Help_Points_Q"]</summary>
                <div class="help-item__a">
                    @if (_pointRewardsOn)
                    {
                        <p>@L["Help_Points_A1"]</p>
                        <ul>
                            @if (policy.ReleasePoints > 0 && policy.MaxRewardedReleasesPerDay > 0)
                            {
                                <li>@L["Help_Points_Li3", Points(policy.ReleasePoints), Points(Math.Max(policy.ReleasePoints, policy.MaxReleaseReward)), policy.MaxRewardedReleasesPerDay]</li>
                            }
                            @if (policy.ResidentReleasePointsPerHour > 0 && policy.ResidentReleaseMaxPoints > 0)
                            {
                                <li>@L["Help_Points_Li4", Points(policy.ResidentReleasePointsPerHour), Points(policy.ResidentReleaseMaxPoints)]</li>
                            }
                            @if (policy.SharedTakenBasePoints > 0)
                            {
                                <li>@L["Help_Points_Li5", Points(policy.SharedTakenBasePoints * policy.SharedTakenMaxMultiplier)]</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>@L["Help_Points_A1_NoRewards"]</p>
                    }
                    @if (_tiersOn)
                    {
                        <p>@L["Help_Points_A2", Points(policy.TierSilverPoints), Points(policy.TierGoldPoints), Points(policy.TierPlatinumPoints)]</p>
                        <ul>
                            @if (policy.QueuePriorityPerTier > 0)
                            {
                                <li>@L["Help_Points_Perk_Queue"]</li>
                            }
                            @if (_charged && policy.TierAllowanceBonus > 0)
                            {
                                <li>@L["Help_Points_Perk_Allowance", Credits(policy.TierAllowanceBonus)]</li>
                            }
                            @if (_charged && policy.TierDiscountPercent > 0)
                            {
                                <li>@L["Help_Points_Perk_Discount", policy.TierDiscountPercent]</li>
                            }
                        </ul>
                    }
                    @if (policy.ReputationDecayPercent > 0)
                    {
                        <p>@L["Help_Points_Decay", policy.ReputationDecayPercent, Days(policy.ReputationDecayIntervalDays)]</p>
                    }
                </div>
            </details>
        }

        <details class="help-item">
            <summary class="help-item__q">@L["Help_NoShow_Q"]</summary>
            <div class="help-item__a">
                <p>@(policy.ReminderLeadTime > TimeSpan.Zero
                    ? L["Help_NoShow_A1_Reminder", Fmt(policy.ReminderLeadTime)]
                    : L["Help_NoShow_A1_NoReminder"])</p>
                <p>@L[_charged ? "Help_NoShow_A2_Paid" : "Help_NoShow_A2_Free"]</p>
            </div>
        </details>

        <details class="help-item">
            <summary class="help-item__q">@L["Help_Queue_Q"]</summary>
            <div class="help-item__a">
                <p>@L["Help_Queue_A1", Fmt(TimeSpan.FromMinutes(policy.QueueOfferMinutes))]</p>
                <p>@(policy.QueuePriorityPerTier > 0 ? L["Help_Queue_A2_Tiered"] : L["Help_Queue_A2"])</p>
            </div>
        </details>

        <details class="help-item">
            <summary class="help-item__q">@L["Help_Blocked_Q"]</summary>
            <div class="help-item__a">
                <p>@L["Help_Blocked_A1"]</p>
                <p>@L["Help_Blocked_A2"]</p>
            </div>
        </details>

        @* Kam se řidič podívá, co se s hlášením děje — a kde nahlásí závadu. Obojí je tatáž stránka. *@
        <details class="help-item">
            <summary class="help-item__q">@L[_userReportsOn ? "Help_MyReports_Q" : "Help_MyReports_Q_Tracking"]</summary>
            <div class="help-item__a">
                <p>@L["Help_MyReports_A1"]</p>
                <p>@L["Help_MyReports_A2"]</p>
                @if (_userReportsOn)
                {
                    <p>@L["Help_MyReports_A3"]</p>
                }
            </div>
        </details>

        @* Rezidentní pravidla vidí jen ten, koho se týkají: aktuální vlastník místa. *@
        @if (_ownsSpot)
        {
            <details class="help-item">
                <summary class="help-item__q">@L["Help_Resident_Q"]</summary>
                <div class="help-item__a">
                    <p>@L["Help_Resident_A0"]</p>
                    <p>@L["Help_Resident_A1"]</p>
                    <p>
                        @(policy.ResidentReleasePointsPerHour > 0 && policy.ResidentReleaseMaxPoints > 0
                            ? L["Help_Resident_A2_Rewarded", Points(policy.ResidentReleasePointsPerHour), Points(policy.ResidentReleaseMaxPoints)]
                            : L["Help_Resident_A2"])
                    </p>
                    <p>@L["Help_Resident_A3"]</p>
                    <p>@L["Help_Resident_A4", policy.ResidentPlanHorizonDays]</p>
                </div>
            </details>
        }

        <details class="help-item">
            <summary class="help-item__q">@L["Help_Notifications_Q"]</summary>
            <div class="help-item__a">
                <p>@L["Help_Notifications_A1"]</p>
                @if (policy.ReminderLeadTime > TimeSpan.Zero)
                {
                    <p>@L["Help_Notifications_Reminder", Fmt(policy.ReminderLeadTime)]</p>
                }
                <p>@L["Help_Notifications_A2"]</p>
                @if (policy.AvailabilityCampaignsEnabled)
                {
                    <p>@L["Help_Notifications_Tips"]</p>
                }
            </div>
        </details>

        <details class="help-item">
            <summary class="help-item__q">@L["Help_Profile_Q"]</summary>
            <div class="help-item__a">
                <p>@L["Help_Profile_A1"]</p>
                <ul>
                    @if (policy.SharedTakenBasePoints > 0)
                    {
                        <li>@L["Help_Profile_Li1"]</li>
                    }
                    <li>@L["Help_Profile_Li2"]</li>
                    <li>@L["Help_Profile_Li3"]</li>
                </ul>
            </div>
        </details>

        @if (_showAdminHelp)
        {
            <FluentLabel Typo="Typography.Subject" Style="margin-top:12px">@L["Help_AdminSection"]</FluentLabel>
        }

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.ManageVisitors)">
            <details class="help-item">
                <summary class="help-item__q">@L["Help_Visitors_Q"]</summary>
                <div class="help-item__a">
                    <p>@L["Help_Visitors_A1"]</p>
                    <p>@L["Help_Visitors_A2"]</p>
                    @if (!_hasVisitorSpots)
                    {
                        @* Bez míst typu Návštěvnické je agenda prázdná — ať správce ví proč. *@
                        <p><strong>@L["Help_Visitors_NoSpots"]</strong></p>
                    }
                </div>
            </details>
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.ManageFleet)">
            <details class="help-item">
                <summary class="help-item__q">@L["Help_FleetAdmin_Q"]</summary>
                <div class="help-item__a">
                    <p>@L["Help_FleetAdmin_A1"]</p>
                    <p>@L["Help_FleetAdmin_A2"]</p>
                </div>
            </details>
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.ReviewMismatches)">
            <details class="help-item">
                <summary class="help-item__q">@L["Help_Mismatch_Q"]</summary>
                <div class="help-item__a">
                    <p>@L["Help_Mismatch_A1"]</p>
                    <p>@L["Help_Mismatch_A2"]</p>
                    <p>@L["Help_Mismatch_A3"]</p>
                </div>
            </details>
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.ManageIncentives)">
            <details class="help-item">
                <summary class="help-item__q">@L["Help_Rules_Q"]</summary>
                <div class="help-item__a">
                    <p>@L["Help_Rules_A1"]</p>
                    <p>
                        @L["Help_Rules_State_Campaigns", policy.AvailabilityCampaignsEnabled ? L["Help_State_On"] : L["Help_State_Off"]]
                        @L["Help_Rules_State_Trust", policy.TrustEnabled ? L["Help_State_On"] : L["Help_State_Off"]]
                        @L["Help_Rules_State_Collusion", policy.AntiCollusionEnabled ? L["Help_State_On"] : L["Help_State_Off"]]
                        @L["Help_Rules_State_Reports", _userReportsOn ? L["Help_State_On"] : L["Help_State_Off"]]
                    </p>
                    @if (policy.TrustEnabled)
                    {
                        <p>@L["Help_Rules_TrustSetup", policy.TrustedBadgeThreshold, Fmt(TimeSpan.FromHours(policy.TrustIntervalHours))]</p>
                    }
                    @if (policy.AntiCollusionEnabled)
                    {
                        <p>@L["Help_Rules_CollusionSetup", policy.CollusionMinInteractions, policy.CollusionConcentrationPercent,
                            Fmt(TimeSpan.FromHours(policy.CollusionScanIntervalHours))]</p>
                    }
                    @if (policy.AvailabilityCampaignsEnabled)
                    {
                        <p>@L["Help_Rules_CampaignSetup", Days(policy.AvailabilityMinConsecutiveDays), policy.AvailabilityFreeThresholdPercent, Days(policy.AvailabilityLookaheadDays), policy.AvailabilitySendHourLocal]</p>
                    }
                    <figure class="help-demo">
                        <picture>
                            <source media="(prefers-reduced-motion: reduce)" srcset="/images/help/administration.png" />
                            <img class="help-demo__image"
                                 src="/images/help/administration.gif"
                                 width="960"
                                 height="540"
                                 loading="lazy"
                                 decoding="async"
                                 alt="@L["Help_Animation_Admin_Alt"]" />
                        </picture>
                        <figcaption>@L["Help_Animation_Admin_Caption"]</figcaption>
                    </figure>
                </div>
            </details>
        </AuthorizeView>
    }
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IncentivePolicy? _policy;
    private bool _charged;
    private bool _pointRewardsOn;
    private bool _pointsOn;
    private bool _tiersOn;
    private bool _ownsSpot;
    private bool _hasVisitorSpots;
    private bool _userReportsOn;
    private bool _showAdminHelp;

    protected override async Task OnInitializedAsync()
    {
        var policyTask = ParkingSettings.GetPolicyAsync();
        var settingsTask = ParkingSettings.GetAsync();
        await Task.WhenAll(policyTask, settingsTask);

        var policy = await policyTask;
        var settings = await settingsTask;
        _policy = policy;
        _userReportsOn = settings.OversightAllowUserReports;

        // Which chapters are worth showing at all under the current configuration.
        _charged = policy.CreditsEnabled;
        _tiersOn = policy.QueuePriorityPerTier > 0
            || (_charged && (policy.TierAllowanceBonus > 0 || policy.TierDiscountPercent > 0));
        _pointRewardsOn = (policy.ReleasePoints > 0 && policy.MaxRewardedReleasesPerDay > 0)
            || (policy.ResidentReleasePointsPerHour > 0 && policy.ResidentReleaseMaxPoints > 0)
            || policy.SharedTakenBasePoints > 0;
        _pointsOn = _pointRewardsOn || _tiersOn || policy.ReputationDecayPercent > 0;

        if (AuthState is not null)
        {
            var state = await AuthState;
            bool Can(string permission) => state.User.HasClaim(D3ParkingClaimTypes.Permission, permission);
            _showAdminHelp = Can(Permissions.Parking.ManageVisitors)
                || Can(Permissions.Parking.ManageFleet)
                || Can(Permissions.Parking.ReviewMismatches)
                || Can(Permissions.Parking.ManageIncentives);

            var user = await UserManager.GetUserAsync(state.User);
            if (user is not null)
            {
                _ownsSpot = await ResidentSpots.GetMyOwnedSpotAsync(user.Id) is not null;

                // Only the visitor-agenda chapter needs this, and only admins ever see it.
                if (Can(Permissions.Parking.ManageVisitors))
                {
                    var spots = await Spots.ListAsync(includeInactive: false);
                    _hasVisitorSpots = spots.Any(s => s.Type == ParkingSpotType.Visitor);
                }
            }
        }
    }

    /// <summary>Whole hours read better than "01:00:00"; anything shorter stays in minutes.</summary>
    private string Fmt(TimeSpan value) => value.TotalHours >= 1 && value.Minutes == 0
        ? L["Help_Unit_Hours", (int)value.TotalHours]
        : L["Help_Unit_Minutes", (int)value.TotalMinutes];

    // Numbers come from the live configuration, so the unit has to inflect with them: Czech needs
    // "1 bod / 2 body / 5 bodů". The templates therefore take an already-formatted "5 bodů", never
    // a bare number followed by a fixed noun.
    private string Points(int count) => $"{count} {PluralText.For(L, "Help_Plural_Points", count)}";

    private string Credits(int count) => $"{count} {PluralText.For(L, "Help_Plural_Credits", count)}";

    private string BudgetPeriod(BudgetRenewalPeriod period) =>
        L[$"Parking_Settings_BudgetPeriod_{period}"];

    private static string FormatAllowedWeekdays(Weekday weekdays)
    {
        var order = new[]
        {
            (Weekday.Monday, DayOfWeek.Monday), (Weekday.Tuesday, DayOfWeek.Tuesday),
            (Weekday.Wednesday, DayOfWeek.Wednesday), (Weekday.Thursday, DayOfWeek.Thursday),
            (Weekday.Friday, DayOfWeek.Friday), (Weekday.Saturday, DayOfWeek.Saturday),
            (Weekday.Sunday, DayOfWeek.Sunday),
        };
        return string.Join(", ", order.Where(entry => weekdays.HasFlag(entry.Item1))
            .Select(entry => CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(entry.Item2)));
    }

    private string Days(int count) => $"{count} {PluralText.For(L, "Help_Plural_Days", count)}";
}
