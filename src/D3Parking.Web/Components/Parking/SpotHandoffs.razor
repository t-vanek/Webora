@inject IResidentSpotHandoffService Handoffs
@inject IParkingSettingsService ParkingSettings
@inject ISiteSettingsService SiteSettings
@inject IStringLocalizer<SharedResource> L
@inject ILogger<SpotHandoffs> Logger

<section class="resident-tools resident-handoff-tile handoff-card" aria-labelledby="spot-handoffs-title">
    <header class="handoff-card__header">
        <div class="handoff-card__heading">
            <FluentIcon Value="@(new Icons.Regular.Size20.People())" Color="Color.Accent" />
            <div>
                <h2 id="spot-handoffs-title">@L["Parking_Handoff_Title"]</h2>
                <p>@L[!_policy.HandoffsEnabled ? "Parking_Handoff_Error_Disabled" : !BookingAllowed ? "Parking_Handoff_BlockedSubtitle" : CanOffer ? "Parking_Handoff_OfferSubtitle" : IsResident ? "Parking_Handoff_ResidentSubtitle" : "Parking_Handoff_RequestSubtitle"]</p>
            </div>
        </div>
        <span class="handoff-card__window">@WindowText</span>
    </header>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">@L[_error]</FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">@L[_info]</FluentMessageBar>
    }

    @if (IsResident)
    {
        <p class="handoff-card__policy">@ReclaimPolicyText</p>
    }

    <div class="resident-handoff-grid">
        @if (!_policy.HandoffsEnabled)
        {
            <p>@L["Parking_Handoff_Error_Disabled"]</p>
        }
        else if (!BookingAllowed)
        {
            <div class="handoff-action-card handoff-action-card--blocked">
                <FluentIcon Value="@(new Icons.Regular.Size20.LockClosed())" Color="Color.Warning" />
                <strong>@L["Parking_Planner_ReservationNotAllowed"]</strong>
                <p>@L["Parking_Handoff_BookingBlocked", BookingRestrictionText]</p>
            </div>
        }
        else if (CanOffer)
        {
            <div class="handoff-action-card">
                <h3>@L["Parking_Handoff_OfferTitle"]</h3>
                <p>@L["Parking_Handoff_OfferHelp"]</p>
                <div class="field">
                    <label for="handoff-recipient-search">@L["Parking_Handoff_FindUser"]</label>
                    <div class="quick-range">
                        <input id="handoff-recipient-search" class="parking-input" @bind="_recipientSearch"
                               placeholder="@L["Parking_Handoff_SearchPlaceholder"]" />
                        <FluentButton Appearance="Appearance.Outline" Disabled="@_busy"
                                      OnClick="SearchRecipientsAsync">@L["Parking_Handoff_Search"]</FluentButton>
                    </div>
                </div>
                @if (_recipients.Count > 0)
                {
                    <div class="field">
                        <label for="handoff-recipient">@L["Parking_Handoff_Recipient"]</label>
                        <select id="handoff-recipient" class="parking-input" @bind="_recipientId">
                            <option value="">@L["Parking_Handoff_SelectUser"]</option>
                            @foreach (var user in _recipients)
                            {
                                <option value="@user.Id">@UserLabel(user)</option>
                            }
                        </select>
                    </div>
                    <FluentButton Appearance="Appearance.Accent" Disabled="@(_busy || !SelectedRecipient.HasValue)"
                                  OnClick="CreateOfferAsync">@L["Parking_Handoff_SendOffer"]</FluentButton>
                }
            </div>
        }
        else if (!IsResident)
        {
            <details class="handoff-collapsible">
                <summary class="handoff-collapsible__summary">
                    <span>@L["Parking_Handoff_RequestSection"]</span>
                </summary>
                <div class="handoff-action-card handoff-action-card--embedded">
                    <p>@L["Parking_Handoff_RequestHelp"]</p>
                    <p class="handoff-card__policy">@ReclaimPolicyText</p>
                    <div class="field">
                        <label for="handoff-resident-search">@L["Parking_Handoff_FindResident"]</label>
                        <div class="quick-range">
                            <input id="handoff-resident-search" class="parking-input" @bind="_residentSearch"
                                   placeholder="@L["Parking_Handoff_ResidentSearchPlaceholder"]" />
                            <FluentButton Appearance="Appearance.Outline" Disabled="@_busy"
                                          OnClick="SearchResidentsAsync">@L["Parking_Handoff_Search"]</FluentButton>
                        </div>
                    </div>
                    @if (_residents.Count > 0)
                    {
                        <div class="field">
                            <label for="handoff-resident">@L["Parking_Handoff_Resident"]</label>
                            <select id="handoff-resident" class="parking-input" @bind="_residentId">
                                <option value="">@L["Parking_Handoff_SelectResident"]</option>
                                @foreach (var resident in _residents)
                                {
                                    <option value="@resident.Id">@UserLabel(resident)</option>
                                }
                            </select>
                        </div>
                        <p class="owned-note">@L["Parking_Handoff_AutoReservationNotice"]</p>
                        <FluentButton Appearance="Appearance.Accent" Disabled="@(_busy || !SelectedResident.HasValue)"
                                      OnClick="CreateRequestAsync">@L["Parking_Handoff_SendRequest"]</FluentButton>
                    }
                </div>
            </details>
        }
        else
        {
            <p class="handoff-card__empty">@L["Parking_Handoff_ResidentNoOffer"]</p>
        }
    </div>

    <div class="handoff-history" aria-busy="@_historyLoading">
        <h3>@L["Parking_Handoff_History"] <span>(@_totalCount)</span></h3>
        @if (_historyLoading)
        {
            <p role="status">@L["Parking_Admin_Loading"]</p>
        }
        else if (_items.Count == 0)
        {
            <p>@L["Handoff_Grid_Empty"]</p>
        }
        else
        {
            <div class="handoff-grid-scroll" tabindex="0" role="region" aria-label="@L["Parking_Handoff_History"]">
                <table class="handoff-history-grid">
                    <thead><tr>
                        <th scope="col">@L["Handoff_Grid_Spot"]</th>
                        <th scope="col">@L["Handoff_Grid_Window"]</th>
                        <th scope="col">@L["Handoff_Grid_Person"]</th>
                        <th scope="col">@L["Handoff_Grid_Status"]</th>
                        <th scope="col">@L["Handoff_Grid_Actions"]</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr @key="item.Id">
                                <th scope="row">@item.SpotCode</th>
                                <td>@FormatWindow(item.StartUtc, item.EndUtc)</td>
                                <td>@Counterparty(item)</td>
                                <td><span class="handoff-grid-status">@L[$"Parking_Handoff_Status_{item.Status}"]</span></td>
                                <td><div class="handoff-grid-actions">@HandoffActions(item)</div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <nav class="handoff-grid-pagination" aria-label="@L["Handoff_Grid_Pagination"]">
            <label for="handoff-page-size">@L["Handoff_Grid_PageSize"]</label>
            <select id="handoff-page-size" class="parking-input" @bind="_pageSize" @bind:after="ResetPageAsync" disabled="@(_busy || _historyLoading)">
                <option value="10">10</option><option value="20">20</option><option value="50">50</option>
            </select>
            <FluentButton Disabled="@(_busy || _historyLoading || _pageIndex == 0)" OnClick="@(() => LoadPageAsync(_pageIndex - 1))">@L["Analysis_Previous"]</FluentButton>
            <span>@L["Analysis_Page", _pageIndex + 1, PageCount]</span>
            <FluentButton Disabled="@(_busy || _historyLoading || _pageIndex + 1 >= PageCount)" OnClick="@(() => LoadPageAsync(_pageIndex + 1))">@L["Analysis_Next"]</FluentButton>
        </nav>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Guid UserId { get; set; }
    [Parameter, EditorRequired] public DateTimeOffset StartUtc { get; set; }
    [Parameter, EditorRequired] public DateTimeOffset EndUtc { get; set; }
    [Parameter] public bool CanOffer { get; set; }
    [Parameter] public bool IsResident { get; set; }
    [Parameter] public bool BookingAllowed { get; set; } = true;
    [Parameter] public string BookingRestrictionText { get; set; } = string.Empty;
    [Parameter] public EventCallback Changed { get; set; }

    private IReadOnlyList<ResidentSpotHandoffDto> _items = [];
    private IReadOnlyList<ResidentSpotHandoffUserDto> _recipients = [];
    private IReadOnlyList<ResidentSpotHandoffUserDto> _residents = [];
    private string? _recipientSearch;
    private string? _residentSearch;
    private string? _recipientId;
    private string? _residentId;
    private string? _error;
    private string? _info;
    private bool _busy;
    private TimeZoneInfo _timeZone = TimeZoneInfo.Utc;
    private IncentivePolicy _policy = IncentivePolicy.Default;

    private Guid? SelectedRecipient => Guid.TryParse(_recipientId, out var id) ? id : null;
    private Guid? SelectedResident => Guid.TryParse(_residentId, out var id) ? id : null;
    private string WindowText => FormatWindow(StartUtc, EndUtc);
    private string ReclaimPolicyText => L[$"Parking_Handoff_Reclaim_{_policy.ResidentReclaimPolicy}"];
    private int _pageIndex;
    private int _pageSize = 10;
    private int _totalCount;
    private bool _historyLoading;
    private int PageCount => Math.Max(1, (_totalCount + _pageSize - 1) / _pageSize);

    protected override async Task OnInitializedAsync()
    {
        var zone = SiteSettings.GetTimeZoneAsync();
        var policy = ParkingSettings.GetPolicyAsync();
        await Task.WhenAll(zone, policy);
        _timeZone = zone.Result;
        _policy = policy.Result;
        await ReloadAsync();
    }

    private async Task SearchRecipientsAsync()
    {
        _error = null;
        _recipients = await Handoffs.SearchRecipientsAsync(UserId, _recipientSearch);
        _recipientId = null;
        if (_recipients.Count == 0) _error = "Parking_Handoff_Error_NoSearchResults";
    }

    private async Task SearchResidentsAsync()
    {
        _error = null;
        _residents = await Handoffs.SearchResidentsAsync(UserId, _residentSearch);
        _residentId = null;
        if (_residents.Count == 0) _error = "Parking_Handoff_Error_NoSearchResults";
    }

    private Task CreateOfferAsync() => SelectedRecipient is { } recipientId
        ? RunAsync(() => Handoffs.CreateOfferAsync(UserId, recipientId, StartUtc, EndUtc), "Parking_Handoff_OfferSent")
        : Task.CompletedTask;

    private Task CreateRequestAsync() => SelectedResident is { } residentId
        ? RunAsync(() => Handoffs.CreateRequestAsync(UserId, residentId, StartUtc, EndUtc), "Parking_Handoff_RequestSent")
        : Task.CompletedTask;

    private Task AcceptAsync(Guid id) => RunAsync(() => Handoffs.AcceptAsync(UserId, id), "Parking_Handoff_ReservationCreated");
    private Task DeclineAsync(Guid id) => RunAsync(() => Handoffs.DeclineAsync(UserId, id), "Parking_Handoff_Declined");
    private Task CancelAsync(Guid id) => RunAsync(() => Handoffs.CancelAsync(UserId, id), "Parking_Handoff_Cancelled");

    private async Task RunAsync(Func<Task<ParkingResult>> action, string successKey)
    {
        _busy = true;
        _error = null;
        _info = null;
        try
        {
            var result = await action();
            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault() ?? "Parking_Handoff_Error_Generic";
                return;
            }

            _info = successKey;
            _recipientId = null;
            _residentId = null;
            await ReloadAsync();
            await Changed.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ReloadAsync() => LoadPageAsync(_pageIndex);
    private Task ResetPageAsync() => LoadPageAsync(0);
    private async Task LoadPageAsync(int page)
    {
        if (_historyLoading) return;
        _historyLoading = true;
        try
        {
            var result = await Handoffs.GetMinePageAsync(UserId, page, _pageSize);
            _items = result.Items;
            _totalCount = result.TotalCount;
            _pageIndex = result.PageIndex;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load handoff page");
            _error = "Parking_Admin_LoadFailed";
        }
        finally { _historyLoading = false; }
    }

    private bool CanAccept(ResidentSpotHandoffDto item) =>
        _policy.HandoffsEnabled
        && _policy.GetReservationDateAvailability(item.StartUtc, DateTimeOffset.UtcNow, _timeZone)
            == ReservationDateAvailability.Allowed
        && item.Status switch
    {
        ResidentSpotHandoffStatus.Offered => item.RecipientId == UserId,
        ResidentSpotHandoffStatus.PendingResident => item.ResidentId == UserId,
        _ => false,
    };

    private bool CanCancel(ResidentSpotHandoffDto item) => item.Status is
        ResidentSpotHandoffStatus.Offered or ResidentSpotHandoffStatus.PendingResident
        && (item.Kind == ResidentSpotHandoffKind.ResidentOffer ? item.ResidentId == UserId : item.RecipientId == UserId);

    private RenderFragment HandoffActions(ResidentSpotHandoffDto item) => __builder =>
    {
            @if (CanAccept(item))
            {
                <FluentButton Appearance="Appearance.Accent" Disabled="@_busy" OnClick="() => AcceptAsync(item.Id)">
                    @(item.Kind == ResidentSpotHandoffKind.UserRequest
                        ? L["Parking_Handoff_ApproveAndReserve"]
                        : L["Parking_Handoff_AcceptAndReserve"])
                </FluentButton>
                <FluentButton Appearance="Appearance.Stealth" Disabled="@_busy"
                              OnClick="() => DeclineAsync(item.Id)">@L["Parking_Handoff_Decline"]</FluentButton>
            }
            else if (CanCancel(item))
            {
                <FluentButton Appearance="Appearance.Stealth" Disabled="@_busy"
                              OnClick="() => CancelAsync(item.Id)">@L["Parking_Handoff_Cancel"]</FluentButton>
            }

    };

    private string Counterparty(ResidentSpotHandoffDto item) => item.Kind switch
    {
        ResidentSpotHandoffKind.ResidentOffer when item.ResidentId == UserId => L["Parking_Handoff_To", item.RecipientName],
        ResidentSpotHandoffKind.ResidentOffer => L["Parking_Handoff_From", item.ResidentName],
        ResidentSpotHandoffKind.UserRequest when item.RecipientId == UserId => L["Parking_Handoff_RequestedFrom", item.ResidentName],
        _ => L["Parking_Handoff_RequestedBy", item.RecipientName],
    };

    private string UserLabel(ResidentSpotHandoffUserDto user) => user.SpotCode is { Length: > 0 }
        ? $"{user.DisplayName} · {user.SpotCode}"
        : user.DisplayName;

    private string FormatWindow(DateTimeOffset startUtc, DateTimeOffset endUtc)
    {
        var start = TimeZoneInfo.ConvertTime(startUtc, _timeZone);
        var end = TimeZoneInfo.ConvertTime(endUtc, _timeZone);
        if (start.TimeOfDay == TimeSpan.Zero && end.TimeOfDay == TimeSpan.Zero
            && DateOnly.FromDateTime(end.DateTime) == DateOnly.FromDateTime(start.DateTime).AddDays(1))
        {
            return $"{start:d} · {L["Parking_AllDay"]}";
        }

        return start.Date == end.Date
            ? $"{start:g} – {end:t}"
            : $"{start:g} – {end:g}";
    }
}
