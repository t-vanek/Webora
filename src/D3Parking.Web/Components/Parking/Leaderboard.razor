@page "/parking/leaderboard"
@attribute [HasPermission(Permissions.Parking.ViewLeaderboard)]
@rendermode InteractiveServer
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject IIncentiveService Incentives
@inject IParkingSettingsService ParkingSettings
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Parking_Leaderboard_Title"]</PageTitle>

<FluentStack Class="page-shell" Orientation="Orientation.Vertical" VerticalGap="20">
    <FluentLabel Typo="Typography.PageTitle">@L["Parking_Leaderboard_Title"]</FluentLabel>
    <FluentLabel Typo="Typography.Body">@L["Parking_Leaderboard_Intro"]</FluentLabel>

    @if (_score is not null)
    {
        <FluentCard Class="hero-card">
            <div class="hero">
                <div class="hero__ring">
                    <div class="tier-ring tier-ring--@_score.Tier" style="--pct:@TierProgressPercent()">
                        <div class="tier-ring__inner">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Trophy())" Color="Color.Custom" CustomColor="currentColor" />
                            <span class="tier-ring__name">@L[$"Parking_Tier_{_score.Tier}"]</span>
                        </div>
                    </div>
                    <span class="hero__next">
                        @if (_score.Tier == LoyaltyTier.Platinum)
                        {
                            @L["Parking_Tier_Max"]
                        }
                        else
                        {
                            @L["Parking_Tier_ToNext", PointsToNextTier(), L[$"Parking_Tier_{NextTier()}"]]
                        }
                    </span>
                </div>

                <div class="hero__body">
                    <span class="hero__label">@L["Parking_MyScore"]</span>
                    <div class="hero__points"><strong>@_score.Points</strong> <span>@L["Parking_Points"]</span></div>

                    <div class="hero__chips">
                        @if (_policy?.CreditsEnabled == true)
                        {
                            <span class="balance-chip balance-chip--ok">@L["Parking_MyCredits"]: <strong>@_score.Credits</strong> @L["Parking_Credits"]</span>
                        }
                        <span class="pill pill--type">@L["Parking_MyStreak"]: @_score.CompletionStreak</span>
                    </div>

                    <div class="trust-meter">
                        <div class="trust-meter__head">
                            <span>@L["Parking_Trust"]</span>
                            <span><strong>@_score.TrustScore</strong>/100</span>
                        </div>
                        <div class="meter"><div class="meter__fill meter__fill--good" style="width:@(_score.TrustScore)%"></div></div>
                    </div>

                    <div class="hero__stats">
                        <div class="stat"><span class="stat__num">@_score.ReservationsReleased</span><span class="stat__lbl">@L["Parking_Stat_Released"]</span></div>
                        <div class="stat"><span class="stat__num">@_score.ReservationsCompleted</span><span class="stat__lbl">@L["Parking_Stat_Completed"]</span></div>
                        <div class="stat"><span class="stat__num">@_score.NoShows</span><span class="stat__lbl">@L["Parking_Stat_NoShows"]</span></div>
                    </div>

                    @if (VisibleBadges(_score.Badges).Count > 0)
                    {
                        <div class="hero__chips">
                            @foreach (var badge in VisibleBadges(_score.Badges))
                            {
                                <FluentBadge Appearance="Appearance.Accent">@L[$"Parking_Badge_{badge}"]</FluentBadge>
                            }
                        </div>
                    }
                </div>
            </div>
        </FluentCard>
    }

    @if (_peer is not null)
    {
        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                <FluentLabel Typo="Typography.Subject">@L["Parking_Team_Mine"]: <strong>@_peer.Department</strong></FluentLabel>
                <FluentLabel Typo="Typography.Body">@L["Parking_Team_Rank", _peer.RankInTeam, _peer.TeamSize]</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="24" Wrap="true">
                    <FluentLabel Typo="Typography.Body">@L["Parking_Points"]: <strong>@_peer.MyPoints</strong> · @L["Parking_Team_Avg"]: @_peer.TeamAveragePoints</FluentLabel>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    }

    @if (_leaderboard is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else if (_leaderboard.Count == 0)
    {
        <div class="empty-state">@L["Parking_Leaderboard_Empty"]</div>
    }
    else
    {
        <div class="admin-panel">
        <FluentDataGrid Items="@_leaderboard.AsQueryable()" TGridItem="LeaderboardEntryDto"
                        GridTemplateColumns="auto 2fr 1fr 1fr 2fr">
            <TemplateColumn Title="@L["Parking_Rank"]">
                @if (context.Rank <= 3)
                {
                    <span class="medal medal--@context.Rank">@context.Rank</span>
                }
                else
                {
                    <span class="rank-num">@context.Rank</span>
                }
            </TemplateColumn>
            <PropertyColumn Property="@(e => e.DisplayName)" Title="@L["Parking_Name"]" />
            <PropertyColumn Property="@(e => e.Points)" Title="@L["Parking_Points"]" />
            <PropertyColumn Property="@(e => e.ReservationsReleased)" Title="@L["Parking_Stat_Released"]" />
            <TemplateColumn Title="@L["Parking_Badges"]">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4" Wrap="true">
                    @foreach (var badge in VisibleBadges(context.Badges))
                    {
                        <FluentBadge>@L[$"Parking_Badge_{badge}"]</FluentBadge>
                    }
                </FluentStack>
            </TemplateColumn>
        </FluentDataGrid>
        </div>
    }

    @if (_teams is { Count: > 0 })
    {
        <FluentLabel Typo="Typography.Subject">@L["Parking_Team_Leaderboard"]</FluentLabel>
        <div class="admin-panel">
        <FluentDataGrid Items="@_teams.AsQueryable()" TGridItem="TeamLeaderboardEntryDto"
                        GridTemplateColumns="auto 2fr 1fr 1fr">
            <PropertyColumn Property="@(t => t.Rank)" Title="@L["Parking_Rank"]" />
            <PropertyColumn Property="@(t => t.Department)" Title="@L["Parking_Team_Name"]" />
            <PropertyColumn Property="@(t => t.MemberCount)" Title="@L["Parking_Team_Members"]" />
            <PropertyColumn Property="@(t => t.AveragePoints)" Title="@L["Parking_Team_AvgPoints"]" />
        </FluentDataGrid>
        </div>
    }
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ParkerScoreDto? _score;
    private IReadOnlyList<LeaderboardEntryDto>? _leaderboard;
    private IReadOnlyList<TeamLeaderboardEntryDto>? _teams;
    private PeerComparisonDto? _peer;
    private IncentivePolicy? _policy;

    private static IReadOnlyList<ParkingBadge> VisibleBadges(IReadOnlyList<ParkingBadge> badges) =>
        badges.Where(badge => badge != ParkingBadge.OffPeakChampion).ToList();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;

        // Five independent reads that the prerender waits for. GetUserId only reads a claim, so there
        // is no Identity round trip to keep them behind, and every service below takes its own context
        // from the factory — so they go together instead of one after another.
        var policy = ParkingSettings.GetPolicyAsync();
        var leaderboard = Incentives.GetLeaderboardAsync();
        var teams = Incentives.GetTeamLeaderboardAsync();

        if (Guid.TryParse(UserManager.GetUserId(state.User), out var userId))
        {
            var score = Incentives.GetScoreAsync(userId);
            var peer = Incentives.GetPeerComparisonAsync(userId);
            await Task.WhenAll(policy, leaderboard, teams, score, peer);
            _score = score.Result;
            _peer = peer.Result;
        }
        else
        {
            await Task.WhenAll(policy, leaderboard, teams);
        }

        _policy = policy.Result;
        _leaderboard = leaderboard.Result;
        _teams = teams.Result;
    }

    // Floor/ceiling reputation thresholds bounding the current tier band.
    private (int floor, int next) TierBand()
    {
        var p = _policy!;
        return _score!.Tier switch
        {
            LoyaltyTier.Bronze => (0, p.TierSilverPoints),
            LoyaltyTier.Silver => (p.TierSilverPoints, p.TierGoldPoints),
            LoyaltyTier.Gold => (p.TierGoldPoints, p.TierPlatinumPoints),
            _ => (p.TierPlatinumPoints, p.TierPlatinumPoints),
        };
    }

    private int TierProgressPercent()
    {
        if (_policy is null || _score is null) return 0;
        if (_score.Tier == LoyaltyTier.Platinum) return 100;
        var (floor, next) = TierBand();
        var span = next - floor;
        if (span <= 0) return 100;
        var pct = (int)Math.Round((_score.Points - floor) * 100.0 / span);
        return Math.Clamp(pct, 0, 100);
    }

    private int PointsToNextTier()
    {
        if (_policy is null || _score is null) return 0;
        var (_, next) = TierBand();
        return Math.Max(0, next - _score.Points);
    }

    private LoyaltyTier NextTier() => _score!.Tier switch
    {
        LoyaltyTier.Bronze => LoyaltyTier.Silver,
        LoyaltyTier.Silver => LoyaltyTier.Gold,
        _ => LoyaltyTier.Platinum,
    };
}
