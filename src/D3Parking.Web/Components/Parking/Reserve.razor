    private async Task SelectPlannerDayAsync(DateOnly date)
    {
        _day = date;
        _sharedSearchRequested = false;
        if (HasHeldResidentSpotForSelectedDay)
        {
            _available = null;
            _quote = null;
            return;
        }

        if (_available is not null)
        {
            await FindAvailableAsync();
        }
    }

    private Task MovePlannerWeekAsync(int weeks) => SelectPlannerDayAsync(_day.AddDays(weeks * 7));

    private Task PlannerTodayAsync() => SelectPlannerDayAsync(PlannerToday);

    private sealed record ParkingReservePreferences(
