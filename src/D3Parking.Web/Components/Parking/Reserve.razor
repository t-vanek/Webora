    private sealed record ReleasePeriod(DateOnly From, DateOnly To, int DayCount, int TakenDays);

    private DateOnly ReleaseToday => SiteTime.Today(DateTimeOffset.UtcNow, _tz);
    private int ReleaseRangeDayCount
    {
        get
        {
            var from = DateOnly.FromDateTime(_releaseFrom);
            var to = DateOnly.FromDateTime(_releaseTo);
            return to < from ? 0 : to.DayNumber - from.DayNumber + 1;
        }
    }
    private DateOnly ReleaseReturnDate => DateOnly.FromDateTime(_releaseTo).AddDays(1);
    private bool ReleaseRangeIsValid =>
        DateOnly.FromDateTime(_releaseFrom) >= ReleaseToday
        && ReleaseRangeDayCount is > 0
        && ReleaseRangeDayCount <= Math.Max(1, _policy?.MaxReleaseRangeDays ?? 92);
    private bool ReleaseRangeHasHeldDay
    {
        get
        {
            if (_ownedSpot is null || !ReleaseRangeIsValid)
            {
                return false;
            }

            var released = _ownedSpot.UpcomingReleases.Select(day => day.Date).ToHashSet();
            var from = DateOnly.FromDateTime(_releaseFrom);
            var to = DateOnly.FromDateTime(_releaseTo);
            for (var date = from; date <= to; date = date.AddDays(1))
            {
                if (!released.Contains(date))
                {
                    return true;
                }
            }

            return false;
        }
    }
    private string ReleaseMinDate => ReleaseToday.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string ReleaseRewardText => _releasePreview > 0
        ? $"+{_releasePreview} {L["Parking_Points"]}"
        : L["Parking_Owned_NoReleaseReward"].Value;

    private IReadOnlyList<ReleasePeriod> ReleasePeriods
    {
        get
        {
            if (_ownedSpot?.UpcomingReleases is not { Count: > 0 } releases)
            {
                return [];
            }

            var periods = new List<ReleasePeriod>();
            var from = releases[0].Date;
            var to = from;
            var taken = releases[0].TakenByGuest ? 1 : 0;
            for (var index = 1; index < releases.Count; index++)
            {
                var day = releases[index];
                if (day.Date == to.AddDays(1))
                {
                    to = day.Date;
                    taken += day.TakenByGuest ? 1 : 0;
                    continue;
                }

                periods.Add(new ReleasePeriod(from, to, to.DayNumber - from.DayNumber + 1, taken));
                from = to = day.Date;
                taken = day.TakenByGuest ? 1 : 0;
            }

            periods.Add(new ReleasePeriod(from, to, to.DayNumber - from.DayNumber + 1, taken));
            return periods;
        }
    }

    // Monday-first, labelled from the request culture's own abbreviations — a plan editor needs no
    // resource string per weekday.
    private static readonly (Weekday Flag, DayOfWeek Day)[] PlanWeekdayOrder =
    [
        (Weekday.Monday, DayOfWeek.Monday), (Weekday.Tuesday, DayOfWeek.Tuesday),
        (Weekday.Wednesday, DayOfWeek.Wednesday), (Weekday.Thursday, DayOfWeek.Thursday),
        (Weekday.Friday, DayOfWeek.Friday), (Weekday.Saturday, DayOfWeek.Saturday),
        (Weekday.Sunday, DayOfWeek.Sunday),
    ];

    private static IEnumerable<(Weekday Flag, string Label)> PlanWeekdays =>
        PlanWeekdayOrder.Select(entry => (entry.Flag,
            CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(entry.Day)));

