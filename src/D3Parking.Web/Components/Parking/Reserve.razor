            var mondayOffset = ((int)_day.DayOfWeek + 6) % 7;
            return _day.AddDays(-mondayOffset);
        }
    }

    private IReadOnlyList<DateOnly> PlannerWeekDates =>
        Enumerable.Range(0, 7).Select(PlannerWeekStart.AddDays).ToList();

    private IReadOnlyList<ReservationDto> PlannerBookings(DateOnly date)
    {
        if (_myReservations is null)
        {
            return [];
        }

        var (start, end) = SiteTime.Day(date, _tz);
        return _myReservations
            .Where(r => r.Status is ReservationStatus.Reserved or ReservationStatus.CheckedIn or ReservationStatus.Completed
                && r.StartUtc < end && r.EndUtc > start)
            .OrderBy(r => r.StartUtc)
            .ToList();
    }

    private bool ResidentOwnsDay(DateOnly date) =>
        date >= PlannerToday
        && _ownedSpot is not null
        && ResidentRelease(date) is null;

    private ReleasedDayDto? ResidentRelease(DateOnly date) =>
        _ownedSpot?.UpcomingReleases.FirstOrDefault(release => release.Date == date);

