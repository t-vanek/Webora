    private static string OccupancyClass(int percent) =>
        percent >= 90 ? "meter__fill--high" : percent >= 70 ? "meter__fill--mid" : "meter__fill--low";

    // Points a reservation on this spot would earn now: off-peak bonus plus, for a shared reserved
    // spot, the commute-distance reward.
    private int PointsForSpot(ParkingSpotDto spot)
    {
        if (_policy is null)
        {
            return 0;
        }

        var offPeak = _policy.IsOffPeak(Start, _tz) ? _policy.OffPeakBonusPoints : 0;
        var shared = spot.OwnerId is not null ? _policy.ComputeSharedTakenReward(_distanceKm) : 0;
        return offPeak + shared;
    }

    // The promised range reward comes from the service — the same skips and the same monthly
    // share-allowance cap as the actual award. A client-side estimate here already drifted from
    // what the release then credited (it ignored the cap and promised points to allowance-0 owners).
    private async Task RefreshReleasePreviewAsync()
    {
        _releasePreview = _ownedSpot is null
            ? 0
            : await ResidentSpots.PreviewReleaseRewardAsync(_userId,
                DateOnly.FromDateTime(_releaseFrom), DateOnly.FromDateTime(_releaseTo));
    }

    private async Task ReleaseRangeChangedAsync()
    {
        _releasePreset = ReleasePreset.Custom;
        await RefreshReleasePreviewAsync();
    }

    private async Task SetReleasePresetAsync(ReleasePreset preset)
    {
        _releasePreset = preset;
        var today = SiteTime.Today(DateTimeOffset.UtcNow, _tz);
        var from = today;
        var to = today;

        if (preset == ReleasePreset.Tomorrow)
        {
            from = today.AddDays(1);
            to = from;
        }
        else if (preset == ReleasePreset.ThisWeek)
        {
            var daysUntilSunday = ((int)DayOfWeek.Sunday - (int)today.DayOfWeek + 7) % 7;
            to = today.AddDays(daysUntilSunday);
        }

        _releaseFrom = from.ToDateTime(TimeOnly.MinValue);
        _releaseTo = to.ToDateTime(TimeOnly.MinValue);
        await RefreshReleasePreviewAsync();
    }

    private async Task ReloadOwnedSpotAsync()
    {
        _ownedSpot = await ResidentSpots.GetMyOwnedSpotAsync(_userId);
        _allowance = _ownedSpot?.MonthlyShareAllowance ?? 0;
        _planDays = _ownedSpot?.PlannedUseDays ?? Weekday.Workdays;
        _planAutoRelease = _ownedSpot?.AutoReleaseUnplannedDays ?? false;
        // Every resident action (release, reclaim, allowance change) can move the promised reward.
        await RefreshReleasePreviewAsync();
    }

