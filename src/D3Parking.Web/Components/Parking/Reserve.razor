@page "/parking"
@attribute [HasPermission(Permissions.Parking.Reserve)]
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IReservationService Reservations
@inject IParkingSettingsService ParkingSettings
@inject IResidentSpotService ResidentSpots
@inject IUserLocationService UserLocation
@inject ISiteSettingsService SiteSettings
@inject UserManager<ApplicationUser> UserManager
@inject ProtectedLocalStorage Storage
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Parking_Title"]</PageTitle>

<div class="page-shell reserve-page">
    <header class="reserve-hero">
        <FluentLabel Typo="Typography.PageTitle">@L["Parking_Title"]</FluentLabel>
        <FluentLabel Typo="Typography.Body">@L["Parking_Intro"]</FluentLabel>
    </header>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">
            @L[_error]
        </FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">
            @L[_info]
        </FluentMessageBar>
    }
    @* Outcome of the "I can't park" flow — pre-localized (carries the replacement spot code). *@
    @if (_blockedMessage is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">
            @_blockedMessage
        </FluentMessageBar>
    }

    @if (_showOrientationMap)
    {
        <div class="parking-map-modal" role="dialog" aria-modal="true" aria-labelledby="parking-map-title">
            <div class="parking-map-modal__surface">
                <div class="parking-map-modal__head">
                    <div>
                        <span class="parking-map-modal__eyebrow">@L["Parking_Map_OrientationEyebrow"]</span>
                        <h2 id="parking-map-title">@L["Parking_Map_OrientationTitle"]</h2>
                        @if (!string.IsNullOrWhiteSpace(_orientationMapSpotCode))
                        {
                            <p>@L["Parking_Map_FindSpot", _orientationMapSpotCode]</p>
                        }
                    </div>
                    <FluentButton Appearance="Appearance.Stealth" OnClick="CloseOrientationMapAsync"
                                  aria-label="@L["Parking_Map_Close"]">
                        @L["Parking_Map_Close"]
                    </FluentButton>
                </div>
                <div class="parking-map-modal__tools">
                    @if (!string.IsNullOrWhiteSpace(_orientationMapSpotCode))
                    {
                        <span class="parking-map-modal__spot">@L["Parking_Spot"]: <strong>@_orientationMapSpotCode</strong></span>
                    }
                    <FluentAnchor Href="@OrientationMapUrl" Target="_blank" Appearance="Appearance.Hypertext">
                        @L["Parking_Map_Open"]
                    </FluentAnchor>
                </div>
                <div class="parking-map-modal__viewport">
                    <img src="@OrientationMapUrl" alt="@L["Parking_Map_ImageAlt"]" />
                </div>
            </div>
        </div>
    }

    @* Apology voucher for a blocked spot: one reservation free, peak included. Redeemed by
       ticking the box before booking; a timely cancel gives it back. A voucher still awaiting
       the spot manager's review is shown, but cannot be redeemed yet. *@
    @if (_voucher is { } voucher)
    {
        <div class="form-panel reserve-voucher">
            @if (voucher.Status == ApologyVoucherStatus.Approved)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
                    <FluentLabel Typo="Typography.Body">@L["Parking_Voucher_Available", Local(voucher.ExpiresAtUtc, "d")]</FluentLabel>
                    <FluentCheckbox @bind-Value="_useVoucher">@L["Parking_Voucher_Use"]</FluentCheckbox>
                </FluentStack>
            }
            else
            {
                <FluentLabel Typo="Typography.Body">@L["Parking_Voucher_Pending"]</FluentLabel>
            }
        </div>
    }

    <div class="reserve-layout">
        <main class="reserve-main">
            @if (!HasConfirmedResidentSpot)
            {
                @SharedSearchArea()
            }

            @ActiveReservationsPanel()

    @if (_available is not null && !HasConfirmedResidentSpot)
    {
        <div class="availability-toolbar">
            <div class="availability-toolbar__title">
                <FluentLabel Typo="Typography.Subject">@L["Parking_Available"]</FluentLabel>
                <span>@L["Parking_Available_Count", VisibleAvailableSpots.Count, AvailableTotal]</span>
            </div>
            <div class="availability-toolbar__controls">
                <label class="select-field">
                    <span>@L["Parking_Filter_Type"]</span>
                    <select class="parking-input" @bind="_spotTypeFilter">
                        <option value="">@L["Parking_Filter_AllTypes"]</option>
                        @foreach (var type in ReservableSpotTypes)
                        {
                            <option value="@type">@L[$"Parking_SpotType_{type}"]</option>
                        }
                    </select>
                </label>
                <label class="select-field">
                    <span>@L["Parking_Sort"]</span>
                    <select class="parking-input" @bind="_availableSort">
                        <option value="@AvailableSort.Recommended">@L["Parking_Sort_Recommended"]</option>
                        <option value="@AvailableSort.Code">@L["Parking_Sort_Code"]</option>
                        <option value="@AvailableSort.Type">@L["Parking_Sort_Type"]</option>
                    </select>
                </label>
            </div>
        </div>

        @if (AvailableTotal == 0)
        {
            <div class="empty-state">
                <FluentIcon Value="@(new Icons.Regular.Size32.VehicleCar())" Color="Color.Neutral" />
                <FluentLabel Typo="Typography.Body">@NoBookableSpotsText</FluentLabel>
                <div class="empty-actions">
                    <FluentButton Appearance="Appearance.Accent" Disabled="@_actionBusy" OnClick="JoinQueueAsync">@L["Parking_Queue_JoinFull"]</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" Disabled="@_actionBusy" OnClick="() => ShiftSearchAsync(TimeSpan.FromMinutes(30))">@L["Parking_TryLater_30"]</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" Disabled="@_actionBusy" OnClick="() => ShiftSearchAsync(TimeSpan.FromMinutes(60))">@L["Parking_TryLater_60"]</FluentButton>
                    @if (SuggestedOffPeakStart is { } offPeakStart)
                    {
                        <FluentButton Appearance="Appearance.Outline" Disabled="@_actionBusy" OnClick="() => SearchFromAsync(offPeakStart)">@L["Parking_TryOffPeak"]</FluentButton>
                    }
                </div>
            </div>
        }
        else if (VisibleAvailableSpots.Count == 0)
        {
            <div class="empty-state">
                <FluentIcon Value="@(new Icons.Regular.Size32.Filter())" Color="Color.Neutral" />
                <FluentLabel Typo="Typography.Body">@L["Parking_Available_FilterEmpty"]</FluentLabel>
            </div>
        }
        else
        {
            @if (RecommendedAvailableSpot is { } recommended)
            {
                <section class="recommended-spot">
                    <div class="recommended-spot__copy">
                        <span>@L["Parking_Recommended_Label"]</span>
                        <strong>@recommended.Code</strong>
                        <div class="recommended-spot__meta">
                            <span class="pill pill--type">@L[$"Parking_SpotType_{recommended.Type}"]</span>
                            @if (_quote is not null)
                            {
                                <span>@_quote.Cost @L["Parking_Credits"]</span>
                            }
                            @if (PointsForSpot(recommended) > 0)
                            {
                                <span>@L["Parking_Earn"] +@PointsForSpot(recommended) @L["Parking_Points"]</span>
                            }
                        </div>
                    </div>
                    <FluentButton Appearance="Appearance.Accent"
                                  Disabled="@(_actionBusy || (_quote is not null && !_quote.Affordable))"
                                  OnClick="() => ReserveAsync(recommended.Id)">
                        @L["Parking_Recommended_Reserve"]
                    </FluentButton>
                </section>
            }

            <div class="spot-groups">
                @{
                    var groups = AvailableSpotGroups;
                }
                @for (var i = 0; i < groups.Count; i++)
                {
                    var group = groups[i];
                    @if (i == 0)
                    {
                        <section class="spot-group spot-group--featured">
                            <div class="spot-group__summary spot-group__summary--static">
                                <span>@L["Parking_Group_Title", group.Label]</span>
                                <span class="count-chip">@group.Spots.Count</span>
                            </div>
                            @SpotGrid(group)
                        </section>
                    }
                    else
                    {
                        <details class="spot-group">
                            <summary class="spot-group__summary">
                                <span>@L["Parking_Group_Title", group.Label]</span>
                                <span class="count-chip">@group.Spots.Count</span>
                            </summary>
                            @SpotGrid(group)
                        </details>
                    }
                }
            </div>
        }
    }

    @if (_myQueue is { Count: > 0 })
    {
        <FluentLabel Typo="Typography.Subject">@L["Parking_Queue_MyQueue"]</FluentLabel>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            @foreach (var q in _myQueue)
            {
                <FluentCard>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Wrap="true" VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Body">
                            @Local(q.StartUtc, "g") – @Local(q.EndUtc, "t")
                        </FluentLabel>
                        <FluentBadge Appearance="Appearance.Accent">@L[$"Parking_QueueState_{q.Status}"]</FluentBadge>
                        @if (q.Status == QueueEntryStatus.Offered)
                        {
                            <FluentLabel Typo="Typography.Body" Style="color: var(--success);">
                                @L["Parking_Queue_OfferedSpot"]: <strong>@q.OfferedSpotCode</strong>
                            </FluentLabel>
                            <FluentButton Appearance="Appearance.Accent" Disabled="@_actionBusy" OnClick="() => ClaimQueueAsync(q.Id)">@L["Parking_Queue_Claim"]</FluentButton>
                        }
                        else
                        {
                            <FluentLabel Typo="Typography.Body">@L["Parking_Queue_Position"]: @q.Position</FluentLabel>
                        }
                        <FluentButton Appearance="Appearance.Stealth" Disabled="@_actionBusy" OnClick="() => LeaveQueueAsync(q.Id)">@L["Parking_Queue_Leave"]</FluentButton>
                    </FluentStack>
                </FluentCard>
            }
        </FluentStack>
    }

    @* "I can't park" panel: helper framing on purpose — the driver asks for a way out, the state
       of the spot is recorded as a side effect. No accusation anywhere in the flow. A plain
       panel, deliberately not FluentCard: fluent-card resolves its default 100% height against
       this stack to 0px and the whole panel collapses invisible (same quirk as the bell panel). *@
    @if (_blockedTarget is { } blocked)
    {
        <div class="form-panel">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                <FluentLabel Typo="Typography.Subject">@L["Parking_Blocked_Title", blocked.SpotCode]</FluentLabel>
                <FluentLabel Typo="Typography.Body">@L["Parking_Blocked_Text"]</FluentLabel>
                @* Mandatory proof: a photo of the blocked spot, ideally straight from the camera
                   (capture hint). The spot manager judges it before the apology voucher becomes
                   redeemable, and each picture can back exactly one report. *@
                <div>
                    <FluentLabel Typo="Typography.Body">@L["Parking_Blocked_PhotoLabel"]</FluentLabel>
                    <InputFile OnChange="OnBlockedPhotoSelectedAsync" accept="image/jpeg,image/png,image/webp"
                               capture="environment" class="parking-input" />
                    @if (_blockedPhotoError is not null)
                    {
                        <FluentLabel Typo="Typography.Body" Style="color:var(--error)">@L[_blockedPhotoError]</FluentLabel>
                    }
                    else if (_blockedPhoto is not null)
                    {
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                            @L["Parking_Blocked_PhotoAttached", _blockedPhotoName ?? string.Empty]
                        </FluentLabel>
                    }
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Blocked_PhotoHint"]</FluentLabel>
                </div>
                @* Optional: the plate of the blocking car — the driver is standing right at it,
                   and it lets the admin tell an employee from an outsider. *@
                <FluentTextField @bind-Value="_blockerPlate" Maxlength="16" Style="width:280px"
                                 Label="@L["Parking_Blocked_PlateLabel"]"
                                 Placeholder="@L["Parking_Blocked_PlatePlaceholder"]" />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                    <FluentButton Appearance="Appearance.Accent" Disabled="@(_blockedBusy || _blockedPhoto is null)"
                                  OnClick="() => ReportBlockedAsync(relocate: true)">@L["Parking_Blocked_Relocate"]</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" Disabled="@(_blockedBusy || _blockedPhoto is null)"
                                  OnClick="() => ReportBlockedAsync(relocate: false)">@L["Parking_Blocked_RecordOnly"]</FluentButton>
                    <FluentButton Appearance="Appearance.Stealth" Disabled="@_blockedBusy"
                                  OnClick="() => _blockedTarget = null">@L["Parking_Blocked_Back"]</FluentButton>
                </FluentStack>
            </FluentStack>
        </div>
    }

            <section class="reservations-panel">
                <div class="reservations-head">
                    <div class="section-head">
                        <FluentIcon Value="@(new Icons.Regular.Size20.CalendarLtr())" Color="Color.Accent" />
                        <span>@L["Parking_MyReservations"]</span>
                    </div>
                    @if (_myReservations is not null)
                    {
                        <div class="reservation-tabs" role="tablist" aria-label="@L["Parking_MyReservations"]">
                            @ReservationTab(ReservationView.Active, L["Parking_Reservations_TabActive"].Value, ActiveReservations.Count)
                            @ReservationTab(ReservationView.Future, L["Parking_Reservations_TabFuture"].Value, FutureReservations.Count)
                            @ReservationTab(ReservationView.History, L["Parking_Reservations_TabHistory"].Value, HistoryReservations.Count)
                        </div>
                    }
                </div>
                @if (_myReservations is null)
                {
                    <div class="loading"><FluentProgressRing /></div>
                }
                else if (_myReservations.Count == 0)
                {
                    <div class="empty-state">@L["Parking_NoReservations"]</div>
                }
                else if (VisibleReservations.Count == 0)
                {
                    <div class="empty-state">@ReservationEmptyText</div>
                }
                else
                {
                    <div class="reservations-table">
                        <FluentDataGrid Items="@VisibleReservations.AsQueryable()" TGridItem="ReservationDto"
                                        GridTemplateColumns="minmax(90px, .8fr) minmax(170px, 1.4fr) minmax(100px, .8fr) minmax(120px, 1fr) minmax(300px, auto)">
                            <PropertyColumn Property="@(r => r.SpotCode)" Title="@L["Parking_Spot"]" />
                            <TemplateColumn Title="@L["Parking_When"]">
                                @ReservationWhen(context)
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Parking_OffPeak"]">
                                @(context.IsOffPeak ? L["Parking_Yes"] : "—")
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Parking_Status"]">
                                <span class="reservation-status reservation-status--@context.Status">
                                    @L[$"Parking_State_{context.Status}"]
                                </span>
                            </TemplateColumn>
                            <TemplateColumn Align="Align.End">
                                @ReservationActions(context)
                            </TemplateColumn>
                        </FluentDataGrid>
                    </div>
                }
            </section>
        </main>

        @if (_ownedSpot is not null)
        {
            <aside class="reserve-side">
                <FluentCard Class="owned-spot-panel">
                    <div class="owned-spot">
                        <div class="resident-mode-tabs" role="tablist" aria-label="@L["Parking_Owned_ModeLabel"]">
                            @ResidentPanelTab(ResidentPanelMode.Today, L["Parking_Owned_ModeToday"].Value)
                            @ResidentPanelTab(ResidentPanelMode.Manage, L["Parking_Owned_ModeManage"].Value)
                        </div>

                        @if (_residentPanelMode == ResidentPanelMode.Today)
                        {
                        <div class="owned-spot__head">
                            <div class="owned-spot__title">
                                <span>@L["Parking_Owned_TodayTitle"]</span>
                                <strong>@_ownedSpot.Code</strong>
                                <span class="pill pill--type">@L[$"Parking_SpotType_{_ownedSpot.Type}"]</span>
                            </div>
                            <span class="owned-status">@L[$"Parking_OwnedState_{_ownedSpot.TodayState}"]</span>
                        </div>

                        @* The resident's right of first refusal: the auto-shared spot can still be
                           confirmed back as long as nobody booked it (the service withdraws any
                           waitlist hold), so the button stays past the cutoff too. *@
                        @if (_ownedSpot.TodayState == OwnedSpotDayState.Held || CanConfirmAutoShared)
                        {
                            <div class="owned-spot__quick">
                                <FluentButton Appearance="Appearance.Accent" Disabled="@_actionBusy" OnClick="ConfirmArrivalAsync">@L["Parking_Owned_Confirm"]</FluentButton>
                                <span class="owned-spot__quick-help">@ConfirmArrivalHelp</span>
                            </div>
                        }
                        else
                        {
                            <div class="owned-today-note">
                                <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="currentColor" />
                                <span>@ResidentParkingText</span>
                            </div>
                        }
                        }
                        else
                        {

                        <section class="resident-tools" aria-labelledby="resident-tools-title">
                            <div class="resident-tools__head">
                                <span class="resident-tools__eyebrow">@L["Parking_Owned_ResidentToolsEyebrow"]</span>
                                <strong id="resident-tools-title">@L["Parking_Owned_ResidentToolsTitle"]</strong>
                                <small>@L["Parking_Owned_ResidentToolsHint", _ownedSpot.Code]</small>
                            </div>

                        <details class="owned-section" open>
                            <summary class="owned-section__summary">
                                <span class="owned-section__label">
                                    <span>@L["Parking_Owned_ReleaseSection"]</span>
                                    @SmartHint("owned-release-hint", L["Parking_Owned_ReleaseHint"].Value, forceIcon: true)
                                </span>
                                <span class="owned-section__meta">+@_releasePreview @L["Parking_Points"]</span>
                            </summary>
                            <div class="owned-fields">
                                <div class="quick-range" role="group" aria-label="@L["Parking_Owned_QuickRelease"]">
                                    @ReleasePresetButton(ReleasePreset.Today, L["Parking_Owned_ReleaseToday"].Value)
                                    @ReleasePresetButton(ReleasePreset.Tomorrow, L["Parking_Owned_ReleaseTomorrow"].Value)
                                    @ReleasePresetButton(ReleasePreset.ThisWeek, L["Parking_Owned_ReleaseThisWeek"].Value)
                                </div>
                                <div class="field">
                                    <label>@L["Parking_Owned_ReleaseFrom"]</label>
                                    <input type="date" @bind="_releaseFrom" @bind:after="ReleaseRangeChangedAsync" class="parking-input" />
                                </div>
                                <div class="field">
                                    <label>@L["Parking_Owned_ReleaseTo"]</label>
                                    <input type="date" @bind="_releaseTo" @bind:after="ReleaseRangeChangedAsync" class="parking-input" />
                                </div>
                                <FluentButton Appearance="Appearance.Outline" Disabled="@_actionBusy" OnClick="ReleaseOwnedAsync">@L["Parking_Owned_Release"]</FluentButton>
                            </div>
                        </details>

                        @if (_ownedSpot.UpcomingReleases.Count > 0)
                        {
                            <details class="owned-section">
                                <summary class="owned-section__summary">
                                    <span class="owned-section__label">
                                        <span>@L["Parking_Owned_ReleasedDaysSection"]</span>
                                        @SmartHint("owned-reclaim-hint", L["Parking_Owned_ReclaimHint"].Value, forceIcon: true)
                                    </span>
                                </summary>
                                <div class="release-calendar">
                                    @foreach (var day in _ownedSpot.UpcomingReleases)
                                    {
                                        var dayLabel = CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(day.Date.DayOfWeek);
                                        <span class="release-calendar__day @(day.TakenByGuest ? "release-calendar__day--taken" : null)"
                                              title="@ReleaseDayTitle(day)">
                                            <strong>@day.Date.ToString("d. M.")</strong>
                                            <small>@dayLabel</small>
                                        </span>
                                    }
                                </div>
                                <div class="owned-fields">
                                    <div class="field">
                                        <label>@L["Parking_Owned_ReclaimFrom"]</label>
                                        <input type="date" @bind="_reclaimFrom" class="parking-input" />
                                    </div>
                                    <div class="field">
                                        <label>@L["Parking_Owned_ReclaimTo"]</label>
                                        <input type="date" @bind="_reclaimTo" class="parking-input" />
                                    </div>
                                    <FluentButton Appearance="Appearance.Outline" Disabled="@_actionBusy" OnClick="ReclaimOwnedAsync">@L["Parking_Owned_Reclaim"]</FluentButton>
                                </div>
                            </details>
                        }

                        <details class="owned-section">
                            <summary class="owned-section__summary">
                                <span class="owned-section__label">
                                    <span>@L["Parking_Owned_QuotaSection"]</span>
                                    @SmartHint("owned-quota-hint", L["Parking_Owned_AllowanceHint"].Value, forceIcon: true)
                                </span>
                            </summary>
                            <div class="owned-fields owned-fields--allowance">
                                <FluentNumberField TValue="int" @bind-Value="_allowance" Min="0" Max="@_ownedSpot.MaxShareAllowance.ToString()"
                                                   Label="@L["Parking_Owned_Allowance"]" />
                                <FluentButton Disabled="@_actionBusy" OnClick="SaveAllowanceAsync">@L["Parking_Owned_SaveAllowance"]</FluentButton>
                            </div>
                        </details>

                        @* Standing usage plan: the days kept are the resident's, the rest are released ahead
                           of time by the maintenance loop — which is what earns the full advance-notice
                           reward instead of the same-day auto-share paying nothing. *@
                        <details class="owned-section">
                            <summary class="owned-section__summary">
                                <span class="owned-section__label">
                                    <span>@L["Parking_Owned_PlanSection"]</span>
                                    @SmartHint("owned-plan-hint", L["Parking_Owned_PlanHint", _ownedSpot.PlanHorizonDays].Value, forceIcon: true)
                                </span>
                            </summary>
                            <div class="plan-days">
                                @foreach (var (flag, label) in PlanWeekdays)
                                {
                                    <FluentButton Appearance="@(_planDays.HasFlag(flag) ? Appearance.Accent : Appearance.Outline)"
                                                  Disabled="@_actionBusy" OnClick="() => TogglePlanDay(flag)">@label</FluentButton>
                                }
                            </div>
                            <div class="owned-plan-actions">
                                <FluentSwitch @bind-Value="_planAutoRelease" Label="@L["Parking_Owned_PlanAutoRelease"]" />
                                <FluentButton Disabled="@_actionBusy" OnClick="SaveUsagePlanAsync">@L["Parking_Owned_SavePlan"]</FluentButton>
                            </div>
                        </details>
                        </section>
                        }
                    </div>
                </FluentCard>
            </aside>
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Guid _userId;
    private DateOnly _day = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly _startTime = new(8, 0);
    private TimeOnly _endTime = new(17, 0);

    private bool _actionBusy;
    private bool _preferencesLoaded;
    private bool _highlightSearch;
    private ElementReference _dateInput;

    private IReadOnlyList<ParkingSpotDto>? _available;
    private ReservationQuoteDto? _quote;
    private IReadOnlyList<ReservationDto>? _myReservations;
    private ReservationView _reservationView = ReservationView.Future;
    private ResidentPanelMode _residentPanelMode = ResidentPanelMode.Today;
    private string _spotTypeFilter = string.Empty;
    private AvailableSort _availableSort = AvailableSort.Recommended;
    private ReleasePreset _releasePreset = ReleasePreset.Today;

    private enum AvailableSort
    {
        Recommended,
        Code,
        Type,
    }

    private enum ReleasePreset
    {
        Custom,
        Today,
        Tomorrow,
        ThisWeek,
    }

    private sealed record SpotGroup(string Label, IReadOnlyList<ParkingSpotDto> Spots);

    private sealed record ParkingReservePreferences(
        string StartTime,
        string EndTime,
        string SpotTypeFilter,
        string Sort);

    private static readonly IComparer<string> SpotCodeComparer =
        Comparer<string>.Create(CompareSpotCodes);

    private string PreferencesStorageKey => $"parking.reserve.preferences.{_userId}";

    private static readonly ParkingSpotType[] ReservableSpotTypes =
        Enum.GetValues<ParkingSpotType>().Where(type => type != ParkingSpotType.Visitor).ToArray();

    private int AvailableTotal => BookableAvailableSpots.Count();

    private ParkingSpotDto? RecommendedAvailableSpot =>
        FilteredAvailableSpots
            .OrderByDescending(PointsForSpot)
            .ThenBy(spot => spot.Code, SpotCodeComparer)
            .FirstOrDefault();

    private IReadOnlyList<SpotGroup> AvailableSpotGroups =>
        VisibleAvailableSpots
            .GroupBy(SpotGroupLabel)
            .OrderBy(group => group.Key, SpotCodeComparer)
            .Select(group => new SpotGroup(group.Key, group.ToList()))
            .ToList();

    private IEnumerable<ParkingSpotDto> FilteredAvailableSpots
    {
        get
        {
            IEnumerable<ParkingSpotDto> spots = BookableAvailableSpots;
            if (Enum.TryParse<ParkingSpotType>(_spotTypeFilter, out var selectedType))
            {
                spots = spots.Where(spot => spot.Type == selectedType);
            }

            return spots;
        }
    }

    private IEnumerable<ParkingSpotDto> BookableAvailableSpots
    {
        get
        {
            IEnumerable<ParkingSpotDto> spots = _available ?? [];
            if (_ownedSpot is { } ownedSpot)
            {
                spots = spots.Where(spot => spot.Id != ownedSpot.SpotId);
            }

            return spots;
        }
    }

    private IReadOnlyList<ParkingSpotDto> VisibleAvailableSpots
    {
        get
        {
            var spots = FilteredAvailableSpots;
            return (_availableSort switch
            {
                AvailableSort.Code => spots.OrderBy(spot => spot.Code, SpotCodeComparer),
                AvailableSort.Type => spots.OrderBy(spot => L[$"Parking_SpotType_{spot.Type}"].Value)
                    .ThenBy(spot => spot.Code, SpotCodeComparer),
                _ => spots.OrderByDescending(PointsForSpot)
                    .ThenBy(spot => spot.Code, SpotCodeComparer),
            }).ToList();
        }
    }

    private string SpotGroupLabel(ParkingSpotDto spot)
    {
        var code = spot.Code.Trim();
        var dash = code.LastIndexOf('-');
        if (dash > 0 && dash < code.Length - 1 && code[(dash + 1)..].All(char.IsDigit))
        {
            return code[..dash];
        }

        return string.IsNullOrWhiteSpace(code) ? L["Parking_Group_Other"].Value : code;
    }

    private static int CompareSpotCodes(string? left, string? right)
    {
        if (ReferenceEquals(left, right))
        {
            return 0;
        }

        if (left is null)
        {
            return -1;
        }

        if (right is null)
        {
            return 1;
        }

        var l = 0;
        var r = 0;
        while (l < left.Length && r < right.Length)
        {
            var lc = left[l];
            var rc = right[r];
            if (char.IsDigit(lc) && char.IsDigit(rc))
            {
                var lStart = l;
                var rStart = r;
                while (l < left.Length && char.IsDigit(left[l])) l++;
                while (r < right.Length && char.IsDigit(right[r])) r++;

                var lTrim = lStart;
                var rTrim = rStart;
                while (lTrim < l && left[lTrim] == '0') lTrim++;
                while (rTrim < r && right[rTrim] == '0') rTrim++;

                var lDigits = l - lTrim;
                var rDigits = r - rTrim;
                var lengthCompare = lDigits.CompareTo(rDigits);
                if (lengthCompare != 0)
                {
                    return lengthCompare;
                }

                for (var i = 0; i < lDigits; i++)
                {
                    var digitCompare = left[lTrim + i].CompareTo(right[rTrim + i]);
                    if (digitCompare != 0)
                    {
                        return digitCompare;
                    }
                }

                var zeroCompare = (l - lStart).CompareTo(r - rStart);
                if (zeroCompare != 0)
                {
                    return zeroCompare;
                }

                continue;
            }

            var charCompare = char.ToUpperInvariant(lc).CompareTo(char.ToUpperInvariant(rc));
            if (charCompare != 0)
            {
                return charCompare;
            }

            l++;
            r++;
        }

        return (left.Length - l).CompareTo(right.Length - r);
    }

    private enum ReservationView
