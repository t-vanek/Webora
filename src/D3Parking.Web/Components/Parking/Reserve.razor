    // site's time zone before being sent as the UTC instants the window is stored and compared in.
    private DateTimeOffset Start => SiteTime.At(_day, _startTime, _tz);
    private DateTimeOffset End => SiteTime.At(_day, _endTime, _tz);
    private bool IsOffPeak => _policy?.IsOffPeak(Start, _tz) ?? false;
    private TimeSpan SearchDuration => End > Start ? End - Start : TimeSpan.FromHours(1);

