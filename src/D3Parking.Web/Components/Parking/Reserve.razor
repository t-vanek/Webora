@page "/parking"
@attribute [HasPermission(Permissions.Parking.Reserve)]
@rendermode InteractiveServer
@using System.Globalization
@using D3Parking.Application.Parking.Maps
@inject IReservationService Reservations
@inject ILotMapService Maps
@inject IParkingSettingsService ParkingSettings
@inject IResidentSpotService ResidentSpots
@inject IUserLocationService UserLocation
@inject ISiteSettingsService SiteSettings
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Parking_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <FluentLabel Typo="Typography.PageTitle">@L["Parking_Title"]</FluentLabel>
    <FluentLabel Typo="Typography.Body">@L["Parking_Intro"]</FluentLabel>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">
            @L[_error]
        </FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">
            @L[_info]
        </FluentMessageBar>
    }
    @* Outcome of the "I can't park" flow — pre-localized (carries the replacement spot code). *@
    @if (_blockedMessage is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">
            @_blockedMessage
        </FluentMessageBar>
    }

    @* Apology voucher for a blocked spot: one reservation free, peak included. Redeemed by
       ticking the box before booking; a timely cancel gives it back. A voucher still awaiting
       the spot manager's review is shown, but cannot be redeemed yet. *@
    @if (_voucher is { } voucher)
    {
        <div class="form-panel">
            @if (voucher.Status == ApologyVoucherStatus.Approved)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
                    <FluentLabel Typo="Typography.Body">@L["Parking_Voucher_Available", Local(voucher.ExpiresAtUtc, "d")]</FluentLabel>
                    <FluentCheckbox @bind-Value="_useVoucher">@L["Parking_Voucher_Use"]</FluentCheckbox>
                </FluentStack>
            }
            else
            {
                <FluentLabel Typo="Typography.Body">@L["Parking_Voucher_Pending"]</FluentLabel>
            }
        </div>
    }

    @if (_ownedSpot is not null)
    {
        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                <FluentLabel Typo="Typography.Subject">@L["Parking_Owned_Title"]</FluentLabel>
                <FluentLabel Typo="Typography.H5">@_ownedSpot.Code (@L[$"Parking_SpotType_{_ownedSpot.Type}"])</FluentLabel>
                <FluentLabel Typo="Typography.Body">
                    @L["Parking_Status"]: @L[$"Parking_OwnedState_{_ownedSpot.TodayState}"]
                </FluentLabel>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                    @* The resident's right of first refusal: the auto-shared spot can still be
                       confirmed back as long as nobody booked it (the service withdraws any
                       waitlist hold), so the button stays past the cutoff too. *@
                    @if (_ownedSpot.TodayState == OwnedSpotDayState.Held || CanConfirmAutoShared)
                    {
                        <FluentButton Appearance="Appearance.Accent" Disabled="@_actionBusy" OnClick="ConfirmArrivalAsync">@L["Parking_Owned_Confirm"]</FluentButton>
                    }
                    <div>
                        <FluentLabel Typo="Typography.Body">@L["Parking_Owned_ReleaseFrom"]</FluentLabel>
                        <input type="date" @bind="_releaseFrom" @bind:after="RefreshReleasePreviewAsync" class="parking-input" />
                    </div>
                    <div>
                        <FluentLabel Typo="Typography.Body">@L["Parking_Owned_ReleaseTo"]</FluentLabel>
                        <input type="date" @bind="_releaseTo" @bind:after="RefreshReleasePreviewAsync" class="parking-input" />
                    </div>
                    <FluentButton Appearance="Appearance.Outline" Disabled="@_actionBusy" OnClick="ReleaseOwnedAsync">@L["Parking_Owned_Release"]</FluentButton>
                </FluentStack>
                @if (CanConfirmAutoShared)
                {
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Owned_AutoShareReclaimHint"]</FluentLabel>
                }
                <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                    @L["Parking_Owned_ReleaseHint"] +@_releasePreview @L["Parking_Points"]
                </FluentLabel>

                @if (_ownedSpot.UpcomingReleases.Count > 0)
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Wrap="true" VerticalAlignment="VerticalAlignment.Center">
                            <FluentLabel Typo="Typography.Body">@L["Parking_Owned_ReleasedDays"]:</FluentLabel>
                            @foreach (var day in _ownedSpot.UpcomingReleases)
                            {
                                <span class="pill @(day.TakenByGuest ? "pill--peak" : "pill--offpeak")">
                                    @day.Date.ToString("d. M.")@(day.TakenByGuest ? $" {L["Parking_Owned_DayTaken"]}" : null)
                                </span>
                            }
                        </FluentStack>
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                            <div>
                                <FluentLabel Typo="Typography.Body">@L["Parking_Owned_ReclaimFrom"]</FluentLabel>
                                <input type="date" @bind="_reclaimFrom" class="parking-input" />
                            </div>
                            <div>
                                <FluentLabel Typo="Typography.Body">@L["Parking_Owned_ReclaimTo"]</FluentLabel>
                                <input type="date" @bind="_reclaimTo" class="parking-input" />
                            </div>
                            <FluentButton Appearance="Appearance.Outline" Disabled="@_actionBusy" OnClick="ReclaimOwnedAsync">@L["Parking_Owned_Reclaim"]</FluentButton>
                        </FluentStack>
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Owned_ReclaimHint"]</FluentLabel>
                    </FluentStack>
                }

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                    <FluentNumberField TValue="int" @bind-Value="_allowance" Min="0" Max="@_ownedSpot.MaxShareAllowance.ToString()"
                                       Label="@L["Parking_Owned_Allowance"]" />
                    <FluentButton Disabled="@_actionBusy" OnClick="SaveAllowanceAsync">@L["Parking_Owned_SaveAllowance"]</FluentButton>
                </FluentStack>

                @* Standing usage plan: the days kept are the resident's, the rest are released ahead
                   of time by the maintenance loop — which is what earns the full advance-notice
                   reward instead of the same-day auto-share paying nothing. *@
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentLabel Typo="Typography.Body">@L["Parking_Owned_PlanDays"]</FluentLabel>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Wrap="true">
                        @foreach (var (flag, label) in PlanWeekdays)
                        {
                            <FluentButton Appearance="@(_planDays.HasFlag(flag) ? Appearance.Accent : Appearance.Outline)"
                                          Disabled="@_actionBusy" OnClick="() => TogglePlanDay(flag)">@label</FluentButton>
                        }
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true" VerticalAlignment="VerticalAlignment.Center">
                        <FluentSwitch @bind-Value="_planAutoRelease" Label="@L["Parking_Owned_PlanAutoRelease"]" />
                        <FluentButton Disabled="@_actionBusy" OnClick="SaveUsagePlanAsync">@L["Parking_Owned_SavePlan"]</FluentButton>
                    </FluentStack>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                        @L["Parking_Owned_PlanHint", _ownedSpot.PlanHorizonDays]
                    </FluentLabel>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    }

    <FluentCard Class="booking-bar">
        <div class="section-head">
            <FluentIcon Value="@(new Icons.Regular.Size20.CalendarClock())" Color="Color.Accent" />
            <span>@L["Parking_FindTitle"]</span>
        </div>
        <div class="booking-bar__row">
            <div class="field">
                <label>@L["Parking_Date"]</label>
                <input type="date" @bind="_day" @bind:after="InvalidateSearch" class="parking-input" />
            </div>
            <div class="field">
                <label>@L["Parking_From"]</label>
                <input type="time" @bind="_startTime" @bind:after="InvalidateSearch" class="parking-input" />
            </div>
            <div class="field">
                <label>@L["Parking_To"]</label>
                <input type="time" @bind="_endTime" @bind:after="InvalidateSearch" class="parking-input" />
            </div>
            <FluentButton Appearance="Appearance.Accent" OnClick="() => FindAvailableAsync()">@L["Parking_Find"]</FluentButton>
        </div>

        @if (_quote is not null)
        {
            <div class="quote-panel">
                <div class="price-tag">
                    <span class="price-tag__num">@_quote.Cost</span>
                    <span class="price-tag__unit">@L["Parking_Credits"]</span>
                </div>
                <span class="pill @(_quote.IsPeak ? "pill--peak" : "pill--offpeak")">
                    @(_quote.IsPeak ? L["Parking_Peak"] : L["Parking_OffPeakLabel"])
                </span>
                <div class="quote-meter">
                    <div class="quote-meter__head">
                        <span>@L["Parking_Occupancy"]</span>
                        <span>@_quote.OccupancyPercent %</span>
                    </div>
                    <div class="meter"><div class="meter__fill @OccupancyClass(_quote.OccupancyPercent)" style="width:@(_quote.OccupancyPercent)%"></div></div>
                </div>
                <span class="balance-chip @(_quote.Affordable ? "balance-chip--ok" : "balance-chip--low")">
                    @L["Parking_Balance"]: <strong>@_quote.Balance</strong> @L["Parking_Credits"]
                </span>
            </div>
            @if (!_quote.Affordable)
            {
                <FluentLabel Typo="Typography.Body" Style="color:var(--error)">@L["Parking_Error_InsufficientCredit"]</FluentLabel>
            }
        }
    </FluentCard>

    @if (_available is not null)
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
            <FluentLabel Typo="Typography.Subject">@L["Parking_Available"]</FluentLabel>
            @* Offered only once a plan is published. The list is never taken away: it is what works
               on a phone, what a screen reader reads, and what is left when the drawing is wrong. *@
            @if (_map is not null)
            {
                <div class="map-toolbar__group" role="group" aria-label="@L["Lot_View"]">
                    <FluentButton Id="reserve-view-list" Appearance="@(_mapView ? Appearance.Outline : Appearance.Accent)"
                                  aria-pressed="@(_mapView ? "false" : "true")"
                                  OnClick="() => _mapView = false">@L["Parking_View_List"]</FluentButton>
                    <FluentButton Id="reserve-view-map" Appearance="@(_mapView ? Appearance.Accent : Appearance.Outline)"
                                  aria-pressed="@(_mapView ? "true" : "false")"
                                  OnClick="() => _mapView = true">@L["Lot_View_Map"]</FluentButton>
                </div>
            }
        </FluentStack>

        @if (_mapView && _map is not null)
        {
            <div class="map-legend">
                <span class="map-legend__item"><span class="map-legend__swatch map-legend__swatch--free"></span>@L["Parking_Map_Free"]</span>
                <span class="map-legend__item"><span class="map-legend__swatch map-legend__swatch--taken"></span>@L["Parking_Map_Taken"]</span>
                <span class="map-legend__item"><span class="map-legend__swatch map-legend__swatch--other"></span>@L["Parking_Map_Other"]</span>
            </div>
            <LotMapView Map="_map"
                        StateOf="MapStateOf"
                        TitleOf="MapTitleOf"
                        Interactive="MapInteractive"
                        OnSpotSelected="ReserveAsync"
                        AriaLabel="@L["Parking_Map_Label"]"
                        ZoomInLabel="@L["Map_ZoomIn"]"
                        ZoomOutLabel="@L["Map_ZoomOut"]"
                        FitLabel="@L["Map_FitView"]" />
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">@L["Parking_Map_Hint"]</FluentLabel>
            @if (_available.Count == 0)
            {
                @* The way out of a full lot has to be on this view too, or switching to the map
                   quietly hides it. *@
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
                    <FluentLabel Typo="Typography.Body">@L["Parking_NoneAvailable"]</FluentLabel>
                    <FluentButton Appearance="Appearance.Accent" Disabled="@_actionBusy" OnClick="JoinQueueAsync">@L["Parking_Queue_JoinFull"]</FluentButton>
                </FluentStack>
            }
        }
        else if (_available.Count == 0)
        {
            <div class="empty-state">
                <FluentIcon Value="@(new Icons.Regular.Size32.VehicleCar())" Color="Color.Neutral" />
                <FluentLabel Typo="Typography.Body">@L["Parking_NoneAvailable"]</FluentLabel>
                <FluentButton Appearance="Appearance.Accent" Disabled="@_actionBusy" OnClick="JoinQueueAsync">@L["Parking_Queue_JoinFull"]</FluentButton>
            </div>
        }
        else
        {
            <div class="spot-grid">
                @foreach (var spot in _available)
                {
                    <div class="spot-card spot-card--@spot.Type">
                        <div class="spot-card__top">
                            <span class="spot-glyph"><FluentIcon Value="@(new Icons.Regular.Size24.VehicleCar())" Color="Color.Accent" /></span>
                            <div>
                                <div class="spot-card__code">@spot.Code</div>
                                <span class="pill pill--type">@L[$"Parking_SpotType_{spot.Type}"]</span>
                            </div>
                        </div>
                        @if (_quote is not null)
                        {
                            <div class="spot-card__price"><strong>@_quote.Cost</strong> @L["Parking_Credits"]</div>
                        }
                        @if (PointsForSpot(spot) > 0)
                        {
                            <span class="reward-chip">@L["Parking_Earn"] +@PointsForSpot(spot) @L["Parking_Points"]</span>
                        }
                        <FluentButton Appearance="Appearance.Accent" Style="width:100%"
                                      Disabled="@(_actionBusy || (_quote is not null && !_quote.Affordable))"
                                      OnClick="() => ReserveAsync(spot.Id)">
                            @L["Parking_Reserve"]
                        </FluentButton>
                    </div>
                }
            </div>
        }
    }

    @if (_myQueue is { Count: > 0 })
    {
        <FluentLabel Typo="Typography.Subject">@L["Parking_Queue_MyQueue"]</FluentLabel>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            @foreach (var q in _myQueue)
            {
                <FluentCard>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Wrap="true" VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Body">
                            @Local(q.StartUtc, "g") – @Local(q.EndUtc, "t")
                        </FluentLabel>
                        <FluentBadge Appearance="Appearance.Accent">@L[$"Parking_QueueState_{q.Status}"]</FluentBadge>
                        @if (q.Status == QueueEntryStatus.Offered)
                        {
                            <FluentLabel Typo="Typography.Body" Style="color: var(--success);">
                                @L["Parking_Queue_OfferedSpot"]: <strong>@q.OfferedSpotCode</strong>
                            </FluentLabel>
                            <FluentButton Appearance="Appearance.Accent" Disabled="@_actionBusy" OnClick="() => ClaimQueueAsync(q.Id)">@L["Parking_Queue_Claim"]</FluentButton>
                        }
                        else
                        {
                            <FluentLabel Typo="Typography.Body">@L["Parking_Queue_Position"]: @q.Position</FluentLabel>
                        }
                        <FluentButton Appearance="Appearance.Stealth" Disabled="@_actionBusy" OnClick="() => LeaveQueueAsync(q.Id)">@L["Parking_Queue_Leave"]</FluentButton>
                    </FluentStack>
                </FluentCard>
            }
        </FluentStack>
    }

    @* "I can't park" panel: helper framing on purpose — the driver asks for a way out, the state
       of the spot is recorded as a side effect. No accusation anywhere in the flow. A plain
       panel, deliberately not FluentCard: fluent-card resolves its default 100% height against
       this stack to 0px and the whole panel collapses invisible (same quirk as the bell panel). *@
    @if (_blockedTarget is { } blocked)
    {
        <div class="form-panel">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                <FluentLabel Typo="Typography.Subject">@L["Parking_Blocked_Title", blocked.SpotCode]</FluentLabel>
                <FluentLabel Typo="Typography.Body">@L["Parking_Blocked_Text"]</FluentLabel>
                @* Mandatory proof: a photo of the blocked spot, ideally straight from the camera
                   (capture hint). The spot manager judges it before the apology voucher becomes
                   redeemable, and each picture can back exactly one report. *@
                <div>
                    <FluentLabel Typo="Typography.Body">@L["Parking_Blocked_PhotoLabel"]</FluentLabel>
                    <InputFile OnChange="OnBlockedPhotoSelectedAsync" accept="image/jpeg,image/png,image/webp"
                               capture="environment" class="parking-input" />
                    @if (_blockedPhotoError is not null)
                    {
                        <FluentLabel Typo="Typography.Body" Style="color:var(--error)">@L[_blockedPhotoError]</FluentLabel>
                    }
                    else if (_blockedPhoto is not null)
                    {
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                            @L["Parking_Blocked_PhotoAttached", _blockedPhotoName ?? string.Empty]
                        </FluentLabel>
                    }
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Blocked_PhotoHint"]</FluentLabel>
                </div>
                @* Optional: the plate of the blocking car — the driver is standing right at it,
                   and it lets the admin tell an employee from an outsider. *@
                <FluentTextField @bind-Value="_blockerPlate" Maxlength="16" Style="width:280px"
                                 Label="@L["Parking_Blocked_PlateLabel"]"
                                 Placeholder="@L["Parking_Blocked_PlatePlaceholder"]" />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                    <FluentButton Appearance="Appearance.Accent" Disabled="@(_blockedBusy || _blockedPhoto is null)"
                                  OnClick="() => ReportBlockedAsync(relocate: true)">@L["Parking_Blocked_Relocate"]</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" Disabled="@(_blockedBusy || _blockedPhoto is null)"
                                  OnClick="() => ReportBlockedAsync(relocate: false)">@L["Parking_Blocked_RecordOnly"]</FluentButton>
                    <FluentButton Appearance="Appearance.Stealth" Disabled="@_blockedBusy"
                                  OnClick="() => _blockedTarget = null">@L["Parking_Blocked_Back"]</FluentButton>
                </FluentStack>
            </FluentStack>
        </div>
    }

    <FluentLabel Typo="Typography.Subject">@L["Parking_MyReservations"]</FluentLabel>
    @if (_myReservations is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else if (_myReservations.Count == 0)
    {
        <div class="empty-state">@L["Parking_NoReservations"]</div>
    }
    else
    {
        <FluentDataGrid Items="@_myReservations.AsQueryable()" TGridItem="ReservationDto"
                        GridTemplateColumns="1fr 2fr 1fr 1fr auto">
            <PropertyColumn Property="@(r => r.SpotCode)" Title="@L["Parking_Spot"]" />
            <TemplateColumn Title="@L["Parking_When"]">
                @Local(context.StartUtc, "g") – @Local(context.EndUtc, "t")
            </TemplateColumn>
            <TemplateColumn Title="@L["Parking_OffPeak"]">
                @(context.IsOffPeak ? L["Parking_Yes"] : "—")
            </TemplateColumn>
            <TemplateColumn Title="@L["Parking_Status"]">
                @L[$"Parking_State_{context.Status}"]
            </TemplateColumn>
            <TemplateColumn Align="Align.End">
                @if (context.Status == ReservationStatus.Reserved)
                {
                    <FluentButton OnClick="() => CheckInAsync(context.Id)" Disabled="@_actionBusy" Appearance="Appearance.Outline">@L["Parking_CheckIn"]</FluentButton>
                    <FluentButton OnClick="() => ReleaseAsync(context.Id)" Disabled="@_actionBusy" Appearance="Appearance.Outline">@L["Parking_Release"]</FluentButton>
                    <FluentButton OnClick="() => CancelAsync(context.Id)" Disabled="@_actionBusy" Appearance="Appearance.Stealth">@L["Parking_Cancel"]</FluentButton>
                    @if (CanReportBlocked(context))
                    {
                        <FluentButton OnClick="() => OpenBlockedPanel(context)" Appearance="Appearance.Stealth">@L["Parking_CantPark"]</FluentButton>
                    }
                    @* The download attribute keeps Blazor's router from intercepting the click,
                       so the .ics streams straight from the endpoint. *@
                    <FluentAnchor Href="@($"api/parking/reservations/{context.Id}/calendar")"
                                  Download="@($"parkovani-{context.SpotCode}.ics")"
                                  Appearance="Appearance.Stealth">@L["Parking_AddToCalendar"]</FluentAnchor>
                }
                else if (context.Status == ReservationStatus.CheckedIn)
                {
                    <FluentButton OnClick="() => CompleteAsync(context.Id)" Disabled="@_actionBusy" Appearance="Appearance.Accent">@L["Parking_Complete"]</FluentButton>
                    <FluentAnchor Href="@($"api/parking/reservations/{context.Id}/calendar")"
                                  Download="@($"parkovani-{context.SpotCode}.ics")"
                                  Appearance="Appearance.Stealth">@L["Parking_AddToCalendar"]</FluentAnchor>
                }
            </TemplateColumn>
        </FluentDataGrid>
        @* Hand-rolled rather than <FluentPaginator>: that one drives PaginationState, which exposes no
           page-change hook — it is built for a grid paging an IQueryable client-side. Here the paging
           happens in SQL, so the buttons have to call back into the component. *@
        @if (_reservationTotal > ReservationPageSize)
        {
            <div class="pager">
                <FluentButton Appearance="Appearance.Outline" Disabled="@(_reservationPageIndex == 0)"
                              OnClick="() => GoToReservationPageAsync(_reservationPageIndex - 1)">@L["Common_PrevPage"]</FluentButton>
                <span>@L["Common_PageOf", _reservationPageIndex + 1, ReservationPageCount]</span>
                <FluentButton Appearance="Appearance.Outline" Disabled="@(_reservationPageIndex >= ReservationPageCount - 1)"
                              OnClick="() => GoToReservationPageAsync(_reservationPageIndex + 1)">@L["Common_NextPage"]</FluentButton>
            </div>
        }
    }
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Guid _userId;
    private DateOnly _day = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly _startTime = new(8, 0);
    private TimeOnly _endTime = new(17, 0);

    private bool _actionBusy;

    private IReadOnlyList<ParkingSpotDto>? _available;
    private ReservationQuoteDto? _quote;
    private IReadOnlyList<ReservationDto>? _myReservations;

    // Paged in SQL. The unpaged read stops at 200 rows without saying so, which for a long-serving
    // driver means their older bookings simply are not there.
    private const int ReservationPageSize = 20;
    private int _reservationPageIndex;
    private int _reservationTotal;

    private int ReservationPageCount =>
        _reservationTotal == 0 ? 1 : (_reservationTotal + ReservationPageSize - 1) / ReservationPageSize;
    private IReadOnlyList<QueueEntryDto>? _myQueue;
    private string? _error;
    private string? _info;

    private OwnedSpotDto? _ownedSpot;
    private DateTime _releaseFrom = DateTime.Today;
    private DateTime _releaseTo = DateTime.Today;
    private DateTime _reclaimFrom = DateTime.Today;
    private DateTime _reclaimTo = DateTime.Today;
    private int _allowance;
    private int _releasePreview;
    private Weekday _planDays = Weekday.Workdays;
    private bool _planAutoRelease;

    // Monday-first, labelled from the request culture's own abbreviations — a plan editor needs no
    // resource string per weekday.
    private static readonly (Weekday Flag, DayOfWeek Day)[] PlanWeekdayOrder =
    [
        (Weekday.Monday, DayOfWeek.Monday), (Weekday.Tuesday, DayOfWeek.Tuesday),
        (Weekday.Wednesday, DayOfWeek.Wednesday), (Weekday.Thursday, DayOfWeek.Thursday),
        (Weekday.Friday, DayOfWeek.Friday), (Weekday.Saturday, DayOfWeek.Saturday),
        (Weekday.Sunday, DayOfWeek.Sunday),
    ];

    private static IEnumerable<(Weekday Flag, string Label)> PlanWeekdays =>
        PlanWeekdayOrder.Select(entry => (entry.Flag,
            CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(entry.Day)));

    private void TogglePlanDay(Weekday flag) =>
        _planDays = _planDays.HasFlag(flag) ? _planDays & ~flag : _planDays | flag;

    // Past the cutoff the spot auto-shares, but until a guest books it the resident can still
    // confirm it back — their right of first refusal (a released day goes through Reclaim instead).
    private bool CanConfirmAutoShared =>
        _ownedSpot is { TodayState: OwnedSpotDayState.SharedFree, ReleasedToday: false };

    private IncentivePolicy? _policy;
    private double? _distanceKm;

    private TimeZoneInfo _tz = TimeZoneInfo.Utc;

    // The picked date and time are local wall-clock at the lot, so they are resolved through the
    // site's time zone before being sent as the UTC instants the window is stored and compared in.
    private DateTimeOffset Start => SiteTime.At(_day, _startTime, _tz);
    private DateTimeOffset End => SiteTime.At(_day, _endTime, _tz);
    private bool IsOffPeak => _policy?.IsOffPeak(Start, _tz) ?? false;

    /// <summary>Renders a stored UTC instant as local wall-clock at the lot.</summary>
    private string Local(DateTimeOffset utc, string format) =>
        TimeZoneInfo.ConvertTime(utc, _tz).ToString(format);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        // UserManager stays on its own: it runs on the scoped Identity DbContext. Everything below
        // goes through IDbContextFactory and gets a fresh context per call, which is exactly what
        // makes issuing those calls together safe — and on a remote database it turns a chain of
        // round trips, all of which the prerender waits for, into one.
        var user = await UserManager.GetUserAsync(state.User);
        _userId = user?.Id ?? Guid.Empty;

        var policy = ParkingSettings.GetPolicyAsync();
        var timeZone = SiteSettings.GetTimeZoneAsync();
        await Task.WhenAll(policy, timeZone);
        _policy = policy.Result;
        _tz = timeZone.Result;

        // Re-seed the date defaults now that the site time zone is known: the field initializers
        // used the server's clock, and around midnight a UTC-hosted server would preselect the
        // wrong local day for the lot.
        _day = SiteTime.Today(DateTimeOffset.UtcNow, _tz);
        _releaseFrom = _day.ToDateTime(TimeOnly.MinValue);
        _releaseTo = _releaseFrom;
        _reclaimFrom = _releaseFrom;
        _reclaimTo = _releaseFrom;

        // Four independent reads. Each writes its own fields, and their continuations are serialised
        // by the renderer's dispatcher, so there is nothing to race over.
        var home = UserLocation.GetHomeAsync(_userId);
        await Task.WhenAll(home, ReloadOwnedSpotAsync(), ReloadReservationsAsync(), ReloadQueueAsync());
        _distanceKm = home.Result.Verified ? home.Result.DistanceKm : null;

        // The published plan, if there is one. Geometry only — which stalls are free comes from the
        // search, so this is read once and never again.
        _map = await Maps.GetPublishedAsync();
    }

    /// <summary>The published drawing of the lot, or null while nobody has published one.</summary>
    private LotMapDetailDto? _map;

    /// <summary>Whether the results are shown as the plan rather than as cards.</summary>
    private bool _mapView;

    /// <summary>
    /// What the last search found, by spot — the map's whole notion of "free". Rebuilt whenever the
    /// list it comes from is replaced, rather than invalidated by hand: the search is cleared from
    /// three different places, and a lookup that has to be remembered at each of them is a lookup
    /// that will one day colour the map with the previous window.
    /// </summary>
    private HashSet<Guid> AvailableIds
    {
        get
        {
            if (!ReferenceEquals(_availableIdsSource, _available))
            {
                _availableIdsSource = _available;
                _availableIds = _available?.Select(s => s.Id).ToHashSet() ?? [];
            }

            return _availableIds;
        }
    }

    private IReadOnlyList<ParkingSpotDto>? _availableIdsSource;
    private HashSet<Guid> _availableIds = [];

    /// <summary>
    /// Every shape the map draws for a spot is one of ours — that is what the link means — so the
    /// only question left is whether the search found it free for the window that was asked about.
    /// The stalls of other tenants have no link and never reach here; they stay context.
    /// </summary>
    private string? MapStateOf(Guid spotId) => AvailableIds.Contains(spotId) ? "Free" : "Taken";

    /// <summary>
    /// Only what is free can be booked, and only under the same conditions the list's button obeys:
    /// nothing in flight, and the window affordable.
    /// </summary>
    private bool MapInteractive(Guid spotId) =>
        AvailableIds.Contains(spotId) && !_actionBusy && (_quote is null || _quote.Affordable);

    private string MapTitleOf(Guid spotId)
    {
        // The code and type come off the shape itself (the map denormalizes them), so a stall that
        // is taken — and therefore absent from the search — can still say what it is.
        var shape = _map?.Shapes.FirstOrDefault(sh => sh.ParkingSpotId == spotId);
        var parts = new List<string> { shape?.SpotCode ?? shape?.Label ?? string.Empty };
        if (shape?.SpotType is { } type)
        {
            parts.Add(L[$"Parking_SpotType_{type}"].Value);
        }

        parts.Add(L[AvailableIds.Contains(spotId) ? "Parking_Map_Free" : "Parking_Map_Taken"].Value);
        if (AvailableIds.Contains(spotId) && _quote is not null)
        {
            parts.Add($"{_quote.Cost} {L["Parking_Credits"]}");
        }

        return string.Join(" · ", parts.Where(p => p.Length > 0));
    }

    private async Task ReloadQueueAsync() => _myQueue = await Reservations.GetMyQueueAsync(_userId);

    private async Task GoToReservationPageAsync(int pageIndex)
    {
        _reservationPageIndex = Math.Clamp(pageIndex, 0, ReservationPageCount - 1);
        await ReloadReservationsAsync();
    }

    // A changed window makes the shown spots and quote stale — clear them so the only path to
    // a reservation goes through a fresh search (the visitor agenda does the same).
    private void InvalidateSearch()
    {
        _available = null;
        _quote = null;
    }

    private async Task JoinQueueAsync()
    {
        if (!TryBeginAction())
        {
            return;
        }

        try
        {
            _error = _info = null;
            var result = await Reservations.JoinQueueAsync(_userId, Start, End);
            if (result.Succeeded)
            {
                _info = "Parking_Queue_Joined";
                await ReloadQueueAsync();
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private async Task ClaimQueueAsync(Guid id)
    {
        if (!TryBeginAction())
        {
            return;
        }

        try
        {
            _error = _info = null;
            var result = await Reservations.ClaimQueueOfferAsync(_userId, id);
            if (result.Succeeded)
            {
                _info = "Parking_Queue_Claimed";
                await ReloadQueueAsync();
                await ReloadReservationsAsync();
                if (_available is not null)
                {
                    await FindAvailableAsync(keepMessages: true);
                }
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private async Task LeaveQueueAsync(Guid id)
    {
        if (!TryBeginAction())
        {
            return;
        }

        try
        {
            _error = _info = null;
            var result = await Reservations.LeaveQueueAsync(_userId, id);
            if (result.Succeeded)
            {
                _info = "Parking_Queue_Left";
                await ReloadQueueAsync();
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private static string OccupancyClass(int percent) =>
        percent >= 90 ? "meter__fill--high" : percent >= 70 ? "meter__fill--mid" : "meter__fill--low";

    // Points a reservation on this spot would earn now: off-peak bonus plus, for a shared reserved
    // spot, the commute-distance reward.
    private int PointsForSpot(ParkingSpotDto spot)
    {
        if (_policy is null)
        {
            return 0;
        }

        var offPeak = _policy.IsOffPeak(Start, _tz) ? _policy.OffPeakBonusPoints : 0;
        var shared = spot.OwnerId is not null ? _policy.ComputeSharedTakenReward(_distanceKm) : 0;
        return offPeak + shared;
    }

    // The promised range reward comes from the service — the same skips and the same monthly
    // share-allowance cap as the actual award. A client-side estimate here already drifted from
    // what the release then credited (it ignored the cap and promised points to allowance-0 owners).
    private async Task RefreshReleasePreviewAsync()
    {
        _releasePreview = _ownedSpot is null
            ? 0
            : await ResidentSpots.PreviewReleaseRewardAsync(_userId,
                DateOnly.FromDateTime(_releaseFrom), DateOnly.FromDateTime(_releaseTo));
    }

    private async Task ReloadOwnedSpotAsync()
    {
        _ownedSpot = await ResidentSpots.GetMyOwnedSpotAsync(_userId);
        _allowance = _ownedSpot?.MonthlyShareAllowance ?? 0;
        _planDays = _ownedSpot?.PlannedUseDays ?? Weekday.Workdays;
        _planAutoRelease = _ownedSpot?.AutoReleaseUnplannedDays ?? false;
        // Every resident action (release, reclaim, allowance change) can move the promised reward.
        await RefreshReleasePreviewAsync();
    }

    private async Task ConfirmArrivalAsync()
    {
        await RunResidentAsync(() => ResidentSpots.ConfirmArrivalAsync(_userId), "Parking_Owned_Confirmed");
    }

    private async Task ReleaseOwnedAsync()
    {
        await RunResidentAsync(
            () => ResidentSpots.ReleaseAsync(_userId, DateOnly.FromDateTime(_releaseFrom), DateOnly.FromDateTime(_releaseTo)),
            "Parking_Owned_Released");
    }

    private async Task ReclaimOwnedAsync()
    {
        await RunResidentAsync(
            () => ResidentSpots.ReclaimAsync(_userId, DateOnly.FromDateTime(_reclaimFrom), DateOnly.FromDateTime(_reclaimTo)),
            "Parking_Owned_Reclaimed");
    }

    private async Task SaveAllowanceAsync()
    {
        await RunResidentAsync(() => ResidentSpots.SetShareAllowanceAsync(_userId, _allowance), "Parking_Owned_AllowanceSaved");
    }

    private async Task SaveUsagePlanAsync()
    {
        await RunResidentAsync(
            () => ResidentSpots.SetUsagePlanAsync(_userId, _planDays, _planAutoRelease),
            "Parking_Owned_PlanSaved");
    }

    private async Task RunResidentAsync(Func<Task<ParkingResult>> action, string successKey)
    {
        if (!TryBeginAction())
        {
            return;
        }

        try
        {
            _error = _info = null;
            var result = await action();
            if (result.Succeeded)
            {
                _info = successKey;
                await ReloadOwnedSpotAsync();
                await ReloadReservationsAsync();
                if (_available is not null)
                {
                    await FindAvailableAsync(keepMessages: true);
                }
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    /// <param name="keepMessages">
    /// Set when this is a refresh after an action that has just announced itself. A search the driver
    /// asked for clears what is on screen — a stale error about the previous window must not outlive
    /// it — but the same call is also how five different actions refresh the results afterwards, and
    /// clearing there wiped every one of their confirmations before it could be read.
    /// </param>
    private async Task FindAvailableAsync(bool keepMessages = false)
    {
        if (!keepMessages)
        {
            _error = _info = null;
        }

        if (End <= Start)
        {
            _error = "Parking_Error_InvalidWindow";
            _available = null;
            _quote = null;
            return;
        }

        _available = await Reservations.GetAvailableSpotsAsync(Start, End);
        _quote = await Reservations.GetQuoteAsync(_userId, Start, End);
    }

    private async Task ReserveAsync(Guid spotId)
    {
        if (!TryBeginAction())
        {
            return;
        }

        try
        {
            _error = _info = null;
            var result = await Reservations.ReserveAsync(_userId, spotId, Start, End, _useVoucher && _voucher is not null);
            if (result.Succeeded)
            {
                _info = "Parking_Reserved";
                await FindAvailableAsync(keepMessages: true);
                await ReloadReservationsAsync();
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private ReservationDto? _blockedTarget;
    private bool _blockedBusy;
    private string? _blockedMessage;
    private string? _blockerPlate;
    private BlockedSpotPhoto? _blockedPhoto;
    private string? _blockedPhotoName;
    private string? _blockedPhotoError;

    private ApologyVoucherDto? _voucher;
    private bool _useVoucher;

    // Mirror of the server rule: the spot's state can only be recorded while the driver can
    // actually be standing in front of it (the check-in window).
    private bool CanReportBlocked(ReservationDto reservation)
    {
        var now = DateTimeOffset.UtcNow;
        return reservation.Status == ReservationStatus.Reserved
            && now >= reservation.StartUtc - TimeSpan.FromMinutes(15)
            && now < reservation.EndUtc;
    }

    private void OpenBlockedPanel(ReservationDto reservation)
    {
        _error = _info = _blockedMessage = null;
        _blockerPlate = null;
        _blockedPhoto = null;
        _blockedPhotoName = null;
        _blockedPhotoError = null;
        _blockedTarget = reservation;
    }

    // Buffers the picked photo so the submit sends bytes, not a stream tied to the input's
    // lifetime. The size cap is enforced right here — OpenReadStream throws past the limit.
    private async Task OnBlockedPhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        _blockedPhoto = null;
        _blockedPhotoName = null;
        _blockedPhotoError = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: BlockedSpotPhoto.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _blockedPhoto = new BlockedSpotPhoto(buffer.ToArray(), e.File.ContentType);
            _blockedPhotoName = e.File.Name;
        }
        catch (IOException)
        {
            _blockedPhotoError = "Parking_Error_PhotoTooLarge";
        }
    }

    private async Task ReportBlockedAsync(bool relocate)
    {
        if (_blockedTarget is not { } blocked || _blockedPhoto is null)
        {
            return;
        }

        _blockedBusy = true;
        try
        {
            var outcome = await Reservations.ReportBlockedSpotAsync(_userId, blocked.Id, relocate, _blockedPhoto, _blockerPlate);
            if (!outcome.Succeeded)
            {
                _error = outcome.Error;
                return;
            }

            _blockedTarget = null;
            _blockedMessage = outcome.RelocatedToSpotCode is { } code
                ? L["Parking_Relocated", code]
                : relocate
                    ? L["Parking_Blocked_NoSpot"]
                    : L["Parking_Blocked_Recorded"];
            if (outcome.VoucherGranted)
            {
                _blockedMessage += " " + L["Parking_Blocked_VoucherGranted"];
            }
            await ReloadReservationsAsync();
            if (_available is not null)
            {
                await FindAvailableAsync(keepMessages: true);
            }
        }
        finally
        {
            _blockedBusy = false;
        }
    }

    private Task CheckInAsync(Guid id) => RunAsync(() => Reservations.CheckInAsync(_userId, id));
    private Task CompleteAsync(Guid id) => RunAsync(() => Reservations.CompleteAsync(_userId, id));
    private Task ReleaseAsync(Guid id) => RunAsync(() => Reservations.ReleaseAsync(_userId, id), "Parking_Released");
    private Task CancelAsync(Guid id) => RunAsync(() => Reservations.CancelAsync(_userId, id));

    // Single-flight guard for the money/state actions: the second click of a double-click must
    // not run (and must not wipe the first one's outcome message).
    private bool TryBeginAction()
    {
        if (_actionBusy)
        {
            return false;
        }

        _actionBusy = true;
        return true;
    }

    private async Task RunAsync(Func<Task<ParkingResult>> action, string? successKey = null)
    {
        if (!TryBeginAction())
        {
            return;
        }

        try
        {
            _error = _info = null;
            var result = await action();
            if (result.Succeeded)
            {
                _info = successKey;
                await ReloadReservationsAsync();
                if (_available is not null)
                {
                    await FindAvailableAsync(keepMessages: true);
                }
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private async Task ReloadReservationsAsync()
    {
        // The apology voucher can appear (blocked-spot flow), disappear (redeemed by a booking)
        // or come back (timely cancel/release) with any reservation action — keep it in sync. It
        // does not depend on the reservation list, so both go at once.
        var page = Reservations.GetMyReservationsPageAsync(_userId, _reservationPageIndex, ReservationPageSize);
        var voucher = Reservations.GetMyApologyVoucherAsync(_userId);
        await Task.WhenAll(page, voucher);
        _myReservations = page.Result.Items;
        _reservationTotal = page.Result.TotalCount;
        // Taken back from the result, not assumed: the service walks the index back when the page it
        // was asked for no longer exists (the last booking on it was just cancelled away).
        _reservationPageIndex = page.Result.PageIndex;
        _voucher = voucher.Result;
        if (_voucher is null)
        {
            _useVoucher = false;
        }
    }
}
