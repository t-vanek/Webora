    private bool HasHeldResidentSpotForSelectedDay =>
        _ownedSpot is not null && SelectedResidentRelease is null;

    private bool _sharedSearchRequested;
    private bool SharedSearchExpanded => _sharedSearchRequested || _available is not null || _quote is not null || _highlightSearch;

    private bool OnlyResidentSpotIsAvailable =>
