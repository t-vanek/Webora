    private RenderFragment SharedSearchArea() => __builder =>
    {
        // A resident normally starts with the answer to "where do I park?".  Searching the
        // shared pool is an exception (another place or time), so keep it behind an explicit
        // action until the resident asks for it.  Once a search has results, retain it so
        // changing filters or time does not make the results disappear.
        if (_ownedSpot is not null && !SharedSearchExpanded)
        {
            <section class="resident-release-banner @(SelectedResidentRelease is { TakenByGuest: true } ? "resident-release-banner--warning" : null)">
                <div>
                    <strong>@SelectedResidentParkingTitle</strong>
                    <span>@SelectedResidentParkingText</span>
                </div>
                <div class="resident-release-banner__actions">
                    @if (SelectedResidentRelease is { TakenByGuest: false })
                    {
                        <FluentButton Appearance="Appearance.Accent" Disabled="@_actionBusy"
                                      OnClick="ReclaimSelectedResidentDayAsync">@L["Parking_ResidentState_TakeBackSpot", _ownedSpot.Code]</FluentButton>
                    }
                    else if (SelectedResidentRelease is { TakenByGuest: true })
                    {
                        <FluentButton Appearance="Appearance.Outline" OnClick="FocusResidentManagementAsync">@L["Parking_ResidentState_ManageRelease"]</FluentButton>
                    }
                    <FluentButton Appearance="Appearance.Outline" OnClick="ShowSharedSearchAsync">@L["Parking_AlternateSearch_Action"]</FluentButton>
                </div>
            </section>
            return;
        }

        @if (_ownedSpot is not null)
        {
            @ResidentSearchNotice()
        }

        @SharedSearchPanel()
    };

    private RenderFragment SharedSearchPanel() => __builder =>
    {
        <FluentCard Id="booking-bar" Class="@($"booking-bar {(_highlightSearch ? "booking-bar--attention" : null)}")">
            <div class="booking-bar__head">
                <div>
                    <div class="section-head">
                        <FluentIcon Value="@(new Icons.Regular.Size20.CalendarClock())" Color="Color.Accent" />
                        <span>@L["Parking_BookingTitle"]</span>
                    </div>
                    <p class="booking-bar__copy">@L["Parking_BookingIntro"]</p>
                </div>
            </div>
            <div class="booking-bar__row">
                <div class="field">
                    <label>@L["Parking_Date"]</label>
                    <input type="date" @ref="_dateInput" @bind="_day" @bind:after="InvalidateSearch" class="parking-input" />
                </div>
                <div class="field">
                    <label>@L["Parking_From"]</label>
                    <input type="time" @bind="_startTime" @bind:after="InvalidateSearch" class="parking-input" />
                </div>
                <div class="field">
                    <label>@L["Parking_To"]</label>
                    <input type="time" @bind="_endTime" @bind:after="InvalidateSearch" class="parking-input" />
                </div>
                <FluentButton Class="booking-bar__submit" Appearance="Appearance.Accent" OnClick="() => FindAvailableAsync()">@L["Parking_Find"]</FluentButton>
            </div>

            @if (_quote is not null)
            {
                <div class="quote-panel">
                    @if (_policy?.CreditsEnabled == true)
                    {
                        <div class="price-tag">
                            <span class="price-tag__num">@_quote.Cost</span>
                            <span class="price-tag__unit">@L["Parking_Credits"]</span>
                        </div>
                    }
                    <span class="pill @(_quote.IsPeak ? "pill--peak" : "pill--offpeak")">
                        @(_quote.IsPeak ? L["Parking_Peak"] : L["Parking_OffPeakLabel"])
                    </span>
                    <div class="quote-meter">
                        <div class="quote-meter__head">
                            <span>@L["Parking_Occupancy"]</span>
                            <span>@_quote.OccupancyPercent %</span>
                        </div>
                        <div class="meter"><div class="meter__fill @OccupancyClass(_quote.OccupancyPercent)" style="width:@(_quote.OccupancyPercent)%"></div></div>
                    </div>
                    @if (_policy?.CreditsEnabled == true)
                    {
                        <span class="balance-chip @(_quote.Affordable ? "balance-chip--ok" : "balance-chip--low")">
                            @L["Parking_Balance"]: <strong>@_quote.Balance</strong> @L["Parking_Credits"]
                        </span>
                    }
                </div>
                @if (_policy?.CreditsEnabled == true && !_quote.Affordable)
                {
                    <FluentLabel Typo="Typography.Body" Style="color:var(--error)">@L["Parking_Error_InsufficientCredit"]</FluentLabel>
                }
            }
        </FluentCard>

        @if (_quote is not null)
        {
            <div class="booking-context-bar" aria-label="@L["Parking_Context_Label"]">
                <div class="booking-context-bar__main">
                    <strong>@L["Parking_Context_Summary", Local(Start, "d"), Local(Start, "t"), Local(End, "t")]</strong>
                    @if (_policy?.CreditsEnabled == true)
                    {
                        <span>@_quote.Cost @L["Parking_Credits"] · @(_quote.IsPeak ? L["Parking_Peak"] : L["Parking_OffPeakLabel"])</span>
                    }
                    else
                    {
                        <span>@(_quote.IsPeak ? L["Parking_Peak"] : L["Parking_OffPeakLabel"])</span>
                    }
                </div>
                @if (_policy?.CreditsEnabled == true)
                {
                    <span class="balance-chip @(_quote.Affordable ? "balance-chip--ok" : "balance-chip--low")">
                        @L["Parking_Balance"]: <strong>@_quote.Balance</strong> @L["Parking_Credits"]
                    </span>
                }
                <button type="button" class="context-link" @onclick="FocusSearchAsync">@L["Parking_Context_Change"]</button>
            </div>
        }
    };

    /// <summary>Renders a stored UTC instant as local wall-clock at the lot.</summary>
    private string Local(DateTimeOffset utc, string format) =>
        TimeZoneInfo.ConvertTime(utc, _tz).ToString(format);

    private string ReservationWhen(ReservationDto reservation)
    {
        var start = TimeZoneInfo.ConvertTime(reservation.StartUtc, _tz);
        var end = TimeZoneInfo.ConvertTime(reservation.EndUtc, _tz);
        if (start.TimeOfDay == TimeSpan.Zero && end.TimeOfDay == TimeSpan.Zero)
        {
            return $"{start:d} · {L["Parking_AllDay"]}";
        }

        return $"{start:g} – {end:t}";
    }

    private string ReleasePeriodLabel(ReleasePeriod period) => period.From == period.To
        ? period.From.ToString("d. M. yyyy", CultureInfo.CurrentCulture)
        : $"{period.From.ToString("d. M.", CultureInfo.CurrentCulture)} – {period.To.ToString("d. M. yyyy", CultureInfo.CurrentCulture)}";

    private string ReleasePeriodStatus(ReleasePeriod period) => period.TakenDays switch
    {
        0 => L["Parking_Owned_PeriodAllFree"].Value,
        var taken when taken == period.DayCount => L["Parking_Owned_PeriodAllTaken"].Value,
        var taken => L["Parking_Owned_PeriodPartlyTaken", taken, period.DayCount - taken].Value,
    };

    private RenderFragment SmartHint(string anchorId, string text, int longAt = 92, bool forceIcon = false) => __builder =>
    {
        if (forceIcon || text.Length > longAt)
        {
            <button type="button" id="@anchorId" class="owned-hint" aria-label="@text">
                <FluentIcon Value="@(new Icons.Regular.Size20.QuestionCircle())" Color="Color.Custom" CustomColor="currentColor" />
            </button>
            <FluentTooltip Anchor="@anchorId" Position="TooltipPosition.Bottom" MaxWidth="440px">@text</FluentTooltip>
        }
        else
        {
            <span class="owned-note">@text</span>
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        // UserManager stays on its own: it runs on the scoped Identity DbContext. Everything below
        // goes through IDbContextFactory and gets a fresh context per call, which is exactly what
        // makes issuing those calls together safe — and on a remote database it turns a chain of
        // round trips, all of which the prerender waits for, into one.
        var user = await UserManager.GetUserAsync(state.User);
        _userId = user?.Id ?? Guid.Empty;

        var policy = ParkingSettings.GetPolicyAsync();
        var timeZone = SiteSettings.GetTimeZoneAsync();
        await Task.WhenAll(policy, timeZone);
        _policy = policy.Result;
        _tz = timeZone.Result;

        // Re-seed the date defaults now that the site time zone is known: the field initializers
        // used the server's clock, and around midnight a UTC-hosted server would preselect the
        // wrong local day for the lot.
        _day = SiteTime.Today(DateTimeOffset.UtcNow, _tz);
        _releaseFrom = _day.ToDateTime(TimeOnly.MinValue);
        _releaseTo = _releaseFrom;

        // Four independent reads. Each writes its own fields, and their continuations are serialised
        // by the renderer's dispatcher, so there is nothing to race over.
        var home = UserLocation.GetHomeAsync(_userId);
        var orientationMap = ParkingSettings.GetOrientationMapAsync();
        await Task.WhenAll(home, orientationMap, ReloadOwnedSpotAsync(), ReloadReservationsAsync(), ReloadQueueAsync());
        _distanceKm = home.Result.Verified ? home.Result.DistanceKm : null;
        _hasOrientationMap = orientationMap.Result is not null;
    }

    private void OpenOrientationMap(string spotCode)
    {
        _orientationMapSpotCode = spotCode;
        _showOrientationMap = true;
    }

    private Task CloseOrientationMapAsync()
    {
        _showOrientationMap = false;
        _orientationMapSpotCode = null;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _preferencesLoaded || _userId == Guid.Empty)
        {
            return;
        }

        _preferencesLoaded = true;
        try
        {
            var stored = await Storage.GetAsync<ParkingReservePreferences>(PreferencesStorageKey);
            if (stored.Success && stored.Value is { } prefs)
            {
                ApplyPreferences(prefs);
                StateHasChanged();
            }
        }
        catch
        {
            try
            {
                await Storage.DeleteAsync(PreferencesStorageKey);
            }
            catch
            {
                // A stored convenience preference must never break the reservation page.
            }
        }
    }

    private async Task ReloadQueueAsync() => _myQueue = await Reservations.GetMyQueueAsync(_userId);

    // A changed window makes the shown spots and quote stale — clear them so the only path to
    // a reservation goes through a fresh search (the visitor agenda does the same).
    private void InvalidateSearch()
    {
        _available = null;
        _quote = null;
    }

    private async Task FocusSearchAsync()
    {
        _highlightSearch = true;
        await Task.Yield();
        await _dateInput.FocusAsync();
        _ = ClearSearchHighlightAsync();
    }

    private async Task FocusResidentManagementAsync()
    {
        if (_day >= ReleaseToday)
        {
            _releasePreset = ReleasePreset.OneDay;
            _releaseFrom = _day.ToDateTime(TimeOnly.MinValue);
            _releaseTo = _releaseFrom;
            await RefreshReleasePreviewAsync();
        }

        await Task.Yield();
        await _residentTools.FocusAsync();
    }

    private async Task ShowSharedSearchAsync()
    {
        _sharedSearchRequested = true;
        await FocusSearchAsync();
    }

    private async Task ClearSearchHighlightAsync()
    {
        await Task.Delay(1400);
        _highlightSearch = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task JoinQueueAsync()
    {
        if (!TryBeginAction())
        {
            return;
        }

        try
        {
            _error = _info = null;
            var result = await Reservations.JoinQueueAsync(_userId, Start, End);
            if (result.Succeeded)
            {
                _info = "Parking_Queue_Joined";
                await ReloadQueueAsync();
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private async Task ClaimQueueAsync(Guid id)
    {
        if (!TryBeginAction())
        {
            return;
        }

        try
        {
            _error = _info = null;
            var result = await Reservations.ClaimQueueOfferAsync(_userId, id);
            if (result.Succeeded)
            {
                _info = "Parking_Queue_Claimed";
                await ReloadQueueAsync();
                await ReloadReservationsAsync();
                if (_available is not null)
                {
                    await FindAvailableAsync(keepMessages: true);
                }
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private async Task LeaveQueueAsync(Guid id)
    {
        if (!TryBeginAction())
        {
            return;
        }

        try
        {
            _error = _info = null;
            var result = await Reservations.LeaveQueueAsync(_userId, id);
            if (result.Succeeded)
            {
                _info = "Parking_Queue_Left";
                await ReloadQueueAsync();
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private static string OccupancyClass(int percent) =>
        percent >= 90 ? "meter__fill--high" : percent >= 70 ? "meter__fill--mid" : "meter__fill--low";

    // The promised range reward comes from the service, using the same date validation and
    // already-released-day skips as the actual award.
    private async Task RefreshReleasePreviewAsync()
    {
        _releasePreview = _ownedSpot is null
            ? 0
            : await ResidentSpots.PreviewReleaseRewardAsync(_userId,
                DateOnly.FromDateTime(_releaseFrom), DateOnly.FromDateTime(_releaseTo));
    }

    private async Task ReleaseFromChangedAsync()
    {
        var from = DateOnly.FromDateTime(_releaseFrom);
        var duration = ReleasePresetDuration(_releasePreset);
        if (duration is not null)
        {
            _releaseTo = from.AddDays(duration.Value - 1).ToDateTime(TimeOnly.MinValue);
        }
        else if (DateOnly.FromDateTime(_releaseTo) < from)
        {
            _releaseTo = _releaseFrom;
        }

        await RefreshReleasePreviewAsync();
    }

    private async Task ReleaseToChangedAsync()
    {
        _releasePreset = ReleasePreset.Custom;
        await RefreshReleasePreviewAsync();
    }

    private async Task SetReleasePresetAsync(ReleasePreset preset)
    {
        _releasePreset = preset;
        var duration = ReleasePresetDuration(preset);
        if (duration is not null)
        {
            var from = DateOnly.FromDateTime(_releaseFrom);
            _releaseTo = from.AddDays(duration.Value - 1).ToDateTime(TimeOnly.MinValue);
        }

        await RefreshReleasePreviewAsync();
    }

    private static int? ReleasePresetDuration(ReleasePreset preset) => preset switch
    {
        ReleasePreset.OneDay => 1,
        ReleasePreset.OneWeek => 7,
        ReleasePreset.TwoWeeks => 14,
        _ => null,
    };

    private async Task ReloadOwnedSpotAsync()
    {
        _ownedSpot = await ResidentSpots.GetMyOwnedSpotAsync(_userId);
        _planDays = _ownedSpot?.PlannedUseDays ?? Weekday.Workdays;
        _planAutoRelease = _ownedSpot?.AutoReleaseUnplannedDays ?? false;
        if (!_releaseRangeInitialized && _ownedSpot is not null)
        {
            ResetReleaseRangeToNextHeldDay();
            _releaseRangeInitialized = true;
        }
        // Every resident release or reclaim can move the promised reward.
        await RefreshReleasePreviewAsync();
    }

    private void ResetReleaseRangeToNextHeldDay()
    {
        var released = _ownedSpot?.UpcomingReleases.Select(day => day.Date).ToHashSet() ?? [];
        var date = ReleaseToday;
        while (released.Contains(date))
        {
            date = date.AddDays(1);
        }

        _releasePreset = ReleasePreset.OneDay;
        _releaseFrom = date.ToDateTime(TimeOnly.MinValue);
        _releaseTo = _releaseFrom;
    }

    private async Task ReleaseOwnedAsync()
    {
        var succeeded = await RunResidentAsync(
            () => ResidentSpots.ReleaseAsync(_userId, DateOnly.FromDateTime(_releaseFrom), DateOnly.FromDateTime(_releaseTo)),
            "Parking_Owned_Released");
        if (succeeded)
        {
            ResetReleaseRangeToNextHeldDay();
            await RefreshReleasePreviewAsync();
        }
    }

    private async Task ReleaseOwnedTodayAsync()
    {
        var today = SiteTime.Today(DateTimeOffset.UtcNow, _tz);
        await RunResidentAsync(() => ResidentSpots.ReleaseAsync(_userId, today, today), "Parking_Owned_Released");
    }

    private async Task RequestReclaimReleasePeriodAsync(ReleasePeriod period)
    {
        if (period.TakenDays > 0)
        {
            _pendingReclaimPeriod = period;
            return;
        }

        await ConfirmReclaimReleasePeriodAsync(period);
    }

    private async Task ConfirmReclaimReleasePeriodAsync(ReleasePeriod period)
    {
        _pendingReclaimPeriod = null;
        await RunResidentAsync(() => ResidentSpots.ReclaimAsync(_userId, period.From, period.To), "Parking_Owned_Reclaimed");
    }

    private void CancelPendingReclaim() => _pendingReclaimPeriod = null;

    private async Task ReclaimSelectedResidentDayAsync() =>
        await RunResidentAsync(() => ResidentSpots.ReclaimAsync(_userId, _day, _day), "Parking_Owned_Reclaimed");

    private async Task ReclaimOwnedTodayAsync()
    {
        var today = SiteTime.Today(DateTimeOffset.UtcNow, _tz);
        await RunResidentAsync(() => ResidentSpots.ReclaimAsync(_userId, today, today), "Parking_Owned_Reclaimed");
    }

    private async Task RequestReclaimOwnedTodayAsync()
    {
        if (_ownedSpot?.TodayState == OwnedSpotDayState.SharedTaken)
        {
            _confirmTodayReclaim = true;
            return;
        }

        await ReclaimOwnedTodayAsync();
    }

    private async Task ConfirmReclaimOwnedTodayAsync()
    {
        _confirmTodayReclaim = false;
        await ReclaimOwnedTodayAsync();
    }

    private void CancelTodayReclaim() => _confirmTodayReclaim = false;

    private async Task SaveUsagePlanAsync()
    {
        await RunResidentAsync(
            () => ResidentSpots.SetUsagePlanAsync(_userId, _planDays, _planAutoRelease),
            "Parking_Owned_PlanSaved");
    }

    private async Task<bool> RunResidentAsync(Func<Task<ParkingResult>> action, string successKey)
    {
        if (!TryBeginAction())
        {
            return false;
        }

        try
        {
            _error = _info = null;
            var result = await action();
            if (result.Succeeded)
            {
                _info = successKey;
                await ReloadOwnedSpotAsync();
                await ReloadReservationsAsync();
                if (HasHeldResidentSpotForSelectedDay)
                {
                    _available = null;
                    _quote = null;
                }
                else if (_available is not null)
                {
                    await FindAvailableAsync(keepMessages: true);
                }
                return true;
            }

            _error = result.Errors.FirstOrDefault();
            return false;
        }
        finally
        {
            _actionBusy = false;
        }
    }

    /// <param name="keepMessages">
    /// Set when this is a refresh after an action that has just announced itself. A search the driver
    /// asked for clears what is on screen — a stale error about the previous window must not outlive
    /// it — but the same call is also how five different actions refresh the results afterwards, and
    /// clearing there wiped every one of their confirmations before it could be read.
    /// </param>
    private async Task FindAvailableAsync(bool keepMessages = false)
    {
        if (!keepMessages)
        {
            _error = _info = null;
        }

        if (End <= Start)
        {
            _error = "Parking_Error_InvalidWindow";
            _available = null;
            _quote = null;
            return;
        }

        _available = await Reservations.GetAvailableSpotsAsync(Start, End);
        _quote = await Reservations.GetQuoteAsync(_userId, Start, End);
        if (!keepMessages)
        {
            await SavePreferencesAsync();
        }
    }

    private async Task ShiftSearchAsync(TimeSpan delta)
    {
        var start = _day.ToDateTime(_startTime).Add(delta);
        var end = _day.ToDateTime(_endTime).Add(delta);
        ApplySearchWindow(start, end);
        await FindAvailableAsync();
    }

    private async Task SearchFromAsync(TimeOnly startTime)
    {
        var start = _day.ToDateTime(startTime);
        var end = start.Add(SearchDuration);
        ApplySearchWindow(start, end);
        await FindAvailableAsync();
    }

    private void ApplySearchWindow(DateTime start, DateTime end)
    {
        if (end.Date > start.Date)
        {
            end = start.Date.AddDays(1).AddMinutes(-1);
        }

        _day = DateOnly.FromDateTime(start);
        _startTime = TimeOnly.FromDateTime(start);
        _endTime = TimeOnly.FromDateTime(end);
    }

    private void ApplyPreferences(ParkingReservePreferences prefs)
    {
        if (TimeOnly.TryParseExact(prefs.StartTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var start))
        {
            _startTime = start;
        }

        if (TimeOnly.TryParseExact(prefs.EndTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var end)
            && end > _startTime)
        {
            _endTime = end;
        }

        if (string.IsNullOrWhiteSpace(prefs.SpotTypeFilter)
            || Enum.TryParse<ParkingSpotType>(prefs.SpotTypeFilter, out _))
        {
            _spotTypeFilter = prefs.SpotTypeFilter ?? string.Empty;
        }

        if (Enum.TryParse<AvailableSort>(prefs.Sort, out var sort))
        {
            _availableSort = sort;
        }

        InvalidateSearch();
    }

    private async Task SavePreferencesAsync()
    {
        try
        {
            await Storage.SetAsync(PreferencesStorageKey, new ParkingReservePreferences(
                _startTime.ToString("HH:mm", CultureInfo.InvariantCulture),
                _endTime.ToString("HH:mm", CultureInfo.InvariantCulture),
                _spotTypeFilter,
                _availableSort.ToString()));
        }
        catch
        {
            // Best-effort only: searching must work even when browser storage is unavailable.
        }
    }

    private async Task ReserveAsync(Guid spotId)
    {
        if (!TryBeginAction())
        {
            return;
        }

        try
        {
            _error = _info = null;
            var result = await Reservations.ReserveAsync(_userId, spotId, Start, End, _useVoucher && _voucher is not null);
            if (result.Succeeded)
            {
                _info = "Parking_Reserved";
                await FindAvailableAsync(keepMessages: true);
                await ReloadReservationsAsync();
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private ReservationDto? _blockedTarget;
    private bool _blockedBusy;
    private string? _blockedMessage;
    private string? _blockerPlate;
    private BlockedSpotPhoto? _blockedPhoto;
    private string? _blockedPhotoName;
    private string? _blockedPhotoError;

    private ApologyVoucherDto? _voucher;
    private bool _useVoucher;

    // Mirror of the server rule: the spot's state can only be recorded while the driver can
    // actually be standing in front of it. Reporting does not confirm arrival.
    private bool CanReportBlocked(ReservationDto reservation)
    {
        var now = DateTimeOffset.UtcNow;
        return reservation.Status == ReservationStatus.Reserved
            && now >= reservation.StartUtc - TimeSpan.FromMinutes(15)
            && now < reservation.EndUtc;
    }

    private void OpenBlockedPanel(ReservationDto reservation)
    {
        _error = _info = _blockedMessage = null;
        _blockerPlate = null;
        _blockedPhoto = null;
        _blockedPhotoName = null;
        _blockedPhotoError = null;
        _blockedTarget = reservation;
    }

    // Buffers the picked photo so the submit sends bytes, not a stream tied to the input's
    // lifetime. The size cap is enforced right here — OpenReadStream throws past the limit.
    private async Task OnBlockedPhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        _blockedPhoto = null;
        _blockedPhotoName = null;
        _blockedPhotoError = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: BlockedSpotPhoto.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _blockedPhoto = new BlockedSpotPhoto(buffer.ToArray(), e.File.ContentType);
            _blockedPhotoName = e.File.Name;
        }
        catch (IOException)
        {
            _blockedPhotoError = "Parking_Error_PhotoTooLarge";
        }
    }

    private async Task ReportBlockedAsync(bool relocate)
    {
        if (_blockedTarget is not { } blocked || _blockedPhoto is null)
        {
            return;
        }

        _blockedBusy = true;
        try
        {
            var outcome = await Reservations.ReportBlockedSpotAsync(_userId, blocked.Id, relocate, _blockedPhoto, _blockerPlate);
            if (!outcome.Succeeded)
            {
                _error = outcome.Error;
                return;
            }

            _blockedTarget = null;
            _blockedMessage = outcome.RelocatedToSpotCode is { } code
                ? L["Parking_Relocated", code]
                : relocate
                    ? L["Parking_Blocked_NoSpot"]
                    : L["Parking_Blocked_Recorded"];
            if (outcome.VoucherGranted && _policy?.CreditsEnabled == true)
            {
                _blockedMessage += " " + L["Parking_Blocked_VoucherGranted"];
            }
            await ReloadReservationsAsync();
            if (_available is not null)
            {
                await FindAvailableAsync(keepMessages: true);
            }
        }
        finally
        {
            _blockedBusy = false;
        }
    }

    private Task ReleaseAsync(Guid id) => RunAsync(() => Reservations.ReleaseAsync(_userId, id), "Parking_Released");
    private Task CancelAsync(Guid id) => RunAsync(() => Reservations.CancelAsync(_userId, id));

    // Single-flight guard for the money/state actions: the second click of a double-click must
    // not run (and must not wipe the first one's outcome message).
    private bool TryBeginAction()
    {
        if (_actionBusy)
        {
            return false;
        }

        _actionBusy = true;
        return true;
    }

    private async Task RunAsync(Func<Task<ParkingResult>> action, string? successKey = null)
    {
        if (!TryBeginAction())
        {
            return;
        }

        try
        {
            _error = _info = null;
            var result = await action();
            if (result.Succeeded)
            {
                _info = successKey;
                await ReloadReservationsAsync();
                if (_available is not null)
                {
                    await FindAvailableAsync(keepMessages: true);
                }
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private async Task ReloadReservationsAsync()
    {
        // The apology voucher can appear (blocked-spot flow), disappear (redeemed by a booking)
        // or come back (timely cancel/release) with any reservation action — keep it in sync. It
        // does not depend on the reservation list, so both go at once.
        var reservations = Reservations.GetMyReservationsAsync(_userId);
        var voucher = Reservations.GetMyApologyVoucherAsync(_userId);
        await Task.WhenAll(reservations, voucher);
        _myReservations = reservations.Result;
        if (VisibleReservations.Count == 0)
        {
            _reservationView = UpcomingReservations.Count > 0
                ? ReservationView.Upcoming
                : _reservationView;
        }

        _voucher = voucher.Result;
        if (_voucher is null)
        {
            _useVoucher = false;
        }
    }
}
