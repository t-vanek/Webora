    private OwnedSpotDayState SelectedResidentDayState => _day == PlannerToday
        ? _ownedSpot?.TodayState ?? OwnedSpotDayState.Held
        : SelectedResidentRelease switch
        {
            { TakenByGuest: true } => OwnedSpotDayState.SharedTaken,
