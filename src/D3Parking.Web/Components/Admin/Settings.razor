@page "/admin/settings"
@attribute [HasPermission(Permissions.Settings.View)]
@rendermode InteractiveServer
@using D3Parking.Application.Identity
@using D3Parking.Application.Settings
@using D3Parking.Domain.Settings
@inject ISiteSettingsService SiteSettings
@inject IEntraSettingsService EntraSettings
@inject IRoleAdminService RoleAdmin
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Settings_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.PageTitle">@L["Settings_Title"]</FluentLabel>

    @if (_form is null)
    {
        <FluentProgressRing />
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar">@_message</FluentMessageBar>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@_error</FluentMessageBar>
        }

        <FluentTabs @bind-ActiveTabId="_activeTab">
            <FluentTab Id="domain" Label="@L["Settings_DomainSection"]">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:720px;padding-top:12px">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_BaseUrlPreview"]</FluentLabel>
                        <code>@(_baseUrl ?? L["Settings_NotSet"])</code>
                    </FluentStack>

                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="12" md="8">
                            <FluentTextField @bind-Value="_form.CanonicalHost"
                                             Label="@L["Settings_CanonicalHost"]"
                                             Placeholder="www.example.com"
                                             Style="width:100%" />
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_CanonicalHostHelp"]</FluentLabel>
                        </FluentGridItem>
                        <FluentGridItem xs="6" md="2">
                            <FluentSelect TOption="UrlScheme"
                                          Items="@(new[] { UrlScheme.Https, UrlScheme.Http })"
                                          OptionText="@(s => s == UrlScheme.Https ? "HTTPS" : "HTTP")"
                                          @bind-SelectedOption="_form.Scheme"
                                          Label="@L["Settings_Scheme"]"
                                          Style="width:100%" />
                        </FluentGridItem>
                        <FluentGridItem xs="6" md="2">
                            <FluentNumberField TValue="int?" @bind-Value="_form.Port"
                                               Label="@L["Settings_Port"]"
                                               Min="1" Max="65535"
                                               Style="width:100%" />
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_PortHelp"]</FluentLabel>
                        </FluentGridItem>
                    </FluentGrid>

                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        <FluentSwitch @bind-Value="_form.ForceHttps" Label="@L["Settings_ForceHttps"]" />
                        @if (_form.ForceHttps && _form.Scheme == UrlScheme.Http)
                        {
                            <FluentLabel Typo="Typography.Body" Color="Color.Warning">@L["Settings_ForceHttpsSchemeWarning"]</FluentLabel>
                        }
                    </FluentStack>

                    <FluentSelect TOption="WwwPreference"
                                  Items="@(new[] { WwwPreference.NoPreference, WwwPreference.PreferWww, WwwPreference.PreferNonWww })"
                                  OptionText="@(w => WwwLabel(w))"
                                  @bind-SelectedOption="_form.WwwPreference"
                                  Label="@L["Settings_Www"]"
                                  Style="max-width:280px" />

                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                        <FluentLabel Typo="Typography.Subject">@L["Settings_Hsts"]</FluentLabel>
                        <FluentSwitch @bind-Value="_form.HstsEnabled" Label="@L["Settings_HstsEnabled"]" />
                        <FluentGrid Spacing="2">
                            <FluentGridItem xs="12" md="3">
                                <FluentNumberField @bind-Value="_form.HstsMaxAgeDays"
                                                   Label="@L["Settings_HstsMaxAge"]"
                                                   Min="0"
                                                   Disabled="@(!_form.HstsEnabled)"
                                                   Style="width:100%" />
                            </FluentGridItem>
                            <FluentGridItem xs="12" md="9">
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Style="padding-top:24px">
                                    <FluentSwitch @bind-Value="_form.HstsIncludeSubDomains"
                                                  Label="@L["Settings_HstsIncludeSubDomains"]"
                                                  Disabled="@(!_form.HstsEnabled)" />
                                    <FluentSwitch @bind-Value="_form.HstsPreload"
                                                  Label="@L["Settings_HstsPreload"]"
                                                  Disabled="@(!_form.HstsEnabled || !_form.HstsIncludeSubDomains)" />
                                </FluentStack>
                            </FluentGridItem>
                        </FluentGrid>
                        @if (_form.HstsEnabled && _form.HstsPreload)
                        {
                            <FluentLabel Typo="Typography.Body" Color="Color.Warning">@L["Settings_HstsPreloadWarning"]</FluentLabel>
                        }
                    </FluentStack>

                    <div>
                        <FluentTextArea @bind-Value="_form.AliasesText"
                                        Label="@L["Settings_Aliases"]"
                                        Rows="3"
                                        Placeholder="example.com&#10;example.net"
                                        Style="width:100%" />
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_AliasesHelp"]</FluentLabel>
                    </div>

                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral"><small>@L["Settings_EnforcementNote"]</small></FluentLabel>

                    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Settings.Edit)" Context="saveDomain">
                        <FluentButton OnClick="SaveDomainAsync" Appearance="Appearance.Accent">@L["Settings_SaveDomain"]</FluentButton>
                    </AuthorizeView>
                </FluentStack>
            </FluentTab>

            <FluentTab Id="regional" Label="@L["Settings_RegionSection"]">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:720px;padding-top:12px">
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="12" md="4">
                            <FluentSelect TOption="string"
                                          Items="@LanguageOptions"
                                          OptionText="@(c => string.IsNullOrEmpty(c) ? L["Settings_Automatic"] : CultureLabel(c))"
                                          OptionValue="@(c => c)"
                                          @bind-Value="_regional.DefaultLanguage"
                                          Label="@L["Settings_DefaultLanguage"]"
                                          Style="width:100%" />
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_DefaultLanguageHelp"]</FluentLabel>
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="8">
                            <FluentSelect TOption="string"
                                          Items="@TimeZoneOptions"
                                          OptionText="@(id => string.IsNullOrEmpty(id) ? L["Settings_ServerLocal"] : TimeZoneLabel(id))"
                                          OptionValue="@(id => id)"
                                          @bind-Value="_regional.DefaultTimeZoneId"
                                          Label="@L["Settings_DefaultTimeZone"]"
                                          Style="width:100%" />
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_DefaultTimeZoneHelp"]</FluentLabel>
                        </FluentGridItem>
                    </FluentGrid>

                    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Settings.Edit)" Context="saveRegion">
                        <FluentButton OnClick="SaveRegionalAsync" Appearance="Appearance.Accent">@L["Settings_SaveRegion"]</FluentButton>
                    </AuthorizeView>
                </FluentStack>
            </FluentTab>

            <FluentTab Id="encoding" Label="@L["Settings_EncodingSection"]">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:720px;padding-top:12px">
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="12" md="6">
                            <FluentSelect TOption="string"
                                          Items="@Charsets"
                                          OptionText="@(c => c.ToUpperInvariant())"
                                          OptionValue="@(c => c)"
                                          @bind-Value="_encoding.PageCharset"
                                          Label="@L["Settings_PageCharset"]"
                                          Style="width:100%" />
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_PageCharsetHelp"]</FluentLabel>
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <FluentSelect TOption="string"
                                          Items="@Charsets"
                                          OptionText="@(c => c.ToUpperInvariant())"
                                          OptionValue="@(c => c)"
                                          @bind-Value="_encoding.EmailCharset"
                                          Label="@L["Settings_EmailCharset"]"
                                          Style="width:100%" />
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EmailCharsetHelp"]</FluentLabel>
                        </FluentGridItem>
                    </FluentGrid>

                    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Settings.Edit)" Context="saveEncoding">
                        <FluentButton OnClick="SaveEncodingAsync" Appearance="Appearance.Accent">@L["Settings_SaveEncoding"]</FluentButton>
                    </AuthorizeView>
                </FluentStack>
            </FluentTab>

            <FluentTab Id="accounts" Label="@L["Settings_AccountsSection"]">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:720px;padding-top:12px">
                    <div style="max-width:480px">
                        <FluentSelect TOption="string"
                                      Items="@RoleOptions"
                                      OptionText="@(r => string.IsNullOrEmpty(r) ? L["Settings_DefaultRole_None"] : AuthorizationDisplay.RoleName(L, r))"
                                      OptionValue="@(r => r)"
                                      @bind-Value="_accounts.DefaultRole"
                                      Label="@L["Settings_DefaultRole"]"
                                      Style="width:100%" />
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_DefaultRoleHelp"]</FluentLabel>
                        @if (string.IsNullOrEmpty(_accounts.DefaultRole))
                        {
                            @* "No role" is a legitimate choice for sites that vet every account by
                               hand, but its consequence is invisible until someone registers and
                               finds an empty application. State it here instead. *@
                            <FluentMessageBar Intent="MessageIntent.Warning" Type="MessageType.MessageBar" AllowDismiss="false">
                                @L["Admin_Settings_NoDefaultRoleWarning"]
                            </FluentMessageBar>
                        }
                    </div>

                    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Settings.Edit)" Context="saveAccounts">
                        <FluentButton OnClick="SaveAccountsAsync" Appearance="Appearance.Accent">@L["Settings_SaveAccounts"]</FluentButton>
                    </AuthorizeView>
                </FluentStack>
            </FluentTab>

            <FluentTab Id="entra" Label="@L["Settings_EntraSection"]">
                @* Two independent halves, because they are two independent decisions: a tenant may
                   push accounts in over SCIM long before anyone is asked to sign in with them.
                   Secrets are write-only — the page can say one exists, never what it is. *@
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:720px;padding-top:12px">
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EntraIntro"]</FluentLabel>

                    @if (_entra.LockedFields.Count > 0)
                    {
                        @* An edit the merge would discard is worse than a field that says why it is
                           disabled, so the page names exactly what configuration has taken over. *@
                        <FluentMessageBar Intent="MessageIntent.Info" Type="MessageType.MessageBar" AllowDismiss="false">
                            @L["Settings_EntraLocked", string.Join(", ", _entra.LockedFields)]
                        </FluentMessageBar>
                    }

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Settings_EntraSignInSection"]</FluentLabel>
                        <FluentSwitch @bind-Value="_entraForm.Enabled" Disabled="@Locked(EntraFields.Enabled)"
                                      Label="@L["Settings_EntraEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EntraSignInHelp"]</FluentLabel>

                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField @bind-Value="_entraForm.TenantId" Label="@L["Settings_EntraTenantId"]"
                                             Placeholder="00000000-0000-0000-0000-000000000000"
                                             Disabled="@Locked(EntraFields.TenantId)" Style="width:100%" />
                            @LockNote(EntraFields.TenantId)
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField @bind-Value="_entraForm.ClientId" Label="@L["Settings_EntraClientId"]"
                                             Placeholder="00000000-0000-0000-0000-000000000000"
                                             Disabled="@Locked(EntraFields.ClientId)" Style="width:100%" />
                            @LockNote(EntraFields.ClientId)
                        </FluentGridItem>
                    </FluentGrid>

                    <div>
                        <FluentTextField @bind-Value="_entraForm.ClientSecret" TextFieldType="TextFieldType.Password"
                                         Label="@L["Settings_EntraClientSecret"]"
                                         Placeholder="@L["Settings_EntraSecretKeep"]"
                                         Disabled="@Locked(EntraFields.ClientSecret)" Style="width:100%" />
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                            @L[_entra.ClientSecretSet ? "Settings_EntraSecretPresent" : "Settings_EntraSecretAbsent"]
                        </FluentLabel>
                        @LockNote(EntraFields.ClientSecret)
                        @if (_entra.ClientSecretSet && !Locked(EntraFields.ClientSecret))
                        {
                            <FluentCheckbox @bind-Value="_clearClientSecret" Label="@L["Settings_EntraSecretClear"]" />
                        }
                    </div>

                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField @bind-Value="_entraForm.DisplayName" Label="@L["Settings_EntraDisplayName"]"
                                             Maxlength="64" Disabled="@Locked(EntraFields.DisplayName)" Style="width:100%" />
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EntraDisplayNameHelp"]</FluentLabel>
                            @LockNote(EntraFields.DisplayName)
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField @bind-Value="_entraForm.Authority" Label="@L["Settings_EntraAuthority"]"
                                             Placeholder="@_authorityPlaceholder"
                                             Disabled="@Locked(EntraFields.Authority)" Style="width:100%" />
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EntraAuthorityHelp"]</FluentLabel>
                            @LockNote(EntraFields.Authority)
                        </FluentGridItem>
                    </FluentGrid>

                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField @bind-Value="_entraForm.CallbackPath" Label="@L["Settings_EntraCallbackPath"]"
                                             Disabled="@Locked(EntraFields.CallbackPath)" Style="width:100%" />
                            @LockNote(EntraFields.CallbackPath)
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField @bind-Value="_entraForm.SignedOutCallbackPath" Label="@L["Settings_EntraSignedOutPath"]"
                                             Disabled="@Locked(EntraFields.SignedOutCallbackPath)" Style="width:100%" />
                            @LockNote(EntraFields.SignedOutCallbackPath)
                        </FluentGridItem>
                    </FluentGrid>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                        @L["Settings_EntraRedirectHelp"] <code>@_redirectUri</code>
                    </FluentLabel>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Settings_EntraAccountsSection"]</FluentLabel>
                    </div>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        <FluentSwitch @bind-Value="_entraForm.LinkByVerifiedEmail"
                                      Disabled="@Locked(EntraFields.LinkByVerifiedEmail)"
                                      Label="@L["Settings_EntraLinkByEmail"]" />
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EntraLinkByEmailHelp"]</FluentLabel>
                        @LockNote(EntraFields.LinkByVerifiedEmail)
                        <FluentSwitch @bind-Value="_entraForm.AllowJustInTimeProvisioning"
                                      Disabled="@Locked(EntraFields.AllowJustInTimeProvisioning)"
                                      Label="@L["Settings_EntraJit"]" />
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EntraJitHelp"]</FluentLabel>
                        @LockNote(EntraFields.AllowJustInTimeProvisioning)
                    </FluentStack>

                    <div>
                        <FluentLabel Typo="Typography.Body">@L["Settings_EntraDefaultRoles"]</FluentLabel>
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EntraDefaultRolesHelp"]</FluentLabel>
                        @LockNote(EntraFields.DefaultRoles)
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true">
                            @* Administrator is absent by design: a default role is granted to every
                               account the directory creates on first sign-in, so offering it here
                               would make "anyone in the tenant" an administrator of this site. *@
                            @foreach (var role in _roles.Where(r => !string.Equals(r, D3Parking.Domain.Authorization.Roles.Administrator, StringComparison.OrdinalIgnoreCase)))
                            {
                                <FluentCheckbox Label="@AuthorizationDisplay.RoleName(L, role)"
                                                Value="@_entraForm.DefaultRoles.Contains(role)"
                                                ValueChanged="@(c => ToggleDefaultRole(role, c))"
                                                Disabled="@Locked(EntraFields.DefaultRoles)" />
                            }
                        </FluentStack>
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Settings_EntraScimSection"]</FluentLabel>
                        <FluentSwitch @bind-Value="_entraForm.ScimEnabled" Disabled="@Locked(EntraFields.ScimEnabled)"
                                      Label="@L["Settings_EntraEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EntraScimHelp"]</FluentLabel>
                    @LockNote(EntraFields.ScimEnabled)

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EntraScimUrl"]</FluentLabel>
                        <code>@_scimUrl</code>
                    </FluentStack>

                    <div>
                        <FluentTextField @bind-Value="_entraForm.ScimBearerToken" TextFieldType="TextFieldType.Password"
                                         Label="@L["Settings_EntraScimToken"]"
                                         Placeholder="@L["Settings_EntraSecretKeep"]"
                                         Disabled="@Locked(EntraFields.ScimBearerToken)" Style="width:100%" />
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                            @L[_entra.ScimBearerTokenSet ? "Settings_EntraSecretPresent" : "Settings_EntraSecretAbsent"]
                        </FluentLabel>
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EntraScimTokenHelp"]</FluentLabel>
                        @LockNote(EntraFields.ScimBearerToken)
                        @if (_entra.ScimBearerTokenSet && !Locked(EntraFields.ScimBearerToken))
                        {
                            <FluentCheckbox @bind-Value="_clearScimToken" Label="@L["Settings_EntraSecretClear"]" />
                        }
                    </div>

                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        <FluentSwitch @bind-Value="_entraForm.ScimBlockOnDeprovision"
                                      Disabled="@Locked(EntraFields.ScimBlockOnDeprovision)"
                                      Label="@L["Settings_EntraScimBlock"]" />
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_EntraScimBlockHelp"]</FluentLabel>
                        @LockNote(EntraFields.ScimBlockOnDeprovision)
                    </FluentStack>

                    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Settings.Edit)" Context="saveEntra">
                        <FluentButton OnClick="SaveEntraAsync" Appearance="Appearance.Accent"
                                      Disabled="@_entra.IsFullyLocked">@L["Settings_SaveEntra"]</FluentButton>
                    </AuthorizeView>

                    <FluentAnchor Href="/admin/directory" Appearance="Appearance.Hypertext">@L["Settings_EntraRoleMappingLink"]</FluentAnchor>
                </FluentStack>
            </FluentTab>

            <FluentTab Id="general" Label="@L["Settings_GeneralSection"]">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="max-width:720px;padding-top:12px">
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField @bind-Value="_general.SiteName"
                                             Label="@L["Settings_SiteName"]"
                                             Placeholder="D3Parking"
                                             Maxlength="128"
                                             Style="width:100%" />
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_SiteNameHelp"]</FluentLabel>
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField @bind-Value="_general.SiteDescription"
                                             Label="@L["Settings_SiteDescription"]"
                                             Maxlength="512"
                                             Style="width:100%" />
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_SiteDescriptionHelp"]</FluentLabel>
                        </FluentGridItem>
                    </FluentGrid>

                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral"><small>@L["Settings_UrlAppearance"]</small></FluentLabel>

                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="12" md="6">
                            <FluentSelect TOption="TrailingSlashPolicy"
                                          Items="@(new[] { TrailingSlashPolicy.NoPreference, TrailingSlashPolicy.Add, TrailingSlashPolicy.Remove })"
                                          OptionText="@(p => TrailingSlashLabel(p))"
                                          @bind-SelectedOption="_general.TrailingSlash"
                                          Label="@L["Settings_TrailingSlash"]"
                                          Style="width:100%" />
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <div style="padding-top:24px">
                                <FluentSwitch @bind-Value="_general.LowercaseUrls" Label="@L["Settings_LowercaseUrls"]" />
                                <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Settings_LowercaseUrlsHelp"]</FluentLabel>
                            </div>
                        </FluentGridItem>
                    </FluentGrid>

                    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Settings.Edit)" Context="saveGeneral">
                        <FluentButton OnClick="SaveGeneralAsync" Appearance="Appearance.Accent">@L["Settings_SaveGeneral"]</FluentButton>
                    </AuthorizeView>
                </FluentStack>
            </FluentTab>
        </FluentTabs>
    }
</FluentStack>

@code {
    private static readonly IReadOnlyList<TimeZoneInfo> TimeZones = TimeZoneInfo.GetSystemTimeZones();
    private static readonly string[] Charsets = ["utf-8", "iso-8859-2", "windows-1250", "iso-8859-1", "windows-1252"];

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Lets other pages deep-link to a section instead of describing where to click.</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    private string? Tab { get; set; }

    private DomainForm? _form;
    private RegionalForm _regional = new();
    private EncodingForm _encoding = new();
    private AccountsForm _accounts = new();
    private GeneralForm _general = new();
    private EntraSettingsView _entra = EmptyEntraView;
    private EntraForm _entraForm = new();
    private bool _clearClientSecret;
    private bool _clearScimToken;
    private string _scimUrl = string.Empty;
    private string _redirectUri = string.Empty;
    private string _authorityPlaceholder = string.Empty;
    private IReadOnlyList<string> _roles = [];
    private string? _baseUrl;
    private string? _message;
    private string? _error;
    private Guid _adminId;
    private string _activeTab = "domain";

    /// <summary>Stands in until the first load, so the markup never dereferences a null view.</summary>
    private static readonly EntraSettingsView EmptyEntraView = new(
        new EntraSettingsDto(false, null, null, null, "/signin-entra", "/signout-entra", "Microsoft",
            true, true, [], false, true),
        ClientSecretSet: false,
        ScimBearerTokenSet: false,
        LockedFields: new HashSet<string>());

    // Build option lists once; the empty leading entry stands for "automatic / default" in the UI.
    private IEnumerable<string> LanguageOptions => new[] { string.Empty }.Concat(SupportedCultures.All);
    private IEnumerable<string> TimeZoneOptions => new[] { string.Empty }.Concat(TimeZones.Select(t => t.Id));

    // Administrator is deliberately absent: the default role is granted to every self-registered
    // account, and the service refuses it too (Error_DefaultRoleReserved) — this just keeps the
    // impossible choice out of the dropdown.
    private IEnumerable<string> RoleOptions => new[] { string.Empty }
        .Concat(_roles.Where(r => !string.Equals(r, D3Parking.Domain.Authorization.Roles.Administrator, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        var admin = await UserManager.GetUserAsync(state.User);
        _adminId = admin?.Id ?? Guid.Empty;
        _roles = (await RoleAdmin.ListAsync()).Select(r => r.Name).ToArray();

        // Shown so whoever fills in the Entra app registration can copy them rather than guess.
        _scimUrl = new Uri(new Uri(Nav.BaseUri), "scim/v2").ToString();

        if (Tab is { Length: > 0 } requested)
        {
            _activeTab = requested;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var dto = await SiteSettings.GetAsync();
        _baseUrl = dto.CanonicalBaseUrl;
        var d = dto.Domain;
        _form = new DomainForm
        {
            CanonicalHost = d.CanonicalHost,
            Scheme = d.Scheme,
            Port = d.Port,
            ForceHttps = d.ForceHttps,
            HstsEnabled = d.HstsEnabled,
            HstsMaxAgeDays = d.HstsMaxAgeDays,
            HstsIncludeSubDomains = d.HstsIncludeSubDomains,
            HstsPreload = d.HstsPreload,
            WwwPreference = d.WwwPreference,
            AliasesText = string.Join('\n', d.Aliases),
        };
        _regional = new RegionalForm
        {
            DefaultLanguage = dto.Regional.DefaultLanguage ?? string.Empty,
            DefaultTimeZoneId = dto.Regional.DefaultTimeZoneId ?? string.Empty,
        };
        _encoding = new EncodingForm
        {
            PageCharset = dto.Encoding.PageCharset ?? "utf-8",
            EmailCharset = dto.Encoding.EmailCharset ?? "utf-8",
        };
        _accounts = new AccountsForm
        {
            DefaultRole = dto.Accounts.DefaultRole ?? string.Empty,
        };
        _general = new GeneralForm
        {
            SiteName = dto.General.SiteName,
            SiteDescription = dto.General.SiteDescription,
            LowercaseUrls = dto.General.LowercaseUrls,
            TrailingSlash = dto.General.TrailingSlash,
        };

        _entra = await EntraSettings.GetForAdminAsync();
        var e = _entra.Settings;
        _entraForm = new EntraForm
        {
            Enabled = e.Enabled,
            TenantId = e.TenantId,
            ClientId = e.ClientId,
            Authority = e.Authority,
            CallbackPath = e.CallbackPath,
            SignedOutCallbackPath = e.SignedOutCallbackPath,
            DisplayName = e.DisplayName,
            LinkByVerifiedEmail = e.LinkByVerifiedEmail,
            AllowJustInTimeProvisioning = e.AllowJustInTimeProvisioning,
            DefaultRoles = new HashSet<string>(e.DefaultRoles, StringComparer.OrdinalIgnoreCase),
            ScimEnabled = e.ScimEnabled,
            ScimBlockOnDeprovision = e.ScimBlockOnDeprovision,
        };

        // Typed secrets are never carried across a reload; a stale value in a password box would be
        // saved again on the next unrelated edit.
        _clearClientSecret = _clearScimToken = false;
        _entraForm.ClientSecret = _entraForm.ScimBearerToken = null;

        _authorityPlaceholder = $"https://login.microsoftonline.com/{(string.IsNullOrWhiteSpace(e.TenantId) ? "{tenant}" : e.TenantId)}/v2.0";
        _redirectUri = new Uri(new Uri(Nav.BaseUri), e.CallbackPath.TrimStart('/')).ToString();
    }

    private async Task SaveDomainAsync()
    {
        _message = _error = null;
        var aliases = (_form!.AliasesText ?? string.Empty)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        var dto = new DomainSettingsDto(
            _form.CanonicalHost, _form.Scheme, _form.Port, _form.ForceHttps,
            _form.HstsEnabled, _form.HstsMaxAgeDays, _form.HstsIncludeSubDomains,
            _form.HstsPreload, _form.WwwPreference, aliases);

        await ApplyAsync(() => SiteSettings.UpdateDomainAsync(dto, _adminId));
    }

    private Task SaveRegionalAsync() =>
        ApplyAsync(() => SiteSettings.UpdateRegionalAsync(new RegionalSettingsDto(_regional.DefaultLanguage, _regional.DefaultTimeZoneId), _adminId));

    private Task SaveEncodingAsync() =>
        ApplyAsync(() => SiteSettings.UpdateEncodingAsync(new EncodingSettingsDto(_encoding.PageCharset, _encoding.EmailCharset), _adminId));

    private Task SaveAccountsAsync() =>
        ApplyAsync(() => SiteSettings.UpdateAccountsAsync(new AccountsSettingsDto(_accounts.DefaultRole), _adminId));

    private Task SaveGeneralAsync() =>
        ApplyAsync(() => SiteSettings.UpdateGeneralAsync(
            new GeneralSettingsDto(_general.SiteName, _general.SiteDescription, _general.LowercaseUrls, _general.TrailingSlash), _adminId));

    private Task SaveEntraAsync() =>
        ApplyAsync(() => EntraSettings.UpdateAsync(
            new EntraSettingsUpdate(
                new EntraSettingsDto(
                    _entraForm.Enabled,
                    _entraForm.TenantId,
                    _entraForm.ClientId,
                    _entraForm.Authority,
                    _entraForm.CallbackPath,
                    _entraForm.SignedOutCallbackPath,
                    _entraForm.DisplayName,
                    _entraForm.LinkByVerifiedEmail,
                    _entraForm.AllowJustInTimeProvisioning,
                    [.. _entraForm.DefaultRoles],
                    _entraForm.ScimEnabled,
                    _entraForm.ScimBlockOnDeprovision),
                Secret(_entraForm.ClientSecret, _clearClientSecret),
                Secret(_entraForm.ScimBearerToken, _clearScimToken)),
            _adminId));

    /// <summary>
    /// A blank box means "leave it alone", because the page never showed what is there to begin
    /// with. Removing a secret therefore has to be asked for explicitly.
    /// </summary>
    private static EntraSecretUpdate Secret(string? typed, bool clear) =>
        !string.IsNullOrWhiteSpace(typed) ? EntraSecretUpdate.Set(typed.Trim())
        : clear ? EntraSecretUpdate.Clear
        : EntraSecretUpdate.Keep;

    private bool Locked(string field) => _entra.IsLocked(field);

    private void ToggleDefaultRole(string role, bool selected)
    {
        if (selected)
        {
            _entraForm.DefaultRoles.Add(role);
        }
        else
        {
            _entraForm.DefaultRoles.Remove(role);
        }
    }

    private RenderFragment? LockNote(string field)
    {
        if (!Locked(field))
        {
            return null;
        }

        return @<span class="settings-lock">@L["Settings_EntraFieldLocked"]</span>;
    }

    private async Task ApplyAsync(Func<Task<AccountResult>> action)
    {
        _message = _error = null;
        var result = await action();
        if (result.Succeeded)
        {
            _message = L["Settings_Saved"];
            await LoadAsync();
        }
        else
        {
            _error = string.Join(" ", result.Errors);
        }
    }

    private static string CultureLabel(string culture)
    {
        try
        {
            var info = System.Globalization.CultureInfo.GetCultureInfo(culture);
            return $"{info.NativeName} ({culture})";
        }
        catch (System.Globalization.CultureNotFoundException)
        {
            return culture;
        }
    }

    private static string TimeZoneLabel(string id)
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(id).DisplayName;
        }
        catch
        {
            return id;
        }
    }

    private string WwwLabel(WwwPreference value) => value switch
    {
        WwwPreference.PreferWww => L["Settings_Www_PreferWww"],
        WwwPreference.PreferNonWww => L["Settings_Www_PreferNonWww"],
        _ => L["Settings_Www_NoPreference"],
    };

    private string TrailingSlashLabel(TrailingSlashPolicy value) => value switch
    {
        TrailingSlashPolicy.Add => L["Settings_TrailingSlash_Add"],
        TrailingSlashPolicy.Remove => L["Settings_TrailingSlash_Remove"],
        _ => L["Settings_TrailingSlash_None"],
    };

    private sealed class DomainForm
    {
        public string? CanonicalHost { get; set; }
        public UrlScheme Scheme { get; set; } = UrlScheme.Https;
        public int? Port { get; set; }
        public bool ForceHttps { get; set; } = true;
        public bool HstsEnabled { get; set; }
        public int HstsMaxAgeDays { get; set; } = 365;
        public bool HstsIncludeSubDomains { get; set; }
        public bool HstsPreload { get; set; }
        public WwwPreference WwwPreference { get; set; } = WwwPreference.NoPreference;
        public string AliasesText { get; set; } = string.Empty;
    }

    private sealed class RegionalForm
    {
        public string? DefaultLanguage { get; set; }
        public string? DefaultTimeZoneId { get; set; }
    }

    private sealed class EncodingForm
    {
        public string? PageCharset { get; set; }
        public string? EmailCharset { get; set; }
    }

    private sealed class AccountsForm
    {
        public string? DefaultRole { get; set; }
    }

    private sealed class EntraForm
    {
        public bool Enabled { get; set; }
        public string? TenantId { get; set; }
        public string? ClientId { get; set; }

        /// <summary>Write-only: holds what was typed now, never what is stored.</summary>
        public string? ClientSecret { get; set; }

        public string? Authority { get; set; }
        public string CallbackPath { get; set; } = "/signin-entra";
        public string SignedOutCallbackPath { get; set; } = "/signout-entra";
        public string DisplayName { get; set; } = "Microsoft";
        public bool LinkByVerifiedEmail { get; set; } = true;
        public bool AllowJustInTimeProvisioning { get; set; } = true;
        public HashSet<string> DefaultRoles { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public bool ScimEnabled { get; set; }

        /// <summary>Write-only, as <see cref="ClientSecret"/>.</summary>
        public string? ScimBearerToken { get; set; }

        public bool ScimBlockOnDeprovision { get; set; } = true;
    }

    private sealed class GeneralForm
    {
        public string? SiteName { get; set; }
        public string? SiteDescription { get; set; }
        public bool LowercaseUrls { get; set; }
        public TrailingSlashPolicy TrailingSlash { get; set; } = TrailingSlashPolicy.NoPreference;
    }
}
