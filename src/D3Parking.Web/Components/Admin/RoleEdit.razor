@page "/admin/roles/{Id:guid}"
@attribute [HasPermission(Permissions.Roles.View)]
@rendermode InteractiveServer
@inject IRoleAdminService RoleAdmin
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Admin_RoleEdit_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.PageTitle">@L["Admin_RoleEdit_Title"]</FluentLabel>
    <FluentAnchor Href="admin/roles" Appearance="Appearance.Hypertext">&laquo; @L["Admin_Roles_Title"]</FluentAnchor>

    @if (_detail is null)
    {
        @if (_loaded)
        {
            <FluentLabel Typo="Typography.Body">@L["Admin_Roles_NotFound"]</FluentLabel>
        }
        else
        {
            <div class="loading"><FluentProgressRing /></div>
        }
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar">@_message</FluentMessageBar>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@_error</FluentMessageBar>
        }

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
            <FluentTextField @bind-Value="_name" Label="@L["Admin_Roles_Name"]"
                             Disabled="_detail.IsDefault" Style="max-width:480px;flex:1" />
            @if (_detail.IsDefault)
            {
                <FluentBadge Appearance="Appearance.Neutral">@L["Admin_Roles_Default"]</FluentBadge>
            }
            else
            {
                <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Edit)" Context="rename">
                    <FluentButton OnClick="RenameAsync" Appearance="Appearance.Outline">@L["Admin_RoleEdit_Rename"]</FluentButton>
                </AuthorizeView>
            }
        </FluentStack>

        <FluentCard Class="profile-section">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                <FluentLabel Typo="Typography.Subject">@L["Admin_Roles_Permissions"]</FluentLabel>
                @if (_readOnly)
                {
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Admin_RoleEdit_AdminAll"]</FluentLabel>
                }
                <PermissionEditor Catalog="RoleAdmin.PermissionCatalog" Selected="_selected" Disabled="_readOnly" />

                @if (!_readOnly)
                {
                    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Edit)" Context="savePerms">
                        <FluentButton OnClick="SavePermissionsAsync" Appearance="Appearance.Accent">@L["Admin_Save"]</FluentButton>
                    </AuthorizeView>
                }
            </FluentStack>
        </FluentCard>

        @if (!_detail.IsDefault)
        {
            <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Delete)" Context="delete">
                <div class="danger-zone">
                    <div class="danger-zone__title">@L["Admin_UserEdit_DangerZone"]</div>
                    @if (_confirmDelete)
                    {
                        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="false">
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                <span>@L["Admin_RoleEdit_DeleteConfirm"]</span>
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                                    <FluentButton OnClick="DeleteAsync" Appearance="Appearance.Accent">
                                        @L["Admin_RoleEdit_DeleteYes"]
                                    </FluentButton>
                                    <FluentButton OnClick="() => _confirmDelete = false" Appearance="Appearance.Outline">
                                        @L["Admin_Cancel"]
                                    </FluentButton>
                                </FluentStack>
                            </FluentStack>
                        </FluentMessageBar>
                    }
                    else
                    {
                        <FluentButton OnClick="() => _confirmDelete = true" Appearance="Appearance.Outline">
                            @L["Admin_RoleEdit_Delete"]
                        </FluentButton>
                    }
                </div>
            </AuthorizeView>
        }
    }
</FluentStack>

@code {
    [Parameter] public Guid Id { get; set; }

    private RoleDetail? _detail;
    private bool _loaded;
    private string? _name;
    private bool _readOnly;
    private HashSet<string> _selected = new(StringComparer.Ordinal);
    private bool _confirmDelete;
    private string? _message;
    private string? _error;

    private Guid _loadedId;

    protected override async Task OnParametersSetAsync()
    {
        // Reload when the route parameter changes on a reused instance — otherwise the screen
        // would keep showing the previous role while the actions target the new Id.
        if (_loadedId != Id)
        {
            _loadedId = Id;
            _message = _error = null;
            _confirmDelete = false;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _detail = await RoleAdmin.GetAsync(Id);
        _loaded = true;
        if (_detail is not null)
        {
            _name = _detail.Name;
            _selected = _detail.Permissions.ToHashSet(StringComparer.Ordinal);
            _readOnly = string.Equals(_detail.Name, Roles.Administrator, StringComparison.Ordinal);
        }
    }

    private async Task RenameAsync() =>
        await RunAsync(() => RoleAdmin.RenameAsync(Id, _name ?? string.Empty), L["Admin_RoleEdit_Renamed"]);

    private async Task SavePermissionsAsync() =>
        await RunAsync(() => RoleAdmin.SetPermissionsAsync(Id, _selected.ToArray()), L["Admin_RoleEdit_PermsSaved"]);

    private async Task DeleteAsync()
    {
        var result = await RoleAdmin.DeleteAsync(Id);
        if (result.Succeeded)
        {
            Nav.NavigateTo("admin/roles");
            return;
        }

        _confirmDelete = false;
        _error = string.Join(" ", result.Errors);
    }

    private async Task RunAsync(Func<Task<AccountResult>> action, string successMessage)
    {
        _message = _error = null;
        var result = await action();
        if (result.Succeeded)
        {
            _message = successMessage;
            await LoadAsync();
        }
        else
        {
            _error = string.Join(" ", result.Errors);
        }
    }
}
