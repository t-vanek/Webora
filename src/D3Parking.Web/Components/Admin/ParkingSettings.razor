@page "/admin/parking/settings"
@attribute [HasPermission(Permissions.Parking.ManageIncentives)]
@rendermode InteractiveServer
@inject IParkingSettingsService SettingsService
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

@* Every feature group carries its own on/off switch in the section head. Off = the group's
   driving values save as zero, which is exactly how the domain already understands "disabled"
   (zero decay percent skips decay, zero base cost makes bookings free, …) — no schema change.
   The switch state is derived back from the values on load, and re-enabling a zeroed group
   seeds the documented defaults so the admin doesn't resurrect a feature into a dead config.

   Bounded percentages render as sliders; open-ended numbers stay stepper fields — fewer places
   to type, none where a slider would just be a worse keyboard. *@

<PageTitle>@L["Parking_Settings_Title"]</PageTitle>

<FluentStack Class="settings-page" Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.PageTitle">@L["Parking_Settings_Title"]</FluentLabel>
    <FluentLabel Typo="Typography.Body">@L["Parking_Settings_Intro"]</FluentLabel>

    @if (_form is null)
    {
        <FluentProgressRing />
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar">@_message</FluentMessageBar>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@L[_error]</FluentMessageBar>
        }

        <FluentTabs @bind-ActiveTabId="_activeTab">
            <FluentTab Id="economy" Label="@L["Parking_Settings_Tab_Economy"]">
                <div class="settings-panel">
                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_EconomySection"]</FluentLabel>
                        <FluentSwitch Value="@_economyOn" ValueChanged="ToggleEconomy" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_EconomyHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.BaseReservationCost" Min="0" Disabled="@(!_economyOn)"
                                           Label="@L["Parking_Settings_BaseCost"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.PeakPricePercent" Min="100" Step="10" Disabled="@(!_economyOn)"
                                           Label="@L["Parking_Settings_PeakPercent"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.OccupancyPricePercent" Min="0" Step="10" Disabled="@(!_economyOn)"
                                           Label="@L["Parking_Settings_OccupancyPercent"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.MaxReservationCost" Min="0" Disabled="@(!_economyOn)"
                                           Label="@L["Parking_Settings_MaxCost"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.MonthlyCreditAllowance" Min="0" Step="10" Disabled="@(!_economyOn)"
                                           Label="@L["Parking_Settings_MonthlyAllowance"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.QueueOfferMinutes" Min="1"
                                           Label="@L["Parking_Settings_QueueOfferMinutes"]" Style="width:100%" />
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_AdaptiveSection"]</FluentLabel>
                        <FluentSwitch @bind-Value="_form.AdaptivePricingEnabled" Label="@L["Parking_Settings_SectionEnabled"]" Disabled="@(!_economyOn)" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_AdaptiveHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <div class="settings-field settings-field--wide">
                            <span class="settings-field__label">@L["Parking_Settings_AdaptiveTarget"] <span class="settings-field__val">@_form.AdaptiveTargetOccupancyPercent %</span></span>
                            <FluentSlider TValue="int" Min="1" Max="100" Step="1" @bind-Value="_form.AdaptiveTargetOccupancyPercent"
                                          Disabled="@(!_economyOn || !_form.AdaptivePricingEnabled)" Style="width:100%" />
                        </div>
                        <div class="settings-field settings-field--wide">
                            <span class="settings-field__label">@L["Parking_Settings_AdaptiveDeadband"] <span class="settings-field__val">@_form.AdaptiveDeadbandPercent %</span></span>
                            <FluentSlider TValue="int" Min="0" Max="50" Step="1" @bind-Value="_form.AdaptiveDeadbandPercent"
                                          Disabled="@(!_economyOn || !_form.AdaptivePricingEnabled)" Style="width:100%" />
                        </div>
                        <FluentNumberField TValue="int" @bind-Value="_form.AdaptiveIntervalMinutes" Min="1" Disabled="@(!_economyOn || !_form.AdaptivePricingEnabled)"
                                           Label="@L["Parking_Settings_AdaptiveInterval"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.AdaptiveGainPercent" Min="0" Step="10" Disabled="@(!_economyOn || !_form.AdaptivePricingEnabled)"
                                           Label="@L["Parking_Settings_AdaptiveGain"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.AdaptiveStepMaxPercent" Min="0" Step="5" Disabled="@(!_economyOn || !_form.AdaptivePricingEnabled)"
                                           Label="@L["Parking_Settings_AdaptiveStepMax"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.AdaptivePeakMinPercent" Min="100" Step="10" Disabled="@(!_economyOn || !_form.AdaptivePricingEnabled)"
                                           Label="@L["Parking_Settings_AdaptivePeakMin"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.AdaptivePeakMaxPercent" Min="100" Step="10" Disabled="@(!_economyOn || !_form.AdaptivePricingEnabled)"
                                           Label="@L["Parking_Settings_AdaptivePeakMax"]" Style="width:100%" />
                    </div>
                </div>
            </FluentTab>

            <FluentTab Id="points" Label="@L["Parking_Settings_Tab_Points"]">
                <div class="settings-panel">
                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_PointsSection"]</FluentLabel>
                        <FluentSwitch Value="@_pointsOn" ValueChanged="TogglePoints" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_PointsHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.ReleasePoints" Min="0" Disabled="@(!_pointsOn)"
                                           Label="@L["Parking_Settings_ReleasePoints"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.OffPeakBonusPoints" Min="0" Disabled="@(!_pointsOn)"
                                           Label="@L["Parking_Settings_OffPeakBonus"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.NoShowPenaltyPoints" Min="0" Disabled="@(!_pointsOn)"
                                           Label="@L["Parking_Settings_NoShowPenalty"]" Style="width:100%" />
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_DemandRewardSection"]</FluentLabel>
                        <FluentSwitch Value="@_demandOn" ValueChanged="ToggleDemand" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_DemandRewardHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.DemandReleaseOccupancyPercent" Min="0" Step="10" Disabled="@(!_demandOn)"
                                           Label="@L["Parking_Settings_DemandOccupancyPercent"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.DemandReleaseQueueBonus" Min="0" Disabled="@(!_demandOn)"
                                           Label="@L["Parking_Settings_DemandQueueBonus"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.MaxReleaseReward" Min="0" Disabled="@(!_demandOn)"
                                           Label="@L["Parking_Settings_MaxReleaseReward"]" Style="width:100%" />
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_StreakGroup"]</FluentLabel>
                        <FluentSwitch Value="@_streakOn" ValueChanged="ToggleStreak" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_StreakHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.StreakBonusPerLevel" Min="0" Disabled="@(!_streakOn)"
                                           Label="@L["Parking_Settings_StreakBonusPerLevel"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.StreakBonusCap" Min="0" Disabled="@(!_streakOn)"
                                           Label="@L["Parking_Settings_StreakBonusCap"]" Style="width:100%" />
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_TiersGroup"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_LoyaltyHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.TierSilverPoints" Min="0" Step="10"
                                           Label="@L["Parking_Settings_TierSilver"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.TierGoldPoints" Min="0" Step="10"
                                           Label="@L["Parking_Settings_TierGold"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.TierPlatinumPoints" Min="0" Step="10"
                                           Label="@L["Parking_Settings_TierPlatinum"]" Style="width:100%" />
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_DecayGroup"]</FluentLabel>
                        <FluentSwitch Value="@_decayOn" ValueChanged="ToggleDecay" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_DecayHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <div class="settings-field settings-field--wide">
                            <span class="settings-field__label">@L["Parking_Settings_ReputationDecayPercent"] <span class="settings-field__val">@_form.ReputationDecayPercent %</span></span>
                            <FluentSlider TValue="int" Min="1" Max="100" Step="1" @bind-Value="_form.ReputationDecayPercent"
                                          Disabled="@(!_decayOn)" Style="width:100%" />
                        </div>
                        <FluentNumberField TValue="int" @bind-Value="_form.ReputationDecayIntervalDays" Min="1" Disabled="@(!_decayOn)"
                                           Label="@L["Parking_Settings_ReputationDecayInterval"]" Style="width:100%" />
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_TierPerksSection"]</FluentLabel>
                        <FluentSwitch Value="@_perksOn" ValueChanged="TogglePerks" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_TierPerksHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.QueuePriorityPerTier" Min="0" Step="5" Disabled="@(!_perksOn)"
                                           Label="@L["Parking_Settings_QueuePriorityPerTier"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.TierAllowanceBonus" Min="0" Step="5" Disabled="@(!_perksOn)"
                                           Label="@L["Parking_Settings_TierAllowanceBonus"]" Style="width:100%" />
                        <div class="settings-field settings-field--wide">
                            <span class="settings-field__label">@L["Parking_Settings_TierDiscountPercent"] <span class="settings-field__val">@_form.TierDiscountPercent %</span></span>
                            <FluentSlider TValue="int" Min="0" Max="30" Step="1" @bind-Value="_form.TierDiscountPercent"
                                          Disabled="@(!_perksOn)" Style="width:100%" />
                        </div>
                    </div>
                </div>
            </FluentTab>

            <FluentTab Id="trust" Label="@L["Parking_Settings_Tab_Trust"]">
                <div class="settings-panel">
                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_TrustSection"]</FluentLabel>
                        <FluentSwitch @bind-Value="_form.TrustEnabled" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_TrustHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.TrustIntervalHours" Min="1" Disabled="@(!_form.TrustEnabled)"
                                           Label="@L["Parking_Settings_TrustInterval"]" Style="width:100%" />
                        <div class="settings-field settings-field--wide">
                            <span class="settings-field__label">@L["Parking_Settings_TrustThreshold"] <span class="settings-field__val">@_form.TrustedBadgeThreshold</span></span>
                            <FluentSlider TValue="int" Min="0" Max="100" Step="5" @bind-Value="_form.TrustedBadgeThreshold"
                                          Disabled="@(!_form.TrustEnabled)" Style="width:100%" />
                        </div>
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_CollusionSection"]</FluentLabel>
                        <FluentSwitch @bind-Value="_form.AntiCollusionEnabled" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_CollusionHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.CollusionMinInteractions" Min="2" Disabled="@(!_form.AntiCollusionEnabled)"
                                           Label="@L["Parking_Settings_CollusionMin"]" Style="width:100%" />
                        <div class="settings-field settings-field--wide">
                            <span class="settings-field__label">@L["Parking_Settings_CollusionConcentration"] <span class="settings-field__val">@_form.CollusionConcentrationPercent %</span></span>
                            <FluentSlider TValue="int" Min="1" Max="100" Step="1" @bind-Value="_form.CollusionConcentrationPercent"
                                          Disabled="@(!_form.AntiCollusionEnabled)" Style="width:100%" />
                        </div>
                        <FluentNumberField TValue="int" @bind-Value="_form.MaxPairTrustWeight" Min="1" Disabled="@(!_form.AntiCollusionEnabled)"
                                           Label="@L["Parking_Settings_MaxPairTrustWeight"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.CollusionScanIntervalHours" Min="1" Disabled="@(!_form.AntiCollusionEnabled)"
                                           Label="@L["Parking_Settings_CollusionInterval"]" Style="width:100%" />
                    </div>
                    <FluentAnchor Href="/admin/parking/collusion" Appearance="Appearance.Hypertext">@L["Parking_Settings_CollusionReviewLink"]</FluentAnchor>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_AvailabilitySection"]</FluentLabel>
                        <FluentSwitch @bind-Value="_form.AvailabilityCampaignsEnabled" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_AvailabilityHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.AvailabilityLookaheadDays" Min="1" Max="60" Disabled="@(!_form.AvailabilityCampaignsEnabled)"
                                           Label="@L["Parking_Settings_AvailabilityLookahead"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.AvailabilityFreeThresholdPercent" Min="1" Max="100" Disabled="@(!_form.AvailabilityCampaignsEnabled)"
                                           Label="@L["Parking_Settings_AvailabilityThreshold"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.AvailabilityMinConsecutiveDays" Min="1" Max="30" Disabled="@(!_form.AvailabilityCampaignsEnabled)"
                                           Label="@L["Parking_Settings_AvailabilityMinDays"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.AvailabilitySendHourLocal" Min="0" Max="23" Disabled="@(!_form.AvailabilityCampaignsEnabled)"
                                           Label="@L["Parking_Settings_AvailabilitySendHour"]" Style="width:100%" />
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_QueuePenaltySection"]</FluentLabel>
                        <FluentSwitch Value="@_queuePenaltyOn" ValueChanged="ToggleQueuePenalty" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_QueuePenaltyHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.QueueNoShowPenaltyPoints" Min="0" Step="5" Disabled="@(!_queuePenaltyOn)"
                                           Label="@L["Parking_Settings_QueueNoShowPoints"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.QueueNoShowCreditPenalty" Min="0" Step="5" Disabled="@(!_queuePenaltyOn)"
                                           Label="@L["Parking_Settings_QueueNoShowCredits"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.QueueNoShowBanDays" Min="0" Disabled="@(!_queuePenaltyOn)"
                                           Label="@L["Parking_Settings_QueueNoShowBanDays"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.QueueNoShowAllowancePenalty" Min="0" Step="5" Disabled="@(!_queuePenaltyOn)"
                                           Label="@L["Parking_Settings_QueueNoShowAllowance"]" Style="width:100%" />
                    </div>
                </div>
            </FluentTab>

            <FluentTab Id="queue" Label="@L["Parking_Settings_Tab_Queue"]">
                <div class="settings-panel">
                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_PeakSection"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_PeakHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <div class="settings-field">
                            <span class="settings-field__label">@L["Parking_Settings_PeakStart"]</span>
                            <input type="time" @bind="_form.PeakStart" class="parking-input" />
                        </div>
                        <div class="settings-field">
                            <span class="settings-field__label">@L["Parking_Settings_PeakEnd"]</span>
                            <input type="time" @bind="_form.PeakEnd" class="parking-input" />
                        </div>
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_TimingSection"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_MinutesHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.ReleaseCutoffMinutes" Min="0" Step="5"
                                           Label="@L["Parking_Settings_ReleaseCutoff"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.NoShowGraceMinutes" Min="0" Step="5"
                                           Label="@L["Parking_Settings_NoShowGrace"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.ReminderLeadMinutes" Min="0"
                                           Label="@L["Parking_Settings_ReminderLead"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.SweepIntervalMinutes" Min="1"
                                           Label="@L["Parking_Settings_SweepInterval"]" Style="width:100%" />
                    </div>
                </div>
            </FluentTab>

            <FluentTab Id="residents" Label="@L["Parking_Settings_Tab_Residents"]">
                <div class="settings-panel">
                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_ResidentSection"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_ResidentsHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <div class="settings-field">
                            <span class="settings-field__label">@L["Parking_Settings_ResidentHoldUntil"]</span>
                            <input type="time" @bind="_form.ResidentHoldUntil" class="parking-input" />
                        </div>
                        <FluentNumberField TValue="int" @bind-Value="_form.ResidentReleasePointsPerHour" Min="0"
                                           Label="@L["Parking_Settings_ResidentPointsPerHour"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.ResidentReleaseMaxPoints" Min="0" Step="5"
                                           Label="@L["Parking_Settings_ResidentMaxPoints"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.ResidentMaxShareAllowance" Min="0"
                                           Label="@L["Parking_Settings_ResidentMaxAllowance"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.ResidentSharePercentPerAllowance" Min="0"
                                           Label="@L["Parking_Settings_ResidentPercentPerAllowance"]" Style="width:100%" />
                        <div class="settings-field settings-field--wide">
                            <span class="settings-field__label">@L["Parking_Settings_ResidentClawback"] <span class="settings-field__val">@_form.ResidentWastedShareClawbackPercent %</span></span>
                            <FluentSlider TValue="int" Min="0" Max="100" Step="5" @bind-Value="_form.ResidentWastedShareClawbackPercent" Style="width:100%" />
                        </div>
                    </div>
                </div>
            </FluentTab>

            <FluentTab Id="location" Label="@L["Parking_Settings_Tab_Location"]">
                <div class="settings-panel">
                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_DistanceSection"]</FluentLabel>
                        <FluentSwitch Value="@_distanceOn" ValueChanged="ToggleDistance" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_DistanceHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="double?" @bind-Value="_form.LotLatitude" Step="0.0001"
                                           Label="@L["Parking_Settings_LotLat"]" Style="width:100%" />
                        <FluentNumberField TValue="double?" @bind-Value="_form.LotLongitude" Step="0.0001"
                                           Label="@L["Parking_Settings_LotLon"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.SharedTakenBasePoints" Min="0" Disabled="@(!_distanceOn)"
                                           Label="@L["Parking_Settings_TakenBase"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.SharedTakenReferenceKm" Min="1" Disabled="@(!_distanceOn)"
                                           Label="@L["Parking_Settings_TakenRefKm"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.SharedTakenMaxMultiplier" Min="1" Disabled="@(!_distanceOn)"
                                           Label="@L["Parking_Settings_TakenMaxMult"]" Style="width:100%" />
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_LimitsSection"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_LimitsHelp"]</FluentLabel>
                    <FluentSwitch @bind-Value="_form.AutoVerifyHomeAddress" Label="@L["Parking_Settings_AutoVerify"]" />
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.AutoVerifyMaxDistanceKm" Min="0" Step="5" Disabled="@(!_form.AutoVerifyHomeAddress)"
                                           Label="@L["Parking_Settings_AutoVerifyMaxKm"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.MaxRewardedReleasesPerDay" Min="0"
                                           Label="@L["Parking_Settings_MaxReleasesPerDay"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.MaxReleaseRangeDays" Min="1" Max="366"
                                           Label="@L["Parking_Settings_MaxRangeDays"]" Style="width:100%" />
                    </div>
                </div>
            </FluentTab>
        </FluentTabs>

        <FluentButton OnClick="SaveAsync" Appearance="Appearance.Accent" Style="margin-top:16px">@L["Parking_Settings_Save"]</FluentButton>
    }
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private SettingsForm? _form;
    private Guid _adminId;
    private string? _message;
    private string? _error;
    private string _activeTab = "economy";

    // Section switches. Derived from the stored values on load; on save an off switch forces the
    // group's driving values to zero, which is what the domain treats as "feature disabled".
    private bool _economyOn;
    private bool _pointsOn;
    private bool _demandOn;
    private bool _streakOn;
    private bool _perksOn;
    private bool _decayOn;
    private bool _queuePenaltyOn;
    private bool _distanceOn;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        var admin = await UserManager.GetUserAsync(state.User);
        _adminId = admin?.Id ?? Guid.Empty;
        await LoadAsync();
    }

    // Re-enabling a group whose values were saved as zeros would resurrect it into a dead
    // config, so each toggle seeds the documented defaults (IncentivePolicy.Default) when
    // everything it governs is zero. Values from the same session survive an off/on flip.
    private void ToggleEconomy(bool on)
    {
        _economyOn = on;
        if (on && _form!.BaseReservationCost == 0)
        {
            _form.BaseReservationCost = 10;
            _form.PeakPricePercent = 200;
            _form.OccupancyPricePercent = 100;
            _form.MaxReservationCost = 40;
        }
    }

    private void TogglePoints(bool on)
    {
        _pointsOn = on;
        if (on && _form!.ReleasePoints == 0 && _form.OffPeakBonusPoints == 0 && _form.NoShowPenaltyPoints == 0)
        {
            _form.ReleasePoints = 10;
            _form.OffPeakBonusPoints = 5;
            _form.NoShowPenaltyPoints = 20;
        }
    }

    private void ToggleDemand(bool on)
    {
        _demandOn = on;
        if (on && _form!.DemandReleaseOccupancyPercent == 0 && _form.DemandReleaseQueueBonus == 0)
        {
            _form.DemandReleaseOccupancyPercent = 100;
            _form.DemandReleaseQueueBonus = 5;
        }
    }

    private void ToggleStreak(bool on)
    {
        _streakOn = on;
        if (on && _form!.StreakBonusPerLevel == 0)
        {
            _form.StreakBonusPerLevel = 2;
            _form.StreakBonusCap = _form.StreakBonusCap == 0 ? 20 : _form.StreakBonusCap;
        }
    }

    private void TogglePerks(bool on)
    {
        _perksOn = on;
        if (on && _form!.QueuePriorityPerTier == 0 && _form.TierAllowanceBonus == 0 && _form.TierDiscountPercent == 0)
        {
            _form.QueuePriorityPerTier = 30;
            _form.TierAllowanceBonus = 20;
            _form.TierDiscountPercent = 5;
        }
    }

    private void ToggleDecay(bool on)
    {
        _decayOn = on;
        if (on && _form!.ReputationDecayPercent == 0)
        {
            _form.ReputationDecayPercent = 10;
        }
    }

    private void ToggleQueuePenalty(bool on)
    {
        _queuePenaltyOn = on;
        if (on && _form!.QueueNoShowPenaltyPoints == 0 && _form.QueueNoShowCreditPenalty == 0
            && _form.QueueNoShowBanDays == 0 && _form.QueueNoShowAllowancePenalty == 0)
        {
            _form.QueueNoShowPenaltyPoints = 50;
            _form.QueueNoShowCreditPenalty = 30;
            _form.QueueNoShowBanDays = 14;
            _form.QueueNoShowAllowancePenalty = 30;
        }
    }

    private void ToggleDistance(bool on)
    {
        _distanceOn = on;
        if (on && _form!.SharedTakenBasePoints == 0)
        {
            _form.SharedTakenBasePoints = 5;
        }
    }

    private async Task LoadAsync()
    {
        var s = await SettingsService.GetAsync();
        _form = new SettingsForm
        {
            ReleasePoints = s.ReleasePoints,
            OffPeakBonusPoints = s.OffPeakBonusPoints,
            NoShowPenaltyPoints = s.NoShowPenaltyPoints,
            ReleaseCutoffMinutes = (int)s.ReleaseCutoff.TotalMinutes,
            NoShowGraceMinutes = (int)s.NoShowGracePeriod.TotalMinutes,
            ReminderLeadMinutes = (int)s.ReminderLeadTime.TotalMinutes,
            SweepIntervalMinutes = (int)s.SweepInterval.TotalMinutes,
            PeakStart = s.PeakStart,
            PeakEnd = s.PeakEnd,
            ResidentHoldUntil = s.ResidentHoldUntil,
            ResidentReleasePointsPerHour = s.ResidentReleasePointsPerHour,
            ResidentReleaseMaxPoints = s.ResidentReleaseMaxPoints,
            ResidentMaxShareAllowance = s.ResidentMaxShareAllowance,
            ResidentSharePercentPerAllowance = s.ResidentSharePercentPerAllowance,
            ResidentWastedShareClawbackPercent = s.ResidentWastedShareClawbackPercent,
            LotLatitude = s.LotLatitude,
            LotLongitude = s.LotLongitude,
            SharedTakenBasePoints = s.SharedTakenBasePoints,
            SharedTakenReferenceKm = s.SharedTakenReferenceKm,
            SharedTakenMaxMultiplier = s.SharedTakenMaxMultiplier,
            AutoVerifyHomeAddress = s.AutoVerifyHomeAddress,
            AutoVerifyMaxDistanceKm = s.AutoVerifyMaxDistanceKm,
            MaxRewardedReleasesPerDay = s.MaxRewardedReleasesPerDay,
            MaxReleaseRangeDays = s.MaxReleaseRangeDays,
            BaseReservationCost = s.BaseReservationCost,
            PeakPricePercent = s.PeakPricePercent,
            OccupancyPricePercent = s.OccupancyPricePercent,
            MaxReservationCost = s.MaxReservationCost,
            MonthlyCreditAllowance = s.MonthlyCreditAllowance,
            QueueOfferMinutes = s.QueueOfferMinutes,
            QueueNoShowPenaltyPoints = s.QueueNoShowPenaltyPoints,
            QueueNoShowCreditPenalty = s.QueueNoShowCreditPenalty,
            QueueNoShowBanDays = s.QueueNoShowBanDays,
            QueueNoShowAllowancePenalty = s.QueueNoShowAllowancePenalty,
            DemandReleaseOccupancyPercent = s.DemandReleaseOccupancyPercent,
            DemandReleaseQueueBonus = s.DemandReleaseQueueBonus,
            MaxReleaseReward = s.MaxReleaseReward,
            StreakBonusPerLevel = s.StreakBonusPerLevel,
            StreakBonusCap = s.StreakBonusCap,
            TierSilverPoints = s.TierSilverPoints,
            TierGoldPoints = s.TierGoldPoints,
            TierPlatinumPoints = s.TierPlatinumPoints,
            QueuePriorityPerTier = s.QueuePriorityPerTier,
            TierAllowanceBonus = s.TierAllowanceBonus,
            TierDiscountPercent = s.TierDiscountPercent,
            ReputationDecayPercent = s.ReputationDecayPercent,
            ReputationDecayIntervalDays = s.ReputationDecayIntervalDays,
            AdaptivePricingEnabled = s.AdaptivePricingEnabled,
            AdaptiveTargetOccupancyPercent = s.AdaptiveTargetOccupancyPercent,
            AdaptiveGainPercent = s.AdaptiveGainPercent,
            AdaptiveDeadbandPercent = s.AdaptiveDeadbandPercent,
            AdaptiveStepMaxPercent = s.AdaptiveStepMaxPercent,
            AdaptivePeakMinPercent = s.AdaptivePeakMinPercent,
            AdaptivePeakMaxPercent = s.AdaptivePeakMaxPercent,
            AdaptiveIntervalMinutes = s.AdaptiveIntervalMinutes,
            TrustEnabled = s.TrustEnabled,
            TrustIntervalHours = s.TrustIntervalHours,
            TrustedBadgeThreshold = s.TrustedBadgeThreshold,
            MaxPairTrustWeight = s.MaxPairTrustWeight,
            AntiCollusionEnabled = s.AntiCollusionEnabled,
            CollusionMinInteractions = s.CollusionMinInteractions,
            CollusionConcentrationPercent = s.CollusionConcentrationPercent,
            CollusionScanIntervalHours = s.CollusionScanIntervalHours,
            AvailabilityCampaignsEnabled = s.AvailabilityCampaignsEnabled,
            AvailabilityLookaheadDays = s.AvailabilityLookaheadDays,
            AvailabilityFreeThresholdPercent = s.AvailabilityFreeThresholdPercent,
            AvailabilityMinConsecutiveDays = s.AvailabilityMinConsecutiveDays,
            AvailabilitySendHourLocal = s.AvailabilitySendHourLocal,
        };

        _economyOn = s.BaseReservationCost > 0;
        _pointsOn = s.ReleasePoints > 0 || s.OffPeakBonusPoints > 0 || s.NoShowPenaltyPoints > 0;
        _demandOn = s.DemandReleaseOccupancyPercent > 0 || s.DemandReleaseQueueBonus > 0;
        _streakOn = s.StreakBonusPerLevel > 0;
        _perksOn = s.QueuePriorityPerTier > 0 || s.TierAllowanceBonus > 0 || s.TierDiscountPercent > 0;
        _decayOn = s.ReputationDecayPercent > 0;
