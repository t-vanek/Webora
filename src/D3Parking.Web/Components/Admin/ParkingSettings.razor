    private RenderFragment PlannerTooltip(string anchorId, string text) => __builder =>
    {
        <button type="button" id="@anchorId" class="planner-tooltip-trigger" aria-label="@text">
            <FluentIcon Value="@(new Icons.Regular.Size20.QuestionCircle())" Color="Color.Custom" CustomColor="currentColor" />
        </button>
        <FluentTooltip Anchor="@anchorId" Position="TooltipPosition.Bottom" MaxWidth="360px">@text</FluentTooltip>
    };

    private RenderFragment OversightNumberRow(
        string id,
        string labelKey,
        string tooltipKey,
        int value,
        Action<int> valueChanged,
        int minimum,
        int? maximum = null) => __builder =>
    {
        <div class="planner-setting-row">
            <div class="planner-setting-row__label">
                <label for="@id">@L[labelKey]</label>
                @PlannerTooltip($"{id}-help", L[tooltipKey].Value)
            </div>
            <FluentNumberField Id="@id" TValue="int" Value="@value"
                               ValueChanged="@(newValue => valueChanged(newValue))"
                               Min="@minimum.ToString()" Max="@maximum?.ToString()"
                               AriaLabel="@L[labelKey]" Style="width:100%" />
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        var admin = await UserManager.GetUserAsync(state.User);
        _adminId = admin?.Id ?? Guid.Empty;
        var timeZone = await SiteSettings.GetTimeZoneAsync();
        _settingsToday = SiteTime.Today(TimeProvider.GetUtcNow(), timeZone);
        await LoadAsync();
    }

    // Re-enabling a group whose values were saved as zeros would resurrect it into a dead
    // config, so each toggle seeds the documented defaults (IncentivePolicy.Default) when
    // everything it governs is zero. Values from the same session survive an off/on flip.
    private void ToggleEconomy(bool on)
    {
        _economyOn = on;
        if (on && _form!.BaseReservationCost == 0)
        {
            _form.BaseReservationCost = 10;
            _form.OccupancyPricePercent = 0;
            _form.MaxReservationCost = 10;
            if (_form.MonthlyCreditAllowance == 0)
            {
                _form.MonthlyCreditAllowance = 100;
            }
        }
    }

    private bool IsReservationWeekdaySelected(Weekday day) =>
        (_form!.AllowedReservationWeekdays & day) != 0;

    private void ToggleReservationWeekday(Weekday day)
    {
        if (IsReservationWeekdaySelected(day))
        {
            if (AllowedReservationWeekdayCount == 1)
            {
                return;
            }

            _form!.AllowedReservationWeekdays &= ~day;
        }
        else
        {
            _form!.AllowedReservationWeekdays |= day;
        }

    }

    private void ChangeWeekdayPreset(ChangeEventArgs args)
    {
        _weekdayPreset = args.Value?.ToString() ?? "custom";
        _form!.AllowedReservationWeekdays = _weekdayPreset switch
        {
            "workdays" => Weekday.Workdays,
            "everyday" => Weekday.Everyday,
            _ => _form.AllowedReservationWeekdays,
        };
    }

    private void TogglePoints(bool on)
    {
        _pointsOn = on;
        if (on && _form!.ReleasePoints == 0)
        {
            _form.ReleasePoints = 10;
        }
    }

    private void ToggleDemand(bool on)
    {
        _demandOn = on;
        if (on && _form!.DemandReleaseOccupancyPercent == 0 && _form.DemandReleaseQueueBonus == 0)
        {
            _form.DemandReleaseOccupancyPercent = 100;
            _form.DemandReleaseQueueBonus = 5;
        }
    }

    private void TogglePerks(bool on)
    {
        _perksOn = on;
        if (on && _form!.QueuePriorityPerTier == 0 && _form.TierAllowanceBonus == 0 && _form.TierDiscountPercent == 0)
        {
            _form.QueuePriorityPerTier = 30;
            _form.TierAllowanceBonus = 20;
            _form.TierDiscountPercent = 5;
        }
    }

    private void ToggleDecay(bool on)
    {
        _decayOn = on;
        if (on && _form!.ReputationDecayPercent == 0)
        {
            _form.ReputationDecayPercent = 10;
        }
    }

