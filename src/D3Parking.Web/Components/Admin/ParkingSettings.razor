                        @OversightNumberRow("operations-recurrence-window", "Parking_Settings_OversightRecurrenceWindow", "Parking_Settings_OversightRecurrenceWindowTooltip", _form.OversightRecurrenceWindowDays, value => _form.OversightRecurrenceWindowDays = value, 1, 365)
