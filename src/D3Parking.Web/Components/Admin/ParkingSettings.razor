@page "/admin/parking/settings"
@attribute [HasPermission(Permissions.Parking.ManageIncentives)]
@rendermode InteractiveServer
@using D3Parking.Application.Parking.Maps
@using D3Parking.Application.Notifications
@using D3Parking.Domain.Notifications
@using System.Globalization
@inject IParkingSettingsService SettingsService
@inject INotificationRuleService NotificationRules
@inject ISiteSettingsService SiteSettings
@inject TimeProvider TimeProvider
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

@* Planner-first configuration: mode, access rules and an optional fixed budget stay prominent.
   Legacy incentive fields remain in the persisted DTO for upgrade compatibility, but saving this
   page keeps them neutral instead of exposing the old live-parking control panel. *@

<PageTitle>@L["Parking_Settings_Title"]</PageTitle>

<FluentStack Class="page-shell settings-page parking-settings-page" Orientation="Orientation.Vertical" VerticalGap="20">
    <div class="admin-head">
        <div class="admin-head__titles">
            <div class="admin-head__title-row"><FluentLabel Typo="Typography.PageTitle">@L["Parking_Settings_Title"]</FluentLabel></div>
            <p class="admin-head__intro">@L["Parking_Settings_Intro"]</p>
        </div>
    </div>

    @if (_form is null)
    {
        <FluentProgressRing />
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar">@_message</FluentMessageBar>
        }
        <details class="settings-map-disclosure">
            <summary><span>@L["Parking_Settings_MapSection"]</span><span class="state-pill state-pill--@(_hasOrientationMap ? "on" : "off")">@L[_hasOrientationMap ? "Parking_Settings_MapReady" : "Parking_Settings_MapMissing"]</span></summary>
        <div class="settings-panel settings-map-panel">
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_MapHelp"]</FluentLabel>
            <div class="orientation-map-admin">
                <InputFile id="parking-orientation-map" OnChange="OnOrientationMapSelectedAsync"
                           accept="@ImageContentType.AcceptAttribute" class="parking-input" />
                @if (_hasOrientationMap)
                {
                    <div class="orientation-map-admin__preview">
                        <img src="@OrientationMapUrl" alt="@L["Parking_Map_ImageAlt"]" />
                    </div>
                    <div class="orientation-map-admin__actions">
                        <FluentAnchor Href="@OrientationMapUrl" Target="_blank" Appearance="Appearance.Hypertext">
                            @L["Parking_Map_Open"]
                        </FluentAnchor>
                        <FluentButton Appearance="Appearance.Stealth" OnClick="ClearOrientationMapAsync">
                            @L["Parking_Settings_MapClear"]
                        </FluentButton>
                    </div>
                }
                else
                {
                    <div class="empty-state orientation-map-admin__empty">@L["Parking_Settings_MapEmptyState"]</div>
                }
            </div>
        </div>
        </details>

        <FluentTabs @bind-ActiveTabId="_activeTab" Class="parking-settings-tabs">
            <FluentTab Id="planner" Label="@L["Parking_Settings_Tab_Planner"]">
                <div class="settings-panel planner-panel">
                    <div class="settings-section__head">
                        <div class="settings-section__title">
                            <FluentIcon Value="@(new Icons.Regular.Size20.CalendarClock())" Color="Color.Custom" CustomColor="currentColor" />
                            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_ReservationModeSection"]</FluentLabel>
                        </div>
                    </div>
                    <div class="planner-setting-row">
                        <div class="planner-setting-row__label">
                            <span>@L["Parking_Settings_UseExactReservationTime"]</span>
                            @PlannerTooltip("planner-time-mode-help", L["Parking_Settings_ReservationModeHelp"].Value)
                        </div>
                        <FluentSwitch @bind-Value="UsesExactReservationTime"
                                      AriaLabel="@L["Parking_Settings_UseExactReservationTime"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                        @L[UsesExactReservationTime
                            ? "Parking_Settings_Mode_TimeWindow_Description"
                            : "Parking_Settings_Mode_AllDay_Description"]
                    </FluentLabel>

                    <div class="settings-section__head">
                        <div class="settings-section__title">
                            <FluentIcon Value="@(new Icons.Regular.Size20.CalendarCheckmark())" Color="Color.Custom" CustomColor="currentColor" />
                            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_BookingCalendarSectionSimple"]</FluentLabel>
                        </div>
                    </div>
                    <div class="planner-settings-column">
                        <div class="planner-setting-row">
                            <div class="planner-setting-row__label">
                                <label for="planner-horizon">@L["Parking_Settings_ReservationHorizonSimple"]</label>
                                @PlannerTooltip("planner-horizon-help", L["Parking_Settings_ReservationHorizonTooltip"].Value)
                            </div>
                            <select id="planner-horizon" class="parking-input" @bind="_form.ReservationHorizonDays">
                                @foreach (var option in ReservationHorizonOptions)
                                {
                                    <option value="@option.Days">@L[option.LabelKey]</option>
                                }
                            </select>
                        </div>
                        <FluentLabel Class="planner-setting-note planner-setting-note--horizon"
                                     Typo="Typography.Body" Color="Color.Neutral" aria-live="polite">
                            @L["Parking_Settings_HorizonThrough", SettingsLastBookableDayLabel]
                        </FluentLabel>
                        <div class="planner-setting-row">
                            <div class="planner-setting-row__label">
                                <span>@L["Parking_Settings_SameDayReservationsAllowed"]</span>
                                @PlannerTooltip("planner-same-day-help", L["Parking_Settings_SameDayReservationsTooltip"].Value)
                            </div>
                            <FluentSwitch @bind-Value="_form.SameDayReservationsAllowed"
                                          AriaLabel="@L["Parking_Settings_SameDayReservationsAllowed"]" />
                        </div>
                        <div class="planner-setting-row">
                            <div class="planner-setting-row__label">
                                <label for="planner-weekdays">@L["Parking_Settings_WeekdayRule"]</label>
                                @PlannerTooltip("planner-weekdays-help", L["Parking_Settings_WeekdayRuleTooltip"].Value)
                            </div>
                            <select id="planner-weekdays" class="parking-input" value="@_weekdayPreset" @onchange="ChangeWeekdayPreset">
                                <option value="workdays">@L["Parking_Settings_Weekdays_Workdays"]</option>
                                <option value="everyday">@L["Parking_Settings_Weekdays_Everyday"]</option>
                                <option value="custom">@L["Parking_Settings_Weekdays_Custom"]</option>
                            </select>
                        </div>
                        @if (_weekdayPreset == "custom")
                        {
                            <div class="weekday-picker" role="group" aria-label="@L["Parking_Settings_AllowedWeekdays"]">
                                @foreach (var option in ReservationWeekdayOptions)
                                {
                                    <button type="button"
                                            class="weekday-picker__day @(IsReservationWeekdaySelected(option.Flag) ? "is-selected" : null)"
                                            aria-pressed="@IsReservationWeekdaySelected(option.Flag)"
                                            @onclick="() => ToggleReservationWeekday(option.Flag)">
                                        @L[option.LabelKey]
                                    </button>
                                }
                            </div>
                        }
                        <div class="planner-setting-row">
                            <div class="planner-setting-row__label">
                                <span>@L["Parking_Settings_PublicHolidayReservationsAllowed"]</span>
                                @PlannerTooltip("planner-holidays-help", L["Parking_Settings_PublicHolidayTooltip"].Value)
                            </div>
                            <FluentSwitch @bind-Value="HolidayReservationsAllowed"
                                          AriaLabel="@L["Parking_Settings_PublicHolidayReservationsAllowed"]" />
                        </div>
                    </div>

                    <div class="settings-section__head">
                        <div class="settings-section__title">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Person())" Color="Color.Custom" CustomColor="currentColor" />
                            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_PersonalLimitSectionSimple"]</FluentLabel>
                        </div>
                    </div>
                    <div class="planner-setting-row">
                        <div class="planner-setting-row__label">
                            <span>@L["Parking_Settings_WeeklyLimitEnabled"]</span>
                            @PlannerTooltip("planner-weekly-toggle-help", L["Parking_Settings_PersonalLimitHelp"].Value)
                        </div>
                        <FluentSwitch @bind-Value="_form.WeeklyReservationLimitEnabled"
                                      AriaLabel="@L["Parking_Settings_WeeklyLimitEnabled"]" />
                    </div>
                    @if (_form.WeeklyReservationLimitEnabled)
                    {
                        <div class="planner-setting-row">
                            <div class="planner-setting-row__label">
                                <label for="planner-weekly-limit">@L["Parking_Settings_WeeklyReservationLimit"]</label>
                                @PlannerTooltip("planner-weekly-limit-help", L["Parking_Settings_WeeklyReservationLimitTooltip"].Value)
                            </div>
                            <FluentNumberField Id="planner-weekly-limit" TValue="int" @bind-Value="_form.WeeklyReservationLimit"
                                               Min="1" Max="7"
                                               AriaLabel="@L["Parking_Settings_WeeklyReservationLimit"]" Style="width:100%" />
                        </div>
                    }

                    <div class="settings-section__head">
                        <div class="settings-section__title">
                            <FluentIcon Value="@(new Icons.Regular.Size20.People())" Color="Color.Custom" CustomColor="currentColor" />
                            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_QueueSection"]</FluentLabel>
                        </div>
                    </div>
                    <div class="planner-setting-row">
                        <div class="planner-setting-row__label">
                            <label for="planner-queue-offer">@L["Parking_Settings_QueueOfferMinutes"]</label>
                            @PlannerTooltip("planner-queue-offer-help", L["Parking_Settings_QueueHelp"].Value)
                        </div>
                        <FluentNumberField Id="planner-queue-offer" TValue="int" @bind-Value="_form.QueueOfferMinutes" Min="1"
                                           AriaLabel="@L["Parking_Settings_QueueOfferMinutes"]" Style="width:100%" />
                    </div>

                    <div class="settings-section__head">
                        <div class="settings-section__title">
                            <FluentIcon Value="@(new Icons.Regular.Size20.DataTrending())" Color="Color.Custom" CustomColor="currentColor" />
                            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_OccupancyNotificationsSection"]</FluentLabel>
                        </div>
                    </div>
                    <div class="planner-settings-column">
                        <div class="planner-setting-row">
                            <div class="planner-setting-row__label">
                                <span>@L["Parking_Settings_LowOccupancyEnabled"]</span>
                                @PlannerTooltip("planner-low-occupancy-help", L["Parking_Settings_LowOccupancyHelp"].Value)
                            </div>
                            <FluentSwitch @bind-Value="_form.AvailabilityCampaignsEnabled"
                                          AriaLabel="@L["Parking_Settings_LowOccupancyEnabled"]" />
                        </div>
                        @if (_form.AvailabilityCampaignsEnabled)
                        {
                            <div class="planner-setting-row">
                                <div class="planner-setting-row__label">
                                    <label for="planner-low-occupancy-threshold">@L["Parking_Settings_LowOccupancyThreshold"]</label>
                                    @PlannerTooltip("planner-low-threshold-help", L["Parking_Settings_LowOccupancyThresholdHelp"].Value)
                                </div>
                                <FluentNumberField Id="planner-low-occupancy-threshold" TValue="int"
                                                   @bind-Value="_form.AvailabilityFreeThresholdPercent" Min="1"
                                                   Max="@Math.Max(1, _form.AvailabilityBusyThresholdPercent - 1).ToString()"
                                                   AriaLabel="@L["Parking_Settings_LowOccupancyThreshold"]" Style="width:100%" />
                            </div>
                        }

                        <div class="planner-setting-row">
                            <div class="planner-setting-row__label">
                                <span>@L["Parking_Settings_HighOccupancyEnabled"]</span>
                                @PlannerTooltip("planner-high-occupancy-help", L["Parking_Settings_HighOccupancyHelp"].Value)
                            </div>
                            <FluentSwitch @bind-Value="_form.HighOccupancyCampaignsEnabled"
                                          AriaLabel="@L["Parking_Settings_HighOccupancyEnabled"]" />
                        </div>
                        @if (_form.HighOccupancyCampaignsEnabled)
                        {
                            <div class="planner-setting-row">
                                <div class="planner-setting-row__label">
                                    <label for="planner-high-occupancy-threshold">@L["Parking_Settings_HighOccupancyThreshold"]</label>
                                    @PlannerTooltip("planner-high-threshold-help", L["Parking_Settings_HighOccupancyThresholdHelp"].Value)
                                </div>
                                <FluentNumberField Id="planner-high-occupancy-threshold" TValue="int"
                                                   @bind-Value="_form.AvailabilityBusyThresholdPercent"
                                                   Min="@Math.Min(100, _form.AvailabilityFreeThresholdPercent + 1).ToString()" Max="100"
                                                   AriaLabel="@L["Parking_Settings_HighOccupancyThreshold"]" Style="width:100%" />
                            </div>
                        }

                        @if (OccupancyNotificationsEnabled)
                        {
                            <div class="planner-setting-row">
                                <div class="planner-setting-row__label">
                                    <label for="planner-occupancy-lookahead">@L["Parking_Settings_AvailabilityLookahead"]</label>
                                    @PlannerTooltip("planner-occupancy-lookahead-help", L["Parking_Settings_OccupancyLookaheadHelp"].Value)
                                </div>
                                <FluentNumberField Id="planner-occupancy-lookahead" TValue="int"
                                                   @bind-Value="_form.AvailabilityLookaheadDays" Min="1"
                                                   Max="@AvailabilityLookaheadMaximum.ToString()"
                                                   AriaLabel="@L["Parking_Settings_AvailabilityLookahead"]" Style="width:100%" />
                            </div>
                            <div class="planner-setting-row">
                                <div class="planner-setting-row__label">
                                    <label for="planner-occupancy-min-days">@L["Parking_Settings_AvailabilityMinDays"]</label>
                                    @PlannerTooltip("planner-occupancy-min-days-help", L["Parking_Settings_OccupancyMinDaysHelp"].Value)
                                </div>
                                <FluentNumberField Id="planner-occupancy-min-days" TValue="int"
                                                   @bind-Value="_form.AvailabilityMinConsecutiveDays" Min="1"
                                                   Max="@_form.AvailabilityLookaheadDays.ToString()"
                                                   AriaLabel="@L["Parking_Settings_AvailabilityMinDays"]" Style="width:100%" />
                            </div>
                            <div class="planner-setting-row">
                                <div class="planner-setting-row__label">
                                    <label for="planner-occupancy-send-hour">@L["Parking_Settings_AvailabilitySendHour"]</label>
                                    @PlannerTooltip("planner-occupancy-send-hour-help", L["Parking_Settings_OccupancySendHourHelp"].Value)
                                </div>
                                <FluentNumberField Id="planner-occupancy-send-hour" TValue="int"
                                                   @bind-Value="_form.AvailabilitySendHourLocal" Min="0" Max="23"
                                                   AriaLabel="@L["Parking_Settings_AvailabilitySendHour"]" Style="width:100%" />
                            </div>
                        }
                    </div>

                    <div class="settings-section__head">
                        <div class="settings-section__title">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Money())" Color="Color.Custom" CustomColor="currentColor" />
                            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_PlannerBudgetSectionSimple"]</FluentLabel>
                        </div>
                    </div>
                    <div class="planner-setting-row">
                        <div class="planner-setting-row__label">
                            <span>@L["Parking_Settings_PlannerBudgetEnabled"]</span>
                            @PlannerTooltip("planner-budget-toggle-help", L["Parking_Settings_PlannerBudgetHelp"].Value)
                        </div>
                        <FluentSwitch Value="@_economyOn" ValueChanged="ToggleEconomy"
                                      AriaLabel="@L["Parking_Settings_PlannerBudgetEnabled"]" />
                    </div>
                    @if (_economyOn)
                    {
                        <div class="planner-settings-column">
                            <div class="planner-setting-row">
                                <div class="planner-setting-row__label">
                                    <label for="planner-base-cost">@L["Parking_Settings_BaseCost"]</label>
                                    @PlannerTooltip("planner-base-cost-help", L["Parking_Settings_BaseCostTooltip"].Value)
                                </div>
                                <FluentNumberField Id="planner-base-cost" TValue="int" @bind-Value="_form.BaseReservationCost" Min="1"
                                                   AriaLabel="@L["Parking_Settings_BaseCost"]" Style="width:100%" />
                            </div>
                            <div class="planner-setting-row">
                                <div class="planner-setting-row__label">
                                    <label for="planner-budget-allowance">@L["Parking_Settings_MonthlyAllowance"]</label>
                                    @PlannerTooltip("planner-budget-allowance-help", L["Parking_Settings_MonthlyAllowanceTooltip"].Value)
                                </div>
                                <FluentNumberField Id="planner-budget-allowance" TValue="int" @bind-Value="_form.MonthlyCreditAllowance" Min="0" Step="10"
                                                   AriaLabel="@L["Parking_Settings_MonthlyAllowance"]" Style="width:100%" />
                            </div>
                            <div class="planner-setting-row">
                                <div class="planner-setting-row__label">
                                    <label for="planner-budget-period">@L["Parking_Settings_BudgetRenewalPeriod"]</label>
                                    @PlannerTooltip("planner-budget-period-help", L["Parking_Settings_BudgetRenewalTooltip"].Value)
                                </div>
                                <select id="planner-budget-period" class="parking-input" @bind="_form.BudgetRenewalPeriod">
                                    <option value="@BudgetRenewalPeriod.Daily">@L["Parking_Settings_BudgetPeriod_Daily"]</option>
                                    <option value="@BudgetRenewalPeriod.Weekly">@L["Parking_Settings_BudgetPeriod_Weekly"]</option>
                                    <option value="@BudgetRenewalPeriod.Monthly">@L["Parking_Settings_BudgetPeriod_Monthly"]</option>
                                    <option value="@BudgetRenewalPeriod.Yearly">@L["Parking_Settings_BudgetPeriod_Yearly"]</option>
                                </select>
                            </div>
                        </div>
                    }
                </div>
            </FluentTab>

            @* Legacy live-parking score controls are intentionally not rendered by the planner. *@
            @* <FluentTab Id="points" Label="@L["Parking_Settings_Tab_Points"]">
                <div class="settings-panel">
