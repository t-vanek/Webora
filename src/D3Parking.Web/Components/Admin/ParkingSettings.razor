                        @OversightNumberRow("operations-sla-normal", "Parking_Settings_OversightSlaNormal", "Parking_Settings_OversightSlaNormalTooltip", _form.OversightSlaNormalHours, value => _form.OversightSlaNormalHours = value, 1)
                        @OversightNumberRow("operations-sla-low", "Parking_Settings_OversightSlaLow", "Parking_Settings_OversightSlaLowTooltip", _form.OversightSlaLowHours, value => _form.OversightSlaLowHours = value, 1)
                    </div>

