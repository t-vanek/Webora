            || s.QueueNoShowBanDays > 0 || s.QueueNoShowAllowancePenalty > 0;
        _distanceOn = s.SharedTakenBasePoints > 0;
    }

    private async Task SaveAsync()
    {
        _message = _error = null;
        var dto = new ParkingSettingsDto(
            _pointsOn ? _form!.ReleasePoints : 0,
            _pointsOn ? _form!.OffPeakBonusPoints : 0,
            _pointsOn ? _form!.NoShowPenaltyPoints : 0,
            TimeSpan.FromMinutes(_form!.ReleaseCutoffMinutes),
            TimeSpan.FromMinutes(_form.NoShowGraceMinutes),
            TimeSpan.FromMinutes(_form.ReminderLeadMinutes),
            _form.PeakStart, _form.PeakEnd,
            TimeSpan.FromMinutes(_form.SweepIntervalMinutes),
            _form.ResidentHoldUntil,
            _form.ResidentReleasePointsPerHour,
            _form.ResidentReleaseMaxPoints,
            _form.ResidentMaxShareAllowance,
            _form.ResidentSharePercentPerAllowance,
            _form.ResidentWastedShareClawbackPercent,
            _form.LotLatitude,
            _form.LotLongitude,
            _distanceOn ? _form.SharedTakenBasePoints : 0,
            _form.SharedTakenReferenceKm,
            _form.SharedTakenMaxMultiplier,
            _form.AutoVerifyHomeAddress,
            _form.AutoVerifyMaxDistanceKm,
            _form.MaxRewardedReleasesPerDay,
            _form.MaxReleaseRangeDays,
            _economyOn ? _form.BaseReservationCost : 0,
            _economyOn ? _form.PeakPricePercent : 100,
            _economyOn ? _form.OccupancyPricePercent : 0,
            _economyOn ? _form.MaxReservationCost : 0,
            _form.MonthlyCreditAllowance,
            _form.QueueOfferMinutes,
            _queuePenaltyOn ? _form.QueueNoShowPenaltyPoints : 0,
            _queuePenaltyOn ? _form.QueueNoShowCreditPenalty : 0,
            _queuePenaltyOn ? _form.QueueNoShowBanDays : 0,
            _queuePenaltyOn ? _form.QueueNoShowAllowancePenalty : 0,
            _demandOn ? _form.DemandReleaseOccupancyPercent : 0,
            _demandOn ? _form.DemandReleaseQueueBonus : 0,
            _form.MaxReleaseReward,
            _streakOn ? _form.StreakBonusPerLevel : 0,
            _form.StreakBonusCap,
            _form.TierSilverPoints,
            _form.TierGoldPoints,
            _form.TierPlatinumPoints,
            _perksOn ? _form.QueuePriorityPerTier : 0,
            _perksOn ? _form.TierAllowanceBonus : 0,
            _perksOn ? _form.TierDiscountPercent : 0,
            _decayOn ? _form.ReputationDecayPercent : 0,
            _form.ReputationDecayIntervalDays,
            _form.AdaptivePricingEnabled && _economyOn,
            _form.AdaptiveTargetOccupancyPercent,
            _form.AdaptiveGainPercent,
            _form.AdaptiveDeadbandPercent,
            _form.AdaptiveStepMaxPercent,
            _form.AdaptivePeakMinPercent,
            _form.AdaptivePeakMaxPercent,
            _form.AdaptiveIntervalMinutes,
            _form.TrustEnabled,
            _form.TrustIntervalHours,
            _form.TrustedBadgeThreshold,
            _form.MaxPairTrustWeight,
            _form.AntiCollusionEnabled,
            _form.CollusionMinInteractions,
            _form.CollusionConcentrationPercent,
            _form.CollusionScanIntervalHours,
            _form.AvailabilityCampaignsEnabled,
            _form.AvailabilityLookaheadDays,
            _form.AvailabilityFreeThresholdPercent,
            _form.AvailabilityMinConsecutiveDays,
            _form.AvailabilitySendHourLocal);

        var result = await SettingsService.UpdateAsync(dto, _adminId);
        if (result.Succeeded)
        {
            _message = L["Parking_Settings_Saved"];
            await LoadAsync();
        }
        else
        {
            _error = result.Errors.FirstOrDefault();
        }
    }

