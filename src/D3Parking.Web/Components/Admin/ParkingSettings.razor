            <FluentTab Id="notifications" Label="@L["Parking_Settings_Tab_Notifications"]">
                <div class="settings-panel">
                    <div class="settings-section__head">
                        <div class="settings-section__title">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Mail())" Color="Color.Custom" CustomColor="currentColor" />
                            <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_NotificationMatrix"]</FluentLabel>
                        </div>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_NotificationMatrixHelp"]</FluentLabel>
                    <FluentMessageBar Intent="MessageIntent.Info" Type="MessageType.MessageBar">
                        @L["Parking_Settings_NotificationSecurityHelp"]
                    </FluentMessageBar>

                    @foreach (var category in Enum.GetValues<NotificationCategory>())
                    {
                        <div class="settings-section__head">
                            <div class="settings-section__title">
                                <FluentIcon Value="@(new Icons.Regular.Size20.Mail())" Color="Color.Custom" CustomColor="currentColor" />
                                <FluentLabel Typo="Typography.Subject">@L[$"Parking_NotificationCategory_{category}"]</FluentLabel>
                            </div>
                        </div>
                        <div style="overflow-x:auto">
                            <table class="notification-rule-table">
                                <thead>
                                    <tr>
                                        <th>@L["Parking_Settings_NotificationLevel"]</th>
                                        <th>@L["Parking_Settings_NotificationInbox"]</th>
                                        <th>@L["Parking_Settings_NotificationLive"]</th>
                                        <th>@L["Parking_Settings_NotificationEmail"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rule in _notificationRules.Where(r => r.Category == category))
                                    {
                                        <tr>
                                            <td>@L[$"Parking_NotificationLevel_{rule.Level}"]</td>
                                            <td><FluentSwitch @bind-Value="rule.InboxEnabled" Disabled="@rule.InboxMandatory" /></td>
                                            <td><FluentSwitch @bind-Value="rule.LiveEnabled" Disabled="@(!rule.InboxEnabled)" /></td>
                                            <td>
                                                <select class="parking-input" @bind="rule.EmailMode">
