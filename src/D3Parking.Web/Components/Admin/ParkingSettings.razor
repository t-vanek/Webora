        _pendingNotificationRules = null;
        _calendarImpact = null;
        var dto = new ParkingSettingsDto(
            0,
            0,
            0,
            TimeSpan.Zero,
            TimeSpan.Zero,
            TimeSpan.Zero,
            _form!.ReservationTimeMode,
            _form.ReservationHorizonDays,
            _form.SameDayReservationsAllowed,
            _form.AllowedReservationWeekdays,
            _form.WeeklyReservationLimitEnabled,
            _form.WeeklyReservationLimit,
            0,
            _form.PeakStart, _form.PeakEnd,
            TimeSpan.FromMinutes(_form.SweepIntervalMinutes),
            _form.ResidentHoldUntil,
            0,
            0,
            0,
            _form.ResidentPlanHorizonDays,
            _form.LotLatitude,
            _form.LotLongitude,
            0,
            _form.SharedTakenReferenceKm,
            _form.SharedTakenMaxMultiplier,
            _form.AutoVerifyHomeAddress,
            _form.AutoVerifyMaxDistanceKm,
            _form.MaxRewardedReleasesPerDay,
            _form.MaxReleaseRangeDays,
            _economyOn ? _form.BaseReservationCost : 0,
            100,
            0,
            _economyOn ? _form.BaseReservationCost : 0,
            _economyOn ? _form.MonthlyCreditAllowance : 0,
            _form.BudgetRenewalPeriod,
            _form.QueueOfferMinutes,
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            _form.TierSilverPoints,
            _form.TierGoldPoints,
            _form.TierPlatinumPoints,
            0,
            0,
            0,
            0,
            _form.ReputationDecayIntervalDays,
            false,
            _form.AdaptiveTargetOccupancyPercent,
            _form.AdaptiveGainPercent,
            _form.AdaptiveDeadbandPercent,
            _form.AdaptiveStepMaxPercent,
            _form.AdaptivePeakMinPercent,
            _form.AdaptivePeakMaxPercent,
            _form.AdaptiveIntervalMinutes,
            false,
            _form.TrustIntervalHours,
            _form.TrustedBadgeThreshold,
            _form.MaxPairTrustWeight,
            false,
            _form.CollusionMinInteractions,
            _form.CollusionConcentrationPercent,
            _form.CollusionScanIntervalHours,
            _form.AvailabilityCampaignsEnabled,
            _form.AvailabilityLookaheadDays,
            _form.AvailabilityFreeThresholdPercent,
            _form.HighOccupancyCampaignsEnabled,
            _form.AvailabilityBusyThresholdPercent,
            _form.AvailabilityMinConsecutiveDays,
            _form.AvailabilitySendHourLocal,
            _form.OversightSlaCriticalHours, _form.OversightSlaHighHours,
            _form.OversightSlaNormalHours, _form.OversightSlaLowHours,
            _form.OversightRecurrenceWindowDays, _form.OversightRecurrenceThreshold,
            _form.OversightDigestHourLocal, _form.OversightInfoDeadlineDays,
            _form.OversightAllowUserReports, _form.OversightDisputeWindowDays,
            _form.ResidentReclaimPolicy, _form.ManualReleasesAreBinding,
            _form.ResidentProtectionDeadlineMode, _form.ResidentProtectionLeadHours,
            _form.ResidentProtectionPreviousDayTime, _form.ResidentNoReplacementAction,
            _form.ResidentAlternativeBookingPolicy,
            _form.HolidayCalendarRegion, _form.PublicHolidayReservationsAllowed);

        if (ParkingSettingsValidator.Validate(dto) is { } settingsValidationError)
        {
            ShowValidationError(settingsValidationError);
            return;
        }

        var notificationRules = _notificationRules.Select(r => new NotificationDeliveryRuleDto(
            r.Category, r.Level, r.InboxEnabled, r.InboxEnabled && r.LiveEnabled,
            r.EmailMode, r.InboxMandatory)).ToList();
        if (NotificationDeliveryRuleValidator.Validate(notificationRules) is { } notificationValidationError)
        {
            ShowValidationError(notificationValidationError);
            return;
        }

        var impact = await SettingsService.GetCalendarChangeImpactAsync(dto);
        if (impact.RequiresConfirmation)
        {
            _pendingCalendarSettings = dto;
            _pendingNotificationRules = notificationRules;
            _calendarImpact = impact;
            return;
        }

        await CommitSettingsAsync(dto, notificationRules, false);
    }

    private async Task ConfirmCalendarChangeAsync()
    {
        if (_pendingCalendarSettings is not { } dto || _pendingNotificationRules is not { } rules)
        {
            return;
        }

        await CommitSettingsAsync(dto, rules, true);
    }

    private void CancelCalendarChange()
    {
        _pendingCalendarSettings = null;
        _pendingNotificationRules = null;
        _calendarImpact = null;
    }

    private async Task CommitSettingsAsync(
        ParkingSettingsDto dto,
        IReadOnlyList<NotificationDeliveryRuleDto> notificationRules,
        bool confirmCalendarInvalidation)
    {
        var result = await SettingsService.UpdateAsync(dto, _adminId, confirmCalendarInvalidation);
        if (result.Succeeded)
        {
            await NotificationRules.UpdateAsync(notificationRules, _adminId);
            CancelCalendarChange();
            _message = L["Parking_Settings_Saved"];
            await LoadAsync();
        }
        else
        {
            _error = result.Errors.FirstOrDefault();
        }
    }

    private void ShowValidationError(string error)
    {
        _error = error;
        _activeTab = error switch
        {
            ParkingSettingsValidator.OversightSlaError
                or ParkingSettingsValidator.OversightRecurrenceError
                or ParkingSettingsValidator.OversightScheduleError => "operations",
            ParkingSettingsValidator.ResidentPolicyError
                or ParkingSettingsValidator.ResidentDeadlineError => "residents",
            ParkingSettingsValidator.CoordinatesError
                or ParkingSettingsValidator.LocationLimitsError => "location",
            NotificationDeliveryRuleValidator.Error => "notifications",
            _ => "planner",
        };
    }

    private bool ResidentPolicyUsesDeadline => _form?.ResidentReclaimPolicy is
        ResidentReclaimPolicy.AdvancePriority or ResidentReclaimPolicy.AdvanceOrReplacement;

    private bool ResidentPolicyUsesFallback => _form?.ResidentReclaimPolicy is
        ResidentReclaimPolicy.AdvancePriority or ResidentReclaimPolicy.AdvanceOrReplacement or ResidentReclaimPolicy.AbsolutePriority;

    private bool ResidentPolicyUsesManualBinding => _form?.ResidentReclaimPolicy is
        ResidentReclaimPolicy.AdvancePriority or ResidentReclaimPolicy.AdvanceOrReplacement;

