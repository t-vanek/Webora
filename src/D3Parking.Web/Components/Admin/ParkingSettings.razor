            <FluentTab Id="residents" Label="@L["Parking_Settings_Tab_Residents"]">
                <div class="settings-panel">
                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_ResidentPrioritySection"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_ResidentPriorityHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <label class="parking-field">
                            <span>@L["Parking_Settings_ResidentReclaimPolicy"]</span>
                            <select class="parking-input" @bind="_form.ResidentReclaimPolicy">
                                <option value="@ResidentReclaimPolicy.ConfirmedBookingProtected">@L["Parking_Settings_Reclaim_Protected"]</option>
                                <option value="@ResidentReclaimPolicy.AdvancePriority">@L["Parking_Settings_Reclaim_Advance"]</option>
                                <option value="@ResidentReclaimPolicy.ReplacementOnly">@L["Parking_Settings_Reclaim_Replacement"]</option>
                                <option value="@ResidentReclaimPolicy.AdvanceOrReplacement">@L["Parking_Settings_Reclaim_Balanced"]</option>
                                <option value="@ResidentReclaimPolicy.AbsolutePriority">@L["Parking_Settings_Reclaim_Absolute"]</option>
                            </select>
                        </label>
                        @if (ResidentPolicyUsesDeadline)
                        {
                            <label class="parking-field">
                                <span>@L["Parking_Settings_ProtectionDeadlineMode"]</span>
                                <select class="parking-input" @bind="_form.ResidentProtectionDeadlineMode">
                                    <option value="@ResidentProtectionDeadlineMode.PreviousDayAtTime">@L["Parking_Settings_Deadline_PreviousDay"]</option>
                                    <option value="@ResidentProtectionDeadlineMode.HoursBeforeStart">@L["Parking_Settings_Deadline_Hours"]</option>
                                </select>
                            </label>
                            @if (_form.ResidentProtectionDeadlineMode == ResidentProtectionDeadlineMode.PreviousDayAtTime)
                            {
                                <label class="parking-field">
                                    <span>@L["Parking_Settings_ProtectionPreviousDayTime"]</span>
                                    <input class="parking-input" type="time" @bind="_form.ResidentProtectionPreviousDayTime" />
                                </label>
                            }
                            else
                            {
                                <FluentNumberField TValue="int" @bind-Value="_form.ResidentProtectionLeadHours" Min="1" Max="168"
                                                   Label="@L["Parking_Settings_ProtectionLeadHours"]" Style="width:100%" />
                            }
                        }
                        @if (ResidentPolicyUsesFallback)
                        {
                            <label class="parking-field">
                                <span>@L["Parking_Settings_NoReplacementAction"]</span>
                                <select class="parking-input" @bind="_form.ResidentNoReplacementAction">
                                    <option value="@ResidentNoReplacementAction.Deny">@L["Parking_Settings_NoReplacement_Deny"]</option>
                                    <option value="@ResidentNoReplacementAction.ManagerOnly">@L["Parking_Settings_NoReplacement_Manager"]</option>
                                    <option value="@ResidentNoReplacementAction.CancelAndQueue">@L["Parking_Settings_NoReplacement_Queue"]</option>
                                    <option value="@ResidentNoReplacementAction.CancelAndNotify">@L["Parking_Settings_NoReplacement_Notify"]</option>
                                </select>
                            </label>
                        }
                    </div>
                    @if (ResidentPolicyUsesManualBinding)
                    {
                        <FluentSwitch @bind-Value="_form.ManualReleasesAreBinding" Label="@L["Parking_Settings_ManualReleaseBinding"]" />
                    }
                    @if (_form.ResidentNoReplacementAction == ResidentNoReplacementAction.CancelAndNotify
                         && ResidentPolicyUsesFallback)
                    {
                        <FluentMessageBar Intent="MessageIntent.Warning" Type="MessageType.MessageBar">
                            @L["Parking_Settings_NoReplacement_NotifyWarning"]
                        </FluentMessageBar>
                    }
                    <FluentMessageBar Intent="MessageIntent.Info" Type="MessageType.MessageBar">
                        @L["Parking_Settings_ResidentPriorityRecommended"]
                    </FluentMessageBar>
                </div>
            </FluentTab>

            <FluentTab Id="location" Label="@L["Parking_Settings_Tab_Location"]">
                <div class="settings-panel">
                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_DistanceSection"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_DistanceHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="double?" @bind-Value="_form.LotLatitude" Step="0.0001"
                                           Label="@L["Parking_Settings_LotLat"]" Style="width:100%" />
                        <FluentNumberField TValue="double?" @bind-Value="_form.LotLongitude" Step="0.0001"
                                           Label="@L["Parking_Settings_LotLon"]" Style="width:100%" />
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_LimitsSection"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_LimitsHelp"]</FluentLabel>
                    <FluentSwitch @bind-Value="_form.AutoVerifyHomeAddress" Label="@L["Parking_Settings_AutoVerify"]" />
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.AutoVerifyMaxDistanceKm" Min="0" Step="5" Disabled="@(!_form.AutoVerifyHomeAddress)"
                                           Label="@L["Parking_Settings_AutoVerifyMaxKm"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.MaxRewardedReleasesPerDay" Min="0"
                                           Label="@L["Parking_Settings_MaxReleasesPerDay"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.MaxReleaseRangeDays" Min="1" Max="366"
                                           Label="@L["Parking_Settings_MaxRangeDays"]" Style="width:100%" />
                    </div>
                </div>
            </FluentTab>

            <FluentTab Id="notifications" Label="@L["Parking_Settings_Tab_Notifications"]">
                <div class="settings-panel">
                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_NotificationMatrix"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_NotificationMatrixHelp"]</FluentLabel>
                    <FluentMessageBar Intent="MessageIntent.Info" Type="MessageType.MessageBar">
                        @L["Parking_Settings_NotificationSecurityHelp"]
                    </FluentMessageBar>

                    @foreach (var category in Enum.GetValues<NotificationCategory>())
                    {
                        <div class="settings-section__head">
                            <FluentLabel Typo="Typography.Subject">@L[$"Parking_NotificationCategory_{category}"]</FluentLabel>
                        </div>
                        <div style="overflow-x:auto">
                            <table class="notification-rule-table">
                                <thead>
                                    <tr>
                                        <th>@L["Parking_Settings_NotificationLevel"]</th>
                                        <th>@L["Parking_Settings_NotificationInbox"]</th>
                                        <th>@L["Parking_Settings_NotificationLive"]</th>
                                        <th>@L["Parking_Settings_NotificationEmail"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rule in _notificationRules.Where(r => r.Category == category))
                                    {
                                        <tr>
                                            <td>@L[$"Parking_NotificationLevel_{rule.Level}"]</td>
                                            <td><FluentSwitch @bind-Value="rule.InboxEnabled" Disabled="@rule.InboxMandatory" /></td>
                                            <td><FluentSwitch @bind-Value="rule.LiveEnabled" Disabled="@(!rule.InboxEnabled)" /></td>
                                            <td>
                                                <select class="parking-input" @bind="rule.EmailMode">
                                                    <option value="@NotificationEmailMode.Never">@L["Parking_NotificationEmail_Never"]</option>
                                                    <option value="@NotificationEmailMode.WhenRequested">@L["Parking_NotificationEmail_Requested"]</option>
                                                    <option value="@NotificationEmailMode.Always">@L["Parking_NotificationEmail_Always"]</option>
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </FluentTab>
        </FluentTabs>

        <div class="settings-savebar">
            <span>@L["Parking_Settings_SaveHint"]</span>
            <FluentButton OnClick="SaveAsync" Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Save())">@L["Parking_Settings_Save"]</FluentButton>
        </div>
    }
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private SettingsForm? _form;
    private Guid _adminId;
    private string? _message;
    private string? _error;
    private string _activeTab = "planner";
    private List<NotificationRuleForm> _notificationRules = [];
    private bool _hasOrientationMap;
    private long _orientationMapVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

    private string OrientationMapUrl => $"/api/parking/orientation-map?v={_orientationMapVersion}";

    // Section switches. Derived from the stored values on load; on save an off switch forces the
    // group's driving values to zero, which is what the domain treats as "feature disabled".
    private bool _economyOn;
    private bool _pointsOn;
    private bool _demandOn;
    private bool _perksOn;
    private bool _decayOn;

    private static readonly (int Days, string LabelKey)[] ReservationHorizonOptions =
    [
        (7, "Parking_Settings_Horizon_1Week"),
        (14, "Parking_Settings_Horizon_2Weeks"),
        (21, "Parking_Settings_Horizon_3Weeks"),
        (28, "Parking_Settings_Horizon_4Weeks"),
        (30, "Parking_Settings_Horizon_1Month"),
        (90, "Parking_Settings_Horizon_3Months"),
        (183, "Parking_Settings_Horizon_6Months"),
        (365, "Parking_Settings_Horizon_1Year"),
    ];

    private static readonly (Weekday Flag, string LabelKey)[] ReservationWeekdayOptions =
    [
        (Weekday.Monday, "Parking_Weekday_Monday"),
        (Weekday.Tuesday, "Parking_Weekday_Tuesday"),
        (Weekday.Wednesday, "Parking_Weekday_Wednesday"),
        (Weekday.Thursday, "Parking_Weekday_Thursday"),
        (Weekday.Friday, "Parking_Weekday_Friday"),
        (Weekday.Saturday, "Parking_Weekday_Saturday"),
        (Weekday.Sunday, "Parking_Weekday_Sunday"),
    ];

    private int AllowedReservationWeekdayCount => ReservationWeekdayOptions.Count(option =>
        IsReservationWeekdaySelected(option.Flag));

    private int EffectiveWeeklyReservationLimit => Math.Clamp(
        _form?.WeeklyReservationLimit ?? 1,
        1,
        7);

    private string AllowedReservationWeekdaysText => string.Join(", ", ReservationWeekdayOptions
        .Where(option => IsReservationWeekdaySelected(option.Flag))
        .Select(option => L[option.LabelKey].Value));

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        var admin = await UserManager.GetUserAsync(state.User);
        _adminId = admin?.Id ?? Guid.Empty;
        await LoadAsync();
    }

    // Re-enabling a group whose values were saved as zeros would resurrect it into a dead
    // config, so each toggle seeds the documented defaults (IncentivePolicy.Default) when
    // everything it governs is zero. Values from the same session survive an off/on flip.
    private void ToggleEconomy(bool on)
    {
        _economyOn = on;
        if (on && _form!.BaseReservationCost == 0)
        {
            _form.BaseReservationCost = 10;
            _form.OccupancyPricePercent = 0;
            _form.MaxReservationCost = 10;
            if (_form.MonthlyCreditAllowance == 0)
            {
                _form.MonthlyCreditAllowance = 100;
            }
        }
    }

    private bool IsReservationWeekdaySelected(Weekday day) =>
        (_form!.AllowedReservationWeekdays & day) != 0;

    private void ToggleReservationWeekday(Weekday day)
    {
        if (IsReservationWeekdaySelected(day))
        {
            if (AllowedReservationWeekdayCount == 1)
            {
                return;
            }

            _form!.AllowedReservationWeekdays &= ~day;
        }
        else
        {
            _form!.AllowedReservationWeekdays |= day;
        }
    }

    private void SetReservationWeekdays(Weekday days) =>
        _form!.AllowedReservationWeekdays = days;

    private void TogglePoints(bool on)
    {
        _pointsOn = on;
        if (on && _form!.ReleasePoints == 0)
        {
            _form.ReleasePoints = 10;
        }
    }

    private void ToggleDemand(bool on)
    {
        _demandOn = on;
        if (on && _form!.DemandReleaseOccupancyPercent == 0 && _form.DemandReleaseQueueBonus == 0)
        {
            _form.DemandReleaseOccupancyPercent = 100;
            _form.DemandReleaseQueueBonus = 5;
        }
    }

    private void TogglePerks(bool on)
    {
        _perksOn = on;
        if (on && _form!.QueuePriorityPerTier == 0 && _form.TierAllowanceBonus == 0 && _form.TierDiscountPercent == 0)
        {
            _form.QueuePriorityPerTier = 30;
            _form.TierAllowanceBonus = 20;
            _form.TierDiscountPercent = 5;
        }
    }

    private void ToggleDecay(bool on)
    {
        _decayOn = on;
        if (on && _form!.ReputationDecayPercent == 0)
        {
            _form.ReputationDecayPercent = 10;
        }
    }

    private async Task LoadAsync()
    {
        var settingsTask = SettingsService.GetAsync();
        var notificationTask = NotificationRules.GetAsync();
        await Task.WhenAll(settingsTask, notificationTask);
        var s = settingsTask.Result;
        _notificationRules = notificationTask.Result.Select(r => new NotificationRuleForm
        {
            Category = r.Category,
            Level = r.Level,
            InboxEnabled = r.InboxEnabled,
            LiveEnabled = r.LiveEnabled,
            EmailMode = r.EmailMode,
            InboxMandatory = r.InboxMandatory,
        }).ToList();
        _form = new SettingsForm
        {
            ReleasePoints = s.ReleasePoints,
            OffPeakBonusPoints = s.OffPeakBonusPoints,
            NoShowPenaltyPoints = s.NoShowPenaltyPoints,
            ReleaseCutoffMinutes = (int)s.ReleaseCutoff.TotalMinutes,
            NoShowGraceMinutes = (int)s.NoShowGracePeriod.TotalMinutes,
            ReminderLeadMinutes = (int)s.ReminderLeadTime.TotalMinutes,
            ReservationTimeMode = s.ReservationTimeMode,
            ReservationHorizonDays = s.ReservationHorizonDays,
            AllowedReservationWeekdays = s.AllowedReservationWeekdays,
            HolidayCalendarRegion = s.HolidayCalendarRegion,
            PublicHolidayReservationsAllowed = s.PublicHolidayReservationsAllowed,
            WeeklyReservationLimitEnabled = s.WeeklyReservationLimitEnabled,
            WeeklyReservationLimit = s.WeeklyReservationLimit,
            SweepIntervalMinutes = (int)s.SweepInterval.TotalMinutes,
            PeakStart = s.PeakStart,
            PeakEnd = s.PeakEnd,
            ResidentHoldUntil = s.ResidentHoldUntil,
            ResidentReleasePointsPerHour = s.ResidentReleasePointsPerHour,
            ResidentReleaseMaxPoints = s.ResidentReleaseMaxPoints,
            ResidentWastedShareClawbackPercent = s.ResidentWastedShareClawbackPercent,
            ResidentReclaimPolicy = s.ResidentReclaimPolicy,
            ManualReleasesAreBinding = s.ManualReleasesAreBinding,
            ResidentProtectionDeadlineMode = s.ResidentProtectionDeadlineMode,
            ResidentProtectionLeadHours = s.ResidentProtectionLeadHours,
            ResidentProtectionPreviousDayTime = s.ResidentProtectionPreviousDayTime,
            ResidentNoReplacementAction = s.ResidentNoReplacementAction,
            LotLatitude = s.LotLatitude,
            LotLongitude = s.LotLongitude,
            SharedTakenBasePoints = s.SharedTakenBasePoints,
            SharedTakenReferenceKm = s.SharedTakenReferenceKm,
            SharedTakenMaxMultiplier = s.SharedTakenMaxMultiplier,
            AutoVerifyHomeAddress = s.AutoVerifyHomeAddress,
            AutoVerifyMaxDistanceKm = s.AutoVerifyMaxDistanceKm,
            MaxRewardedReleasesPerDay = s.MaxRewardedReleasesPerDay,
            MaxReleaseRangeDays = s.MaxReleaseRangeDays,
            BaseReservationCost = s.BaseReservationCost,
            PeakPricePercent = s.PeakPricePercent,
            OccupancyPricePercent = s.OccupancyPricePercent,
            MaxReservationCost = s.MaxReservationCost,
            MonthlyCreditAllowance = s.MonthlyCreditAllowance,
            BudgetRenewalPeriod = s.BudgetRenewalPeriod,
            QueueOfferMinutes = s.QueueOfferMinutes,
            QueueNoShowPenaltyPoints = s.QueueNoShowPenaltyPoints,
            QueueNoShowCreditPenalty = s.QueueNoShowCreditPenalty,
            QueueNoShowBanDays = s.QueueNoShowBanDays,
            QueueNoShowAllowancePenalty = s.QueueNoShowAllowancePenalty,
            DemandReleaseOccupancyPercent = s.DemandReleaseOccupancyPercent,
            DemandReleaseQueueBonus = s.DemandReleaseQueueBonus,
            MaxReleaseReward = s.MaxReleaseReward,
            StreakBonusPerLevel = s.StreakBonusPerLevel,
            StreakBonusCap = s.StreakBonusCap,
            TierSilverPoints = s.TierSilverPoints,
            TierGoldPoints = s.TierGoldPoints,
            TierPlatinumPoints = s.TierPlatinumPoints,
            QueuePriorityPerTier = s.QueuePriorityPerTier,
            TierAllowanceBonus = s.TierAllowanceBonus,
            TierDiscountPercent = s.TierDiscountPercent,
            ReputationDecayPercent = s.ReputationDecayPercent,
            ReputationDecayIntervalDays = s.ReputationDecayIntervalDays,
            AdaptivePricingEnabled = s.AdaptivePricingEnabled,
            AdaptiveTargetOccupancyPercent = s.AdaptiveTargetOccupancyPercent,
            AdaptiveGainPercent = s.AdaptiveGainPercent,
            AdaptiveDeadbandPercent = s.AdaptiveDeadbandPercent,
            AdaptiveStepMaxPercent = s.AdaptiveStepMaxPercent,
            AdaptivePeakMinPercent = s.AdaptivePeakMinPercent,
            AdaptivePeakMaxPercent = s.AdaptivePeakMaxPercent,
            AdaptiveIntervalMinutes = s.AdaptiveIntervalMinutes,
            TrustEnabled = s.TrustEnabled,
            TrustIntervalHours = s.TrustIntervalHours,
            TrustedBadgeThreshold = s.TrustedBadgeThreshold,
            MaxPairTrustWeight = s.MaxPairTrustWeight,
            AntiCollusionEnabled = s.AntiCollusionEnabled,
            CollusionMinInteractions = s.CollusionMinInteractions,
            CollusionConcentrationPercent = s.CollusionConcentrationPercent,
            CollusionScanIntervalHours = s.CollusionScanIntervalHours,
            AvailabilityCampaignsEnabled = s.AvailabilityCampaignsEnabled,
            AvailabilityLookaheadDays = s.AvailabilityLookaheadDays,
            AvailabilityFreeThresholdPercent = s.AvailabilityFreeThresholdPercent,
            AvailabilityMinConsecutiveDays = s.AvailabilityMinConsecutiveDays,
            AvailabilitySendHourLocal = s.AvailabilitySendHourLocal,
            OversightSlaCriticalHours = s.OversightSlaCriticalHours,
            OversightSlaHighHours = s.OversightSlaHighHours,
            OversightSlaNormalHours = s.OversightSlaNormalHours,
            OversightSlaLowHours = s.OversightSlaLowHours,
            OversightRecurrenceWindowDays = s.OversightRecurrenceWindowDays,
            OversightRecurrenceThreshold = s.OversightRecurrenceThreshold,
            OversightDigestHourLocal = s.OversightDigestHourLocal,
            OversightInfoDeadlineDays = s.OversightInfoDeadlineDays,
            OversightAllowUserReports = s.OversightAllowUserReports,
            OversightDisputeWindowDays = s.OversightDisputeWindowDays,
        };

        _economyOn = s.BaseReservationCost > 0;
        _pointsOn = s.ReleasePoints > 0;
        _demandOn = s.DemandReleaseOccupancyPercent > 0 || s.DemandReleaseQueueBonus > 0;
        _perksOn = s.QueuePriorityPerTier > 0 || s.TierAllowanceBonus > 0 || s.TierDiscountPercent > 0;
        _decayOn = s.ReputationDecayPercent > 0;
        _hasOrientationMap = await SettingsService.GetOrientationMapAsync() is not null;
    }

    private async Task OnOrientationMapSelectedAsync(InputFileChangeEventArgs e)
    {
        _message = _error = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: D3Parking.Domain.Parking.ParkingSettings.MaxOrientationMapBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var result = await SettingsService.SetOrientationMapAsync(buffer.ToArray(), _adminId);
            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault();
                return;
            }

            _hasOrientationMap = true;
            _orientationMapVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            _message = L["Parking_Settings_MapSaved"];
        }
        catch (IOException)
        {
            _error = "Parking_Settings_MapTooLarge";
        }
    }

    private async Task ClearOrientationMapAsync()
    {
        _message = _error = null;
        var result = await SettingsService.ClearOrientationMapAsync(_adminId);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
            return;
        }

        _hasOrientationMap = false;
        _orientationMapVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        _message = L["Parking_Settings_MapRemoved"];
    }

    private async Task SaveAsync()
    {
        _message = _error = null;
        var dto = new ParkingSettingsDto(
            0,
            0,
            0,
            TimeSpan.Zero,
            TimeSpan.Zero,
            TimeSpan.Zero,
            _form!.ReservationTimeMode,
            _form.ReservationHorizonDays,
            _form.AllowedReservationWeekdays,
            _form.WeeklyReservationLimitEnabled,
            EffectiveWeeklyReservationLimit,
            0,
            _form.PeakStart, _form.PeakEnd,
            TimeSpan.FromMinutes(_form.SweepIntervalMinutes),
            _form.ResidentHoldUntil,
            0,
            0,
            0,
            _form.ReservationHorizonDays,
            _form.LotLatitude,
            _form.LotLongitude,
            0,
            _form.SharedTakenReferenceKm,
            _form.SharedTakenMaxMultiplier,
            _form.AutoVerifyHomeAddress,
            _form.AutoVerifyMaxDistanceKm,
            0,
            _form.MaxReleaseRangeDays,
            _economyOn ? _form.BaseReservationCost : 0,
            100,
            0,
            _economyOn ? _form.BaseReservationCost : 0,
            _economyOn ? _form.MonthlyCreditAllowance : 0,
            _form.BudgetRenewalPeriod,
            _form.QueueOfferMinutes,
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            _form.TierSilverPoints,
            _form.TierGoldPoints,
            _form.TierPlatinumPoints,
            0,
            0,
            0,
            0,
            _form.ReputationDecayIntervalDays,
            false,
            _form.AdaptiveTargetOccupancyPercent,
            _form.AdaptiveGainPercent,
            _form.AdaptiveDeadbandPercent,
            _form.AdaptiveStepMaxPercent,
            _form.AdaptivePeakMinPercent,
            _form.AdaptivePeakMaxPercent,
            _form.AdaptiveIntervalMinutes,
            false,
            _form.TrustIntervalHours,
            _form.TrustedBadgeThreshold,
            _form.MaxPairTrustWeight,
            false,
            _form.CollusionMinInteractions,
            _form.CollusionConcentrationPercent,
            _form.CollusionScanIntervalHours,
            _form.AvailabilityCampaignsEnabled,
            _form.AvailabilityLookaheadDays,
            _form.AvailabilityFreeThresholdPercent,
            _form.AvailabilityMinConsecutiveDays,
            _form.AvailabilitySendHourLocal,
            _form.OversightSlaCriticalHours, _form.OversightSlaHighHours,
            _form.OversightSlaNormalHours, _form.OversightSlaLowHours,
            _form.OversightRecurrenceWindowDays, _form.OversightRecurrenceThreshold,
            _form.OversightDigestHourLocal, _form.OversightInfoDeadlineDays,
            _form.OversightAllowUserReports, _form.OversightDisputeWindowDays,
            _form.ResidentReclaimPolicy, _form.ManualReleasesAreBinding,
            _form.ResidentProtectionDeadlineMode, _form.ResidentProtectionLeadHours,
            _form.ResidentProtectionPreviousDayTime, _form.ResidentNoReplacementAction,
            _form.HolidayCalendarRegion, _form.PublicHolidayReservationsAllowed);

        var result = await SettingsService.UpdateAsync(dto, _adminId);
        if (result.Succeeded)
        {
            await NotificationRules.UpdateAsync(_notificationRules.Select(r => new NotificationDeliveryRuleDto(
                r.Category, r.Level, r.InboxEnabled, r.InboxEnabled && r.LiveEnabled,
                r.EmailMode, r.InboxMandatory)).ToList(), _adminId);
            _message = L["Parking_Settings_Saved"];
            await LoadAsync();
        }
        else
        {
            _error = result.Errors.FirstOrDefault();
        }
    }

    private bool ResidentPolicyUsesDeadline => _form?.ResidentReclaimPolicy is
        ResidentReclaimPolicy.AdvancePriority or ResidentReclaimPolicy.AdvanceOrReplacement;

    private bool ResidentPolicyUsesFallback => _form?.ResidentReclaimPolicy is
        ResidentReclaimPolicy.AdvancePriority or ResidentReclaimPolicy.AdvanceOrReplacement or ResidentReclaimPolicy.AbsolutePriority;

    private bool ResidentPolicyUsesManualBinding => _form?.ResidentReclaimPolicy is
        ResidentReclaimPolicy.AdvancePriority or ResidentReclaimPolicy.AdvanceOrReplacement;

    private sealed class SettingsForm
    {
        public int ReleasePoints { get; set; }
        public int OffPeakBonusPoints { get; set; }
        public int NoShowPenaltyPoints { get; set; }
        public int ReleaseCutoffMinutes { get; set; }
        public int NoShowGraceMinutes { get; set; }
        public int ReminderLeadMinutes { get; set; }
        public ReservationTimeMode ReservationTimeMode { get; set; }
        public int ReservationHorizonDays { get; set; }
        public Weekday AllowedReservationWeekdays { get; set; } = Weekday.Everyday;
        public HolidayCalendarRegion HolidayCalendarRegion { get; set; } = HolidayCalendarRegion.CzechRepublic;
        public bool PublicHolidayReservationsAllowed { get; set; }
        public bool WeeklyReservationLimitEnabled { get; set; }
        public int WeeklyReservationLimit { get; set; }
        public int SweepIntervalMinutes { get; set; }
        public TimeOnly PeakStart { get; set; }
        public TimeOnly PeakEnd { get; set; }
        public TimeOnly ResidentHoldUntil { get; set; }
        public int ResidentReleasePointsPerHour { get; set; }
        public int ResidentReleaseMaxPoints { get; set; }
        public int ResidentWastedShareClawbackPercent { get; set; }
        public ResidentReclaimPolicy ResidentReclaimPolicy { get; set; }
        public bool ManualReleasesAreBinding { get; set; }
        public ResidentProtectionDeadlineMode ResidentProtectionDeadlineMode { get; set; }
        public int ResidentProtectionLeadHours { get; set; }
