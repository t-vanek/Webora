                        <FluentSwitch Value="@_pointsOn" ValueChanged="TogglePoints" Label="@L["Parking_Settings_SectionEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_PointsHelp"]</FluentLabel>
                    <div class="settings-grid">
