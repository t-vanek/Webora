@page "/admin/parking/settings"
@attribute [HasPermission(Permissions.Parking.ManageIncentives)]
@rendermode InteractiveServer
@using D3Parking.Application.Parking.Maps
@using D3Parking.Application.Notifications
@using D3Parking.Domain.Notifications
@inject IParkingSettingsService SettingsService
@inject INotificationRuleService NotificationRules
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

@* Planner-first configuration: mode, access rules and an optional fixed budget stay prominent.
   Legacy incentive fields remain in the persisted DTO for upgrade compatibility, but saving this
   page keeps them neutral instead of exposing the old live-parking control panel. *@

<PageTitle>@L["Parking_Settings_Title"]</PageTitle>

<FluentStack Class="page-shell settings-page parking-settings-page" Orientation="Orientation.Vertical" VerticalGap="20">
    <div class="admin-head">
        <div class="admin-head__titles">
            <div class="admin-head__title-row"><FluentLabel Typo="Typography.PageTitle">@L["Parking_Settings_Title"]</FluentLabel></div>
            <p class="admin-head__intro">@L["Parking_Settings_Intro"]</p>
        </div>
    </div>

    @if (_form is null)
    {
        <FluentProgressRing />
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar">@_message</FluentMessageBar>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@L[_error]</FluentMessageBar>
        }

        <details class="settings-map-disclosure">
            <summary><span>@L["Parking_Settings_MapSection"]</span><span class="state-pill state-pill--@(_hasOrientationMap ? "on" : "off")">@L[_hasOrientationMap ? "Parking_Settings_MapReady" : "Parking_Settings_MapMissing"]</span></summary>
        <div class="settings-panel settings-map-panel">
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_MapHelp"]</FluentLabel>
            <div class="orientation-map-admin">
                <InputFile id="parking-orientation-map" OnChange="OnOrientationMapSelectedAsync"
                           accept="@ImageContentType.AcceptAttribute" class="parking-input" />
                @if (_hasOrientationMap)
                {
                    <div class="orientation-map-admin__preview">
                        <img src="@OrientationMapUrl" alt="@L["Parking_Map_ImageAlt"]" />
                    </div>
                    <div class="orientation-map-admin__actions">
                        <FluentAnchor Href="@OrientationMapUrl" Target="_blank" Appearance="Appearance.Hypertext">
                            @L["Parking_Map_Open"]
                        </FluentAnchor>
                        <FluentButton Appearance="Appearance.Stealth" OnClick="ClearOrientationMapAsync">
                            @L["Parking_Settings_MapClear"]
                        </FluentButton>
                    </div>
                }
                else
                {
                    <div class="empty-state orientation-map-admin__empty">@L["Parking_Settings_MapEmptyState"]</div>
                }
            </div>
        </div>
        </details>

        <FluentTabs @bind-ActiveTabId="_activeTab" Class="parking-settings-tabs">
            <FluentTab Id="planner" Label="@L["Parking_Settings_Tab_Planner"]">
                <div class="settings-panel">
                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_ReservationModeSection"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_ReservationModeHelp"]</FluentLabel>
                    <div class="reservation-mode-options" role="radiogroup" aria-label="@L["Parking_Settings_ReservationModeSection"]">
                        <button type="button" role="radio"
                                aria-checked="@(_form.ReservationTimeMode == ReservationTimeMode.AllDay)"
                                class="reservation-mode-option @(_form.ReservationTimeMode == ReservationTimeMode.AllDay ? "is-selected" : null)"
                                @onclick="() => _form.ReservationTimeMode = ReservationTimeMode.AllDay">
                            <span class="reservation-mode-option__marker">
                                @if (_form.ReservationTimeMode == ReservationTimeMode.AllDay)
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" Color="Color.Accent" />
                                    <strong>@L["Parking_Settings_ModeActive"]</strong>
                                }
                            </span>
                            <strong>@L["Parking_Settings_Mode_AllDay_Title"]</strong>
                            <span>@L["Parking_Settings_Mode_AllDay_Description"]</span>
                        </button>
                        <button type="button" role="radio"
                                aria-checked="@(_form.ReservationTimeMode == ReservationTimeMode.TimeWindow)"
                                class="reservation-mode-option @(_form.ReservationTimeMode == ReservationTimeMode.TimeWindow ? "is-selected" : null)"
                                @onclick="() => _form.ReservationTimeMode = ReservationTimeMode.TimeWindow">
                            <span class="reservation-mode-option__marker">
                                @if (_form.ReservationTimeMode == ReservationTimeMode.TimeWindow)
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" Color="Color.Accent" />
                                    <strong>@L["Parking_Settings_ModeActive"]</strong>
                                }
                            </span>
                            <strong>@L["Parking_Settings_Mode_TimeWindow_Title"]</strong>
                            <span>@L["Parking_Settings_Mode_TimeWindow_Description"]</span>
                        </button>
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_BookingCalendarSection"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_BookingCalendarHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <label class="parking-field">
                            <span>@L["Parking_Settings_ReservationHorizonDays"]</span>
                            <select class="parking-input" @bind="_form.ReservationHorizonDays">
                                @foreach (var option in ReservationHorizonOptions)
                                {
                                    <option value="@option.Days">@L[option.LabelKey]</option>
                                }
                            </select>
                        </label>
                        <label class="parking-field">
                            <span>@L["Parking_Settings_HolidayCalendar"]</span>
                            <select class="parking-input" @bind="_form.HolidayCalendarRegion">
                                <option value="@HolidayCalendarRegion.CzechRepublic">@L["Parking_Settings_HolidayCalendar_CZ"]</option>
                                <option value="@HolidayCalendarRegion.None">@L["Parking_Settings_HolidayCalendar_None"]</option>
                            </select>
                        </label>
                    </div>
                    <div class="settings-field settings-field--wide">
                        <span class="settings-field__label">@L["Parking_Settings_AllowedWeekdays"]</span>
                        <span class="settings-field__help">@L["Parking_Settings_AllowedWeekdaysHelp"]</span>
                        <div class="weekday-picker__presets">
                            <FluentButton Appearance="Appearance.Stealth" OnClick="() => SetReservationWeekdays(Weekday.Workdays)">@L["Parking_Settings_Weekdays_Workdays"]</FluentButton>
                            <FluentButton Appearance="Appearance.Stealth" OnClick="() => SetReservationWeekdays(Weekday.Everyday)">@L["Parking_Settings_Weekdays_Everyday"]</FluentButton>
                        </div>
                        <div class="weekday-picker" role="group" aria-label="@L["Parking_Settings_AllowedWeekdays"]">
                            @foreach (var option in ReservationWeekdayOptions)
                            {
                                <button type="button"
                                        class="weekday-picker__day @(IsReservationWeekdaySelected(option.Flag) ? "is-selected" : null)"
                                        aria-pressed="@IsReservationWeekdaySelected(option.Flag)"
                                        @onclick="() => ToggleReservationWeekday(option.Flag)">
                                    @L[option.LabelKey]
                                </button>
                            }
                        </div>
                    </div>
                    <FluentSwitch @bind-Value="_form.PublicHolidayReservationsAllowed"
                                  Disabled="@(_form.HolidayCalendarRegion == HolidayCalendarRegion.None)"
                                  Label="@L["Parking_Settings_PublicHolidayReservationsAllowed"]" />
                    <div class="settings-rule-summary">
                        <strong>@L["Parking_Settings_CurrentRule"]</strong>
                        <span>@L["Parking_Settings_BookingCalendarSummary", _form.ReservationHorizonDays, AllowedReservationWeekdaysText,
                            _form.HolidayCalendarRegion == HolidayCalendarRegion.None
                                ? L["Parking_Settings_Holidays_NotConfigured"]
                                : L[_form.PublicHolidayReservationsAllowed ? "Parking_Settings_Holidays_Allowed" : "Parking_Settings_Holidays_Blocked"]]</span>
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_PersonalLimitSection"]</FluentLabel>
                        <FluentSwitch @bind-Value="_form.WeeklyReservationLimitEnabled" Label="@L["Parking_Settings_WeeklyLimitEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_PersonalLimitHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.WeeklyReservationLimit" Min="1" Max="7"
                                           Disabled="@(!_form.WeeklyReservationLimitEnabled)"
                                           Label="@L["Parking_Settings_WeeklyReservationLimit"]" Style="width:100%" />
                    </div>
                    <div class="settings-rule-summary">
                        <strong>@L["Parking_Settings_CurrentRule"]</strong>
                        <span>@(_form.WeeklyReservationLimitEnabled
                            ? L["Parking_Settings_PlannerAccessSummaryNoLastMinute", EffectiveWeeklyReservationLimit]
                            : L["Parking_Settings_PlannerAccessSummaryDisabled"])</span>
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_QueueSection"]</FluentLabel>
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_QueueHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.QueueOfferMinutes" Min="1"
                                           Label="@L["Parking_Settings_QueueOfferMinutes"]" Style="width:100%" />
                    </div>

                    <div class="settings-section__head">
                        <FluentLabel Typo="Typography.Subject">@L["Parking_Settings_PlannerBudgetSection"]</FluentLabel>
                        <FluentSwitch Value="@_economyOn" ValueChanged="ToggleEconomy" Label="@L["Parking_Settings_PlannerBudgetEnabled"]" />
                    </div>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Settings_PlannerBudgetHelp"]</FluentLabel>
                    <div class="settings-grid">
                        <FluentNumberField TValue="int" @bind-Value="_form.BaseReservationCost" Min="0" Disabled="@(!_economyOn)"
                                           Label="@L["Parking_Settings_BaseCost"]" Style="width:100%" />
                        <FluentNumberField TValue="int" @bind-Value="_form.MonthlyCreditAllowance" Min="0" Step="10" Disabled="@(!_economyOn)"
                                           Label="@L["Parking_Settings_MonthlyAllowance"]" Style="width:100%" />
                        <label class="parking-field">
                            <span>@L["Parking_Settings_BudgetRenewalPeriod"]</span>
                            <select class="parking-input" @bind="_form.BudgetRenewalPeriod" disabled="@(!_economyOn)">
                                <option value="@BudgetRenewalPeriod.Daily">@L["Parking_Settings_BudgetPeriod_Daily"]</option>
                                <option value="@BudgetRenewalPeriod.Weekly">@L["Parking_Settings_BudgetPeriod_Weekly"]</option>
                                <option value="@BudgetRenewalPeriod.Monthly">@L["Parking_Settings_BudgetPeriod_Monthly"]</option>
                                <option value="@BudgetRenewalPeriod.Yearly">@L["Parking_Settings_BudgetPeriod_Yearly"]</option>
                            </select>
                        </label>
                    </div>
                    <div class="settings-rule-summary">
                        <strong>@L["Parking_Settings_BudgetResult"]</strong>
                        <span>@(_economyOn
                            ? L["Parking_Settings_BudgetSummaryEnabled", _form.MonthlyCreditAllowance,
                                L[$"Parking_Settings_BudgetPeriod_{_form.BudgetRenewalPeriod}"], _form.BaseReservationCost]
                            : L["Parking_Settings_BudgetSummaryDisabled"])</span>
                    </div>

                </div>
            </FluentTab>

