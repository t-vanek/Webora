@page "/admin/parking/spots"
@attribute [HasPermission(Permissions.Parking.ManageSpots)]
@rendermode InteractiveServer
@inject IParkingSpotService Spots
@inject IReservationService Reservations
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Parking_Admin_Title"]</PageTitle>

<FluentStack Class="page-shell spot-admin-page" Orientation="Orientation.Vertical" VerticalGap="20">
    <div class="admin-head spots-head">
        <div class="admin-head__titles">
            <div class="admin-head__title-row">
                <FluentLabel Typo="Typography.PageTitle">@L["Parking_Admin_Title"]</FluentLabel>
                @if (_summary is not null)
                {
                    <span class="count-chip">@_summary.Total</span>
                }
            </div>
            <p class="admin-head__intro">@L["Parking_Admin_Intro"]</p>
        </div>
        <FluentButton Appearance="Appearance.Accent" Class="spots-create-action"
                      IconStart="@(_createOpen ? new Icons.Regular.Size20.Dismiss() : new Icons.Regular.Size20.Add())"
                      OnClick="() => _createOpen = !_createOpen">
            @L[_createOpen ? "Parking_Admin_CloseCreate" : "Parking_Admin_AddSpots"]
        </FluentButton>
    </div>

    @if (_summary is not null)
    {
        <section class="spots-overview" aria-label="@L["Parking_Admin_Overview"]">
            @SpotMetric(L["Parking_Admin_Summary_Total"], _summary.Total, "total", () => ResetFiltersAsync())
            @SpotMetric(L["Parking_Admin_Summary_Active"], _summary.Active, "active", () => SetStateAsync(ParkingSpotStateFilter.Active))
            @SpotMetric(L["Parking_Admin_Summary_Resident"], _summary.Resident, "resident", () => SetOwnershipAsync(ParkingSpotOwnershipFilter.Resident))
            @SpotMetric(L["Parking_Admin_Summary_Shared"], _summary.Shared, "shared", () => SetOwnershipAsync(ParkingSpotOwnershipFilter.Shared))
            @SpotMetric(L["Parking_Admin_Summary_Visitor"], _summary.Visitor, "visitor", () => SetTypeAsync(ParkingSpotType.Visitor.ToString()))
        </section>
    }

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">@L[_error]</FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">@_info</FluentMessageBar>
    }

    @* A plain panel, deliberately not FluentCard: fluent-card ships contain:content, which clips
       the select's dropped-down listbox to the card edge — the "Typ" menu opened as a sliver
       peeking from under the panel. *@
    @if (_createOpen)
    {
    <div class="form-panel spots-create-panel">
        <FluentTabs @bind-ActiveTabId="_activeAddTab">
            <FluentTab Id="tab-single" Label="@L["Parking_Admin_Tab_Single"]">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="padding-top:12px">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                        @* Immediate: bind on (composed) input events — the change event of the underlying
                           web component does not cross the shadow boundary reliably. *@
                        <FluentTextField Id="single-code" Immediate="true" @bind-Value="_newCode" Label="@L["Parking_Admin_Code"]" Placeholder="A-12" />
                        <FluentSelect TOption="ParkingSpotType"
                                      Items="@_spotTypes"
                                      OptionValue="@(t => t.ToString())"
                                      OptionText="@(t => L[$"Parking_SpotType_{t}"].Value)"
                                      @bind-SelectedOption="_newType"
                                      Label="@L["Parking_Admin_Type"]" />
                        <FluentTextField @bind-Value="_newNotes" Label="@L["Parking_Admin_Notes"]" />
                        <FluentButton Appearance="Appearance.Accent" OnClick="CreateAsync">@L["Parking_Admin_Add"]</FluentButton>
                    </FluentStack>
                </FluentStack>
            </FluentTab>

            <FluentTab Id="tab-series" Label="@L["Parking_Admin_Tab_Series"]">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="padding-top:12px">
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Admin_SeriesIntro"]</FluentLabel>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                        <FluentTextField Id="ser-sections" @bind-Value="_serSections" @bind-Value:after="RefreshSeriesPlanAsync"
                                         Immediate="true" ImmediateDelay="300"
                                         Label="@L["Parking_Admin_Sections"]" Placeholder="A, B, P2" />
                        <FluentTextField Id="ser-separator" @bind-Value="_serSeparator" @bind-Value:after="RefreshSeriesPlanAsync"
                                         Immediate="true" ImmediateDelay="300"
                                         Label="@L["Parking_Admin_Separator"]" Style="width:90px" />
                        <FluentNumberField Id="ser-from" TValue="int" @bind-Value="_serFrom" @bind-Value:after="RefreshSeriesPlanAsync"
                                           Immediate="true" ImmediateDelay="300"
                                           Min="0" Max="@SpotCodeSeries.MaxNumber.ToString()" Label="@L["Parking_Admin_RangeFrom"]" Style="width:110px" />
                        <FluentNumberField Id="ser-to" TValue="int" @bind-Value="_serTo" @bind-Value:after="RefreshSeriesPlanAsync"
                                           Immediate="true" ImmediateDelay="300"
                                           Min="0" Max="@SpotCodeSeries.MaxNumber.ToString()" Label="@L["Parking_Admin_RangeTo"]" Style="width:110px" />
                        <FluentNumberField Id="ser-pad" TValue="int" @bind-Value="_serPad" @bind-Value:after="RefreshSeriesPlanAsync"
                                           Immediate="true" ImmediateDelay="300"
                                           Min="0" Max="@SpotCodeSeries.MaxPadWidth.ToString()" Label="@L["Parking_Admin_PadWidth"]" Style="width:110px" />
                        <FluentSelect TOption="ParkingSpotType"
                                      Items="@_spotTypes"
                                      OptionValue="@(t => t.ToString())"
                                      OptionText="@(t => L[$"Parking_SpotType_{t}"].Value)"
                                      @bind-SelectedOption="_serType"
                                      Label="@L["Parking_Admin_Type"]" />
                        <FluentTextField @bind-Value="_serNotes" Label="@L["Parking_Admin_Notes"]" />
                    </FluentStack>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">@L["Parking_Admin_PadWidthHint"]</FluentLabel>
                    @BatchPreview(_serError, _serPlan)
                    <FluentButton Id="ser-create" Appearance="Appearance.Accent"
                                  Disabled="@(_serPlan is null || _serPlan.NewCodes.Count == 0)"
                                  OnClick="GenerateSeriesAsync">@L["Parking_Admin_CreateBatch"]</FluentButton>
                </FluentStack>
            </FluentTab>

            <FluentTab Id="tab-list" Label="@L["Parking_Admin_Tab_List"]">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="padding-top:12px">
                    <FluentTextArea Id="list-codes" @bind-Value="_listCodes" @bind-Value:after="RefreshListPlanAsync"
                                    Immediate="true" ImmediateDelay="400"
                                    Label="@L["Parking_Admin_CodeList"]" Rows="6" Style="width:100%; max-width:420px"
                                    Placeholder="P2-08b&#10;U výtahu 1" />
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                        <FluentSelect TOption="ParkingSpotType"
                                      Items="@_spotTypes"
                                      OptionValue="@(t => t.ToString())"
                                      OptionText="@(t => L[$"Parking_SpotType_{t}"].Value)"
                                      @bind-SelectedOption="_listType"
                                      Label="@L["Parking_Admin_Type"]" />
                        <FluentTextField @bind-Value="_listNotes" Label="@L["Parking_Admin_Notes"]" />
                    </FluentStack>
                    @BatchPreview(null, _listPlan)
                    <FluentButton Id="list-create" Appearance="Appearance.Accent"
                                  Disabled="@(_listPlan is null || _listPlan.NewCodes.Count == 0 || _listPlan.NewCodes.Count > SpotCodeSeries.MaxBatchSize)"
                                  OnClick="CreateListAsync">@L["Parking_Admin_CreateBatch"]</FluentButton>
                </FluentStack>
            </FluentTab>
        </FluentTabs>
    </div>
    }

    <div class="spots-commandbar">
        <FluentSearch Id="spot-search" @bind-Value="_search" @bind-Value:after="SearchAsync"
                      Immediate="true" ImmediateDelay="300"
                      Placeholder="@L["Parking_Admin_SearchHint"]" Class="spots-search" />
        <FluentSelect TOption="ParkingSpotStateFilter" Items="@_stateFilters"
                      OptionText="StateFilterLabel" @bind-SelectedOption="_stateFilter"
                      @bind-SelectedOption:after="FilterAsync" Class="spots-filter" />
        <FluentSelect TOption="string" Items="@_typeFilters"
                      OptionValue="@(value => value)" OptionText="TypeFilterLabel"
                      @bind-SelectedOption="_typeFilter" @bind-SelectedOption:after="FilterAsync"
                      Class="spots-filter" />
        <FluentSelect TOption="ParkingSpotOwnershipFilter" Items="@_ownershipFilters"
                      OptionText="OwnershipFilterLabel" @bind-SelectedOption="_ownershipFilter"
                      @bind-SelectedOption:after="FilterAsync" Class="spots-filter" />
    </div>

    <div class="spots-results-head">
        <span>@L["Parking_Admin_Results", _total]</span>
        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.ReviewMismatches)" Context="mismatchLink">
            <FluentAnchor Href="/admin/parking/oversight/occupancy" Appearance="Appearance.Hypertext">@L["Parking_Mismatch_Link"]</FluentAnchor>
        </AuthorizeView>
    </div>

    @if (_spots is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else if (_spots.Count == 0)
    {
        <FluentLabel Typo="Typography.Body">
            @L[string.IsNullOrWhiteSpace(_search) ? "Parking_Admin_NoSpots" : "Parking_Admin_NoMatch"]
        </FluentLabel>
    }
    else
    {
        <div class="admin-panel spots-desktop-list">
            <FluentDataGrid Items="@_spots.AsQueryable()" TGridItem="ParkingSpotDto"
                            GridTemplateColumns="minmax(90px, .8fr) minmax(150px, 1.1fr) minmax(140px, 1.1fr) minmax(100px, .8fr) minmax(240px, 1.7fr) minmax(230px, auto)">
                <PropertyColumn Property="@(s => s.Code)" Title="@L["Parking_Admin_Code"]" />
                @* The colour-dot pill wraps an inline select, so the type is recognisable at a
                   glance and editable in place — same idiom as the resident column. *@
                <TemplateColumn Title="@L["Parking_Admin_Type"]">
                    <span class="type-pill type-pill--@context.Type" style="width:100%">
                        <FluentSelect TOption="ParkingSpotType"
                                      Items="@_spotTypes"
                                      OptionValue="@(t => t.ToString())"
                                      OptionText="@(t => L[$"Parking_SpotType_{t}"].Value)"
                                      Value="@context.Type.ToString()"
                                      ValueChanged="@(v => ChangeTypeAsync(context, v))"
                                      Style="width:100%; min-width:140px" />
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="@L["Parking_Admin_Notes"]">
                    @(string.IsNullOrWhiteSpace(context.Notes) ? "—" : context.Notes)
                </TemplateColumn>
                <TemplateColumn Title="@L["Parking_Admin_State"]">
                    @if (context.IsActive)
                    {
                        <span class="state-pill state-pill--on">@L["Parking_Admin_Active"]</span>
                    }
                    else
                    {
                        <span class="state-pill state-pill--off">@L["Parking_Admin_Inactive"]</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="@L["Parking_Admin_Resident"]">
                    <div class="resident-cell @(context.ResidentCount == 0 ? "resident-cell--empty" : null)">
                        @if (context.ResidentCount == 0)
                        {
                            <div class="resident-cell__state">
                                <span class="resident-cell__dot" aria-hidden="true"></span>
                                <div>
                                    <strong>@L["Parking_Admin_SharedPool"]</strong>
                                    <small>@L["Parking_Admin_NoResident"]</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="resident-cell__person">
                                <span class="resident-avatar" aria-hidden="true">@context.ResidentCount</span>
                                <div>
                                    <strong>@ResidentNames(context)</strong>
                                    <small>@L["Parking_Admin_ResidentCountOfCapacity", context.ResidentCount, context.ResidentCapacity]</small>
                                </div>
                            </div>
                        }
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common_Actions"]" Align="Align.End">
                    <div class="spot-row-actions">
                        <FluentButton OnClick="() => OpenResidentEditor(context.Id)"
                                      Appearance="Appearance.Stealth">@L["Parking_Admin_ManageResidents"]</FluentButton>
                        @if (context.IsActive)
                        {
                            <FluentButton OnClick="() => SetActiveAsync(context.Id, false)" Appearance="Appearance.Stealth">@L["Parking_Admin_Deactivate"]</FluentButton>
                        }
                        else
                        {
                            <FluentButton OnClick="() => SetActiveAsync(context.Id, true)" Appearance="Appearance.Outline">@L["Parking_Admin_Activate"]</FluentButton>
                        }
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
        </div>
        <div class="spots-mobile-list">
            @foreach (var spot in _spots)
            {
                <article class="spots-mobile-row">
                    <div class="spots-mobile-row__head">
                        <strong>@spot.Code</strong>
                        <span class="state-pill state-pill--@(spot.IsActive ? "on" : "off")">
                            @L[spot.IsActive ? "Parking_Admin_Active" : "Parking_Admin_Inactive"]
                        </span>
                    </div>
                    <div class="spots-mobile-row__facts">
                        <span>@L[$"Parking_SpotType_{spot.Type}"]</span>
                        <span>@(spot.ResidentCount == 0 ? L["Parking_Admin_SharedPool"] : ResidentNames(spot))</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(spot.Notes))
                    {
                        <small>@spot.Notes</small>
                    }
                    <div class="spots-mobile-row__actions">
                        <FluentButton OnClick="() => OpenResidentEditor(spot.Id)"
                                      Appearance="Appearance.Stealth">@L["Parking_Admin_ManageResidents"]</FluentButton>
                        <FluentButton OnClick="() => SetActiveAsync(spot.Id, !spot.IsActive)" Appearance="Appearance.Stealth">
                            @L[spot.IsActive ? "Parking_Admin_Deactivate" : "Parking_Admin_Activate"]
                        </FluentButton>
                    </div>
                </article>
            }
        </div>
        @* Hand-rolled for the same reason as the booking history's pager: FluentPaginator drives
           PaginationState, which has no page-change hook — it is built for a grid paging an
           IQueryable client-side, and here the paging happens in SQL. *@
        @if (_total > SpotPageSize)
        {
            <div class="pager">
                <FluentButton Appearance="Appearance.Outline" Disabled="@(_pageIndex == 0)"
                              OnClick="() => GoToPageAsync(_pageIndex - 1)">@L["Common_PrevPage"]</FluentButton>
                <span>@L["Common_PageOf", _pageIndex + 1, PageCount]</span>
                <FluentButton Appearance="Appearance.Outline" Disabled="@(_pageIndex >= PageCount - 1)"
                              OnClick="() => GoToPageAsync(_pageIndex + 1)">@L["Common_NextPage"]</FluentButton>
            </div>
        }
    }
</FluentStack>

@if (SelectedResidentSpot is { } residentSpot)
{
    <div class="resident-dialog-backdrop" @onclick="CloseResidentEditor">
        <section class="resident-dialog" role="dialog" aria-modal="true"
                 aria-labelledby="resident-dialog-title" @onclick:stopPropagation="true">
            <header class="resident-dialog__head">
                <div>
                    <small>@L["Parking_Admin_ManageResidents"]</small>
                    <h2 id="resident-dialog-title">@L["Parking_Admin_ResidentsForSpot", residentSpot.Code]</h2>
                </div>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseResidentEditor"
                              aria-label="@L["Common_Close"]">@L["Common_Close"]</FluentButton>
            </header>
            @ResidentEditor(residentSpot)
        </section>
    </div>
}

@code {
    private IReadOnlyList<ParkingSpotDto>? _spots;
    private ParkingSpotDirectorySummary? _summary;
    private readonly ParkingSpotType[] _spotTypes = Enum.GetValues<ParkingSpotType>();
    private readonly ParkingSpotStateFilter[] _stateFilters = Enum.GetValues<ParkingSpotStateFilter>();
    private readonly ParkingSpotOwnershipFilter[] _ownershipFilters = Enum.GetValues<ParkingSpotOwnershipFilter>();
    private readonly string[] _typeFilters = [string.Empty, .. Enum.GetNames<ParkingSpotType>()];

    // Paged in SQL. A lot of two hundred spots used to render as two hundred rows, each carrying two
    // inline selects — and the resident one holds an option per user, so the page grew as the product
    // of the lot and the directory. One page's worth of rows is the point of this whole screen.
    private const int SpotPageSize = 25;
    private int _pageIndex;
    private int _total;
    private string? _search;
    private ParkingSpotStateFilter _stateFilter;
    private ParkingSpotOwnershipFilter _ownershipFilter;
    private string _typeFilter = string.Empty;
    private bool _createOpen;
    private Guid? _residentEditorSpotId;
    private readonly HashSet<Guid> _residentAssignmentsInProgress = [];

    private ParkingSpotDto? SelectedResidentSpot => _residentEditorSpotId is { } spotId
        ? _spots?.FirstOrDefault(spot => spot.Id == spotId)
        : null;

    /// <summary>Set for one reload after a create, so the page lands where the new code sorted.</summary>
    private string? _jumpToCode;

    private int PageCount => _total == 0 ? 1 : (_total + SpotPageSize - 1) / SpotPageSize;

    private string? _activeAddTab = "tab-single";

    private string? _newCode;
    private ParkingSpotType _newType = ParkingSpotType.Standard;
    private string? _newNotes;

    // Series generator inputs + live plan.
    private string? _serSections;
    private string _serSeparator = "-";
    private int _serFrom = 1;
    private int _serTo = 10;
    private int _serPad;
    private ParkingSpotType _serType = ParkingSpotType.Standard;
    private string? _serNotes;
    private string? _serError;
    private SpotBatchPlan? _serPlan;

    // Pasted-list inputs + live plan.
    private string? _listCodes;
    private ParkingSpotType _listType = ParkingSpotType.Standard;
    private string? _listNotes;
    private SpotBatchPlan? _listPlan;

    private string? _error;
    private string? _info;

    private RenderFragment SpotMetric(string label, int value, string tone, Func<Task> action) => __builder =>
    {
        <button type="button" class="spots-metric spots-metric--@tone" @onclick="action">
            <span>@label</span>
            <strong>@value</strong>
        </button>
    };

    /// <summary>Shared dry-run readout for both batch tabs: counts, sample codes, collisions.</summary>
    private RenderFragment BatchPreview(string? patternError, SpotBatchPlan? plan) => __builder =>
    {
        @if (patternError is not null)
        {
            <FluentLabel Typo="Typography.Body" Color="Color.Error">@L[patternError]</FluentLabel>
        }
        else if (plan is not null)
        {
            <div class="batch-preview">
                <span><span class="count-chip">@plan.NewCodes.Count</span> @L["Parking_Admin_PreviewNew"]</span>
                @if (plan.NewCodes.Count > 0)
                {
                    <span class="batch-preview__codes">@Sample(plan.NewCodes)</span>
                }
                @if (plan.DuplicateCodes.Count > 0)
                {
                    <span class="batch-preview__dup">@string.Format(L["Parking_Admin_PreviewDup"], plan.DuplicateCodes.Count, Sample(plan.DuplicateCodes))</span>
                }
                @if (plan.InvalidCodes.Count > 0)
                {
                    <span class="batch-preview__bad">@string.Format(L["Parking_Admin_PreviewInvalid"], plan.InvalidCodes.Count, Sample(plan.InvalidCodes))</span>
                }
            </div>
        }
    };

    // First 8 + the last one is enough to sanity-check a series without flooding the panel.
    private static string Sample(IReadOnlyList<string> codes) =>
        codes.Count <= 9
            ? string.Join(", ", codes)
            : string.Join(", ", codes.Take(8)) + " … " + codes[^1];

    private IReadOnlyList<ResidentCandidateDto> _residentCandidates = [];
    private readonly Dictionary<Guid, string> _residentSearch = [];

    protected override async Task OnInitializedAsync()
    {
        var candidatesTask = Spots.ListResidentCandidatesAsync();
        var spotsTask = ReloadAsync();
        await Task.WhenAll(candidatesTask, spotsTask);
        _residentCandidates = candidatesTask.Result;
    }

    private string StateFilterLabel(ParkingSpotStateFilter value) => value switch
    {
        ParkingSpotStateFilter.Active => L["Parking_Admin_Filter_Active"],
        ParkingSpotStateFilter.Inactive => L["Parking_Admin_Filter_Inactive"],
        _ => L["Parking_Admin_Filter_AllStates"],
    };

    private string TypeFilterLabel(string value) => string.IsNullOrEmpty(value)
        ? L["Parking_Admin_Filter_AllTypes"]
        : L[$"Parking_SpotType_{value}"];

    private string OwnershipFilterLabel(ParkingSpotOwnershipFilter value) => value switch
    {
        ParkingSpotOwnershipFilter.Resident => L["Parking_Admin_Filter_Resident"],
        ParkingSpotOwnershipFilter.Shared => L["Parking_Admin_Filter_Shared"],
        _ => L["Parking_Admin_Filter_AllOwnership"],
    };

    private string OwnerLabel(ParkingSpotDto spot) =>
        spot.OwnerId is null
            ? L["Parking_Admin_NoResident"].Value
            : string.IsNullOrWhiteSpace(spot.OwnerName)
                ? spot.OwnerId.Value.ToString()
                : spot.OwnerName;

    private string ResidentNames(ParkingSpotDto spot) => spot.ResidentList.Count > 0
        ? string.Join(", ", spot.ResidentList.Select(r => r.Name))
        : OwnerLabel(spot);

    private static string Initials(string label)
    {
        var parts = label.Split([' ', '.', '@', '_', '-'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            return "?";
        }

        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    private RenderFragment ResidentEditor(ParkingSpotDto spot) => __builder =>
    {
        <div class="resident-editor__panel">
            <div class="resident-editor__members">
                @if (spot.ResidentList.Count == 0)
                {
                    <span class="resident-editor__empty">@L["Parking_Admin_NoResident"]</span>
                }
                else
                {
                    @foreach (var resident in spot.ResidentList)
                    {
                        <div class="resident-editor__member">
                            <span>@resident.Name</span>
                            <FluentButton Appearance="Appearance.Stealth"
                                          OnClick="() => RemoveResidentAsync(spot.Id, resident.UserId)">@L["Common_Remove"]</FluentButton>
                        </div>
                    }
                }
            </div>
            <label class="resident-editor__capacity">
                <span>@L["Parking_Admin_ResidentCapacity"]</span>
                <input type="number" min="1" max="20" value="@spot.ResidentCapacity"
                       aria-label="@L["Parking_Admin_ResidentCapacity"]"
                       @oninput="args => ChangeResidentCapacityAsync(spot.Id, args)" />
            </label>
            @if (spot.Type == ParkingSpotType.Visitor)
            {
                <span class="resident-editor__empty">@L["Parking_Admin_ResidentVisitorUnavailable"]</span>
            }
            else if (spot.ResidentCount >= spot.ResidentCapacity)
            {
                <span class="resident-editor__empty">@L["Parking_Admin_ResidentCapacityFull"]</span>
            }
            else
            {
                <label class="resident-picker__search">
                    <span>@L["Parking_Admin_FindResident"]</span>
                    <input type="search"
                           value="@ResidentSearch(spot.Id)"
                           placeholder="@L["Parking_Admin_FindResidentPlaceholder"]"
                           @oninput="args => SetResidentSearch(spot.Id, args.Value?.ToString())" />
                </label>
                <div class="resident-picker__options" role="listbox" aria-label="@L["Parking_Admin_FindResident"]">
                    @foreach (var candidate in ResidentOptions(spot.Id))
                    {
                        <button type="button" role="option" class="resident-picker__option"
                                disabled="@_residentAssignmentsInProgress.Contains(candidate.UserId)"
                                @onclick="() => AddResidentAsync(spot.Id, candidate.UserId)">
                            <strong>@candidate.Name</strong>
                            @if (!string.Equals(candidate.Name, candidate.Email, StringComparison.OrdinalIgnoreCase))
                            {
                                <small>@candidate.Email</small>
                            }
                        </button>
                    }
                    @if (ResidentOptions(spot.Id).Count == 0)
                    {
                        <span class="resident-editor__empty">@L["Parking_Admin_NoResidentCandidates"]</span>
                    }
                </div>
            }
        </div>
    };

    private void OpenResidentEditor(Guid spotId) => _residentEditorSpotId = spotId;

    private void CloseResidentEditor()
    {
        if (_residentEditorSpotId is { } spotId)
        {
            _residentSearch.Remove(spotId);
        }

        _residentEditorSpotId = null;
    }

    private string ResidentSearch(Guid spotId) =>
        _residentSearch.GetValueOrDefault(spotId, string.Empty);

    private void SetResidentSearch(Guid spotId, string? value) =>
        _residentSearch[spotId] = value?.TrimStart() ?? string.Empty;

    private IReadOnlyList<ResidentCandidateDto> ResidentOptions(Guid spotId)
    {
        var term = ResidentSearch(spotId).Trim();
        return _residentCandidates
            .Where(candidate => string.IsNullOrEmpty(term)
                || candidate.Name.Contains(term, StringComparison.CurrentCultureIgnoreCase)
                || candidate.Email.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Take(8)
            .ToList();
    }

    private async Task AddResidentAsync(Guid spotId, Guid residentId)
    {
        if (!_residentAssignmentsInProgress.Add(residentId))
        {
            return;
        }

        _error = _info = null;
        try
        {
            var result = await Spots.AddResidentAsync(spotId, residentId);
            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault();
            }

            if (result.Succeeded)
            {
                _residentSearch.Remove(spotId);
            }

            await Task.WhenAll(ReloadAsync(), ReloadResidentCandidatesAsync());
        }
        finally
        {
            _residentAssignmentsInProgress.Remove(residentId);
        }
    }

    private async Task ReloadResidentCandidatesAsync() =>
        _residentCandidates = await Spots.ListResidentCandidatesAsync();

    private async Task CreateAsync()
    {
        _error = _info = null;
        var code = _newCode ?? string.Empty;
        var result = await Spots.CreateAsync(code, _newType, _newNotes);
        if (result.Succeeded)
        {
            _newCode = _newNotes = null;
            _newType = ParkingSpotType.Standard;
            JumpTo(code);
            await ReloadAsync();
        }
        else
        {
            _error = result.Errors.FirstOrDefault();
        }
    }

    private async Task RefreshSeriesPlanAsync()
    {
        var expansion = SpotCodeSeries.Expand(_serSections, _serSeparator, _serFrom, _serTo, _serPad);
        _serError = expansion.ErrorKey;
        _serPlan = expansion.Succeeded && expansion.Codes.Count > 0
            ? await Spots.PreviewBatchAsync(expansion.Codes)
            : null;
    }

    private async Task RefreshListPlanAsync()
    {
        var codes = ParseListCodes();
        _listPlan = codes.Count > 0 ? await Spots.PreviewBatchAsync(codes) : null;
    }

    private IReadOnlyList<string> ParseListCodes() =>
        (_listCodes ?? string.Empty).Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

    private async Task GenerateSeriesAsync()
    {
        _error = _info = null;
        var expansion = SpotCodeSeries.Expand(_serSections, _serSeparator, _serFrom, _serTo, _serPad);
        if (!expansion.Succeeded)
        {
            _serError = expansion.ErrorKey;
            return;
        }

        await ApplyBatchAsync(expansion.Codes, await Spots.CreateBatchAsync(expansion.Codes, _serType, _serNotes));
        await RefreshSeriesPlanAsync();
    }

    private async Task CreateListAsync()
    {
        var codes = ParseListCodes();
        _error = _info = null;
        await ApplyBatchAsync(codes, await Spots.CreateBatchAsync(codes, _listType, _listNotes));
        await RefreshListPlanAsync();
    }

    private async Task ApplyBatchAsync(IReadOnlyList<string> requested, SpotBatchResult result)
    {
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
            return;
        }

        _info = result.SkippedCodes.Count == 0
            ? string.Format(L["Parking_Admin_BatchCreated"], result.CreatedCount)
            : string.Format(L["Parking_Admin_BatchCreatedSkipped"], result.CreatedCount, result.SkippedCodes.Count, Sample(result.SkippedCodes));

        // The first code that was actually created, so the reload lands on the new series rather than
        // wherever the admin happened to be paged to.
        var skipped = result.SkippedCodes.ToHashSet(StringComparer.OrdinalIgnoreCase);
        JumpTo(requested.FirstOrDefault(c => !skipped.Contains(c.Trim())));
        await ReloadAsync();
    }

    private async Task ChangeTypeAsync(ParkingSpotDto spot, string? typeValue)
    {
        if (!Enum.TryParse<ParkingSpotType>(typeValue, out var type) || type == spot.Type)
        {
            return;
        }

        _error = _info = null;
        var result = await Spots.UpdateAsync(spot.Id, spot.Code, type, spot.Notes);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
        }

        await ReloadAsync();
    }

    private async Task SetActiveAsync(Guid id, bool active)
    {
        _error = _info = null;
        var result = await Spots.SetActiveAsync(id, active);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _summary = await Spots.GetAdminSummaryAsync();
        ParkingSpotType? type = Enum.TryParse<ParkingSpotType>(_typeFilter, out var parsedType) ? parsedType : null;
        var page = await Spots.ListAdminPageAsync(
            new ParkingSpotListQuery(_search, _stateFilter, type, _ownershipFilter),
            _pageIndex, SpotPageSize, _jumpToCode);
        _spots = page.Items;
        _total = page.TotalCount;
        // Taken back from the result, not assumed: the service walks the index back when the page
        // asked for no longer exists, and forward when a jump was requested.
        _pageIndex = page.PageIndex;
        _jumpToCode = null;
    }

    /// <summary>
    /// Aims the next reload at a freshly created code. The search goes with it: a spot created while
    /// the list is filtered to something else would otherwise be reported as created and be nowhere
    /// on screen.
    /// </summary>
    private void JumpTo(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            return;
        }

        _jumpToCode = code;
        _search = null;
    }

    private async Task SearchAsync()
    {
        // A new search starts at the front; page 5 of the old result set means nothing in the new one.
        _pageIndex = 0;
        await ReloadAsync();
    }

    private async Task RemoveResidentAsync(Guid spotId, Guid userId)
    {
        _error = _info = null;
        var result = await Spots.RemoveResidentAsync(spotId, userId);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
        }
        await Task.WhenAll(ReloadAsync(), ReloadResidentCandidatesAsync());
    }

    private async Task SetResidentCapacityAsync(Guid spotId, int capacity)
    {
        _error = _info = null;
        var result = await Spots.SetResidentCapacityAsync(spotId, capacity);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
        }
        await ReloadAsync();
    }

    private async Task ChangeResidentCapacityAsync(Guid spotId, ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var capacity))
        {
            await SetResidentCapacityAsync(spotId, capacity);
        }
    }

    private async Task FilterAsync()
    {
        _pageIndex = 0;
        await ReloadAsync();
    }

    private async Task SetStateAsync(ParkingSpotStateFilter value)
    {
        _stateFilter = value;
        await FilterAsync();
    }

    private async Task SetOwnershipAsync(ParkingSpotOwnershipFilter value)
    {
        _ownershipFilter = value;
        await FilterAsync();
    }

    private async Task SetTypeAsync(string value)
    {
        _typeFilter = value;
        await FilterAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _stateFilter = ParkingSpotStateFilter.All;
        _ownershipFilter = ParkingSpotOwnershipFilter.All;
        _typeFilter = string.Empty;
        _search = null;
        await FilterAsync();
    }

    private async Task GoToPageAsync(int pageIndex)
    {
        _pageIndex = Math.Clamp(pageIndex, 0, PageCount - 1);
        await ReloadAsync();
    }
}
