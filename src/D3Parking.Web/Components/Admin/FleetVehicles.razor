@page "/admin/parking/fleet"
@attribute [HasPermission(Permissions.Parking.ManageSpots)]
@rendermode InteractiveServer
@inject IFleetService Fleet
@inject IParkingSpotService Spots
@inject IUserAdminService UserAdmin
@inject ISiteSettingsService SiteSettings
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Fleet_Admin_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <div class="admin-head__titles">
        <div class="admin-head__title-row">
            <FluentLabel Typo="Typography.PageTitle">@L["Fleet_Admin_Title"]</FluentLabel>
            @if (_vehicles is not null)
            {
                <span class="count-chip">@_vehicles.Count</span>
            }
        </div>
        <p class="admin-head__intro">@L["Fleet_Admin_Intro"]</p>
    </div>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">@L[_error]</FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">@_info</FluentMessageBar>
    }

    @* Same plain panel as the spots page — fluent-card's contain:content would clip the
       spot select's dropdown to the card edge. *@
    <div class="form-panel">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentLabel Typo="Typography.Subject">
                @(_editing is null ? L["Fleet_Admin_AddTitle"] : L["Fleet_Admin_EditTitle", _editing.Plate])
            </FluentLabel>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                <FluentTextField Id="fleet-plate" Immediate="true" @bind-Value="_formPlate" Maxlength="16"
                                 Label="@L["Fleet_Admin_Plate"]" Placeholder="1AB 2345" Style="width:150px" />
                @* String Value/ValueChanged, not @bind-SelectedOption: the web component's
                   change event does not cross the shadow boundary reliably, and hiding the
                   spot select below depends on this rerender. *@
                <FluentSelect Id="fleet-type" TOption="VehicleType"
                              Items="@_vehicleTypes"
                              OptionValue="@(t => t.ToString())"
                              OptionText="@(t => L[$"Fleet_Type_{t}"].Value)"
                              Value="@_formType.ToString()"
                              ValueChanged="@(v => OnTypeChanged(v))"
                              Label="@L["Fleet_Admin_Type"]"
                              Style="min-width:170px" />
                <FluentTextField @bind-Value="_formName" Maxlength="128"
                                 Label="@L["Fleet_Admin_Name"]" Style="width:220px" />
                <FluentTextField Id="fleet-email" @bind-Value="_formEmail" Maxlength="256"
                                 Label="@L["Fleet_Admin_DriverEmail"]" Style="width:260px" />
                @* The dedicated spot is the company-vehicle entitlement; for an employee vehicle
                   the control disappears (and FormSpotId sends null) instead of erroring later. *@
                @if (_formType == VehicleType.Company)
                {
                    <FluentSelect TOption="string"
                                  Items="@_spotOptions"
                                  OptionValue="@(id => id)"
                                  OptionText="@(id => SpotLabel(id))"
                                  @bind-Value="_formSpotId"
                                  Label="@L["Fleet_Admin_Spot"]"
                                  Style="min-width:150px" />
                }
                <FluentTextField @bind-Value="_formNotes" Maxlength="512" Label="@L["Fleet_Admin_Notes"]" />
                @if (_editing is null)
                {
                    <FluentButton Id="fleet-add" Appearance="Appearance.Accent" OnClick="CreateAsync">@L["Fleet_Admin_Add"]</FluentButton>
                }
                else
                {
                    <FluentButton Id="fleet-save" Appearance="Appearance.Accent" OnClick="SaveEditAsync">@L["Fleet_Admin_Save"]</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" OnClick="CancelEdit">@L["Fleet_Admin_Cancel"]</FluentButton>
                }
            </FluentStack>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">@L["Fleet_Admin_TypeHint"]</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">@L["Fleet_Admin_EmailHint"]</FluentLabel>
        </FluentStack>
    </div>

    @if (_vehicles is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else if (_vehicles.Count == 0)
    {
        <FluentLabel Typo="Typography.Body">@L["Fleet_Admin_NoVehicles"]</FluentLabel>
    }
    else
    {
        <div class="admin-panel">
            <FluentDataGrid Items="@_vehicles.AsQueryable()" TGridItem="CompanyVehicleDto"
                            GridTemplateColumns="1fr 1.1fr 1.3fr 1.5fr 0.7fr 1.5fr 1.2fr auto">
                <PropertyColumn Property="@(v => v.Plate)" Title="@L["Fleet_Admin_Plate"]" />
                <TemplateColumn Title="@L["Fleet_Admin_Type"]">
                    @L[$"Fleet_Type_{context.Type}"]
                </TemplateColumn>
                <TemplateColumn Title="@L["Fleet_Admin_Name"]">
                    @(string.IsNullOrWhiteSpace(context.Name) ? "—" : context.Name)
                </TemplateColumn>
                <TemplateColumn Title="@L["Fleet_Admin_DriverEmail"]">
                    @(string.IsNullOrWhiteSpace(context.DriverEmail) ? "—" : context.DriverEmail)
                </TemplateColumn>
                <TemplateColumn Title="@L["Fleet_Admin_Spot"]">
                    @(context.SpotCode ?? "—")
                </TemplateColumn>
                @* The driver column doubles as the manual pairing control: an admin picks the
                   account directly (they are the authority — no code ceremony), clearing it unpairs. *@
                <TemplateColumn Title="@L["Fleet_Admin_PairedUser"]">
                    <FluentSelect TOption="string"
                                  Items="@_userOptions"
                                  OptionValue="@(id => id)"
                                  OptionText="@(id => UserLabel(id))"
                                  Value="@(context.PairedUserId?.ToString() ?? string.Empty)"
                                  ValueChanged="@(v => PairAsync(context, v))"
                                  Style="width:100%" />
                </TemplateColumn>
                @* The funnel column: names the exact missing ingredient (account, plate, code…)
                   instead of a bare active/inactive — the "why has nobody paired" support
                   question should be answerable from this grid alone. Details ride in title. *@
                <TemplateColumn Title="@L["Fleet_Admin_State"]">
                    @{ var pill = StatePill(context); }
                    <span class="state-pill @pill.Css" title="@pill.Hint">@pill.Label</span>
                </TemplateColumn>
                <TemplateColumn Align="Align.End">
                    <FluentButton OnClick="() => BeginEdit(context)" Appearance="Appearance.Outline">@L["Fleet_Admin_Edit"]</FluentButton>
                    @if (context.IsActive)
                    {
                        <FluentButton OnClick="() => SetActiveAsync(context.Id, false)" Appearance="Appearance.Stealth">@L["Fleet_Admin_Deactivate"]</FluentButton>
                    }
                    else
                    {
                        <FluentButton OnClick="() => SetActiveAsync(context.Id, true)" Appearance="Appearance.Outline">@L["Fleet_Admin_Activate"]</FluentButton>
                        <FluentButton OnClick="() => DeleteAsync(context.Id)" Appearance="Appearance.Stealth">@L["Fleet_Admin_Delete"]</FluentButton>
                    }
                </TemplateColumn>
            </FluentDataGrid>
        </div>
    }
</FluentStack>

@code {
    private IReadOnlyList<CompanyVehicleDto>? _vehicles;
    private IReadOnlyList<ParkingSpotDto> _spots = [];
    private IReadOnlyList<UserSummary> _users = [];
    private TimeZoneInfo _tz = TimeZoneInfo.Utc;

    private string? _formPlate;
    private VehicleType _formType = VehicleType.Company;
    private string? _formName;
    private string? _formEmail;
    private string _formSpotId = string.Empty;
    private string? _formNotes;
    private CompanyVehicleDto? _editing;
    private readonly VehicleType[] _vehicleTypes = Enum.GetValues<VehicleType>();

    private string? _error;
    private string? _info;

    // Visitor spots are the reception's agenda — the service refuses them, so don't offer them.
    private IEnumerable<string> _spotOptions => new[] { string.Empty }
        .Concat(_spots.Where(s => s.IsActive && s.Type != ParkingSpotType.Visitor)
            .OrderBy(s => s.Code, StringComparer.OrdinalIgnoreCase)
            .Select(s => s.Id.ToString()));

    private IEnumerable<string> _userOptions => new[] { string.Empty }.Concat(_users.Select(u => u.Id.ToString()));

    protected override async Task OnInitializedAsync()
    {
        _tz = await SiteSettings.GetTimeZoneAsync();
        _users = await UserAdmin.ListAsync(null);
        _spots = await Spots.ListAsync();
        await ReloadAsync();
    }

    private string Fmt(DateTimeOffset utc) => TimeZoneInfo.ConvertTime(utc, _tz).ToString("g");

    /// <summary>One pill per funnel state; Hint carries the explanation (and timestamps).</summary>
    private (string Css, string Label, string? Hint) StatePill(CompanyVehicleDto v) => v.PairingState switch
    {
        FleetPairingState.Paired => ("state-pill--on", L["Fleet_State_Paired"],
            v.PairedAtUtc is { } at ? L["Fleet_State_Paired_Hint", Fmt(at)] : null),
        FleetPairingState.CodeSent => ("state-pill--info", L["Fleet_State_CodeSent"],
            v.PairingCodeSentAtUtc is { } sent ? L["Fleet_State_CodeSent_Hint", Fmt(sent)] : null),
        FleetPairingState.Locked => ("state-pill--warn", L["Fleet_State_Locked"],
            v.PairingLockedUntilUtc is { } until ? L["Fleet_State_Locked_Hint", Fmt(until)] : null),
        FleetPairingState.ReadyToPair => ("state-pill--info", L["Fleet_State_ReadyToPair"], L["Fleet_State_ReadyToPair_Hint"]),
        FleetPairingState.PlateMissing => ("state-pill--info", L["Fleet_State_PlateMissing"], L["Fleet_State_PlateMissing_Hint"]),
        FleetPairingState.NoAccount => ("state-pill--warn", L["Fleet_State_NoAccount"], L["Fleet_State_NoAccount_Hint"]),
        FleetPairingState.ManualOnly => ("state-pill--off", L["Fleet_State_ManualOnly"], L["Fleet_State_ManualOnly_Hint"]),
        _ => ("state-pill--off", L["Fleet_Admin_Inactive"], null),
    };

    private string SpotLabel(string id)
    {
        if (string.IsNullOrEmpty(id))
        {
            return L["Fleet_Admin_NoSpot"];
        }

        return _spots.FirstOrDefault(s => s.Id.ToString() == id)?.Code ?? id;
    }

    private string UserLabel(string id)
    {
        if (string.IsNullOrEmpty(id))
        {
            return L["Fleet_Admin_NotPaired"];
        }

        var user = _users.FirstOrDefault(u => u.Id.ToString() == id);
        return user is null ? id : (string.IsNullOrWhiteSpace(user.DisplayName) ? user.Email : user.DisplayName);
    }

    // The hidden spot select keeps its value while the form says "employee vehicle", so the
    // submitted spot must follow what the admin sees: none.
    private Guid? FormSpotId => _formType == VehicleType.Employee
        ? null
        : Guid.TryParse(_formSpotId, out var parsed) ? parsed : null;

    private void OnTypeChanged(string? value)
    {
        if (Enum.TryParse<VehicleType>(value, out var parsed))
        {
            _formType = parsed;
        }
    }

    private async Task CreateAsync()
    {
        _error = _info = null;
        var result = await Fleet.CreateAsync(_formPlate ?? string.Empty, _formType, _formName, _formEmail, FormSpotId, _formNotes);
        if (result.Succeeded)
        {
            ResetForm();
            await ReloadAsync();
        }
        else
        {
            _error = result.Errors.FirstOrDefault();
        }
    }

    private void BeginEdit(CompanyVehicleDto vehicle)
    {
        _error = _info = null;
        _editing = vehicle;
        _formPlate = vehicle.Plate;
        _formType = vehicle.Type;
        _formName = vehicle.Name;
        _formEmail = vehicle.DriverEmail;
        _formSpotId = vehicle.AssignedSpotId?.ToString() ?? string.Empty;
        _formNotes = vehicle.Notes;
    }

    private void CancelEdit() => ResetForm();

    private async Task SaveEditAsync()
    {
        if (_editing is null)
        {
            return;
        }

        _error = _info = null;
        var result = await Fleet.UpdateAsync(_editing.Id, _formPlate ?? string.Empty, _formType, _formName, _formEmail, FormSpotId, _formNotes);
        if (result.Succeeded)
        {
            ResetForm();
            await ReloadAsync();
        }
        else
        {
            _error = result.Errors.FirstOrDefault();
        }
    }

    private async Task PairAsync(CompanyVehicleDto vehicle, string? userId)
    {
        _error = _info = null;
        Guid? target = Guid.TryParse(userId, out var parsed) ? parsed : null;
        if (target == vehicle.PairedUserId)
        {
            return;
        }

        // Changing one driver for another goes through an explicit unpair first, so the old
        // driver's residency is released with the usual notification before the new one starts.
        var result = vehicle.PairedUserId is not null
            ? await Fleet.UnpairAsync(vehicle.Id)
            : ParkingResult.Success;
        if (result.Succeeded && target is { } newUser)
        {
            result = await Fleet.PairManuallyAsync(vehicle.Id, newUser);
        }

        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
        }

        await ReloadAsync();
    }

    private async Task SetActiveAsync(Guid id, bool active)
    {
        _error = _info = null;
        var result = await Fleet.SetActiveAsync(id, active);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
        }

        await ReloadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        _error = _info = null;
        var result = await Fleet.DeleteAsync(id);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
        }

        await ReloadAsync();
    }

    private void ResetForm()
    {
        _editing = null;
        _formPlate = _formName = _formEmail = _formNotes = null;
        _formType = VehicleType.Company;
        _formSpotId = string.Empty;
    }

    private async Task ReloadAsync() => _vehicles = await Fleet.ListAsync();
}
