@page "/admin/parking/fleet"
@attribute [HasPermission(Permissions.Parking.ManageFleet)]
@rendermode InteractiveServer
@implements IDisposable
@inject IFleetService Fleet
@inject IParkingSpotService Spots
@inject IUserAdminService UserAdmin
@inject ISiteSettingsService SiteSettings
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Fleet_Admin_Title"]</PageTitle>

<FluentStack Class="page-shell" Orientation="Orientation.Vertical" VerticalGap="20">
    <div class="admin-head fleet-head">
        <div class="admin-head__titles">
            <div class="admin-head__title-row">
                <FluentLabel Typo="Typography.PageTitle">@L["Fleet_Admin_Title"]</FluentLabel>
            </div>
            <p class="admin-head__intro">@L["Fleet_Admin_Intro"]</p>
        </div>
        <FluentButton Id="fleet-open-add" Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Add())"
                      OnClick="BeginCreateAsync">@L["Fleet_Admin_AddTitle"]</FluentButton>
    </div>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">@L[_error]</FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">@L[_info]</FluentMessageBar>
    }

    @if (_vehicles is null || _summary is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else
    {
        <section class="fleet-overview" aria-label="@L["Fleet_Overview_Label"]">
            @FleetMetric(L["Fleet_Overview_Active"], ActiveVehicleCount, "active")
            @FleetMetric(L["Fleet_Overview_Paired"], PairedVehicleCount, "paired")
            @FleetMetric(L["Fleet_Overview_Action"], ActionVehicleCount, ActionVehicleCount > 0 ? "attention" : "clear")
            @FleetMetric(L["Fleet_Overview_Assigned"], AssignedSpotCount, "parking")
        </section>

        <section class="fleet-commandbar" aria-label="@L["Fleet_Filter_Label"]">
            <label class="lot-search fleet-search" for="fleet-search">
                <FluentIcon Value="@(new Icons.Regular.Size20.Search())" Color="Color.Custom" CustomColor="currentColor" />
                <input id="fleet-search" type="search" placeholder="@L["Fleet_Filter_Search"]"
                       value="@_search" @oninput="OnSearchInputAsync" />
            </label>
            <select class="parking-input fleet-filter" aria-label="@L["Fleet_Filter_Type"]"
                    value="@_typeFilter" @onchange="OnTypeFilterChangedAsync">
                <option value="">@L["Fleet_Filter_AllTypes"]</option>
                @foreach (var type in _vehicleTypes)
                {
                    <option value="@type">@L[$"Fleet_Type_{type}"]</option>
                }
            </select>
            <select class="parking-input fleet-filter" aria-label="@L["Fleet_Filter_Parking"]"
                    value="@_parkingFilter" @onchange="OnParkingFilterChangedAsync">
                <option value="">@L["Fleet_Filter_AllParking"]</option>
                <option value="assigned">@L["Fleet_Filter_Assigned"]</option>
                <option value="unassigned">@L["Fleet_Filter_Unassigned"]</option>
            </select>
            @if (HasActiveFilters)
            {
                <button type="button" class="lot-clear-filter" @onclick="ClearFiltersAsync">@L["Fleet_Filter_Clear"]</button>
            }
        </section>

        <div class="fleet-state-filters" role="group" aria-label="@L["Fleet_Filter_State"]">
            @FleetViewButton(FleetViewActive, L["Fleet_View_Active"], ActiveVehicleCount)
            @FleetViewButton(FleetViewPaired, L["Fleet_View_Paired"], PairedVehicleCount)
            @FleetViewButton(FleetViewAction, L["Fleet_View_Action"], ActionVehicleCount)
            @FleetViewButton(FleetViewManual, L["Fleet_View_Manual"], ManualVehicleCount)
            @FleetViewButton(FleetViewInactive, L["Fleet_View_Inactive"], InactiveVehicleCount)
        </div>

        <div class="fleet-results-head">
            <span aria-live="polite">@L["Fleet_Filter_ResultCount", _totalCount]</span>
            <span>@ActiveViewDescription</span>
        </div>

        <div class="fleet-workspace @(SideOpen ? "has-side" : null)">
            <div class="fleet-registry">
                @if (_summary.TotalCount == 0)
                {
                    <div class="fleet-empty">
                        <strong>@L["Fleet_Admin_NoVehicles"]</strong>
                        <FluentButton Appearance="Appearance.Accent" OnClick="BeginCreateAsync">@L["Fleet_Admin_AddTitle"]</FluentButton>
                    </div>
                }
                else if (_totalCount == 0)
                {
                    <div class="fleet-empty">
                        <strong>@L["Fleet_Filter_EmptyTitle"]</strong>
                        <span>@L["Fleet_Filter_EmptyText"]</span>
                        <FluentButton Appearance="Appearance.Outline" OnClick="ClearFiltersAsync">@L["Fleet_Filter_Clear"]</FluentButton>
                    </div>
                }
                else
                {
                    <div class="admin-panel fleet-table-wrap">
                        <table class="fleet-table">
                            <thead>
                                <tr>
                                    <th scope="col">@L["Fleet_Table_Vehicle"]</th>
                                    <th scope="col">@L["Fleet_Table_Driver"]</th>
                                    <th scope="col">@L["Fleet_Table_Parking"]</th>
                                    <th scope="col">@L["Fleet_Table_Pairing"]</th>
                                    <th scope="col">@L["Fleet_Table_Activity"]</th>
                                    <th scope="col" class="fleet-table__actions">@L["Fleet_Table_Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vehicle in _vehicles)
                                {
                                    var pill = StatePill(vehicle);
                                    <tr class="@(_selected?.Id == vehicle.Id ? "is-selected" : null)">
                                        <th scope="row">
                                            <button type="button" class="fleet-vehicle-link" aria-pressed="@(_selected?.Id == vehicle.Id ? "true" : "false")"
                                                    @onclick="() => SelectVehicle(vehicle)">
                                                <span>@vehicle.Plate</span>
                                                <small>@(string.IsNullOrWhiteSpace(vehicle.Name) ? L[$"Fleet_Type_{vehicle.Type}"] : vehicle.Name)</small>
                                            </button>
                                        </th>
                                        <td>
                                            <div class="fleet-cell-stack">
                                                <span>@(vehicle.PairedUserName ?? L["Fleet_Driver_Unpaired"].Value)</span>
                                                <small>@(vehicle.DriverEmail ?? L["Fleet_Driver_NoEmail"].Value)</small>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fleet-cell-stack">
                                                <span>@L[$"Fleet_Type_{vehicle.Type}"]</span>
                                                <small>@(vehicle.SpotCode is null ? L["Fleet_Parking_NoSpot"] : L["Fleet_Parking_Spot", vehicle.SpotCode])</small>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fleet-cell-stack">
                                                <span class="state-pill @pill.Css" title="@pill.Hint">@pill.Label</span>
                                                <small>@PairingNextStep(vehicle)</small>
                                            </div>
                                        </td>
                                        <td class="fleet-table__activity">@PairingActivity(vehicle)</td>
                                        <td class="fleet-table__actions">
                                            <button type="button" class="fleet-more" title="@L["Fleet_Action_Detail"]"
                                                    aria-label="@L["Fleet_Action_DetailFor", vehicle.Plate]" @onclick="() => SelectVehicle(vehicle)">
                                                <FluentIcon Value="@(new Icons.Regular.Size20.MoreHorizontal())" Color="Color.Custom" CustomColor="currentColor" />
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (PageCount > 1)
                    {
                        <div class="pager" aria-label="@L["Fleet_Pagination_Label"]">
                            <FluentButton Appearance="Appearance.Outline" Disabled="@(_pageIndex == 0)"
                                          OnClick="() => GoToPageAsync(_pageIndex - 1)">@L["Common_PrevPage"]</FluentButton>
                            <span>@L["Common_PageOf", _pageIndex + 1, PageCount]</span>
                            <FluentButton Appearance="Appearance.Outline" Disabled="@(_pageIndex >= PageCount - 1)"
                                          OnClick="() => GoToPageAsync(_pageIndex + 1)">@L["Common_NextPage"]</FluentButton>
                        </div>
                    }
                }
            </div>

            @if (_editorOpen)
            {
                <aside class="admin-panel fleet-side fleet-editor" aria-label="@L["Fleet_Editor_Label"]">
                    <div class="fleet-side__head">
                        <div>
                            <span class="fleet-side__eyebrow">@(_editing is null ? L["Fleet_Editor_New"] : L["Fleet_Editor_Edit"])</span>
                            <strong>@(_editing is null ? L["Fleet_Admin_AddTitle"] : _editing.Plate)</strong>
                        </div>
                        <button type="button" class="fleet-more" aria-label="@L["Fleet_Action_Close"]" @onclick="CloseSide">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" Color="Color.Custom" CustomColor="currentColor" />
                        </button>
                    </div>

                    @if (_optionsBusy)
                    {
                        <div class="loading"><FluentProgressRing /></div>
                    }
                    else
                    {
                        <div class="fleet-form">
                            <FluentTextField Id="fleet-plate" Immediate="true" @bind-Value="_formPlate" Maxlength="16"
                                             Label="@L["Fleet_Admin_Plate"]" Placeholder="1AB 2345" />
                            <FluentSelect Id="fleet-type" TOption="VehicleType"
                                          Items="@_vehicleTypes"
                                          OptionValue="@(t => t.ToString())"
                                          OptionText="@(t => L[$"Fleet_Type_{t}"].Value)"
                                          Value="@_formType.ToString()"
                                          ValueChanged="@(v => OnTypeChanged(v))"
                                          Label="@L["Fleet_Admin_Type"]" />
                            <FluentTextField @bind-Value="_formName" Maxlength="128" Label="@L["Fleet_Admin_Name"]" />
                            <FluentTextField Id="fleet-email" @bind-Value="_formEmail" Maxlength="256" Label="@L["Fleet_Admin_DriverEmail"]" />
                            @if (_formType == VehicleType.Company)
                            {
                                <FluentSelect TOption="string"
                                              Items="@SpotOptions"
                                              OptionValue="@(id => id)"
                                              OptionText="@(id => SpotLabel(id))"
                                              @bind-Value="_formSpotId"
                                              Label="@L["Fleet_Admin_Spot"]" />
                            }
                            <FluentTextField @bind-Value="_formNotes" Maxlength="512" Label="@L["Fleet_Admin_Notes"]" />

                            <div class="fleet-form__hint">
                                <strong>@L["Fleet_Editor_Entitlement"]</strong>
                                <span>@(_formType == VehicleType.Company ? L["Fleet_Editor_CompanyHint"] : L["Fleet_Editor_EmployeeHint"])</span>
                            </div>

                            <div class="fleet-side__actions">
                                @if (_editing is null)
                                {
                                    <FluentButton Id="fleet-add" Appearance="Appearance.Accent" Disabled="@_busy" OnClick="CreateAsync">@L["Fleet_Admin_Add"]</FluentButton>
                                }
                                else
                                {
                                    <FluentButton Id="fleet-save" Appearance="Appearance.Accent" Disabled="@_busy" OnClick="SaveEditAsync">@L["Fleet_Admin_Save"]</FluentButton>
                                }
                                <FluentButton Appearance="Appearance.Outline" OnClick="CloseSide">@L["Fleet_Admin_Cancel"]</FluentButton>
                            </div>
                        </div>
                    }
                </aside>
            }
            else if (_selected is not null)
            {
                var selectedPill = StatePill(_selected);
                <aside class="admin-panel fleet-side" aria-live="polite" aria-label="@L["Fleet_Detail_Label"]">
                    <div class="fleet-side__head">
                        <div>
                            <span class="fleet-side__eyebrow">@L["Fleet_Detail_Vehicle"]</span>
                            <strong>@_selected.Plate</strong>
                        </div>
                        <button type="button" class="fleet-more" aria-label="@L["Fleet_Action_Close"]" @onclick="CloseSide">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" Color="Color.Custom" CustomColor="currentColor" />
                        </button>
                    </div>

                    <div class="fleet-detail__status">
                        <span class="state-pill @selectedPill.Css">@selectedPill.Label</span>
                        <span class="state-pill state-pill--@(_selected.IsActive ? "on" : "off")">
                            @L[_selected.IsActive ? "Parking_Admin_Active" : "Parking_Admin_Inactive"]
                        </span>
                    </div>

                    <section class="fleet-detail__section">
                        <h3>@L["Fleet_Detail_Identity"]</h3>
                        @DetailFact(L["Fleet_Admin_Name"], _selected.Name ?? "—")
                        @DetailFact(L["Fleet_Admin_Type"], L[$"Fleet_Type_{_selected.Type}"])
                        @DetailFact(L["Fleet_Admin_DriverEmail"], _selected.DriverEmail ?? L["Fleet_Driver_NoEmail"])
                    </section>

                    <section class="fleet-detail__section">
                        <h3>@L["Fleet_Detail_Parking"]</h3>
                        @DetailFact(L["Fleet_Admin_Spot"], _selected.SpotCode ?? L["Fleet_Parking_NoSpot"])
                        <p class="fleet-detail__note">@ParkingEntitlement(_selected)</p>
                    </section>

                    <section class="fleet-detail__section">
                        <h3>@L["Fleet_Detail_Pairing"]</h3>
                        @DetailFact(L["Fleet_Admin_PairedUser"], _selected.PairedUserName ?? L["Fleet_Admin_NotPaired"])
                        <p class="fleet-detail__note">@PairingNextStep(_selected)</p>
                    </section>

                    @if (!string.IsNullOrWhiteSpace(_selected.Notes))
                    {
                        <section class="fleet-detail__section">
                            <h3>@L["Fleet_Admin_Notes"]</h3>
                            <p class="fleet-detail__note">@_selected.Notes</p>
                        </section>
                    }

                    @if (_pairingOpen)
                    {
                        <section class="fleet-pairing">
                            <h3>@L["Fleet_Pair_Title"]</h3>
                            @if (_optionsBusy)
                            {
                                <FluentProgressRing Style="width:24px;height:24px" />
                            }
                            else
                            {
                                <FluentSelect TOption="string"
                                              Items="@UserOptions"
                                              OptionValue="@(id => id)"
                                              OptionText="@(id => UserLabel(id))"
                                              Value="@_pairUserId"
                                              ValueChanged="OnPairUserChanged"
                                              Label="@L["Fleet_Admin_PairedUser"]" />
                                @if (!_pairingConfirmed)
                                {
                                    <FluentButton Appearance="Appearance.Accent" Disabled="@_busy" OnClick="PreparePairing">
                                        @L["Fleet_Pair_Review"]
                                    </FluentButton>
                                }
                                else
                                {
                                    <div class="fleet-pairing__confirm">
                                        <strong>@L["Fleet_Pair_ConfirmTitle"]</strong>
                                        <span>@PairingConfirmationText</span>
                                    </div>
                                    <FluentButton Appearance="Appearance.Accent" Disabled="@_busy" OnClick="ConfirmPairingAsync">@L["Fleet_Pair_Confirm"]</FluentButton>
                                    <FluentButton Appearance="Appearance.Outline" OnClick="() => _pairingConfirmed = false">@L["Fleet_Pair_Back"]</FluentButton>
                                }
                            }
                        </section>
                    }

                    <div class="fleet-side__actions">
                        <FluentButton Appearance="Appearance.Accent" OnClick="() => BeginEditAsync(_selected)">@L["Fleet_Admin_Edit"]</FluentButton>
                        <FluentButton Appearance="Appearance.Outline" OnClick="BeginPairAsync">@PairActionLabel(_selected)</FluentButton>
                        @if (_selected.IsActive)
                        {
                            <FluentButton Appearance="Appearance.Stealth" Disabled="@_busy" OnClick="() => SetActiveAsync(_selected.Id, false)">@L["Fleet_Admin_Deactivate"]</FluentButton>
                        }
                        else
                        {
                            <FluentButton Appearance="Appearance.Outline" Disabled="@_busy" OnClick="() => SetActiveAsync(_selected.Id, true)">@L["Fleet_Admin_Activate"]</FluentButton>
                            <FluentButton Appearance="Appearance.Stealth" Disabled="@_busy" OnClick="() => DeleteAsync(_selected.Id)">@L["Fleet_Admin_Delete"]</FluentButton>
                        }
                    </div>
                </aside>
            }
        </div>
    }
</FluentStack>

@code {
    private const string FleetViewActive = "active";
    private const string FleetViewPaired = "paired";
    private const string FleetViewAction = "action";
    private const string FleetViewManual = "manual";
    private const string FleetViewInactive = "inactive";
    private const int PageSize = 25;

    private IReadOnlyList<CompanyVehicleDto>? _vehicles;
    private FleetDirectorySummary? _summary;
    private IReadOnlyList<ParkingSpotDto> _spots = [];
    private IReadOnlyList<UserSummary> _users = [];
    private TimeZoneInfo _tz = TimeZoneInfo.Utc;

    private string? _search;
    private string _typeFilter = string.Empty;
    private string _parkingFilter = string.Empty;
    private string _view = FleetViewActive;
    private int _pageIndex;
    private int _totalCount;
    private CancellationTokenSource? _searchDebounce;

    private CompanyVehicleDto? _selected;
    private CompanyVehicleDto? _editing;
    private bool _editorOpen;
    private bool _pairingOpen;
    private bool _pairingConfirmed;
    private bool _optionsBusy;
    private bool _spotsLoaded;
    private bool _usersLoaded;
    private bool _busy;

    private string? _formPlate;
    private VehicleType _formType = VehicleType.Company;
    private string? _formName;
    private string? _formEmail;
    private string _formSpotId = string.Empty;
    private string? _formNotes;
    private string _pairUserId = string.Empty;
    private readonly VehicleType[] _vehicleTypes = Enum.GetValues<VehicleType>();

    private string? _error;
    private string? _info;

    private int ActiveVehicleCount => _summary?.ActiveCount ?? 0;
    private int InactiveVehicleCount => _summary?.InactiveCount ?? 0;
    private int PairedVehicleCount => _summary?.PairedCount ?? 0;
    private int ManualVehicleCount => _summary?.ManualCount ?? 0;
    private int ActionVehicleCount => _summary?.ActionCount ?? 0;
    private int AssignedSpotCount => _summary?.AssignedSpotCount ?? 0;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
    private bool SideOpen => _editorOpen || _selected is not null;
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_search) || !string.IsNullOrEmpty(_typeFilter) || !string.IsNullOrEmpty(_parkingFilter);

    private string ActiveViewDescription => _view switch
    {
        FleetViewPaired => L["Fleet_View_PairedHint"],
        FleetViewAction => L["Fleet_View_ActionHint"],
        FleetViewManual => L["Fleet_View_ManualHint"],
        FleetViewInactive => L["Fleet_View_InactiveHint"],
        _ => L["Fleet_View_ActiveHint"],
    };

    private IEnumerable<string> SpotOptions => new[] { string.Empty }
        .Concat(_spots.Where(s => s.IsActive && s.Type != ParkingSpotType.Visitor && SpotAvailableForEditor(s.Id))
            .OrderBy(s => s.Code, StringComparer.OrdinalIgnoreCase)
            .Select(s => s.Id.ToString()));

    private IEnumerable<string> UserOptions => new[] { string.Empty }.Concat(_users.Select(u => u.Id.ToString()));

    private string PairingConfirmationText => _selected is null
        ? string.Empty
        : string.IsNullOrEmpty(_pairUserId)
            ? L["Fleet_Pair_ConfirmUnpair", _selected.Plate]
            : L["Fleet_Pair_ConfirmPair", UserLabel(_pairUserId), _selected.Plate, _selected.SpotCode ?? L["Fleet_Parking_NoSpot"]];

    private Guid? FormSpotId => _formType == VehicleType.Employee
        ? null
        : Guid.TryParse(_formSpotId, out var parsed) ? parsed : null;

    protected override async Task OnInitializedAsync()
    {
        _tz = await SiteSettings.GetTimeZoneAsync();
        await ReloadAsync();
    }

    private string Fmt(DateTimeOffset utc) => TimeZoneInfo.ConvertTime(utc, _tz).ToString("g");

    private (string Css, string Label, string? Hint) StatePill(CompanyVehicleDto vehicle) => vehicle.PairingState switch
    {
        FleetPairingState.Paired => ("state-pill--on", L["Fleet_State_Paired"],
            vehicle.PairedAtUtc is { } at ? L["Fleet_State_Paired_Hint", Fmt(at)] : null),
        FleetPairingState.CodeSent => ("state-pill--info", L["Fleet_State_CodeSent"],
            vehicle.PairingCodeSentAtUtc is { } sent ? L["Fleet_State_CodeSent_Hint", Fmt(sent)] : null),
        FleetPairingState.Locked => ("state-pill--warn", L["Fleet_State_Locked"],
            vehicle.PairingLockedUntilUtc is { } until ? L["Fleet_State_Locked_Hint", Fmt(until)] : null),
        FleetPairingState.ReadyToPair => ("state-pill--info", L["Fleet_State_ReadyToPair"], L["Fleet_State_ReadyToPair_Hint"]),
        FleetPairingState.PlateMissing => ("state-pill--info", L["Fleet_State_PlateMissing"], L["Fleet_State_PlateMissing_Hint"]),
        FleetPairingState.NoAccount => ("state-pill--warn", L["Fleet_State_NoAccount"], L["Fleet_State_NoAccount_Hint"]),
        FleetPairingState.ManualOnly => ("state-pill--off", L["Fleet_State_ManualOnly"], L["Fleet_State_ManualOnly_Hint"]),
        _ => ("state-pill--off", L["Fleet_Admin_Inactive"], null),
    };

    private string PairingNextStep(CompanyVehicleDto vehicle) => vehicle.PairingState switch
    {
        FleetPairingState.Paired => L["Fleet_Next_Paired", vehicle.PairedUserName ?? vehicle.DriverEmail ?? "—"],
        FleetPairingState.CodeSent => L["Fleet_Next_CodeSent"],
        FleetPairingState.Locked => vehicle.PairingLockedUntilUtc is { } until ? L["Fleet_Next_Locked", Fmt(until)] : L["Fleet_State_Locked"],
        FleetPairingState.ReadyToPair => L["Fleet_Next_Ready"],
        FleetPairingState.PlateMissing => L["Fleet_Next_Plate"],
        FleetPairingState.NoAccount => L["Fleet_Next_Account"],
        FleetPairingState.ManualOnly => L["Fleet_Next_Manual"],
        _ => L["Fleet_Next_Inactive"],
    };

    private string PairingActivity(CompanyVehicleDto vehicle)
    {
        var instant = vehicle.PairingState == FleetPairingState.Paired ? vehicle.PairedAtUtc : vehicle.PairingCodeSentAtUtc;
        return instant is { } at ? Fmt(at) : "—";
    }

    private string ParkingEntitlement(CompanyVehicleDto vehicle) => vehicle.Type == VehicleType.Company
        ? vehicle.SpotCode is null ? L["Fleet_Detail_CompanyNoSpot"] : L["Fleet_Detail_CompanySpot", vehicle.SpotCode]
        : L["Fleet_Detail_EmployeePool"];

    private string PairActionLabel(CompanyVehicleDto vehicle) => vehicle.PairedUserId is null
        ? L["Fleet_Pair_Action"]
        : L["Fleet_Pair_ChangeAction"];

    private string SpotLabel(string id)
    {
        if (string.IsNullOrEmpty(id))
        {
            return L["Fleet_Admin_NoSpot"];
        }

        return _spots.FirstOrDefault(s => s.Id.ToString() == id)?.Code ?? id;
    }

    private string UserLabel(string id)
    {
        if (string.IsNullOrEmpty(id))
        {
            return L["Fleet_Admin_NotPaired"];
        }

        var user = _users.FirstOrDefault(u => u.Id.ToString() == id);
        return user is null ? id : string.IsNullOrWhiteSpace(user.DisplayName) ? user.Email : $"{user.DisplayName} · {user.Email}";
    }

    private bool SpotAvailableForEditor(Guid spotId) =>
        !(_summary?.AssignedSpotIds.Contains(spotId) ?? false) || _editing?.AssignedSpotId == spotId;

    private async Task SetViewAsync(string view)
    {
        _view = view;
        _selected = null;
        _pairingOpen = false;
        await ApplyFiltersAsync();
    }

    private async Task ClearFiltersAsync()
    {
        CancelSearchDebounce();
        _search = null;
        _typeFilter = string.Empty;
        _parkingFilter = string.Empty;
        await ApplyFiltersAsync();
    }

    private async Task OnSearchInputAsync(ChangeEventArgs args)
    {
        _search = args.Value?.ToString();
        CancelSearchDebounce();
        var debounce = _searchDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, debounce.Token);
            await ApplyFiltersAsync(debounce.Token);
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke owns the next query.
        }
    }

    private async Task OnTypeFilterChangedAsync(ChangeEventArgs args)
    {
        CancelSearchDebounce();
        _typeFilter = args.Value?.ToString() ?? string.Empty;
        await ApplyFiltersAsync();
    }

    private async Task OnParkingFilterChangedAsync(ChangeEventArgs args)
    {
        CancelSearchDebounce();
        _parkingFilter = args.Value?.ToString() ?? string.Empty;
        await ApplyFiltersAsync();
    }

    private async Task ApplyFiltersAsync(CancellationToken cancellationToken = default)
    {
        _pageIndex = 0;
        _selected = null;
        _pairingOpen = false;
        await LoadPageAsync(cancellationToken);
    }

    private async Task GoToPageAsync(int pageIndex)
    {
        CancelSearchDebounce();
        _pageIndex = Math.Clamp(pageIndex, 0, PageCount - 1);
        _selected = null;
        _pairingOpen = false;
        await LoadPageAsync();
    }

    private void SelectVehicle(CompanyVehicleDto vehicle)
    {
        _selected = vehicle;
        _editorOpen = false;
        _pairingOpen = false;
        _pairingConfirmed = false;
        _error = _info = null;
    }

    private async Task BeginCreateAsync()
    {
        ResetForm();
        _selected = null;
        _editorOpen = true;
        await EnsureSpotsAsync();
    }

    private async Task BeginEditAsync(CompanyVehicleDto vehicle)
    {
        _error = _info = null;
        _editing = vehicle;
        _formPlate = vehicle.Plate;
        _formType = vehicle.Type;
        _formName = vehicle.Name;
        _formEmail = vehicle.DriverEmail;
        _formSpotId = vehicle.AssignedSpotId?.ToString() ?? string.Empty;
        _formNotes = vehicle.Notes;
        _editorOpen = true;
        await EnsureSpotsAsync();
    }

    private async Task BeginPairAsync()
    {
        if (_selected is null)
        {
            return;
        }

        _pairUserId = _selected.PairedUserId?.ToString() ?? string.Empty;
        _pairingOpen = true;
        _pairingConfirmed = false;
        await EnsureUsersAsync();
    }

    private void OnPairUserChanged(string? value)
    {
        _pairUserId = value ?? string.Empty;
        _pairingConfirmed = false;
    }

    private void PreparePairing() => _pairingConfirmed = true;

    private void CloseSide()
    {
        _selected = null;
        _editorOpen = false;
        _pairingOpen = false;
        _pairingConfirmed = false;
        ResetForm();
    }

    private async Task EnsureSpotsAsync()
    {
        if (_spotsLoaded)
        {
            return;
        }

        _optionsBusy = true;
        try
        {
            _spots = await Spots.ListAsync();
            _spotsLoaded = true;
        }
        finally
        {
            _optionsBusy = false;
        }
    }

    private async Task EnsureUsersAsync()
    {
        if (_usersLoaded)
        {
            return;
        }

        _optionsBusy = true;
        try
        {
            _users = await UserAdmin.ListAsync(null);
            _usersLoaded = true;
        }
        finally
        {
            _optionsBusy = false;
        }
    }

    private void OnTypeChanged(string? value)
    {
        if (Enum.TryParse<VehicleType>(value, out var parsed))
        {
            _formType = parsed;
        }
    }

    private async Task CreateAsync()
    {
        _error = _info = null;
        _busy = true;
        try
        {
            var result = await Fleet.CreateAsync(_formPlate ?? string.Empty, _formType, _formName, _formEmail, FormSpotId, _formNotes);
            if (result.Succeeded)
            {
                _info = L["Fleet_Success_Created"].Value;
                CloseSide();
                await ReloadAsync();
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveEditAsync()
    {
        if (_editing is null)
        {
            return;
        }

        _error = _info = null;
        _busy = true;
        try
        {
            var result = await Fleet.UpdateAsync(_editing.Id, _formPlate ?? string.Empty, _formType, _formName, _formEmail, FormSpotId, _formNotes);
            if (result.Succeeded)
            {
                _info = L["Fleet_Success_Updated"].Value;
                CloseSide();
                await ReloadAsync();
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmPairingAsync()
    {
        if (_selected is null)
        {
            return;
        }

        _error = _info = null;
        _busy = true;
        try
        {
            Guid? target = Guid.TryParse(_pairUserId, out var parsed) ? parsed : null;
            if (target == _selected.PairedUserId)
            {
                _pairingOpen = false;
                return;
            }

            var vehicleId = _selected.Id;
            var result = _selected.PairedUserId is not null
                ? await Fleet.UnpairAsync(vehicleId)
                : ParkingResult.Success;
            if (result.Succeeded && target is { } newUser)
            {
                result = await Fleet.PairManuallyAsync(vehicleId, newUser);
            }

            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault();
                return;
            }

            _info = L[target is null ? "Fleet_Success_Unpaired" : "Fleet_Success_Paired"].Value;
            _pairingOpen = false;
            _pairingConfirmed = false;
            await ReloadAsync();
            _selected = _vehicles?.FirstOrDefault(v => v.Id == vehicleId);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetActiveAsync(Guid id, bool active)
    {
        _error = _info = null;
        _busy = true;
        try
        {
            var result = await Fleet.SetActiveAsync(id, active);
            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault();
                return;
            }

            _info = L[active ? "Fleet_Success_Activated" : "Fleet_Success_Deactivated"].Value;
            await ReloadAsync();
            _selected = _vehicles?.FirstOrDefault(v => v.Id == id);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        _error = _info = null;
        _busy = true;
        try
        {
            var result = await Fleet.DeleteAsync(id);
            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault();
                return;
            }

            _info = L["Fleet_Success_Deleted"].Value;
            CloseSide();
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetForm()
    {
        _editing = null;
        _formPlate = _formName = _formEmail = _formNotes = null;
        _formType = VehicleType.Company;
        _formSpotId = string.Empty;
    }

    private async Task ReloadAsync(CancellationToken cancellationToken = default)
    {
        var summaryTask = Fleet.GetAdminSummaryAsync(cancellationToken);
        var pageTask = Fleet.ListAdminPageAsync(CurrentFilter(), _pageIndex, PageSize, cancellationToken);
        await Task.WhenAll(summaryTask, pageTask);

        _summary = await summaryTask;
        ApplyPage(await pageTask);
    }

    private async Task LoadPageAsync(CancellationToken cancellationToken = default)
    {
        var page = await Fleet.ListAdminPageAsync(CurrentFilter(), _pageIndex, PageSize, cancellationToken);
        ApplyPage(page);
    }

    private void ApplyPage(PagedResult<CompanyVehicleDto> page)
    {
        var selectedId = _selected?.Id;
        _vehicles = page.Items;
        _totalCount = page.TotalCount;
        _pageIndex = page.PageIndex;
        _selected = selectedId is { } id ? _vehicles.FirstOrDefault(v => v.Id == id) : null;
    }

    private FleetVehicleListQuery CurrentFilter() => new(
        Search: _search,
        Type: Enum.TryParse<VehicleType>(_typeFilter, out var type) ? type : null,
        Parking: _parkingFilter switch
        {
            "assigned" => FleetParkingAssignmentFilter.Assigned,
            "unassigned" => FleetParkingAssignmentFilter.Unassigned,
            _ => FleetParkingAssignmentFilter.All,
        },
        State: _view switch
        {
            FleetViewPaired => FleetVehicleStateFilter.Paired,
            FleetViewAction => FleetVehicleStateFilter.ActionRequired,
            FleetViewManual => FleetVehicleStateFilter.ManualOnly,
            FleetViewInactive => FleetVehicleStateFilter.Inactive,
            _ => FleetVehicleStateFilter.Active,
        });

    private void CancelSearchDebounce()
    {
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _searchDebounce = null;
    }

    private RenderFragment FleetMetric(string label, int value, string tone) => __builder =>
    {
        <div class="fleet-metric fleet-metric--@tone">
            <span class="fleet-metric__label">@label</span>
            <strong>@value</strong>
        </div>
    };

    private RenderFragment FleetViewButton(string view, string label, int count) => __builder =>
    {
        <button type="button" class="fleet-state-filter @(_view == view ? "is-selected" : null)"
                aria-pressed="@(_view == view ? "true" : "false")" @onclick="() => SetViewAsync(view)">
            <span>@label</span><strong>@count</strong>
        </button>
    };

    private RenderFragment DetailFact(string label, string value) => __builder =>
    {
        <div class="fleet-detail__fact"><span>@label</span><strong>@value</strong></div>
    };

    public void Dispose() => CancelSearchDebounce();
}
