@inject IStringLocalizer<SharedResource> L

<FluentBadge Appearance="Appearance.Accent" Fill="@_fill">@L[$"AccountStatus_{Status}"]</FluentBadge>

@code {
    [Parameter, EditorRequired] public AccountStatus Status { get; set; }

    // Semantic colour mapping: success for active accounts, warning for paused/deactivated/suspended
    // states the user can still recover, danger for blocked. The Fill string matches Fluent's
    // accent-fill colour names.
    private string _fill => Status switch
    {
        AccountStatus.Active => "success",
        AccountStatus.Deactivated => "warning",
        AccountStatus.Suspended => "warning",
        AccountStatus.Blocked => "danger",
        _ => "neutral",
    };
}
