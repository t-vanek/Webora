@page "/admin/audit"
@attribute [HasPermission(Permissions.Audit.View)]
@rendermode InteractiveServer
@inject IAuditService Audit
@inject ISiteSettingsService SiteSettings
@inject IStringLocalizer<SharedResource> L

@* The account trail has been written since the first release and, until this page, could only be
   read one user at a time from their detail screen. Oversight questions are cross-account by
   nature — who changed roles this week, who deleted an account — so the whole trail lives here. *@

<PageTitle>@L["Admin_Audit_Title"]</PageTitle>

<FluentStack Class="page-shell audit-page" Orientation="Orientation.Vertical" VerticalGap="20">
    <div class="admin-head">
        <div class="admin-head__titles">
            <div class="admin-head__title-row">
                <FluentLabel Typo="Typography.PageTitle">@L["Admin_Audit_Title"]</FluentLabel>
                @if (_entries is not null)
                {
                    @* What the filters match, not what this page draws. The chip used to say 200 for
                       every trail longer than 200, which is the one number it must never say. *@
                    <span class="count-chip">@_total</span>
                }
            </div>
            <p class="admin-head__intro">@L["Admin_Audit_Intro"]</p>
        </div>
    </div>

    @* Both filters go through FilterAsync, not ReloadAsync: a narrowed trail has its own pages, and
       page 7 of the old result set means nothing in the new one. *@
    <div class="audit-commandbar">
        @* Immediate: the change event of the underlying web component does not cross the shadow
           boundary reliably, so a term typed here reached the component only once the field lost
           focus — measured in the browser, the grid sat on the old result set the whole time. The
           delay is the debounce; every keystroke is a query. *@
        <FluentSearch @bind-Value="_search" @bind-Value:after="FilterAsync"
                      Immediate="true" ImmediateDelay="300"
                      Placeholder="@L["Admin_Audit_SearchHint"]" Class="audit-search" />
        <FluentSelect TOption="string"
                      Items="@_typeOptions"
                      OptionValue="@(t => t)"
                      OptionText="@(t => t.Length == 0 ? L["Admin_Audit_AllTypes"] : L[$"Audit_Type_{t}"])"
                      @bind-SelectedOption="_type"
                      @bind-SelectedOption:after="FilterAsync"
                      Class="audit-filter" />
        @if (!string.IsNullOrWhiteSpace(_search) || !string.IsNullOrEmpty(_type))
        {
            <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size20.Dismiss())"
                          OnClick="ClearFiltersAsync">@L["Common_ClearFilters"]</FluentButton>
        }
    </div>

    <div class="audit-results-head">
        <span>@L["Admin_Audit_Results", _total]</span>
        <small>@L["Admin_Audit_ResultHint"]</small>
    </div>

    @if (_entries is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else if (_entries.Count == 0)
    {
        <div class="empty-state">@L["Admin_Audit_Empty"]</div>
    }
    else
    {
        <div class="audit-workspace @(_selected is not null ? "has-detail" : null)">
            <div class="audit-list-pane">
                <div class="admin-panel audit-desktop-list">
                    <table class="audit-native-table">
                        <thead>
                            <tr>
                                <th>@L["Admin_UserEdit_AuditWhen"]</th>
                                <th>@L["Admin_Audit_Event"]</th>
                                <th>@L["Admin_Audit_Subject"]</th>
                                <th>@L["Admin_UserEdit_AuditActor"]</th>
                                <th aria-label="@L["Common_Actions"]"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in _entries)
                            {
                                <tr class="@(_selected?.Id == entry.Id ? "is-selected" : null)" @onclick="() => _selected = entry">
                                    <td>@Fmt(entry.OccurredAtUtc)</td>
                                    <td><strong>@L[$"Audit_Type_{entry.Type}"]</strong></td>
                                    <td>@Subject(entry)</td>
                                    <td>@ActorLabel(entry.Actor)</td>
                                    <td><FluentButton Appearance="Appearance.Stealth" IconEnd="@(new Icons.Regular.Size16.ChevronRight())" Title="@L["Admin_Audit_OpenDetail"]" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="audit-mobile-list">
                    @foreach (var entry in _entries)
                    {
                        <button type="button" class="audit-mobile-row" @onclick="() => _selected = entry">
                            <span class="audit-mobile-row__head"><strong>@L[$"Audit_Type_{entry.Type}"]</strong><span>@Fmt(entry.OccurredAtUtc)</span></span>
                            <span>@Subject(entry)</span>
                            <small>@ActorLabel(entry.Actor)</small>
                        </button>
                    }
                </div>
            </div>
            <aside class="audit-detail-pane">
                @if (_selected is null)
                {
                    <div class="audit-detail-empty">@L["Admin_Audit_SelectHint"]</div>
                }
                else
                {
                    <div class="audit-detail-head">
                        <div><small>@L["Admin_Audit_Event"]</small><h2>@L[$"Audit_Type_{_selected.Type}"]</h2></div>
                        <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size20.Dismiss())"
                                      Title="@L["Common_Close"]" OnClick="() => _selected = null" />
                    </div>
                    <dl class="audit-detail-facts">
                        <div><dt>@L["Admin_UserEdit_AuditWhen"]</dt><dd>@Fmt(_selected.OccurredAtUtc)</dd></div>
                        <div><dt>@L["Admin_Audit_Subject"]</dt><dd>@Subject(_selected)</dd></div>
                        <div><dt>@L["Admin_UserEdit_AuditActor"]</dt><dd>@ActorLabel(_selected.Actor)</dd></div>
                    </dl>
                    <div class="audit-detail-payload">
                        <small>@L["Admin_UserEdit_AuditDetail"]</small>
                        <pre>@(_selected.Detail ?? "—")</pre>
                    </div>
                    @if (_selected.UserEmail is not null)
                    {
                        <FluentAnchor Href="@($"admin/users/{_selected.UserId}")" Appearance="Appearance.Outline">
                            @L["Admin_Audit_OpenAccount"]
                        </FluentAnchor>
                    }
                }
            </aside>
        </div>
        @if (_total > PageSize)
        {
            <div class="pager">
                <FluentButton Appearance="Appearance.Outline" Disabled="@(_pageIndex == 0)"
                              OnClick="() => GoToPageAsync(_pageIndex - 1)">@L["Common_PrevPage"]</FluentButton>
                <span>@L["Common_PageOf", _pageIndex + 1, PageCount]</span>
                <FluentButton Appearance="Appearance.Outline" Disabled="@(_pageIndex >= PageCount - 1)"
                              OnClick="() => GoToPageAsync(_pageIndex + 1)">@L["Common_NextPage"]</FluentButton>
            </div>
        }
    }
</FluentStack>

@code {
    // Paged in SQL. This read used to stop at 200 rows and say nothing about it, which on an
    // append-only trail means the older half of the history simply had no way to be reached — and
    // the questions this page exists for ("who was handing out roles in March") are asked of exactly
    // the rows a cap swallows.
    private const int PageSize = 50;

    private IReadOnlyList<AuditLogEntry>? _entries;
    private AuditLogEntry? _selected;
    private int _pageIndex;
    private int _total;
    private string? _search;
    private string _type = string.Empty;
    private TimeZoneInfo _tz = TimeZoneInfo.Local;

    private int PageCount => _total == 0 ? 1 : (_total + PageSize - 1) / PageSize;

    private readonly string[] _typeOptions =
        [string.Empty, .. Enum.GetNames<AccountAuditEventType>()];

    protected override async Task OnInitializedAsync()
    {
        _tz = await SiteSettings.GetTimeZoneAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        AccountAuditEventType? type = Enum.TryParse<AccountAuditEventType>(_type, out var parsed) ? parsed : null;
        var page = await Audit.SearchAsync(_search, type, _pageIndex, PageSize);
        _entries = page.Items;
        _total = page.TotalCount;
        // Taken back from the result: the service walks the index back when the page asked for no
        // longer exists.
        _pageIndex = page.PageIndex;
        if (_selected is not null && _entries.All(entry => entry.Id != _selected.Id))
        {
            _selected = null;
        }
    }

    private async Task FilterAsync()
    {
        _pageIndex = 0;
        await ReloadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _search = null;
        _type = string.Empty;
        await FilterAsync();
    }

    private async Task GoToPageAsync(int pageIndex)
    {
        _pageIndex = Math.Clamp(pageIndex, 0, PageCount - 1);
        await ReloadAsync();
    }

    private string Fmt(DateTimeOffset utc) => TimeZoneInfo.ConvertTime(utc, _tz).ToString("g");

    private string Subject(AuditLogEntry entry) => entry.UserEmail is null
        ? L["Admin_Audit_DeletedUser"]
        : entry.UserDisplayName ?? entry.UserEmail;

    private string ActorLabel(string actor) => actor switch
    {
        "self" => L["Admin_UserEdit_ActorSelf"],
        _ when actor.StartsWith("admin:", StringComparison.OrdinalIgnoreCase) => L["Admin_UserEdit_ActorAdmin"],
        _ => actor,
    };
}
