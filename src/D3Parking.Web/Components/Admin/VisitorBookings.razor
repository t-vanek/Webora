@page "/admin/parking/visitors"
@attribute [HasPermission(Permissions.Parking.ManageVisitors)]
@rendermode InteractiveServer
@inject ILogger<VisitorBookings> Logger
@inject IVisitorBookingService Visitors
@inject IParkingSettingsService ParkingSettings
@inject IParkingSpotService Spots
@inject IUserAdminService UserAdmin
@inject ISiteSettingsService SiteSettings
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Parking_Visitors_Title"]</PageTitle>

@* Reception agenda for Visitor-type spots: guests have no accounts, so the booking carries the
   visitor's name/company/plate and (optionally) the visited employee, who gets a bell heads-up.
   Visitor spots are excluded from the employee pool, so this page is the only competition. *@
<FluentStack Class="page-shell visitors-page" Orientation="Orientation.Vertical" VerticalGap="20">
    <div class="admin-head visitors-head">
        <div class="admin-head__titles">
            <div class="admin-head__title-row">
                <FluentLabel Typo="Typography.PageTitle">@L["Parking_Visitors_Title"]</FluentLabel>
                @if (_bookings is not null)
                {
                    <span class="count-chip">@_bookings.Count</span>
                }
            </div>
            <p class="admin-head__intro">@L["Parking_Visitors_Intro"]</p>
        </div>
        <FluentButton Id="visitors-open-create" Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Add())"
                      Disabled="@(_createOpen || _cancelBooking is not null || _actionBusy || !_ready)" OnClick="OpenCreateAsync">
            @L["Parking_Visitors_NewBooking"]
        </FluentButton>
    </div>

    @if (_bookings is not null)
    {
        <section class="visitors-overview" aria-label="@L["Parking_Visitors_Overview"]">
            @VisitorMetric(L["Parking_Visitors_Today"], TodayBookings.Count.ToString(), "today", () => SetViewAsync(TodayView))
            @VisitorMetric(L["Parking_Visitors_Upcoming"], _bookings.Count.ToString(), "upcoming", () => SetViewAsync(UpcomingView))
            @VisitorMetric(L["Parking_Visitors_FreeNow"], AvailabilityCount, "free", OpenCreateAsync)
            @VisitorMetric(L["Parking_Visitors_SpotCapacity"], _visitorSpotCount.ToString(), "capacity", OpenCreateAsync)
        </section>
        <small>@L["Parking_Visitors_AvailabilityFor", SelectedWindowLabel]</small>
    }

    @if (_error is not null && !_createOpen)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">@L[_error]</FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">@L[_info]</FluentMessageBar>
    }

    @if (_setupFailed || _bookingsLoadFailed)
    {
        <FluentMessageBar Intent="MessageIntent.Error">@L["Parking_Admin_LoadFailed"]</FluentMessageBar>
        <FluentButton OnClick="ReloadPageAsync">@L["Parking_Admin_Retry"]</FluentButton>
    }

    <div class="visitors-commandbar">
        <FluentSearch @bind-Value="_search" Immediate="true" ImmediateDelay="200"
                      Placeholder="@L["Parking_Visitors_Search"]" Class="visitors-search" />
        <div class="visitors-view-switch" role="group" aria-label="@L["Parking_Visitors_View"]">
            <button type="button" class="@(_view == TodayView ? "is-active" : null)" @onclick="() => _view = TodayView">
                @L["Parking_Visitors_Today"] <span>@(_bookings is null ? "—" : TodayBookings.Count.ToString())</span>
            </button>
            <button type="button" class="@(_view == UpcomingView ? "is-active" : null)" @onclick="() => _view = UpcomingView">
                @L["Parking_Visitors_Upcoming"] <span>@(_bookings?.Count.ToString() ?? "—")</span>
            </button>
        </div>
    </div>

    <div class="visitors-results-head">
        <strong>@L[_view == TodayView ? "Parking_Visitors_TodayAgenda" : "Parking_Visitors_Upcoming"]</strong>
        @if (_bookings is not null)
        {
            <span>@L["Parking_Visitors_Results", VisibleBookings.Count]</span>
        }
    </div>
    @if (!_setupFailed && !_bookingsLoadFailed && _bookings is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else if (_bookings is not null && VisibleBookings.Count == 0)
    {
        <div class="empty-state">@L["Parking_Visitors_Empty"]</div>
    }
    else if (_bookings is not null)
    {
        <div class="admin-panel visitors-desktop-list">
            <table class="visitors-table">
                <thead><tr>
                    <th>@L["Parking_When"]</th><th>@L["Parking_Visitors_Name"]</th><th>@L["Parking_Spot"]</th>
                    <th>@L["Parking_Visitors_Plate"]</th><th>@L["Parking_Visitors_Host"]</th><th>@L["Parking_Visitors_CreatedBy"]</th><th></th>
                </tr></thead>
                <tbody>
                    @foreach (var booking in VisibleBookings)
                    {
                        <tr>
                            <td><strong>@Local(booking.StartUtc, "d")</strong><small>@BookingTimeLabel(booking)</small></td>
                            <td><strong>@booking.VisitorName</strong><small>@(booking.Company ?? "—")</small></td>
                            <td><span class="visitors-spot">@booking.SpotCode</span></td>
                            <td>@(booking.LicensePlate ?? "—")</td><td>@(booking.HostName ?? "—")</td><td>@booking.CreatedByName</td>
                            <td><FluentButton Id="@($"visitors-cancel-{booking.Id}")" Appearance="Appearance.Stealth"
                                              Disabled="@(_actionBusy || _cancelBooking is not null || _createOpen)"
                                              IconStart="@(new Icons.Regular.Size16.Delete())"
                                              Title="@L["Parking_Visitors_CancelLabel", booking.VisitorName]"
                                              aria-label="@L["Parking_Visitors_CancelLabel", booking.VisitorName]"
                                              OnClick="() => RequestCancellation(booking)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="visitors-mobile-list">
            @foreach (var booking in VisibleBookings)
            {
                <article class="visitors-mobile-row">
                    <div class="visitors-mobile-row__head"><strong>@booking.VisitorName</strong><span class="visitors-spot">@booking.SpotCode</span></div>
                    <span>@Local(booking.StartUtc, "d") · @BookingTimeLabel(booking)</span>
                    <small>@(booking.Company ?? booking.LicensePlate ?? L["Parking_Visitors_NoExtraInfo"])</small>
                    <div class="visitors-mobile-row__foot"><span>@(booking.HostName ?? "—")</span><FluentButton Appearance="Appearance.Stealth" Disabled="@(_actionBusy || _cancelBooking is not null || _createOpen)"
                        OnClick="() => RequestCancellation(booking)">@L["Parking_Cancel"]</FluentButton></div>
                </article>
            }
        </div>
    }
</FluentStack>

@if (_createOpen)
{
    <AdminDialog Title="@L["Parking_Visitors_NewBooking"]" Eyebrow="@L["Parking_Visitors_Title"]"
                 Size="wide" Class="visitors-create-dialog" BackdropClass="visitors-create-backdrop"
                 Busy="@_actionBusy" OnClose="CloseCreate">
        <div class="visitors-dialog-form">
            @if (_error is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@L[_error]</FluentMessageBar>
            }
            <p role="status">@L[AllDay ? "Parking_Visitors_ModeAllDay" : "Parking_Visitors_ModeTimeWindow", _tz.Id]</p>
            <div class="visitors-dialog-grid @(AllDay ? null : "visitors-dialog-grid--schedule")">
                <label class="visitors-dialog-field">
                    <span>@L["Parking_Visitors_Date"]</span>
                    <input id="visitors-date" type="date" autofocus disabled="@_actionBusy" @bind="_day" @bind:after="ReloadFreeSpotsAsync" class="parking-input"
                           min="@FirstBookableDay.ToString("yyyy-MM-dd")" max="@LastBookableDay.ToString("yyyy-MM-dd")" />
                </label>
                @if (!AllDay)
                {
                    <label class="visitors-dialog-field">
                        <span>@L["Parking_Visitors_From"]</span>
                        <input id="visitors-from" type="time" disabled="@_actionBusy" @bind="_from" @bind:after="ReloadFreeSpotsAsync" class="parking-input" />
                    </label>
                    <label class="visitors-dialog-field">
                        <span>@L["Parking_Visitors_To"]</span>
                        <input id="visitors-to" type="time" disabled="@_actionBusy" @bind="_to" @bind:after="ReloadFreeSpotsAsync" class="parking-input" />
                    </label>
                }
                <div class="visitors-dialog-field">
                <FluentSelect Id="visitors-spot" TOption="VisitorOption" Items="SpotOptions" Disabled="@(_actionBusy || _availabilityLoading || _availabilityFailed)"
                              OptionText="@(option => option.Text)" OptionValue="@(option => option.Value)"
                              @bind-Value="_selectedSpotId" Label="@L["Parking_Spot"]" />
                </div>
            </div>
            @if (SelectedWindowErrorKey is { } calendarError)
            {
                <FluentMessageBar Intent="MessageIntent.Warning" Type="MessageType.MessageBar">@L[calendarError]</FluentMessageBar>
            }
            @if (_availabilityLoading)
            {
                <div role="status">@L["Admin_Loading"]</div>
            }
            else if (_availabilityFailed)
            {
                <FluentMessageBar Intent="MessageIntent.Error">@L["Parking_Admin_LoadFailed"]</FluentMessageBar>
                <FluentButton OnClick="ReloadFreeSpotsAsync">@L["Parking_Admin_Retry"]</FluentButton>
            }
            else if (SelectedWindowErrorKey is null && _freeSpots.Count == 0)
            {
                <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Visitors_NoFreeSpots"]</FluentLabel>
            }
            <div class="visitors-dialog-grid">
                <div class="visitors-dialog-field">
                <FluentTextField Id="visitors-name" Disabled="@_actionBusy" @bind-Value="_visitorName" Label="@L["Parking_Visitors_Name"]" Maxlength="128" />
                </div>
                <div class="visitors-dialog-field">
                <FluentTextField Disabled="@_actionBusy" @bind-Value="_company" Label="@L["Parking_Visitors_Company"]" Maxlength="128" />
                </div>
                <div class="visitors-dialog-field">
                <FluentTextField Disabled="@_actionBusy" @bind-Value="_plate" Label="@L["Parking_Visitors_Plate"]" Maxlength="16" />
                </div>
                <div class="visitors-dialog-field">
                <FluentSelect Id="visitors-host" TOption="VisitorOption" Items="HostOptions" Disabled="@_actionBusy"
                              OptionText="@(option => option.Text)" OptionValue="@(option => option.Value)"
                              @bind-Value="_selectedHostId" Label="@L["Parking_Visitors_Host"]" />
                </div>
            </div>
            <div class="admin-dialog__actions">
                <FluentButton Appearance="Appearance.Outline" Disabled="@_actionBusy" OnClick="CloseCreate">@L["Common_Cancel"]</FluentButton>
                <FluentButton Id="visitors-book" Appearance="Appearance.Accent" OnClick="BookAsync"
                              Disabled="@(_actionBusy || _saveUncertain || _availabilityLoading || _availabilityFailed || SelectedSpot is null || SelectedWindowErrorKey is not null)">
                    @L["Parking_Visitors_Book"]
                </FluentButton>
            </div>
        </div>
    </AdminDialog>
}

@if (_cancelBooking is { } cancelling)
{
    <AdminDialog Title="@L["Parking_Visitors_CancelTitle"]" Eyebrow="@L["Parking_Visitors_Title"]"
                 Class="visitors-cancel-dialog" Busy="@_actionBusy" OnClose="CloseCancellation">
        @if (_cancelError is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error">@L[_cancelError]</FluentMessageBar>
        }
        <p><strong>@cancelling.VisitorName</strong><br />
            @cancelling.SpotCode · @Local(cancelling.StartUtc, "d") · @BookingTimeLabel(cancelling)
        </p>
        <p>@L["Parking_Visitors_CancelImpact"]</p>
        @if (cancelling.HostName is not null)
        {
            <p>@L["Parking_Visitors_CancelHostNotice"]</p>
        }
        <div class="admin-dialog__actions">
            <FluentButton Id="visitors-keep-booking" Appearance="Appearance.Outline" Disabled="@_actionBusy"
                          OnClick="CloseCancellation">@L[_cancelUncertain ? "Common_Close" : "Parking_Visitors_KeepBooking"]</FluentButton>
            <FluentButton Id="visitors-confirm-cancel" Appearance="Appearance.Accent" Disabled="@(_actionBusy || _cancelUncertain)"
                          OnClick="ConfirmCancellationAsync">@L["Parking_Cancel"]</FluentButton>
        </div>
    </AdminDialog>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Guid _userId;
    private TimeZoneInfo _tz = TimeZoneInfo.Utc;
    private IncentivePolicy? _policy;

    private DateOnly _day = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly _from = new(8, 0);
    private TimeOnly _to = new(17, 0);

    private IReadOnlyList<ParkingSpotDto> _freeSpots = [];
    private string? _selectedSpotId = string.Empty;
    private ParkingSpotDto? SelectedSpot => _freeSpots.FirstOrDefault(s => s.Id.ToString() == _selectedSpotId);
    private IReadOnlyList<UserSummary> _users = [];
    private string? _selectedHostId = string.Empty;
    private UserSummary? SelectedHost => _users.FirstOrDefault(u => u.Id.ToString() == _selectedHostId);
    private IReadOnlyList<VisitorBookingDto>? _bookings;
    private int _visitorSpotCount;
    private bool _createOpen;
    private VisitorBookingDto? _cancelBooking;
    private string? _cancelError;
    private bool _cancelUncertain;
    private string? _search;
    private string _view = TodayView;

    private const string TodayView = "today";
    private const string UpcomingView = "upcoming";

    private string? _visitorName;
    private string? _company;
    private string? _plate;
    private string? _error;
    private string? _info;

    private bool _ready;
    private bool _setupFailed;
    private bool _bookingsLoadFailed;
    private bool _availabilityLoading;
    private bool _availabilityFailed;
    private bool _noBookableWindow;
    private long _availabilitySequence;
    private bool AllDay => _policy?.ReservationTimeMode == ReservationTimeMode.AllDay;
    private DateTimeOffset Start => AllDay ? SiteTime.Day(_day, _tz).Start : SiteTime.At(_day, _from, _tz);
    // In a time window, 00:00 denotes the end of the selected day.
    private DateTimeOffset End => AllDay || _to == TimeOnly.MinValue
        ? SiteTime.Day(_day, _tz).End : SiteTime.At(_day, _to, _tz);
    private DateOnly Today => SiteTime.Today(DateTimeOffset.UtcNow, _tz);
    private DateOnly FirstBookableDay => _policy?.FirstBookableDate(Today) ?? Today;
    private DateOnly LastBookableDay => Today.AddDays(_policy?.ReservationHorizonDays ?? 14);
    private string? SelectedWindowErrorKey => _noBookableWindow ? "Parking_Visitors_NoBookableWindow"
        : _policy is null ? null
        : _policy.GetReservationDateAvailability(_day, Today).ToParkingErrorKey() is { } dateError ? dateError
        : !AllDay && (_tz.IsInvalidTime(_day.ToDateTime(_from))
            || _tz.IsInvalidTime(_day.ToDateTime(_to)))
            ? "Parking_Visitor_Error_NonexistentTime"
            : VisitorBookingWindowRules.Validate(Start, End, _policy, DateTimeOffset.UtcNow, _tz);
    private string AvailabilityCount => _availabilityLoading || _availabilityFailed || SelectedWindowErrorKey is not null
        ? "—" : _freeSpots.Count.ToString();
    private string SelectedWindowLabel => AllDay ? $"{_day:d} · {L["Parking_AllDay"]}"
        : $"{_day:d} · {_from:HH:mm}–{(_to == TimeOnly.MinValue ? "24:00" : _to.ToString("HH:mm"))}";

    private IReadOnlyList<VisitorBookingDto> TodayBookings => (_bookings ?? [])
        .Where(booking => booking.StartUtc < SiteTime.Day(Today, _tz).End
            && booking.EndUtc > SiteTime.Day(Today, _tz).Start)
        .ToList();

    private IReadOnlyList<VisitorBookingDto> VisibleBookings
    {
        get
        {
            IEnumerable<VisitorBookingDto> query = _view == TodayView ? TodayBookings : _bookings ?? [];
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                query = query.Where(booking =>
                    Contains(booking.VisitorName, term) || Contains(booking.Company, term)
                    || Contains(booking.LicensePlate, term) || Contains(booking.HostName, term)
                    || Contains(booking.SpotCode, term));
            }

            return query.ToList();
        }
    }

    private RenderFragment VisitorMetric(string label, string value, string tone, Func<Task> action) => __builder =>
    {
        <button type="button" class="visitors-metric visitors-metric--@tone" @onclick="action">
            <span>@label</span><strong>@value</strong>
        </button>
    };

    private Task SetViewAsync(string view)
    {
        _view = view;
        return Task.CompletedTask;
    }

    protected override Task OnInitializedAsync() => ReloadPageAsync();

    private async Task ReloadPageAsync()
    {
        _setupFailed = false;
        _ready = false;
        try
        {
            var state = await AuthState!;
            var user = await UserManager.GetUserAsync(state.User);
            _userId = user?.Id ?? Guid.Empty;
            _tz = await SiteSettings.GetTimeZoneAsync();
            _policy = await ParkingSettings.GetCurrentPolicyAsync();
            _day = _policy.FirstBookableDate(Today);
            _users = await UserAdmin.ListAsync(null);
            _visitorSpotCount = (await Spots.ListAsync(includeInactive: false)).Count(spot => spot.Type == ParkingSpotType.Visitor);
            _ready = true;
            await LoadFreeSpotsAsync(chooseInitialWindow: true);
            await ReloadBookingsAsync();
        }
        catch (Exception)
        {
            _setupFailed = true;
            Logger.LogWarning("Loading visitor booking setup failed.");
        }
    }

    private async Task OpenCreateAsync()
    {
        if (_actionBusy || !_ready || _cancelBooking is not null || _createOpen) return;
        _error = _info = null;
        _saveUncertain = false;
        _createOpen = true;
        await LoadFreeSpotsAsync(chooseInitialWindow: true);
    }

    private Task ReloadFreeSpotsAsync() => LoadFreeSpotsAsync(chooseInitialWindow: false);

    private async Task LoadFreeSpotsAsync(bool chooseInitialWindow)
    {
        var sequence = ++_availabilitySequence;
        var selectedId = SelectedSpot?.Id;
        _selectedSpotId = string.Empty;
        _freeSpots = [];
        _availabilityLoading = true;
        _availabilityFailed = false;
        try
        {
            var policy = await ParkingSettings.GetCurrentPolicyAsync();
            var timeZone = await SiteSettings.GetTimeZoneAsync();
            if (sequence != _availabilitySequence) return;
            _policy = policy;
            _tz = timeZone;
            _noBookableWindow = false;
            if (chooseInitialWindow)
            {
                if (VisitorBookingWindowRules.FindInitialWindow(policy, DateTimeOffset.UtcNow, timeZone) is { } window)
                {
                    _day = SiteTime.Today(window.Start, timeZone);
                    if (!AllDay)
                    {
                        _from = SiteTime.TimeOfDay(window.Start, timeZone);
                        _to = SiteTime.TimeOfDay(window.End, timeZone);
                    }
                }
                else
                {
                    _noBookableWindow = true;
                }
            }
            if (SelectedWindowErrorKey is not null) return;
            var free = await Visitors.GetFreeSpotsAsync(Start, End);
            if (sequence != _availabilitySequence) return;
            _freeSpots = free;
            _selectedSpotId = free.FirstOrDefault(s => s.Id == selectedId)?.Id.ToString() ?? string.Empty;
        }
        catch (Exception)
        {
            if (sequence == _availabilitySequence) _availabilityFailed = true;
            Logger.LogWarning("Loading visitor parking availability failed.");
        }
        finally
        {
            if (sequence == _availabilitySequence) _availabilityLoading = false;
        }
    }

    private async Task ReloadBookingsAsync()
    {
        _bookingsLoadFailed = false;
        try
        {
            _bookings = await Visitors.ListUpcomingAsync();
        }
        catch (Exception)
        {
            _bookings = null;
            _bookingsLoadFailed = true;
            Logger.LogWarning("Loading visitor bookings failed.");
        }
    }

    // Single-flight for the booking actions: a double-clicked Book must not fire twice against
    // the same window (the second would clear the success message and show a conflict error).
    private bool _actionBusy;
    private bool _saveUncertain;

    private void CloseCreate() => _createOpen = false;

    private async Task BookAsync()
    {
        if (_actionBusy || _saveUncertain || _availabilityLoading || _availabilityFailed || SelectedWindowErrorKey is not null)
        {
            return;
        }

        _actionBusy = true;
        try
        {
            _error = _info = null;
            if (SelectedSpot is not { } spot)
            {
                return;
            }

            var result = await Visitors.BookAsync(_userId, spot.Id, Start, End,
                _visitorName ?? string.Empty, _company, _plate, SelectedHost?.Id);
            if (result.Succeeded)
            {
                _info = "Parking_Visitors_Booked";
                _visitorName = _company = _plate = null;
                _selectedHostId = string.Empty;
                _view = UpcomingView;
                _search = null;
                await ReloadFreeSpotsAsync();
                await ReloadBookingsAsync();
                _createOpen = false;
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
                if (_error == "Parking_Error_AccessDenied") return;
                if (_error == "Parking_Visitor_Error_HostUnavailable")
                {
                    // The chosen account may have departed since this form was opened. Keep the
                    // draft but remove that stale choice; booking without a host remains explicit.
                    _users = _users.Where(u => u.Id.ToString() != _selectedHostId).ToArray();
                    _selectedHostId = string.Empty;
                }
                await ReloadFreeSpotsAsync();
            }
        }
        catch (Exception)
        {
            _saveUncertain = true;
            _error = "Parking_Visitors_SaveUncertain";
            Logger.LogWarning("A visitor booking operation failed; its result needs reloading.");
            await ReloadFreeSpotsAsync();
            await ReloadBookingsAsync();
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private void RequestCancellation(VisitorBookingDto booking)
    {
        if (_actionBusy || _createOpen || _cancelBooking is not null) return;
        _error = _info = _cancelError = null;
        _cancelUncertain = false;
        _cancelBooking = booking;
    }

    private void CloseCancellation()
    {
        if (_actionBusy) return;
        _cancelBooking = null;
        _cancelError = null;
    }

    private async Task ConfirmCancellationAsync()
    {
        if (_actionBusy || _cancelUncertain || _cancelBooking is not { } booking) return;

        _actionBusy = true;
        try
        {
            _error = _info = _cancelError = null;
            var result = await Visitors.CancelCheckedAsync(booking.Id, _userId);
            _cancelBooking = null;
            if (result.Succeeded)
            {
                _info = "Parking_Visitors_Cancelled";
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
                // Revoked write permissions must not trigger another read of the whole agenda.
                if (_error == "Parking_Error_AccessDenied") return;
            }
            await ReloadFreeSpotsAsync();
            await ReloadBookingsAsync();
        }
        catch (Exception)
        {
            _cancelUncertain = true;
            _cancelError = "Parking_Visitors_CancelUncertain";
            Logger.LogWarning("Cancelling a visitor booking failed; its result needs reloading.");
            await ReloadFreeSpotsAsync();
            await ReloadBookingsAsync();
        }
        finally
        {
            _actionBusy = false;
        }
    }

    // Explicit empty options keep the visible selection consistent with the value sent to the server.
    private sealed record VisitorOption(string Value, string Text);
    private IEnumerable<VisitorOption> SpotOptions => new[] { new VisitorOption(string.Empty, L["Parking_Visitors_ChooseSpot"]) }
        .Concat(_freeSpots.Select(s => new VisitorOption(s.Id.ToString(), s.Code)));
    private IEnumerable<VisitorOption> HostOptions => new[] { new VisitorOption(string.Empty, L["Parking_Visitors_NoHost"]) }
        .Concat(_users.Where(u => u.Status == AccountStatus.Active)
            .Select(u => new VisitorOption(u.Id.ToString(), u.DisplayName ?? u.Email)));

    private string BookingTimeLabel(VisitorBookingDto booking)
    {
        if (ReservationWindowRules.IsFullLocalDay(booking.StartUtc, booking.EndUtc, _tz))
            return L["Parking_AllDay"];
        var endFormat = SiteTime.Today(booking.StartUtc, _tz) == SiteTime.Today(booking.EndUtc, _tz) ? "t" : "g";
        return $"{Local(booking.StartUtc, "t")}–{Local(booking.EndUtc, endFormat)}";
    }

    private string Local(DateTimeOffset utc, string format) =>
        TimeZoneInfo.ConvertTime(utc, _tz).ToString(format);

    private static bool Contains(string? value, string term) =>
        value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
}
