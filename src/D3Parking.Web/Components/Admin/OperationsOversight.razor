@page "/admin/parking/oversight"
@page "/admin/parking/oversight/{Tab}"
@* The two queues used to be pages of their own, and later two tabs. Their routes stay as aliases
   so bookmarks and older deep links land on the matching filter instead of a 404. *@
@page "/admin/parking/mismatches"
@page "/admin/parking/collusion"
@attribute [HasAnyPermission(Permissions.Parking.ReviewMismatches, Permissions.Parking.ReviewCollusion)]
@rendermode InteractiveServer
@inject IOversightService Oversight
@inject ISiteSettingsService SiteSettings
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Parking_Oversight_Title"]</PageTitle>

@* One queue over everything the lot flags for a human decision. What used to be two grids of
   signals is one list of cases: a case knows who owns it, what was decided and what has already
   been tried, which a row of raw evidence never could.

   The kinds stay apart where it matters — a case is only ever visible to the permission that may
   see its evidence, and the columns here are the ones both kinds share. Anything specific to a
   report or to a flagged pair lives in the case detail, where there is room for it.

   The page-level gate is any-of: a reviewer who holds one permission gets in and sees only their
   kind of case, which is also what the counts are of. *@
<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <div class="admin-head__titles">
        <div class="admin-head__title-row">
            <FluentLabel Typo="Typography.PageTitle">@L["Parking_Oversight_Title"]</FluentLabel>
            @if (_queue is { OpenCount: > 0 })
            {
                <span class="count-chip" title="@L["Parking_Oversight_OpenCases"]">@_queue.OpenCount</span>
            }
            <FluentButton Appearance="Appearance.Stealth" Disabled="@_busy" OnClick="RefreshAsync"
                          IconStart="@(new Icons.Regular.Size20.ArrowClockwise())">@L["Parking_Oversight_Refresh"]</FluentButton>
        </div>
        <p class="admin-head__intro">@L["Parking_Oversight_Intro"]</p>
    </div>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">
            @L[_error]
        </FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">
            @L[_info]
        </FluentMessageBar>
    }

    @if (_queue is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else
    {
        @* Buttons, not FluentTabs: every one of these labels carries a count that changes the
           moment a case is ruled on, and swapping a tab element's children is exactly what makes
           FluentTabs re-read them and snap the selection back to the first tab (see LotDashboard). *@
        @* A group of toggles, not a tablist: they narrow one list rather than swap panels, and
           aria-pressed is what says which one is on. *@
        <div class="oversight-views" role="group" aria-label="@L["Parking_Oversight_Views"]">
            @foreach (var view in Views)
            {
                <FluentButton aria-pressed="@((_view == view).ToString().ToLowerInvariant())"
                              Appearance="@(_view == view ? Appearance.Accent : Appearance.Outline)"
                              Disabled="@_busy" OnClick="() => SwitchViewAsync(view)">
                    @L[$"Parking_Oversight_View_{view}"]
                    <span class="count-chip oversight-views__count">@CountFor(view)</span>
                </FluentButton>
            }
        </div>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true" VerticalAlignment="VerticalAlignment.Center">
            @* The kind filter only appears for a reviewer who can see more than one — with a
               single permission there is nothing to filter between. *@
            @if (_scopeKinds.Count > 1)
            {
                <FluentSelect TOption="string"
                              Items="@_kindOptions"
                              OptionValue="@(k => k)"
                              OptionText="@(k => k.Length == 0 ? L["Parking_Oversight_AllKinds"] : L[$"Parking_OversightKind_{k}"])"
                              @bind-Value="_kindFilter"
                              @bind-Value:after="ReloadAsync"
                              Style="min-width:220px" />
            }
            <FluentSelect TOption="string"
                          Items="@_priorityOptions"
                          OptionValue="@(p => p)"
                          OptionText="@(p => p.Length == 0 ? L["Parking_Oversight_AllPriorities"] : L[$"Parking_OversightPriority_{p}"])"
                          @bind-Value="_priorityFilter"
                          @bind-Value:after="ReloadAsync"
                          Style="min-width:200px" />
            <FluentSearch @bind-Value="_search" @bind-Value:after="ReloadAsync"
                          Placeholder="@L["Parking_Oversight_SearchHint"]" Style="max-width:320px" />
        </FluentStack>

        @if (_queue.Cases.Count == 0)
        {
            <div class="empty-state">@L["Parking_Oversight_Empty"]</div>
        }
        else
        {
            <div class="admin-head__title-row">
                <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Oversight_Records"]</FluentLabel>
                <span class="count-chip">@_queue.Cases.Count</span>
            </div>
            <div class="admin-panel">
                <FluentDataGrid Items="@_queue.Cases.AsQueryable()" TGridItem="OversightCaseListItemDto"
                                GridTemplateColumns="0.5fr 1.1fr 1.6fr 0.9fr 0.8fr 1.1fr 1fr auto">
                    <TemplateColumn Title="@L["Parking_Oversight_Number"]">
                        <a href="@CaseLink(context.Id)">#@context.Number</a>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Parking_Oversight_Kind"]">
                        @L[$"Parking_OversightKind_{context.Kind}"]
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Parking_Oversight_Subject"]">
                        @(string.IsNullOrEmpty(context.Subject) ? "—" : context.Subject)
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Parking_Status"]">
                        <span class="state-pill state-pill--@StatusClass(context.Status)">
                            @L[$"Parking_OversightStatus_{context.Status}"]
                        </span>
                        @if (context.Resolution is { } resolution)
                        {
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                                @L[$"Parking_OversightResolution_{resolution}"]
                            </FluentLabel>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Parking_Oversight_Priority"]">
                        <span class="state-pill state-pill--@PriorityClass(context.Priority)">
                            @L[$"Parking_OversightPriority_{context.Priority}"]
                        </span>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Parking_Oversight_Assignee"]">
                        @(context.AssigneeName ?? L["Parking_Oversight_Unassigned"].Value)
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Parking_Oversight_Opened"]">
                        @Local(context.OpenedAtUtc, "g")
                    </TemplateColumn>
                    <TemplateColumn Align="Align.End">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Wrap="true"
                                     HorizontalAlignment="HorizontalAlignment.End" VerticalAlignment="VerticalAlignment.Center">
                            @if (context.AssigneeId is null && context.Status != OversightCaseStatus.Resolved)
                            {
                                <FluentButton Appearance="Appearance.Outline" Disabled="@_busy"
                                              OnClick="() => ClaimAsync(context.Id)">@L["Parking_Oversight_Claim"]</FluentButton>
                            }
                            <FluentButton Appearance="Appearance.Stealth"
                                          OnClick="() => Nav.NavigateTo(CaseLink(context.Id))">@L["Parking_Oversight_Open"]</FluentButton>
                        </FluentStack>
                    </TemplateColumn>
                </FluentDataGrid>
            </div>
        }
    }
</FluentStack>

@code {
    private static readonly OversightView[] Views =
        [OversightView.Open, OversightView.Mine, OversightView.Unassigned, OversightView.All];

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>
    /// The trailing route segment. Accepts a saved view (<c>mine</c>) so a view is linkable, and
    /// the names the per-queue pages used to have (<c>collusion</c>, <c>occupancy</c>) so an old
    /// bookmark opens the queue narrowed to that kind.
    /// </summary>
    [Parameter] public string? Tab { get; set; }

    private Guid _reviewerId;
    private OversightQueueDto? _queue;
    private IReadOnlyList<OversightCaseKind> _scopeKinds = [];
    private OversightScope _scope = OversightScope.None;
    private TimeZoneInfo _tz = TimeZoneInfo.Utc;
    private OversightView _view = OversightView.Open;
    private string _kindFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private string _search = string.Empty;
    private string[] _kindOptions = [];
    private readonly string[] _priorityOptions =
        [string.Empty, .. Enum.GetNames<OversightCasePriority>()];
    private bool _busy;
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthState!).User;
        _scope = OversightScope.From(
            principal.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Parking.ReviewMismatches),
            principal.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Parking.ReviewCollusion));
        _scopeKinds = _scope.Kinds;
        _kindOptions = [string.Empty, .. _scopeKinds.Select(k => k.ToString())];

        var user = await UserManager.GetUserAsync(principal);
        _reviewerId = user?.Id ?? Guid.Empty;
        _tz = await SiteSettings.GetTimeZoneAsync();

        ApplyRoute();
        await LoadAsync();
    }

    /// <summary>
    /// Reads the route segment as either a view or a kind. A kind the reviewer cannot see is
    /// ignored rather than honoured — an old collusion bookmark opened by a mismatch reviewer
    /// should land on their queue, not on an empty one.
    /// </summary>
    private void ApplyRoute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        var segment = Tab
            ?? (path.EndsWith("collusion", StringComparison.OrdinalIgnoreCase) ? nameof(OversightCaseKind.CollusionRing)
                : path.EndsWith("mismatches", StringComparison.OrdinalIgnoreCase) ? nameof(OversightCaseKind.OccupancyMismatch)
                : null);
        if (segment is null)
        {
            return;
        }

        if (Enum.TryParse<OversightView>(segment, ignoreCase: true, out var view))
        {
            _view = view;
            return;
        }

        // "collusion" and "occupancy" are what the old routes called the kinds.
        var kind = segment.ToLowerInvariant() switch
        {
            "collusion" or "collusionring" => (OversightCaseKind?)OversightCaseKind.CollusionRing,
            "occupancy" or "occupancymismatch" or "mismatches" => OversightCaseKind.OccupancyMismatch,
            _ => null,
        };

        if (kind is { } wanted && _scope.Allows(wanted))
        {
            _kindFilter = wanted.ToString();
        }
    }

    private async Task LoadAsync()
    {
        // Signals become cases here rather than where they are raised, so a report filed a second
        // ago is already on the desk when the reviewer opens it — no waiting for a sweep.
        await Oversight.EnsureCasesAsync();

        _queue = await Oversight.GetQueueAsync(
            new OversightQuery(
                _reviewerId,
                _view,
                _kindFilter.Length == 0 ? null : Enum.Parse<OversightCaseKind>(_kindFilter),
                _priorityFilter.Length == 0 ? null : Enum.Parse<OversightCasePriority>(_priorityFilter),
                _search),
            _scope);
    }

    private int CountFor(OversightView view) => _queue is null ? 0 : view switch
    {
        OversightView.Open => _queue.OpenCount,
        OversightView.Mine => _queue.MineCount,
        OversightView.Unassigned => _queue.UnassignedCount,
        _ => _queue.TotalCount,
    };

    private async Task SwitchViewAsync(OversightView view)
    {
        _view = view;

        // Keep the address bar on the open view so it can be linked and reloaded. replace: the
        // views are one screen, not steps of the reviewer's history.
        Nav.NavigateTo($"admin/parking/oversight/{view.ToString().ToLowerInvariant()}", replace: true);
        await ReloadAsync();
    }

    private Task RefreshAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _error = _info = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClaimAsync(Guid caseId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _error = _info = null;
            var result = await Oversight.ClaimAsync(caseId, _reviewerId, _scope);
            if (result.Succeeded)
            {
                _info = "Parking_Oversight_Claimed";
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }

            // Reload either way: a friendly "someone else has it" means the list is stale.
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string CaseLink(Guid caseId) => $"admin/parking/oversight/case/{caseId}";

    private static string StatusClass(OversightCaseStatus status) => status switch
    {
        OversightCaseStatus.New => "warn",
        OversightCaseStatus.InProgress => "info",
        _ => "off",
    };

    private static string PriorityClass(OversightCasePriority priority) => priority switch
    {
        OversightCasePriority.Critical => "alert",
        OversightCasePriority.High => "warn",
        OversightCasePriority.Low => "off",
        _ => "info",
    };

    private string Local(DateTimeOffset utc, string format) =>
        TimeZoneInfo.ConvertTime(utc, _tz).ToString(format);
}
