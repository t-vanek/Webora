@page "/admin/parking/oversight"
@page "/admin/parking/oversight/{Tab}"
@* The two queues used to be pages of their own. Their routes stay as aliases so bookmarks and
   older deep links land on the matching tab instead of a 404. *@
@page "/admin/parking/mismatches"
@page "/admin/parking/collusion"
@attribute [HasAnyPermission(Permissions.Parking.ReviewMismatches, Permissions.Parking.ReviewCollusion)]
@rendermode InteractiveServer
@inject IParkingSpotService Spots
@inject ICollusionService Collusion
@inject ISiteSettingsService SiteSettings
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Parking_Oversight_Title"]</PageTitle>

@* One screen for everything the lot flags for a human decision. Two queues that read alike —
   a signal, its evidence, and a ruling — but never overlap: occupancy mismatches are reported by
   drivers about the physical lot, collusion flags are raised by the nightly scan about the
   incentive scheme. They share the shell (loading, messages, busy state, counts) and keep their
   own columns, because "photo proof and a mailto" and "two names and a concentration" have
   nothing to say to each other in a common grid.

   The page-level gate is any-of: a reviewer who holds one permission gets in and sees only their
   queue, which is also what decides the landing tab. *@
<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    @* Reload sits on the title line, not opposite it: the intro runs the full width, so a
       space-between head would wrap the button onto a line of its own. *@
    <div class="admin-head__titles">
        <div class="admin-head__title-row">
            <FluentLabel Typo="Typography.PageTitle">@L["Parking_Oversight_Title"]</FluentLabel>
            @if (_openCases > 0)
            {
                <span class="count-chip" title="@L["Parking_Oversight_OpenCases"]">@_openCases</span>
            }
            <FluentButton Appearance="Appearance.Stealth" Disabled="@_busy" OnClick="RefreshAsync"
                          IconStart="@(new Icons.Regular.Size20.ArrowClockwise())">@L["Parking_Oversight_Refresh"]</FluentButton>
        </div>
        <p class="admin-head__intro">@L["Parking_Oversight_Intro"]</p>
    </div>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">
            @L[_error]
        </FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">
            @L[_info]
        </FluentMessageBar>
    }

    @if (!_loaded)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else
    {
        @* Tab labels stay constant. Counts belong in the panel heads instead: a label that changes
           after a ruling would swap the tab element's own children, which is what makes FluentTabs
           re-read its children and snap the selection back to the first tab (see LotDashboard).

           Which tabs exist is decided before the first render — permissions cannot change
           mid-circuit — so the conditionals below never swap children either. *@
        <FluentTabs @bind-ActiveTabId="_activeTab" OnTabChange="OnTabChange">
            @if (_canReviewMismatches)
            {
                <FluentTab Id="@OccupancyTab" Label="@L["Parking_Mismatch_Title"]">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                        @* No heading here: it would repeat the tab label verbatim. The count rides
                           above the grid instead, where it reads as the table's caption. *@
                        <p class="admin-head__intro">@L["Parking_Mismatch_Intro"]</p>

                        @if (_mismatches.Count == 0)
                        {
                            <div class="empty-state">@L["Parking_Mismatch_Empty"]</div>
                        }
                        else
                        {
                            <div class="admin-head__title-row">
                                <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Oversight_Records"]</FluentLabel>
                                <span class="count-chip">@_mismatches.Count</span>
                            </div>
                            <div class="admin-panel">
                                <FluentDataGrid Items="@_mismatches.AsQueryable()" TGridItem="OccupancyMismatchDto"
                                                GridTemplateColumns="0.7fr 1.5fr 1.1fr 0.8fr 0.8fr 1.8fr 1.2fr 1.4fr">
                                    <PropertyColumn Property="@(m => m.SpotCode)" Title="@L["Parking_Spot"]" />
                                    <TemplateColumn Title="@L["Parking_Mismatch_Window"]">
                                        @Local(context.StartUtc, "g") – @Local(context.EndUtc, "t")
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Parking_Mismatch_ReportedAt"]">
                                        @Local(context.ReportedAtUtc, "g")
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Parking_Mismatch_RelocatedTo"]">
                                        @(context.RelocatedToSpotCode ?? "—")
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Parking_Mismatch_Photo"]">
                                        @if (context.HasPhoto)
                                        {
                                            @* target=_blank keeps Blazor's router out; the endpoint checks ManageSpots. *@
                                            <a href="@($"api/parking/mismatches/{context.Id}/photo")" target="_blank" rel="noopener"
                                               title="@L["Parking_Mismatch_PhotoOpen"]">
                                                <img src="@($"api/parking/mismatches/{context.Id}/photo")" alt="@L["Parking_Mismatch_Photo"]"
                                                     loading="lazy" style="max-width:96px;max-height:64px;border-radius:6px;object-fit:cover" />
                                            </a>
                                        }
                                        else
                                        {
                                            <span title="@L["Parking_Mismatch_PhotoMissing"]">—</span>
                                        }
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Parking_Mismatch_Related"]">
                                        @if (context.BlockerPlate is null && context.RelatedReservations.Count == 0)
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                                                @if (context.BlockerPlate is { } plate)
                                                {
                                                    @* The recorded plate, resolved against registered vehicles: an
                                                       employee gets a name + mailto, anything else is an outsider. *@
                                                    <span>
                                                        <strong>@plate</strong> — @(context.BlockerMatchName ?? L["Parking_Mismatch_PlateUnknown"].Value)
                                                        @if (context.BlockerMatchIsVisitor)
                                                        {
                                                            <text> (@L["Parking_Mismatch_PlateVisitor"])</text>
                                                        }
                                                        @if (context.BlockerMatchEmail is { } matchEmail)
                                                        {
                                                            <a href="@MailTo(matchEmail, context)" title="@matchEmail">&#9993;</a>
                                                        }
                                                    </span>
                                                }
                                                @foreach (var related in context.RelatedReservations)
                                                {
                                                    <span>
                                                        @related.Name — @L[$"Parking_State_{related.Status}"]
                                                        @if (related.Email is not null)
                                                        {
                                                            <a href="@MailTo(related.Email, context)" title="@related.Email">&#9993;</a>
                                                        }
                                                    </span>
                                                }
                                            </FluentStack>
                                        }
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Parking_Mismatch_Reporter"]">
                                        @if (context.ReporterEmail is { } reporterEmail)
                                        {
                                            <a href="@MailTo(reporterEmail, context)" title="@reporterEmail">@context.ReporterName</a>
                                        }
                                        else
                                        {
                                            @context.ReporterName
                                        }
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Parking_Mismatch_Voucher"]">
                                        @if (context.Voucher is not { } voucher)
                                        {
                                            <span>—</span>
                                        }
                                        else if (voucher.Status == ApologyVoucherStatus.PendingApproval)
                                        {
                                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Wrap="true" VerticalAlignment="VerticalAlignment.Center">
                                                <FluentBadge Appearance="Appearance.Accent">@L["Parking_VoucherState_PendingApproval"]</FluentBadge>
                                                <FluentButton Appearance="Appearance.Accent" Disabled="@_busy"
                                                              OnClick="() => ApproveAsync(voucher.Id)">@L["Parking_Mismatch_Approve"]</FluentButton>
                                                <FluentButton Appearance="Appearance.Outline" Disabled="@_busy"
                                                              OnClick="() => RejectAsync(voucher.Id)">@L["Parking_Mismatch_Reject"]</FluentButton>
                                            </FluentStack>
                                        }
                                        else
                                        {
                                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                                                <FluentBadge Appearance="@(voucher.Status == ApologyVoucherStatus.Approved ? Appearance.Accent : Appearance.Neutral)">
                                                    @L[$"Parking_VoucherState_{voucher.Status}"]
                                                </FluentBadge>
                                                @if (voucher.ReviewedAtUtc is { } reviewedAt)
                                                {
                                                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                                                        @Local(reviewedAt, "g")@(voucher.ReviewedByName is { } reviewer ? $" — {reviewer}" : string.Empty)
                                                    </FluentLabel>
                                                }
                                            </FluentStack>
                                        }
                                    </TemplateColumn>
                                </FluentDataGrid>
                            </div>
                        }
                    </FluentStack>
                </FluentTab>
            }

            @if (_canReviewCollusion)
            {
                <FluentTab Id="@CollusionTab" Label="@L["Parking_Collusion_Title"]">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                        <p class="admin-head__intro">@L["Parking_Collusion_Intro"]</p>

                        @if (_flags.Count == 0)
                        {
                            <div class="empty-state">@L["Parking_Collusion_Empty"]</div>
                        }
                        else
                        {
                            <div class="admin-head__title-row">
                                <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Parking_Oversight_Records"]</FluentLabel>
                                <span class="count-chip">@_flags.Count</span>
                            </div>
                            <div class="admin-panel">
                                <FluentDataGrid Items="@_flags.AsQueryable()" TGridItem="CollusionFlagDto"
                                                GridTemplateColumns="2fr 1fr 1fr 1.1fr 1fr auto">
                                    <TemplateColumn Title="@L["Parking_Collusion_Pair"]">
                                        @context.UserAName ↔ @context.UserBName
                                    </TemplateColumn>
                                    <PropertyColumn Property="@(f => f.MutualInteractions)" Title="@L["Parking_Collusion_Mutual"]" />
                                    <TemplateColumn Title="@L["Parking_Collusion_Concentration"]">
                                        @context.ConcentrationAPercent % / @context.ConcentrationBPercent %
                                    </TemplateColumn>
                                    @* When the scan raised it: without it a reviewer cannot tell a flag
                                       from last night from one that has sat unresolved for weeks. *@
                                    <TemplateColumn Title="@L["Parking_Collusion_DetectedAt"]">
                                        @Local(context.DetectedAtUtc, "g")
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Parking_Status"]">
                                        <span class="state-pill state-pill--@StatusClass(context.Status)">@L[$"Parking_CollusionState_{context.Status}"]</span>
                                    </TemplateColumn>
                                    <TemplateColumn Align="Align.End">
                                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Wrap="true"
                                                     HorizontalAlignment="HorizontalAlignment.End" VerticalAlignment="VerticalAlignment.Center">
                                            @if (context.Status == CollusionFlagStatus.New)
                                            {
                                                <FluentButton OnClick="() => ReviewFlagAsync(context.Id)" Disabled="@_busy"
                                                              Appearance="Appearance.Outline">@L["Parking_Collusion_Review"]</FluentButton>
                                            }
                                            <FluentButton OnClick="() => DismissFlagAsync(context.Id)" Disabled="@_busy"
                                                          Appearance="Appearance.Stealth">@L["Parking_Collusion_Dismiss"]</FluentButton>
                                        </FluentStack>
                                    </TemplateColumn>
                                </FluentDataGrid>
                            </div>
                        }
                    </FluentStack>
                </FluentTab>
            }
        </FluentTabs>
    }
</FluentStack>

@code {
    private const string OccupancyTab = "occupancy";
    private const string CollusionTab = "collusion";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Which queue to open, so a tab is linkable: /admin/parking/oversight/collusion.</summary>
    [Parameter] public string? Tab { get; set; }

    private Guid _reviewerId;
    private IReadOnlyList<OccupancyMismatchDto> _mismatches = [];
    private IReadOnlyList<CollusionFlagDto> _flags = [];
    private TimeZoneInfo _tz = TimeZoneInfo.Utc;
    private bool _canReviewMismatches;
    private bool _canReviewCollusion;
    private string _activeTab = OccupancyTab;
    private int _openCases;
    private bool _loaded;
    private bool _busy;
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthState!).User;
        _canReviewMismatches = principal.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Parking.ReviewMismatches);
        _canReviewCollusion = principal.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Parking.ReviewCollusion);

        var user = await UserManager.GetUserAsync(principal);
        _reviewerId = user?.Id ?? Guid.Empty;
        _tz = await SiteSettings.GetTimeZoneAsync();

        _activeTab = ResolveInitialTab();
        await LoadAsync();
        _loaded = true;
    }

    /// <summary>
    /// Route parameter first, then the legacy per-queue routes, and finally the reviewer's
    /// permissions — landing on a tab that isn't rendered would show an empty page.
    /// </summary>
    private string ResolveInitialTab()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        var requested = Tab ?? (path.EndsWith("collusion", StringComparison.OrdinalIgnoreCase) ? CollusionTab : OccupancyTab);
        var wanted = string.Equals(requested, CollusionTab, StringComparison.OrdinalIgnoreCase) ? CollusionTab : OccupancyTab;

        return wanted switch
        {
            CollusionTab when !_canReviewCollusion => OccupancyTab,
            OccupancyTab when !_canReviewMismatches => CollusionTab,
            _ => wanted,
        };
    }

    // Only what the reviewer is allowed to see is fetched: the page-level gate is any-of, so a
    // mismatch reviewer without the collusion permission must not have flags loaded on their behalf.
    private async Task LoadAsync()
    {
        _mismatches = _canReviewMismatches
            ? [.. (await Spots.GetOccupancyMismatchesAsync())
                // Pending vouchers first: they are the part of this queue that is actually waiting
                // on the reviewer, the rest is the trend record behind it.
                .OrderByDescending(m => m.Voucher?.Status == ApologyVoucherStatus.PendingApproval)
                .ThenByDescending(m => m.ReportedAtUtc)]
            : [];

        _flags = _canReviewCollusion ? await Collusion.GetFlagsAsync() : [];

        _openCases = _mismatches.Count(m => m.Voucher?.Status == ApologyVoucherStatus.PendingApproval)
            + _flags.Count(f => f.Status == CollusionFlagStatus.New);
    }

    private void OnTabChange(FluentTab tab)
    {
        _activeTab = tab.Id ?? OccupancyTab;

        // Keep the address bar on the open queue so the tab can be linked and reloaded.
        // replace: the two tabs are one screen, not two steps of the reviewer's history.
        Nav.NavigateTo($"admin/parking/oversight/{_activeTab}", replace: true);
    }

    private static string StatusClass(CollusionFlagStatus status) => status switch
    {
        CollusionFlagStatus.New => "warn",
        CollusionFlagStatus.Reviewed => "info",
        _ => "off",
    };

    private async Task RefreshAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _error = _info = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ApproveAsync(Guid voucherId) => RunAsync(async () =>
        (await Spots.ApproveVoucherAsync(voucherId, _reviewerId), "Parking_Mismatch_Approved"));

    private Task RejectAsync(Guid voucherId) => RunAsync(async () =>
        (await Spots.RejectVoucherAsync(voucherId, _reviewerId), "Parking_Mismatch_Rejected"));

    // The collusion service reports failure by throwing, not by a result — a ruling that returns
    // has landed, so these lift into the shared path as an unconditional success.
    private Task ReviewFlagAsync(Guid flagId) => RunAsync(async () =>
    {
        await Collusion.ReviewAsync(flagId);
        return (ParkingResult.Success, "Parking_Collusion_ReviewedInfo");
    });

    private Task DismissFlagAsync(Guid flagId) => RunAsync(async () =>
    {
        await Collusion.DismissAsync(flagId);
        return (ParkingResult.Success, "Parking_Collusion_DismissedInfo");
    });

    /// <summary>
    /// One decision path for both queues: run the action, report it, reload either way — a
    /// friendly "already decided" failure means the list the reviewer acted on was stale.
    /// </summary>
    private async Task RunAsync(Func<Task<(ParkingResult Result, string? SuccessKey)>> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _error = _info = null;
            var (result, successKey) = await action();
            if (result.Succeeded)
            {
                _info = successKey;
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private string Local(DateTimeOffset utc, string format) =>
        TimeZoneInfo.ConvertTime(utc, _tz).ToString(format);

    // Prefilled mailto so the admin's follow-up is one click: subject carries the spot and day.
    private string MailTo(string email, OccupancyMismatchDto mismatch) =>
        $"mailto:{email}?subject={Uri.EscapeDataString(L["Parking_Mismatch_MailSubject", mismatch.SpotCode, Local(mismatch.StartUtc, "d")])}";
}
