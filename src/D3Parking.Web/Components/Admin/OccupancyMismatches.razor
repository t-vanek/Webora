@page "/admin/parking/mismatches"
@attribute [HasPermission(Permissions.Parking.ReviewMismatches)]
@rendermode InteractiveServer
@inject IParkingSpotService Spots
@inject ISiteSettingsService SiteSettings
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Parking_Mismatch_Title"]</PageTitle>

@* Trend view of blocked spots. Every row carries the reservations that met the window on that
   spot — the admin's shortlist for who to ask (typically the no-show whose car may still be
   there) — each with a mailto link so the follow-up is one click away. Rows with a pending
   apology voucher are the review queue: the manager judges the photo proof and rules. *@
<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <div class="admin-head__titles">
        <div class="admin-head__title-row">
            <FluentLabel Typo="Typography.PageTitle">@L["Parking_Mismatch_Title"]</FluentLabel>
            @if (_mismatches is { Count: > 0 })
            {
                <span class="count-chip">@_mismatches.Count</span>
            }
        </div>
        <p class="admin-head__intro">@L["Parking_Mismatch_Intro"]</p>
    </div>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">
            @L[_error]
        </FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">
            @L[_info]
        </FluentMessageBar>
    }

    @if (_mismatches is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else if (_mismatches.Count == 0)
    {
        <div class="empty-state">@L["Parking_Mismatch_Empty"]</div>
    }
    else
    {
        <div class="admin-panel">
            <FluentDataGrid Items="@_mismatches.AsQueryable()" TGridItem="OccupancyMismatchDto"
                            GridTemplateColumns="0.7fr 1.5fr 1.1fr 0.8fr 0.8fr 1.8fr 1.2fr 1.4fr">
                <PropertyColumn Property="@(m => m.SpotCode)" Title="@L["Parking_Spot"]" />
                <TemplateColumn Title="@L["Parking_Mismatch_Window"]">
                    @Local(context.StartUtc, "g") – @Local(context.EndUtc, "t")
                </TemplateColumn>
                <TemplateColumn Title="@L["Parking_Mismatch_ReportedAt"]">
                    @Local(context.ReportedAtUtc, "g")
                </TemplateColumn>
                <TemplateColumn Title="@L["Parking_Mismatch_RelocatedTo"]">
                    @(context.RelocatedToSpotCode ?? "—")
                </TemplateColumn>
                <TemplateColumn Title="@L["Parking_Mismatch_Photo"]">
                    @if (context.HasPhoto)
                    {
                        @* target=_blank keeps Blazor's router out; the endpoint checks ManageSpots. *@
                        <a href="@($"api/parking/mismatches/{context.Id}/photo")" target="_blank" rel="noopener"
                           title="@L["Parking_Mismatch_PhotoOpen"]">
                            <img src="@($"api/parking/mismatches/{context.Id}/photo")" alt="@L["Parking_Mismatch_Photo"]"
                                 loading="lazy" style="max-width:96px;max-height:64px;border-radius:6px;object-fit:cover" />
                        </a>
                    }
                    else
                    {
                        <span title="@L["Parking_Mismatch_PhotoMissing"]">—</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="@L["Parking_Mismatch_Related"]">
                    @if (context.BlockerPlate is null && context.RelatedReservations.Count == 0)
                    {
                        <span>—</span>
                    }
                    else
                    {
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                            @if (context.BlockerPlate is { } plate)
                            {
                                @* The recorded plate, resolved against registered vehicles: an
                                   employee gets a name + mailto, anything else is an outsider. *@
                                <span>
                                    <strong>@plate</strong> — @(context.BlockerMatchName ?? L["Parking_Mismatch_PlateUnknown"].Value)
                                    @if (context.BlockerMatchIsVisitor)
                                    {
                                        <text> (@L["Parking_Mismatch_PlateVisitor"])</text>
                                    }
                                    @if (context.BlockerMatchEmail is { } matchEmail)
                                    {
                                        <a href="@MailTo(matchEmail, context)" title="@matchEmail">&#9993;</a>
                                    }
                                </span>
                            }
                            @foreach (var related in context.RelatedReservations)
                            {
                                <span>
                                    @related.Name — @L[$"Parking_State_{related.Status}"]
                                    @if (related.Email is not null)
                                    {
                                        <a href="@MailTo(related.Email, context)" title="@related.Email">&#9993;</a>
                                    }
                                </span>
                            }
                        </FluentStack>
                    }
                </TemplateColumn>
                <TemplateColumn Title="@L["Parking_Mismatch_Reporter"]">
                    @if (context.ReporterEmail is { } reporterEmail)
                    {
                        <a href="@MailTo(reporterEmail, context)" title="@reporterEmail">@context.ReporterName</a>
                    }
                    else
                    {
                        @context.ReporterName
                    }
                </TemplateColumn>
                <TemplateColumn Title="@L["Parking_Mismatch_Voucher"]">
                    @if (context.Voucher is not { } voucher)
                    {
                        <span>—</span>
                    }
                    else if (voucher.Status == ApologyVoucherStatus.PendingApproval)
                    {
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Wrap="true" VerticalAlignment="VerticalAlignment.Center">
                            <FluentBadge Appearance="Appearance.Accent">@L["Parking_VoucherState_PendingApproval"]</FluentBadge>
                            <FluentButton Appearance="Appearance.Accent" Disabled="@_reviewBusy"
                                          OnClick="() => ApproveAsync(voucher.Id)">@L["Parking_Mismatch_Approve"]</FluentButton>
                            <FluentButton Appearance="Appearance.Outline" Disabled="@_reviewBusy"
                                          OnClick="() => RejectAsync(voucher.Id)">@L["Parking_Mismatch_Reject"]</FluentButton>
                        </FluentStack>
                    }
                    else
                    {
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                            <FluentBadge Appearance="@(voucher.Status == ApologyVoucherStatus.Approved ? Appearance.Accent : Appearance.Neutral)">
                                @L[$"Parking_VoucherState_{voucher.Status}"]
                            </FluentBadge>
                            @if (voucher.ReviewedAtUtc is { } reviewedAt)
                            {
                                <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                                    @Local(reviewedAt, "g")@(voucher.ReviewedByName is { } reviewer ? $" — {reviewer}" : string.Empty)
                                </FluentLabel>
                            }
                        </FluentStack>
                    }
                </TemplateColumn>
            </FluentDataGrid>
        </div>
    }
</FluentStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Guid _reviewerId;
    private IReadOnlyList<OccupancyMismatchDto>? _mismatches;
    private TimeZoneInfo _tz = TimeZoneInfo.Utc;
    private bool _reviewBusy;
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        _reviewerId = user?.Id ?? Guid.Empty;
        _tz = await SiteSettings.GetTimeZoneAsync();
        _mismatches = await Spots.GetOccupancyMismatchesAsync();
    }

    private Task ApproveAsync(Guid voucherId) =>
        ReviewAsync(() => Spots.ApproveVoucherAsync(voucherId, _reviewerId), "Parking_Mismatch_Approved");

    private Task RejectAsync(Guid voucherId) =>
        ReviewAsync(() => Spots.RejectVoucherAsync(voucherId, _reviewerId), "Parking_Mismatch_Rejected");

    private async Task ReviewAsync(Func<Task<ParkingResult>> action, string successKey)
    {
        if (_reviewBusy)
        {
            return;
        }

        _reviewBusy = true;
        try
        {
            _error = _info = null;
            var result = await action();
            if (result.Succeeded)
            {
                _info = successKey;
            }
            else
            {
                _error = result.Errors.FirstOrDefault();
            }

            // Reload either way: a friendly "already decided" failure means the list is stale.
            _mismatches = await Spots.GetOccupancyMismatchesAsync();
        }
        finally
        {
            _reviewBusy = false;
        }
    }

    private string Local(DateTimeOffset utc, string format) =>
        TimeZoneInfo.ConvertTime(utc, _tz).ToString(format);

    // Prefilled mailto so the admin's follow-up is one click: subject carries the spot and day.
    private string MailTo(string email, OccupancyMismatchDto mismatch) =>
        $"mailto:{email}?subject={Uri.EscapeDataString(L["Parking_Mismatch_MailSubject", mismatch.SpotCode, Local(mismatch.StartUtc, "d")])}";
}
