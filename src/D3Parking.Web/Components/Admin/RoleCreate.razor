@page "/admin/roles/create"
@attribute [HasPermission(Permissions.Roles.Create)]
@rendermode InteractiveServer
@inject IRoleAdminService RoleAdmin
@inject IPermissionGroupAdminService Groups
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

@* Starting from a built-in role — the compositions the system already models — turns "reason about
   the whole catalog" into "how does this differ from the lot manager". *@

<PageTitle>@L["Admin_Roles_Create"]</PageTitle>

<FluentStack Class="page-shell entity-create-page" Orientation="Orientation.Vertical" VerticalGap="20">
    <div class="user-detail-nav"><FluentAnchor Href="admin/roles" Appearance="Appearance.Hypertext">← @L["Admin_Roles_Title"]</FluentAnchor></div>
    <div class="admin-head"><div class="admin-head__titles"><div class="admin-head__title-row"><FluentLabel Typo="Typography.PageTitle">@L["Admin_Roles_Create"]</FluentLabel></div><p class="admin-head__intro">@L["Admin_Roles_TemplateIntro"]</p></div></div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="false">
            @_error
        </FluentMessageBar>
    }

    <section class="entity-create-section">
        <FluentTextField @bind-Value="_name" Label="@L["Admin_Roles_Name"]" Style="width:100%;max-width:480px" />
    </section>
    <section class="entity-create-section">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <FluentLabel Typo="Typography.Subject">@L["Admin_Roles_Template"]</FluentLabel>
            <p class="admin-head__intro">@L["Admin_Roles_TemplateIntro"]</p>
            <div class="role-templates">
                @foreach (var template in _templates)
                {
                    <button type="button"
                            class="role-template @(_appliedTemplate == template.Name ? "role-template--active" : string.Empty)"
                            @onclick="() => ApplyTemplate(template)">
                        <span class="role-template__name">@AuthorizationDisplay.RoleName(L, template.Name)</span>
                        <span class="role-template__desc">@AuthorizationDisplay.RoleDescription(L, template.Name)</span>
                        <span class="role-template__count">@PluralText.For(L, "Admin_Roles_GroupCount", template.Groups.Count)</span>
                    </button>
                }
            </div>
        </FluentStack>
    </section>

    <section class="entity-create-section">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <FluentLabel Typo="Typography.Subject">@L["Admin_RoleEdit_Composition"]</FluentLabel>
            <p class="admin-head__intro">@L["Admin_RoleEdit_CompositionIntro"]</p>
            <GroupPicker Groups="_groups"
                         Selected="_selected"
                         Grantable="_grantable"
                         SelectionChanged="OnSelectionChanged" />
        </FluentStack>
    </section>
    <div class="entity-create-actions">
        <FluentAnchor Href="admin/roles" Appearance="Appearance.Outline">@L["Common_Cancel"]</FluentAnchor>
        <FluentButton OnClick="CreateAsync" Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Add())">@L["Admin_Roles_Create"]</FluentButton>
    </div>
</FluentStack>

@code {
    [SupplyParameterFromQuery(Name = "from")] private Guid? From { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? _name;
    private HashSet<Guid> _selected = [];
    private IReadOnlyList<PermissionGroupSummary> _groups = [];
    private IReadOnlyList<RoleSummary> _templates = [];
    private string? _appliedTemplate;
    private Guid _actorId;
    private IReadOnlySet<string>? _grantable;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        _actorId = Guid.TryParse(UserManager.GetUserId(state.User), out var id) ? id : Guid.Empty;
        _grantable = state.User.Claims
            .Where(c => c.Type == D3ParkingClaimTypes.Permission)
            .Select(c => c.Value)
            .ToHashSet(StringComparer.Ordinal);

        _groups = await Groups.ListAsync();

        var roles = await RoleAdmin.ListAsync();
        _templates = roles.Where(r => r.IsDefault).ToArray();

        // Arriving from a role's "Duplicate" action: prefill from that role, built-in or not.
        if (From is { } sourceId && roles.FirstOrDefault(r => r.Id == sourceId) is { } source)
        {
            ApplyTemplate(source);
            _name = L["Admin_Roles_CopyName", AuthorizationDisplay.RoleName(L, source.Name)];
        }
    }

    private void ApplyTemplate(RoleSummary template)
    {
        // Only groups this administrator may compose from are copied; the rest would fail on save.
        _selected = template.Groups
            .Where(g => _grantable is null || g.Permissions.All(_grantable.Contains))
            .Select(g => g.Id)
            .ToHashSet();
        _appliedTemplate = template.Name;
    }

    // Any hand edit means the selection is no longer that template, so the highlight has to go.
    private void OnSelectionChanged() => _appliedTemplate = null;

    private async Task CreateAsync()
    {
        _error = null;
        var result = await RoleAdmin.CreateAsync(_name ?? string.Empty, _selected.ToArray(), _actorId);
        if (result.Succeeded)
        {
            Nav.NavigateTo("admin/roles");
            return;
        }

        _error = string.Join(" ", result.Errors);
    }
}
