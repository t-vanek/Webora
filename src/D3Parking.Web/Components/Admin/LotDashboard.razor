@page "/admin/parking/dashboard"
@attribute [HasPermission(Permissions.Parking.ManageSpots)]
@rendermode InteractiveServer
@using System.Globalization
@* ApexCharts is imported here and not in _Imports.razor on purpose: its namespace also declares
   Color, Orientation and Align, so importing it globally makes those ambiguous with Fluent UI's
   across every component in the project. The aliases below keep Fluent winning inside this file. *@
@using ApexCharts
@using Color = Microsoft.FluentUI.AspNetCore.Components.Color
@using Orientation = Microsoft.FluentUI.AspNetCore.Components.Orientation
@using Align = Microsoft.FluentUI.AspNetCore.Components.Align
@inject ILotDashboardService Dashboard
@inject IParkingSpotService Spots
@inject ISiteSettingsService SiteSettings
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Lot_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <div class="admin-head__titles">
        <div class="admin-head__title-row">
            <FluentLabel Typo="Typography.PageTitle">@L["Lot_Title"]</FluentLabel>
            @if (_board is not null)
            {
                <span class="count-chip">@_board.Overview.TotalSpots</span>
            }
        </div>
        <p class="admin-head__intro">
            @L["Lot_Intro"]
            <FluentAnchor Href="/admin/parking/spots" Appearance="Appearance.Hypertext">@L["Lot_LinkSpots"]</FluentAnchor>
            <FluentAnchor Href="/admin/parking/mismatches" Appearance="Appearance.Hypertext">@L["Parking_Mismatch_Link"]</FluentAnchor>
        </p>
    </div>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">@L[_error]</FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">@_info</FluentMessageBar>
    }

    @if (_board is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else
    {
        @* The live summary as a table: one row per metric, its number, and a sparkline for the metrics
           that actually have a day-by-day history. The rows without one show no chart rather than a
           flat line — a trend for "how many spots are residents'" would be invented. *@
        <table class="lot-summary">
            <thead>
                <tr>
                    <th scope="col">@L["Lot_Summary_Metric"]</th>
                    <th scope="col" class="lot-summary__num">@L["Lot_Summary_Value"]</th>
                    <th scope="col">@L["Lot_Summary_Trend", LotBoard.SummaryTrendDays]</th>
                </tr>
            </thead>
            <tbody>
                @SummaryRow(L["Lot_Stat_Occupancy"], $"{_board.Overview.OccupancyPercent} %",
                    MeterClass(_board.Overview.OccupancyPercent), OccupancyTrend, percent: true)
                @SummaryRow(L["Lot_Stat_Occupied"], _board.Overview.Occupied.ToString(), null, OccupiedTrend)
                @SummaryRow(L["Lot_Stat_Mismatches"], _board.Overview.OpenMismatches.ToString(),
                    _board.Overview.OpenMismatches > 0 ? "warn" : null, MismatchTrend)
                @SummaryRow(L["Lot_Stat_WastedShares"], _board.Overview.UnusedSharedDays.ToString(),
                    _board.Overview.UnusedSharedDays > 0 ? "warn" : null, WastedShareTrend)
                @SummaryRow(L["Lot_Stat_Booked"], _board.Overview.Booked.ToString(), null, null)
                @SummaryRow(L["Lot_Stat_Free"], _board.Overview.Free.ToString(), null, null)
                @SummaryRow(L["Lot_Stat_Residents"], _board.Overview.ResidentSpots.ToString(), null, null)
                @SummaryRow(L["Lot_Stat_Pool"], _board.Overview.PoolSpots.ToString(), null, null)
                @SummaryRow(L["Lot_Stat_Visitors"], _board.Overview.VisitorBookings.ToString(), null, null)
                @SummaryRow(L["Lot_Stat_Queue"], _board.Overview.QueueWaiting.ToString(),
                    _board.Overview.QueueWaiting > 0 ? "warn" : null, null)
                @SummaryRow(L["Lot_Stat_Inactive"], _board.Overview.InactiveSpots.ToString(),
                    _board.Overview.InactiveSpots > 0 ? "off" : null, null)
            </tbody>
        </table>

        @* Two tabs: the lot as a picture, and the lot as numbers over time. Everything on one page
           was a single long scroll where the board and the charts competed for the same attention.
           The summary table above stays outside the tabs — "how is the lot doing right now" should
           not cost a tab switch.

           Both tab bodies render unconditionally, and must stay that way. Guarding them with
           @if (_activeTab == …) looks tempting — it would keep charts out of a hidden panel — but it
           fights FluentTabs: swapping a panel's children on selection makes the web component re-read
           its children and snap the selection back to the first tab, so the page bounces to "Plocha"
           the moment you leave it. Left alone, the analytics charts pick up their real width when
           their panel is shown (measured: 975 px, not 0), so there is nothing to work around. *@
        <FluentTabs @bind-ActiveTabId="_activeTab" OnTabChange="OnTabChangedAsync">
            <FluentTab Id="@BoardTab" Label="@L["Lot_Tab_Board"]">
        <div class="lot-tab">
        <div class="lot-toolbar">
            <div class="field">
                <label>@L["Lot_Day"]</label>
                <input type="date" @bind="_day" @bind:after="ReloadBoardAsync" class="parking-input" />
            </div>
            <FluentButton Appearance="Appearance.Outline" OnClick="() => ShiftDayAsync(-1)">@L["Lot_PrevDay"]</FluentButton>
            <FluentButton Appearance="Appearance.Outline" OnClick="() => ShiftDayAsync(1)">@L["Lot_NextDay"]</FluentButton>
            <FluentButton Appearance="Appearance.Outline" OnClick="GoTodayAsync">@L["Lot_Today"]</FluentButton>
            @if (!_board.IsToday)
            {
                <span class="state-pill state-pill--info">@L["Lot_NotToday"]</span>
            }
        </div>

        <div class="lot-legend">
            @foreach (var state in BoardStates)
            {
                <span class="lot-legend__item">
                    <span class="lot-tile__dot lot-tile__dot--@state"></span>@L[$"Lot_State_{state}"]
                </span>
            }
        </div>

        @* The lot drawn as itself: a tile per spot, grouped into the sections the codes imply. The
           loop variable is not called "section" — @section is a reserved Razor directive, so
           @section.Spots would be parsed as one. *@
        @foreach (var zone in _board.Spots.GroupBy(s => s.Section))
        {
            <div class="lot-section">
                <div class="section-head">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Map())" Color="Color.Accent" />
                    <span>@(string.IsNullOrEmpty(zone.Key) ? L["Lot_SectionUnnamed"] : zone.Key)</span>
                    <span class="count-chip">@zone.Count()</span>
                </div>
                <div class="lot-board">
                    @foreach (var tile in zone)
                    {
                        @* A button, not a div: the board is keyboard-navigable and each tile opens the
                           spot's dialog — the same affordance a screen reader announces. *@
                        <button type="button"
                                class="lot-tile lot-tile--@tile.State @(_detail?.SpotId == tile.SpotId ? "lot-tile--selected" : null)"
                                title="@TileTooltip(tile)"
                                @onclick="() => SelectSpotAsync(tile.SpotId)">
                            <span class="lot-tile__head">
                                <span class="lot-tile__code">@tile.Code</span>
                                <span class="lot-tile__dot lot-tile__dot--@tile.State"></span>
                            </span>
                            <span class="lot-tile__meta">
                                <span class="type-pill type-pill--@tile.Type">@L[$"Parking_SpotType_{tile.Type}"]</span>
                            </span>
                            <span class="lot-tile__holder">
                                @if (tile.OwnerName is not null)
                                {
                                    <span class="lot-tile__owner" title="@L["Lot_Tile_Resident"]">@tile.OwnerName</span>
                                }
                                @if (tile.HolderName is not null)
                                {
                                    <span class="lot-tile__guest">@tile.HolderName</span>
                                }
                            </span>
                            @if (tile.MismatchCount > 0)
                            {
                                <span class="lot-tile__flag" title="@L["Lot_Tile_Mismatches"]">▲ @tile.MismatchCount</span>
                            }
                        </button>
                    }
                </div>
            </div>
        }
        </div>
            </FluentTab>

            <FluentTab Id="@AnalyticsTab" Label="@L["Lot_Tab_Analytics"]">
        <div class="lot-tab">
            <div class="lot-toolbar">
                <FluentSelect TOption="int" Items="@AnalyticsWindows"
                              OptionValue="@(d => d.ToString())"
                              OptionText="@(d => L["Lot_LastDays", d].Value)"
                              Value="@_analyticsDays.ToString()"
                              ValueChanged="ChangeAnalyticsWindowAsync"
                              Label="@L["Lot_Window"]" />
            </div>
            @if (_analytics is null)
            {
                <div class="loading"><FluentProgressRing /></div>
            }
            else
            {
                <div class="lot-stats">
                    @Stat(L["Lot_Stat_AvgUtilization"], $"{_analytics.AverageOccupancyPercent} %", MeterClass(_analytics.AverageOccupancyPercent))
                    @Stat(L["Lot_Stat_Bookings"], _analytics.TotalReservations.ToString(), null)
                    @Stat(L["Lot_Stat_NoShowRate"], $"{_analytics.NoShowPercent} %", _analytics.NoShowPercent > 10 ? "warn" : null)
                    @Stat(L["Lot_Stat_Peak"], PeakLabel(_analytics), null)
                </div>

                @* Load over time — the "busiest spot in time" question the table alone could not
                   answer. Keyed on the window so switching it rebuilds the chart instead of
                   animating between two different x-axes. *@
                @if (_analytics.Daily.Count > 0)
                {
                    <FluentLabel Typo="Typography.Subject">@L["Lot_Trend"]</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Lot_Trend_Hint", _analytics.Daily[0].Capacity]</FluentLabel>
                    <ApexChart @key="@($"daily-{_analyticsDays}")" TItem="DailyOccupancyDto"
                               Options="@_dailyOptions" Height="240">
                        <ApexPointSeries TItem="DailyOccupancyDto"
                                         Items="@_analytics.Daily"
                                         Name="@L["Lot_Trend_Series"].Value"
                                         SeriesType="SeriesType.Area"
                                         XValue="@(d => d.Date.ToString("d.M."))"
                                         YValue="@(d => d.Occupied)" />
                    </ApexChart>
                }

                @if (_analytics.Spots.Count > 0)
                {
                    <FluentLabel Typo="Typography.Subject">@L["Lot_Busiest"]</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Lot_Busiest_Hint", TopSpotCount]</FluentLabel>
                    <ApexChart @key="@($"busiest-{_analyticsDays}")" TItem="SpotUtilizationDto"
                               Options="@_busiestOptions" Height="@(60 + TopSpots.Count * 26)">
                        <ApexPointSeries TItem="SpotUtilizationDto"
                                         Items="@TopSpots"
                                         Name="@L["Lot_Detail_Utilization"].Value"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(s => s.Code)"
                                         YValue="@(s => s.UtilizationPercent)" />
                    </ApexChart>
                }

                @if (_analytics.Demand.Count > 0)
                {
                    <FluentLabel Typo="Typography.Subject">@L["Lot_Demand"]</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Lot_Demand_Hint"]</FluentLabel>
                    @* One heatmap series per weekday, Monday first — the row order is the series
                       order reversed, because ApexCharts stacks the first series at the bottom. *@
                    <ApexChart @key="@($"demand-{_analyticsDays}")" TItem="DemandCellDto"
                               Options="@_demandOptions" Height="260">
                        @foreach (var day in WeekOrder.Reverse())
                        {
                            <ApexPointSeries TItem="DemandCellDto"
                                             Items="@DemandRow(day)"
                                             Name="@ShortDay(day)"
                                             SeriesType="SeriesType.Heatmap"
                                             XValue="@(c => c.Hour)"
                                             YValue="@(c => c.Count)" />
                        }
                    </ApexChart>
                }

                @* The numbers a chart cannot carry: no-shows, blocked-spot reports and shared days per
                   spot. Kept behind a disclosure so the charts lead but the detail stays reachable. *@
                @if (_analytics.Spots.Count > 0)
                {
                    <details class="lot-table-toggle">
                        <summary>@L["Lot_Analytics_Table"]</summary>
                        <FluentDataGrid Items="@_analytics.Spots.AsQueryable()" TGridItem="SpotUtilizationDto"
                                        GridTemplateColumns="1fr 1.2fr 1.4fr 1fr 0.8fr 0.8fr 1fr">
                            <PropertyColumn Property="@(s => s.Code)" Title="@L["Parking_Admin_Code"]" />
                            <TemplateColumn Title="@L["Parking_Admin_Type"]">
                                <span class="type-pill type-pill--@context.Type">@L[$"Parking_SpotType_{context.Type}"]</span>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Parking_Admin_Resident"]">
                                @(context.OwnerName ?? "—")
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Lot_Detail_Utilization"]">
                                @context.UtilizationPercent % · @context.BookedDays/@context.WindowDays
                            </TemplateColumn>
                            <PropertyColumn Property="@(s => s.NoShows)" Title="@L["Lot_Detail_NoShows"]" />
                            <PropertyColumn Property="@(s => s.Mismatches)" Title="@L["Lot_Col_Mismatch"]" />
                            <TemplateColumn Title="@L["Lot_Detail_Shared"]">
                                @if (context.SharedDays == 0)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <span>@context.SharedDays (@context.UnusedSharedDays)</span>
                                }
                            </TemplateColumn>
                        </FluentDataGrid>
                    </details>
                }
            }
        </div>
            </FluentTab>
        </FluentTabs>

        @* The spot's detail is a dialog, not a tab: it belongs to the tile you just clicked, and a
           tab would have sat there empty until something was selected. Rendered only while open, so
           the chart inside mounts into a laid-out dialog and can measure itself. *@
        @if (_detail is not null)
        {
            <FluentDialog Hidden="false" Modal="true" TrapFocus="true"
                          Class="lot-dialog" OnDismiss="CloseDetail"
                          aria-label="@_detail.Code">
            <div class="admin-panel lot-detail">
                <div class="section-head">
                    <FluentIcon Value="@(new Icons.Regular.Size20.VehicleCar())" Color="Color.Accent" />
                    <span>@_detail.Code</span>
                    <span class="type-pill type-pill--@_detail.Type">@L[$"Parking_SpotType_{_detail.Type}"]</span>
                    <span class="state-pill state-pill--@(_detail.IsActive ? "on" : "off")">
                        @L[_detail.IsActive ? "Parking_Admin_Active" : "Parking_Admin_Inactive"]
                    </span>
                    <FluentButton Appearance="Appearance.Stealth" OnClick="CloseDetail">@L["Lot_Close"]</FluentButton>
                </div>

                <div class="lot-detail__facts">
                    <div><span class="lot-detail__label">@L["Lot_Detail_State"]</span> @L[$"Lot_State_{_detail.State}"]</div>
                    <div>
                        <span class="lot-detail__label">@L["Parking_Admin_Resident"]</span>
                        @(_detail.OwnerName ?? L["Lot_Detail_NoResident"].Value)
                    </div>
                    @if (_detail.OwnerId is not null)
                    {
                        <div>
                            <span class="lot-detail__label">@L["Lot_Detail_Plan"]</span>
                            @PlanLabel(_detail)
                        </div>
                        <div>
                            <span class="lot-detail__label">@L["Parking_Owned_Allowance"]</span>
                            @_detail.MonthlyShareAllowance
                        </div>
                    }
                    <div>
                        <span class="lot-detail__label">@L["Lot_Detail_Utilization"]</span>
                        @_detail.Stats.UtilizationPercent % (@_detail.Stats.BookedDays / @_detail.Stats.WindowDays @L["Lot_Detail_Days"])
                    </div>
                    <div>
                        <span class="lot-detail__label">@L["Lot_Detail_NoShows"]</span> @_detail.Stats.NoShows
                    </div>
                    <div>
                        <span class="lot-detail__label">@L["Lot_Detail_Mismatches"]</span> @_detail.Stats.Mismatches
                    </div>
                    @if (_detail.Stats.SharedDays > 0)
                    {
                        <div>
                            <span class="lot-detail__label">@L["Lot_Detail_Shared"]</span>
                            @_detail.Stats.SharedDays (@L["Lot_Detail_Wasted"]: @_detail.Stats.UnusedSharedDays)
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_detail.Notes))
                    {
                        <div><span class="lot-detail__label">@L["Parking_Admin_Notes"]</span> @_detail.Notes</div>
                    }
                </div>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                    @if (_detail.IsActive)
                    {
                        <FluentButton Appearance="Appearance.Outline" Disabled="@_busy"
                                      OnClick="() => SetActiveAsync(false)">@L["Lot_Deactivate"]</FluentButton>
                    }
                    else
                    {
                        <FluentButton Appearance="Appearance.Accent" Disabled="@_busy"
                                      OnClick="() => SetActiveAsync(true)">@L["Parking_Admin_Activate"]</FluentButton>
                    }
                </FluentStack>

                @* This spot's own recent load — the per-spot answer to the lot-wide trend above.
                   Keyed on the spot so switching tiles rebuilds rather than animating across spots. *@
                @if (_detail.Trend.Count > 0)
                {
                    <FluentLabel Typo="Typography.Subject">@L["Lot_Detail_Trend"]</FluentLabel>
                    <ApexChart @key="@($"trend-{_detail.SpotId}")" TItem="SpotDayDto"
                               Options="@_trendOptions" Height="140">
                        <ApexPointSeries TItem="SpotDayDto"
                                         Items="@_detail.Trend"
                                         Name="@L["Lot_Detail_Trend_Series"].Value"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(d => d.Date.ToString("d.M."))"
                                         YValue="@(d => d.Busy ? 1 : 0)" />
                    </ApexChart>
                }

                <FluentLabel Typo="Typography.Subject">@L["Lot_Calendar"]</FluentLabel>
                @if (_detail.Calendar.Count == 0)
                {
                    <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Lot_Calendar_Empty"]</FluentLabel>
                }
                else
                {
                    <div class="lot-calendar">
                        @foreach (var entry in _detail.Calendar)
                        {
                            <div class="lot-calendar__row lot-calendar__row--@entry.Kind">
                                <span class="lot-calendar__when">
                                    @entry.Date.ToString("ddd d. M.")
                                    <small>@Local(entry.StartUtc, "H:mm")–@Local(entry.EndUtc, "H:mm")</small>
                                </span>
                                @* No fallback label here: an entry without a holder is a released day,
                                   and the status pill on the right already names it. *@
                                <span class="lot-calendar__who">@entry.HolderName</span>
                                <span class="lot-calendar__status">
                                    @if (entry.Status is { } status)
                                    {
                                        <span class="state-pill state-pill--@StatusClass(status)">@L[$"Parking_State_{status}"]</span>
                                    }
                                    else
                                    {
                                        <span class="state-pill state-pill--info">@L[$"Lot_CalendarKind_{entry.Kind}"]</span>
                                    }
                                    @if (entry.CreditsCharged > 0)
                                    {
                                        <span class="tag">@entry.CreditsCharged @L["Parking_Credits"]</span>
                                    }
                                </span>
                                <span class="lot-calendar__actions">
                                    @if (entry.CanCancel)
                                    {
                                        <FluentButton Appearance="Appearance.Stealth" Disabled="@_busy"
                                                      OnClick="() => CancelAsync(entry.ReservationId!.Value)">@L["Lot_CancelBooking"]</FluentButton>
                                    }
                                    @if (entry.CanMove)
                                    {
                                        <FluentButton Appearance="Appearance.Stealth" Disabled="@_busy"
                                                      OnClick="() => BeginMoveAsync(entry.ReservationId!.Value)">@L["Lot_MoveBooking"]</FluentButton>
                                    }
                                </span>
                            </div>
                            @if (_moveReservationId == entry.ReservationId)
                            {
                                <div class="lot-calendar__move">
                                    @if (_moveTargets is null)
                                    {
                                        <FluentProgressRing Style="width:20px;height:20px" />
                                    }
                                    else if (_moveTargets.Count == 0)
                                    {
                                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Lot_MoveNoTargets"]</FluentLabel>
                                    }
                                    else
                                    {
                                        <FluentSelect TOption="MoveTargetDto"
                                                      Items="@_moveTargets"
                                                      OptionValue="@(t => t.SpotId.ToString())"
                                                      OptionText="@(t => t.Code)"
                                                      @bind-Value="_moveTargetId"
                                                      Label="@L["Lot_MoveTo"]" />
                                        <FluentButton Appearance="Appearance.Accent" Disabled="@(_busy || string.IsNullOrEmpty(_moveTargetId))"
                                                      OnClick="ConfirmMoveAsync">@L["Lot_MoveConfirm"]</FluentButton>
                                        <FluentButton Appearance="Appearance.Stealth" OnClick="CancelMove">@L["Lot_MoveAbort"]</FluentButton>
                                    }
                                </div>
                            }
                        }
                    </div>
                }

                @if (_detail.Mismatches.Count > 0)
                {
                    <FluentLabel Typo="Typography.Subject">@L["Lot_Detail_MismatchLog"]</FluentLabel>
                    <div class="lot-calendar">
                        @foreach (var mismatch in _detail.Mismatches)
                        {
                            <div class="lot-calendar__row lot-calendar__row--Mismatch">
                                <span class="lot-calendar__when">@Local(mismatch.ReportedAtUtc, "d. M. H:mm")</span>
                                <span class="lot-calendar__who">@mismatch.ReporterName</span>
                                <span class="lot-calendar__status">
                                    @if (mismatch.BlockerPlate is not null)
                                    {
                                        <span class="tag">@mismatch.BlockerPlate</span>
                                    }
                                    @if (mismatch.Relocated)
                                    {
                                        <span class="state-pill state-pill--on">@L["Lot_Detail_Relocated"]</span>
                                    }
                                </span>
                                <span class="lot-calendar__actions"></span>
                            </div>
                        }
                    </div>
                }
            </div>
            </FluentDialog>
        }
    }
</FluentStack>


@code {
    private const string BoardTab = "tab-board";
    private const string AnalyticsTab = "tab-analytics";

    private static readonly SpotBoardState[] BoardStates = Enum.GetValues<SpotBoardState>();
    private static readonly int[] AnalyticsWindows = [7, 30, 90];

    // Monday-first, like the rest of the app's day pickers.
    private static readonly DayOfWeek[] WeekOrder =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday,
    ];

    private LotBoardDto? _board;
    private LotSummaryTrendsDto? _trends;
    private SpotDetailDto? _detail;
    private LotAnalyticsDto? _analytics;

    private string? _activeTab = BoardTab;
    private DateTime _day = DateTime.Today;
    private int _analyticsDays = 30;

    private Guid? _moveReservationId;
    private IReadOnlyList<MoveTargetDto>? _moveTargets;
    private string? _moveTargetId;

    private Guid _userId;
    private TimeZoneInfo _tz = TimeZoneInfo.Utc;
    private bool _busy;
    private string? _error;
    private string? _info;

    /// <summary>How many spots the "busiest" chart lists before it stops being readable.</summary>
    private const int TopSpotCount = 12;

    private List<SpotUtilizationDto> TopSpots =>
        _analytics?.Spots.Take(TopSpotCount).ToList() ?? [];

    // One options instance per chart: ApexCharts mutates the object it is given, so sharing one
    // between charts makes them fight over axis and type settings.
    private readonly ApexChartOptions<DailyOccupancyDto> _dailyOptions = DailyChartOptions();
    private readonly ApexChartOptions<SpotUtilizationDto> _busiestOptions = BusiestChartOptions();
    private readonly ApexChartOptions<DemandCellDto> _demandOptions = ChartBase<DemandCellDto>();
    private readonly ApexChartOptions<SpotDayDto> _trendOptions = TrendChartOptions();

    private static ApexChartOptions<DailyOccupancyDto> DailyChartOptions()
    {
        var options = ChartBase<DailyOccupancyDto>();
        options.Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 };
        // Whole spots on the y-axis: half a car has never parked anywhere.
        options.Yaxis = [new YAxis { Min = 0, DecimalsInFloat = 0, ForceNiceScale = true }];
        return options;
    }

    private static ApexChartOptions<SpotUtilizationDto> BusiestChartOptions()
    {
        var options = ChartBase<SpotUtilizationDto>();
        // Horizontal bars: spot codes are text and read far better along the y-axis than tilted
        // under a vertical column.
        options.PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true } };
        // Pinned to 0–100 so the eye compares bars against the whole window, not against the
        // busiest spot — otherwise a lot where nothing is used looks fully booked. Which also means
        // bars are often short, so no data labels: they would not fit inside them, and the axis plus
        // the detailed table below already carry the exact numbers.
        options.Yaxis = [new YAxis { Min = 0, Max = 100, DecimalsInFloat = 0 }];
        return options;
    }

    private static ApexChartOptions<SpotDayDto> TrendChartOptions()
    {
        var options = ChartBase<SpotDayDto>();
        // A busy/idle strip, so the axis carries no information worth the space.
        options.Yaxis = [new YAxis { Min = 0, Max = 1, Show = false }];
        return options;
    }

    /// <summary>
    /// A sparkline for one table row: no axes, no grid, no tooltip chrome — at 34 px tall the shape is
    /// the whole message, and the exact days live in the spot's own tab. A fresh instance per row
    /// because ApexCharts writes into the options object it is handed.
    /// </summary>
    private static ApexChartOptions<SpotDayDto> RowTrendOptions()
    {
        var options = ChartBase<SpotDayDto>();
        options.Chart.Sparkline = new ChartSparkline { Enabled = true };
        options.Yaxis = [new YAxis { Min = 0, Max = 1, Show = false }];
        options.Tooltip = new Tooltip { Enabled = false };
        return options;
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private DateOnly Day => DateOnly.FromDateTime(_day);

    /// <summary>Renders a stored UTC instant as local wall-clock at the lot.</summary>
    private string Local(DateTimeOffset utc, string format) => TimeZoneInfo.ConvertTime(utc, _tz).ToString(format);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        var user = await UserManager.GetUserAsync(state.User);
        _userId = user?.Id ?? Guid.Empty;
        _tz = await SiteSettings.GetTimeZoneAsync();

        // Re-seed "today" through the site zone: the field initializer used the server's clock, and a
        // UTC-hosted server would preselect yesterday for a lot that is already past midnight.
        _day = SiteTime.Today(DateTimeOffset.UtcNow, _tz).ToDateTime(TimeOnly.MinValue);

        // The board and the summary header are what the page opens on. The analytics tab's queries
        // scan every booking in its window, so they wait until somebody actually goes there.
        await ReloadBoardAsync();
        _trends = await Dashboard.GetSummaryTrendsAsync();
    }

    private async Task ReloadBoardAsync()
    {
        _board = await Dashboard.GetBoardAsync(Day);
        // The open detail must follow the day being looked at, or its calendar and the board disagree.
        if (_detail is not null)
        {
            await OpenDetailAsync(_detail.SpotId);
        }
    }

    /// <summary>
    /// Loads the analytics the first time its tab is shown. Bound to the tab strip rather than guarding
    /// the panel's markup: an @if around a tab body makes FluentTabs snap the selection back to the
    /// first tab (see the note next to FluentTabs).
    /// </summary>
    private async Task OnTabChangedAsync(FluentTab tab)
    {
        _activeTab = tab?.Id;
        if (_activeTab == AnalyticsTab && _analytics is null)
        {
            await ReloadAnalyticsAsync();
        }
    }

    private Task ShiftDayAsync(int days)
    {
        _day = _day.AddDays(days);
        return ReloadBoardAsync();
    }

    private Task GoTodayAsync()
    {
        _day = SiteTime.Today(DateTimeOffset.UtcNow, _tz).ToDateTime(TimeOnly.MinValue);
        return ReloadBoardAsync();
    }

    /// <summary>Clicking a tile opens that spot's dialog.</summary>
    private Task SelectSpotAsync(Guid spotId) => OpenDetailAsync(spotId);

    private async Task OpenDetailAsync(Guid spotId)
    {
        CancelMove();
        // Two weeks ahead from the day on the board: enough to see the week being planned without
        // turning the dialog into a scroll marathon.
        _detail = await Dashboard.GetSpotDetailAsync(spotId, Day, 14);
    }

    private void CloseDetail()
    {
        CancelMove();
        _detail = null;
    }

    private async Task ChangeAnalyticsWindowAsync(string? days)
    {
        if (int.TryParse(days, out var parsed))
        {
            _analyticsDays = parsed;
            await ReloadAnalyticsAsync();
        }
    }

    private async Task ReloadAnalyticsAsync()
    {
        var today = SiteTime.Today(DateTimeOffset.UtcNow, _tz);
        _analytics = await Dashboard.GetAnalyticsAsync(today.AddDays(-(_analyticsDays - 1)), today);
    }

    /// <summary>All 24 hours of one weekday, zeros included — a heatmap row needs every cell.</summary>
    private List<DemandCellDto> DemandRow(DayOfWeek day) =>
        Enumerable.Range(0, 24)
            .Select(hour => _analytics?.Demand.FirstOrDefault(c => c.DayOfWeek == day && c.Hour == hour)
                ?? new DemandCellDto(day, hour, 0))
            .ToList();

    private static string ShortDay(DayOfWeek day) =>
        CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(day);

    /// <summary>
    /// Chart options that read on both the light and the dark theme without knowing which one is on.
    /// The theme lives in another interactive island (AccountMenu owns the single FluentDesignTheme),
    /// so this page cannot ask; instead the background stays transparent, labels and gridlines use
    /// mid-grey/low-alpha values that hold contrast against white and near-black alike, and the series
    /// take the brand colours, which were picked to work on both.
    /// </summary>
    private static ApexChartOptions<T> ChartBase<T>() where T : class => new()
    {
        Chart = new Chart
        {
            Background = "transparent",
            Toolbar = new Toolbar { Show = false },
            Zoom = new Zoom { Enabled = false },
            FontFamily = "inherit",
            ForeColor = "#8a8a8a",
            Animations = new Animations { Enabled = false },
        },
        Colors = ["#884DFF", "#89E103"],
        Grid = new Grid { BorderColor = "rgba(128,128,128,.25)" },
        DataLabels = new DataLabels { Enabled = false },
        Legend = new Legend { Show = false },
        Tooltip = new Tooltip { Theme = Mode.Dark },
    };

    private string PeakLabel(LotAnalyticsDto analytics) =>
        analytics is { PeakHour: { } hour, PeakDayOfWeek: { } day }
            ? $"{ShortDay(day)} {hour}:00"
            : "—";

    private static string MeterClass(int percent) => percent switch
    {
        >= 85 => "meter__fill--high",
        >= 60 => "meter__fill--mid",
        _ => "meter__fill--low",
    };

    private static string StatusClass(ReservationStatus status) => status switch
    {
        ReservationStatus.CheckedIn => "on",
        ReservationStatus.Completed => "on",
        ReservationStatus.NoShow => "warn",
        ReservationStatus.Cancelled => "off",
        ReservationStatus.Released => "info",
        _ => "info",
    };

    private string TileTooltip(SpotTileDto tile)
    {
        var parts = new List<string> { tile.Code, L[$"Lot_State_{tile.State}"].Value };
        if (tile.OwnerName is not null)
        {
            parts.Add($"{L["Parking_Admin_Resident"]}: {tile.OwnerName}");
        }

        if (tile.HolderName is not null && tile.FromUtc is { } from && tile.ToUtc is { } to)
        {
            parts.Add($"{tile.HolderName} {Local(from, "H:mm")}–{Local(to, "H:mm")}");
        }

        if (tile.MismatchCount > 0)
        {
            parts.Add($"{L["Lot_Tile_Mismatches"]}: {tile.MismatchCount}");
        }

        return string.Join(" · ", parts);
    }

    private string PlanLabel(SpotDetailDto detail)
    {
        if (!detail.AutoReleaseUnplannedDays)
        {
            return L["Lot_Detail_PlanOff"];
        }

        var days = WeekOrder.Where(d => (detail.PlannedUseDays & d.ToWeekday()) != 0).Select(ShortDay);
        var listed = string.Join(", ", days);
        return string.IsNullOrEmpty(listed) ? L["Lot_Detail_PlanNone"] : listed;
    }

    /// <summary>
    /// One tile of the analytics headline strip. Those four are single figures over the chosen window
    /// with no day-by-day history to draw, so they stay tiles rather than joining a trend table.
    /// </summary>
    private RenderFragment Stat(string label, string value, string? tone) => __builder =>
    {
        <div class="lot-stat @(tone is null ? null : $"lot-stat--{tone}")">
            <span class="lot-stat__value">@value</span>
            <span class="lot-stat__label">@label</span>
        </div>
    };

    /// <summary>
    /// One row of the summary table: the metric, its current number, and its sparkline when the metric
    /// has a daily history. `tone` maps onto the shared state-pill palette; `percent` scales the chart
    /// to 0–100 instead of letting it fit the data, so an occupancy line is read against the whole lot.
    /// </summary>
    private RenderFragment SummaryRow(string label, string value, string? tone,
        IReadOnlyList<DailyCountDto>? trend, bool percent = false) => __builder =>
    {
        <tr class="@(tone is null ? null : $"lot-summary--{tone}")">
            <th scope="row">@label</th>
            <td class="lot-summary__num">@value</td>
            <td class="lot-summary__chart">
                @if (trend is { Count: > 0 })
                {
                    @* Explicit pixel width: ApexCharts measures its container on mount and a table cell
                       has no resolved width yet, so a relative chart comes out zero-wide. *@
                    <ApexChart @key="@($"sum-{label}")" TItem="DailyCountDto"
                               Options="@SparklineOptions(percent)" Height="34" Width="180">
                        <ApexPointSeries TItem="DailyCountDto"
                                         Items="@trend"
                                         Name="@label"
                                         SeriesType="SeriesType.Area"
                                         XValue="@(d => d.Date.ToString("d.M."))"
                                         YValue="@(d => d.Count)" />
                    </ApexChart>
                }
                else
                {
                    <span class="lot-summary__nochart" title="@L["Lot_Summary_NoTrend"]">—</span>
                }
            </td>
        </tr>
    };

    private IReadOnlyList<DailyCountDto>? OccupancyTrend =>
        _trends?.Occupancy.Select(d => new DailyCountDto(d.Date, d.OccupancyPercent)).ToList();

    private IReadOnlyList<DailyCountDto>? OccupiedTrend =>
        _trends?.Occupancy.Select(d => new DailyCountDto(d.Date, d.Occupied)).ToList();

    private IReadOnlyList<DailyCountDto>? MismatchTrend => _trends?.Mismatches;

    private IReadOnlyList<DailyCountDto>? WastedShareTrend => _trends?.WastedShares;

    /// <summary>
    /// A sparkline for a summary row: no axes or grid at 34 px tall, the shape is the whole message.
    /// A fresh instance per row because ApexCharts writes into the options object it is handed.
    /// </summary>
    private static ApexChartOptions<DailyCountDto> SparklineOptions(bool percent)
    {
        var options = ChartBase<DailyCountDto>();
        options.Chart.Sparkline = new ChartSparkline { Enabled = true };
        options.Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 };
        options.Yaxis = [new YAxis { Min = 0, Max = percent ? 100 : null, Show = false }];
        return options;
    }

    private async Task SetActiveAsync(bool active)
    {
        if (_detail is null)
        {
            return;
        }

        await RunAsync(() => Spots.SetActiveAsync(_detail.SpotId, active),
            active ? "Lot_Info_Activated" : "Lot_Info_Deactivated");
    }

    private Task CancelAsync(Guid reservationId) =>
        RunAsync(() => Dashboard.CancelReservationAsync(reservationId, _userId), "Lot_Info_Cancelled");

    private async Task BeginMoveAsync(Guid reservationId)
    {
        _moveReservationId = reservationId;
        _moveTargets = null;
        _moveTargetId = null;
        _moveTargets = await Dashboard.GetMoveTargetsAsync(reservationId);
        _moveTargetId = _moveTargets.FirstOrDefault()?.SpotId.ToString();
    }

    private void CancelMove()
    {
        _moveReservationId = null;
        _moveTargets = null;
        _moveTargetId = null;
    }

    private async Task ConfirmMoveAsync()
    {
        if (_moveReservationId is not { } reservationId || !Guid.TryParse(_moveTargetId, out var targetSpotId))
        {
            return;
        }

        await RunAsync(() => Dashboard.MoveReservationAsync(reservationId, targetSpotId, _userId), "Lot_Info_Moved");
        CancelMove();
    }

    /// <summary>
    /// Runs one intervention, then reloads everything it could have changed. The board, the open
    /// detail and the analytics all read the same rows, so refreshing only one of them would leave
    /// the manager looking at a screen that half-agrees with itself.
    /// </summary>
    private async Task RunAsync(Func<Task<ParkingResult>> action, string successKey)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        _info = null;
        try
        {
            var result = await action();
            if (result.Succeeded)
            {
                _info = L[successKey];
            }
            else
            {
                _error = result.Errors.FirstOrDefault() ?? "Parking_Error_InvalidState";
            }
        }
        finally
        {
            _busy = false;
        }

        // The service drops its cached aggregates on an override, so these re-read fresh numbers.
        // Analytics is only refreshed when it has been opened — otherwise the intervention would
        // pay for a window nobody is looking at.
        await ReloadBoardAsync();
        _trends = await Dashboard.GetSummaryTrendsAsync();
        if (_analytics is not null)
        {
            await ReloadAnalyticsAsync();
        }
    }
}
