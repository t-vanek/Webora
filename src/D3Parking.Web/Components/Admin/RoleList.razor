@page "/admin/roles"
@attribute [HasPermission(Permissions.Roles.View)]
@rendermode InteractiveServer
@inject IRoleAdminService RoleAdmin
@inject IStringLocalizer<SharedResource> L

@* A role is a job description assembled from permission groups, so the card leads with the groups
   it is made of — that is the shape an administrator picked. The matrix answers the cross-role
   question ("who can do what"), which no single role page ever could. *@

<PageTitle>@L["Admin_Roles_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <div class="admin-head">
        <div class="admin-head__titles">
            <div class="admin-head__title-row">
                <FluentLabel Typo="Typography.PageTitle">@L["Admin_Roles_Title"]</FluentLabel>
                @if (_roles is not null)
                {
                    <span class="count-chip">@_roles.Count</span>
                }
            </div>
            <p class="admin-head__intro">@L["Admin_Roles_Intro"]</p>
        </div>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
            <div class="view-switch" role="group" aria-label="@L["Admin_Roles_ViewLabel"]">
                <button type="button" class="view-switch__btn @(_matrix ? string.Empty : "view-switch__btn--active")"
                        @onclick="() => _matrix = false" aria-pressed="@(!_matrix)">
                    @L["Admin_Roles_ViewCards"]
                </button>
                <button type="button" class="view-switch__btn @(_matrix ? "view-switch__btn--active" : string.Empty)"
                        @onclick="() => _matrix = true" aria-pressed="@_matrix">
                    @L["Admin_Roles_ViewMatrix"]
                </button>
            </div>
            <AuthorizeView Policy="@PermissionPolicies.For(Permissions.PermissionGroups.View)" Context="groups">
                <FluentAnchor Href="admin/permission-groups" Appearance="Appearance.Outline">@L["Nav_AdminPermissionGroups"]</FluentAnchor>
            </AuthorizeView>
            <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Create)" Context="create">
                <FluentAnchor Href="admin/roles/create" Appearance="Appearance.Accent">@L["Admin_Roles_Create"]</FluentAnchor>
            </AuthorizeView>
        </FluentStack>
    </div>

    @if (_roles is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else if (_matrix)
    {
        <div class="admin-panel role-matrix__wrap">
            <table class="role-matrix">
                <thead>
                    <tr>
                        <th scope="col">@L["Admin_Roles_Name"]</th>
                        @foreach (var area in Permissions.Areas)
                        {
                            <th scope="col">@AuthorizationDisplay.AreaName(L, area.Name)</th>
                        }
                        <th scope="col">@L["Admin_Roles_Users"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in _roles)
                    {
                        <tr>
                            <th scope="row">
                                <a href="@($"admin/roles/{role.Id}")">@AuthorizationDisplay.RoleName(L, role.Name)</a>
                            </th>
                            @foreach (var area in Permissions.Areas)
                            {
                                var held = area.Permissions.Count(role.Permissions.Contains);
                                <td class="@CellClass(held, area.Permissions.Count)"
                                    title="@($"{held} / {area.Permissions.Count}")">
                                    @(held == 0 ? "—" : $"{held}/{area.Permissions.Count}")
                                </td>
                            }
                            <td>@role.UserCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="role-cards">
            @foreach (var role in _roles)
            {
                <a class="role-card" href="@($"admin/roles/{role.Id}")">
                    <div class="role-card__head">
                        <span class="role-card__name">@AuthorizationDisplay.RoleName(L, role.Name)</span>
                        @if (role.IsDefault)
                        {
                            <FluentBadge Appearance="Appearance.Neutral">@L["Admin_Roles_Default"]</FluentBadge>
                        }
                    </div>
                    <p class="role-card__desc">@AuthorizationDisplay.RoleDescription(L, role.Name)</p>

                    <div class="role-card__caps">
                        @if (role.Groups.Count == 0)
                        {
                            <span class="role-card__none">@L["Admin_Roles_NoGroups"]</span>
                        }
                        else
                        {
                            @foreach (var group in role.Groups)
                            {
                                <span class="tag">@AuthorizationDisplay.GroupName(L, group.Name)</span>
                            }
                        }
                    </div>

                    <div class="role-card__foot">
                        <span>@PluralText.For(L, "Admin_Roles_MemberCount", role.UserCount)</span>
                        <span>@PluralText.For(L, "Admin_Roles_PermissionCount", role.Permissions.Count)</span>
                    </div>
                </a>
            }
        </div>
    }
</FluentStack>

@code {
    private IReadOnlyList<RoleSummary>? _roles;
    private bool _matrix;

    protected override async Task OnInitializedAsync() => _roles = await RoleAdmin.ListAsync();

    private static string CellClass(int held, int total) => held switch
    {
        0 => "role-matrix__cell",
        _ when held == total => "role-matrix__cell role-matrix__cell--full",
        _ => "role-matrix__cell role-matrix__cell--partial",
    };
}
