    private async Task LinkAsync(MapShapeDto shape, string? spotId)
    {
        _error = _info = null;
        Guid? id = Guid.TryParse(spotId, out var parsed) ? parsed : null;
        var result = await Maps.LinkSpotAsync(shape.Id, id);
