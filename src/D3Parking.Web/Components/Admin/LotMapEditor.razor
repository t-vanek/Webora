@page "/admin/parking/map"
@page "/admin/parking/map/{MapId:guid}"
@attribute [HasPermission(Permissions.Parking.ManageSpots)]
@rendermode InteractiveServer
@using System.Globalization
@using D3Parking.Application.Parking.Maps
@using D3Parking.Domain.Parking.Maps
@implements IAsyncDisposable
@inject ILotMapService Maps
@inject IParkingSpotService Spots
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Map_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <div class="admin-head__titles">
        <div class="admin-head__title-row">
            <FluentLabel Typo="Typography.PageTitle">@L["Map_Title"]</FluentLabel>
            @if (_map is not null)
            {
                <span class="count-chip">@_map.Shapes.Count</span>
            }
        </div>
        <p class="admin-head__intro">@L["Map_Intro"]</p>
    </div>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="true">@L[_error]</FluentMessageBar>
    }
    @if (_info is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar" AllowDismiss="true">@_info</FluentMessageBar>
    }

    @if (_map is null)
    {
        @* The chooser. Also where a map is created, because a new one is nothing but a name and a
           coordinate space — there is no wizard worth opening for two numbers. *@
        <div class="form-panel">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                <FluentLabel Typo="Typography.Subject">@L["Map_New"]</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                    <FluentTextField Id="map-name" Immediate="true" @bind-Value="_newName" Label="@L["Map_Name"]" Placeholder="@L["Map_NamePlaceholder"]" />
                    <FluentNumberField TValue="int" @bind-Value="_newWidth" Min="@LotMap.MinDimension.ToString()" Label="@L["Map_Width"]" Style="width:120px" />
                    <FluentNumberField TValue="int" @bind-Value="_newHeight" Min="@LotMap.MinDimension.ToString()" Label="@L["Map_Height"]" Style="width:120px" />
                    <FluentButton Id="map-create" Appearance="Appearance.Accent" OnClick="CreateMapAsync">@L["Map_Create"]</FluentButton>
                </FluentStack>
                <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">@L["Map_SizeHint"]</FluentLabel>
            </FluentStack>
        </div>

        <div class="form-panel">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                <FluentLabel Typo="Typography.Subject">@L["Map_Import"]</FluentLabel>
                <FluentTextArea @bind-Value="_importJson" Rows="4" Style="width:100%; max-width:520px" Label="@L["Map_ImportJson"]" />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Bottom">
                    <FluentTextField @bind-Value="_importName" Label="@L["Map_ImportName"]" />
                    <FluentButton Appearance="Appearance.Outline" OnClick="ImportAsync">@L["Map_ImportRun"]</FluentButton>
                </FluentStack>
            </FluentStack>
        </div>

        @if (_maps.Count == 0)
        {
            <FluentLabel Typo="Typography.Body">@L["Map_None"]</FluentLabel>
        }
        else
        {
            <div class="admin-panel">
                <FluentDataGrid Items="@_maps.AsQueryable()" TGridItem="LotMapSummaryDto" GridTemplateColumns="1.5fr 1fr 1fr 1fr auto">
                    <TemplateColumn Title="@L["Map_Name"]">
                        <FluentAnchor Href="@($"/admin/parking/map/{context.Id}")" Appearance="Appearance.Hypertext">@context.Name</FluentAnchor>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Map_Size"]">@context.Width × @context.Height</TemplateColumn>
                    <TemplateColumn Title="@L["Map_Shapes"]">@context.ShapeCount (@context.LinkedCount @L["Map_Linked"])</TemplateColumn>
                    <TemplateColumn Title="@L["Map_State"]">
                        @if (context.IsPublished)
                        {
                            <span class="state-pill state-pill--on">@L["Map_Published"]</span>
                        }
                        else
                        {
                            <span class="state-pill state-pill--off">@L["Map_Draft"]</span>
                        }
                    </TemplateColumn>
                    <TemplateColumn Align="Align.End">
                        <FluentButton Appearance="Appearance.Stealth" OnClick="() => DeleteMapAsync(context.Id)">@L["Map_Delete"]</FluentButton>
                    </TemplateColumn>
                </FluentDataGrid>
            </div>
        }
    }
    else
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true" VerticalAlignment="VerticalAlignment.Center">
            <FluentAnchor Href="/admin/parking/map" Appearance="Appearance.Hypertext">← @L["Map_BackToList"]</FluentAnchor>
            <FluentLabel Typo="Typography.H5">@_map.Name</FluentLabel>
            @if (_map.IsPublished)
            {
                <span class="state-pill state-pill--on">@L["Map_Published"]</span>
            }
        </FluentStack>

        @* Toolbar. The tool decides what a drag on empty canvas does; everything else on the bar is
           a view setting, which is why none of it touches the model. *@
        <div class="map-toolbar">
            <div class="map-toolbar__group" role="group" aria-label="@L["Map_Tools"]">
                @foreach (var tool in Tools)
                {
                    <FluentButton Appearance="@(_tool == tool ? Appearance.Accent : Appearance.Outline)"
                                  OnClick="() => SetToolAsync(tool)"
                                  aria-pressed="@(_tool == tool ? "true" : "false")">@L[$"Map_Tool_{tool}"]</FluentButton>
                }
            </div>

            <div class="map-toolbar__group">
                <FluentSelect TOption="MapShapeKind"
                              Items="@ShapeKinds"
                              OptionValue="@(k => k.ToString())"
                              OptionText="@(k => L[$"Map_Kind_{k}"].Value)"
                              @bind-SelectedOption="_drawKind"
                              Label="@L["Map_DrawKind"]" Style="width:150px" />
                <FluentNumberField TValue="int" Value="@_map.GridSize" ValueChanged="SetGridAsync" Immediate="true"
                                   Min="0" Max="500" Label="@L["Map_Grid"]" Style="width:90px" />
            </div>

            <div class="map-toolbar__group">
                @* Also Ctrl+Z on the canvas. The button is here because the shortcut only reaches the
                   editor while the canvas has focus, and the moment anyone needs undo most is right
                   after clicking something else. *@
                <FluentButton Id="map-undo" Appearance="Appearance.Outline" Disabled="@(_undo.Count == 0)"
                              OnClick="UndoAsync">↶ @L["Map_Undo"]</FluentButton>
                <FluentButton Id="map-duplicate" Appearance="Appearance.Outline" Disabled="@(_selected.Count == 0)"
                              OnClick="DuplicateSelectedAsync">@L["Map_Duplicate"]</FluentButton>
            </div>

            <div class="map-toolbar__group">
                @* On a plan of five hundred shapes "where is 434?" has no answer but scanning by eye.
                   Selects every match and moves the view onto them. *@
                <FluentSearch Id="map-find" @bind-Value="_find" @bind-Value:after="FindAsync"
                              Immediate="true" ImmediateDelay="300"
                              Placeholder="@L["Map_FindHint"]" Style="width:150px" />
            </div>

            <div class="map-toolbar__group">
                <FluentButton Appearance="Appearance.Outline" OnClick="() => ZoomAsync(1.25)" aria-label="@L["Map_ZoomIn"]">＋</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="() => ZoomAsync(0.8)" aria-label="@L["Map_ZoomOut"]">－</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="ResetViewAsync">@L["Map_FitView"]</FluentButton>
            </div>

            <div class="map-toolbar__group">
                <FluentButton Appearance="@(_map.IsPublished ? Appearance.Outline : Appearance.Accent)" OnClick="TogglePublishedAsync">
                    @L[_map.IsPublished ? "Map_Unpublish" : "Map_Publish"]
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="ExportAsync">@L["Map_Export"]</FluentButton>
            </div>
        </div>

        <div class="map-split">
            <div class="map-split__canvas">
                @* tabindex so the canvas takes focus and the keyboard shortcuts (Delete, arrows,
                   Escape) reach it; the JS module listens on this element, not on the document. *@
                <svg class="map-canvas map-canvas--@_tool" @ref="_canvasRef" tabindex="0"
                     viewBox="@($"0 0 {_map.Width} {_map.Height}")"
                     role="application" aria-label="@L["Map_CanvasLabel"]">
                    @if (_map.HasBackground)
                    {
                        @* The traced-over site plan. Never receives the pointer: a click on it must
                           start a marquee or a new rectangle, not select the picture. *@
                        <image href="@($"/api/parking/maps/{_map.Id}/background?v={_backgroundVersion}")"
                               x="0" y="0" width="@Inv(_map.Width)" height="@Inv(_map.Height)"
                               opacity="@Inv(_map.BackgroundOpacity / 100d)"
                               preserveAspectRatio="none" pointer-events="none" />
                    }

                    @foreach (var shape in _map.Shapes)
                    {
                        <g @key="shape.Id"
                           class="map-shape map-shape--@shape.Kind @(shape.ParkingSpotId is null ? "map-shape--unlinked" : "map-shape--linked") @(_selected.Contains(shape.Id) ? "is-selected" : null)"
                           data-id="@shape.Id" data-x="@Inv(shape.X)" data-y="@Inv(shape.Y)"
                           data-w="@Inv(shape.Width)" data-h="@Inv(shape.Height)" data-rot="@Inv(shape.Rotation)">
                            <polygon points="@shape.Rect.ToSvgPoints()" />
                            @if (!string.IsNullOrEmpty(shape.Label))
                            {
                                <SvgLabel X="@Inv(shape.Rect.CentreX)" Y="@Inv(shape.Rect.CentreY)"
                                          Transform="@RotateAbout(shape)" Text="@shape.Label" />
                            }
                        </g>
                    }

                    @* Left empty on purpose: the JS module draws the handles and the marquee in here.
                       Blazor renders no children for it, so its diff never touches what JS put inside. *@
                    <g class="map-overlay"></g>
                </svg>
                <p class="map-hint">@L["Map_CanvasHint"]</p>
            </div>

            <aside class="map-split__side" aria-live="polite">
                @if (_selected.Count == 1 && SelectedShape is { } picked)
                {
                    <div class="admin-panel map-panel">
                        <FluentLabel Typo="Typography.Subject">@L["Map_Shape"]</FluentLabel>
                        <FluentTextField Id="shape-label" Immediate="true" ImmediateDelay="400" Value="@picked.Label"
                                         ValueChanged="@(v => RelabelAsync(picked, v))" Label="@L["Map_Label"]" />
                        <FluentSelect TOption="MapShapeKind"
                                      Items="@ShapeKinds"
                                      OptionValue="@(k => k.ToString())"
                                      OptionText="@(k => L[$"Map_Kind_{k}"].Value)"
                                      Value="@picked.Kind.ToString()"
                                      ValueChanged="@(v => ChangeKindAsync(picked, v))"
                                      Label="@L["Map_Kind"]" />

                        @if (picked.Kind == MapShapeKind.Spot)
                        {
                            <FluentSelect TOption="string"
                                          Items="@SpotOptions"
                                          OptionValue="@(id => id)"
                                          OptionText="@(id => SpotLabel(id))"
                                          Value="@(picked.ParkingSpotId?.ToString() ?? string.Empty)"
                                          ValueChanged="@(v => LinkAsync(picked, v))"
                                          Label="@L["Map_LinkedSpot"]" />
                            @if (picked.LabelMismatch)
                            {
                                <FluentLabel Typo="Typography.Body" Color="Color.Warning" Style="font-size:12px">
                                    @string.Format(L["Map_LabelMismatch"], picked.Label, picked.SpotCode)
                                </FluentLabel>
                            }
                        }

                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">
                            @string.Format(L["Map_Geometry"], Inv(picked.X), Inv(picked.Y), Inv(picked.Width), Inv(picked.Height), Inv(picked.Rotation))
                        </FluentLabel>

                        @* The row tool: the one thing that makes tracing a site plan of hundreds of
                           stalls finish in an afternoon. It repeats this rectangle along its own axis
                           and carries the numbering on from its label. *@
                        <hr class="map-panel__rule" />
                        <FluentLabel Typo="Typography.Subject">@L["Map_Row"]</FluentLabel>
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                            <FluentNumberField Id="row-count" TValue="int" @bind-Value="_rowCount" Immediate="true" Min="2"
                                               Max="@MapRowPlan.MaxRowLength.ToString()" Label="@L["Map_RowCount"]" Style="width:100px" />
                            <FluentNumberField TValue="double" @bind-Value="_rowGap" Immediate="true" Label="@L["Map_RowGap"]" Style="width:100px" />
                            <FluentNumberField TValue="int" @bind-Value="_rowStep" Immediate="true" Label="@L["Map_RowStep"]" Style="width:100px" />
                        </FluentStack>
                        <FluentSelect TOption="RowDirection"
                                      Items="@Directions"
                                      OptionValue="@(d => d.ToString())"
                                      OptionText="@(d => L[$"Map_Dir_{d}"].Value)"
                                      @bind-SelectedOption="_rowDirection"
                                      Label="@L["Map_RowDirection"]" />
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">@RowPreview(picked)</FluentLabel>
                        <FluentButton Id="map-row" Appearance="Appearance.Accent" OnClick="() => AddRowAsync(picked)">@L["Map_RowCreate"]</FluentButton>
                    </div>
                }
                else if (_selected.Count > 1)
                {
                    <div class="admin-panel map-panel">
                        <FluentLabel Typo="Typography.Subject">@string.Format(L["Map_SelectedCount"], _selected.Count)</FluentLabel>
                        <FluentSelect TOption="ParkingSpotType"
                                      Items="@SpotTypes"
                                      OptionValue="@(t => t.ToString())"
                                      OptionText="@(t => L[$"Parking_SpotType_{t}"].Value)"
                                      @bind-SelectedOption="_bulkType"
                                      Label="@L["Map_BulkSpotType"]" />
                        <FluentButton Id="map-create-spots" Appearance="Appearance.Accent" OnClick="CreateSpotsAsync">@L["Map_CreateSpots"]</FluentButton>
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">@L["Map_CreateSpotsHint"]</FluentLabel>

                        @* Lining up. Alignment is only ever new positions, so it goes down the same
                           path a drag takes and inherits its clamping and its undo step. *@
                        <hr class="map-panel__rule" />
                        <FluentLabel Typo="Typography.Subject">@L["Map_Align"]</FluentLabel>
                        <div class="map-align">
                            @foreach (var (mode, key) in Alignments)
                            {
                                <FluentButton Appearance="Appearance.Outline" OnClick="() => AlignAsync(mode)"
                                              Title="@L[key]" aria-label="@L[key]">@L[$"{key}_Short"]</FluentButton>
                            }
                        </div>

                        <hr class="map-panel__rule" />
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Bottom">
                            <FluentSelect TOption="MapShapeKind"
                                          Items="@ShapeKinds"
                                          OptionValue="@(k => k.ToString())"
                                          OptionText="@(k => L[$"Map_Kind_{k}"].Value)"
                                          @bind-SelectedOption="_bulkKind"
                                          Label="@L["Map_BulkKind"]" Style="width:150px" />
                            <FluentButton Id="map-bulk-kind" Appearance="Appearance.Outline" OnClick="SetKindAsync">@L["Map_BulkKindApply"]</FluentButton>
                        </FluentStack>

                        @* Renumbering. A row traced perfectly and started one out is otherwise
                           thirteen labels retyped by hand. Order is how the selection reads —
                           bands from the top, each band from the left — which the reverse box
                           flips for the columns numbered the other way. *@
                        <hr class="map-panel__rule" />
                        <FluentLabel Typo="Typography.Subject">@L["Map_Renumber"]</FluentLabel>
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                            <FluentTextField Id="renumber-from" Immediate="true" @bind-Value="_renumberFrom"
                                             Label="@L["Map_RenumberFrom"]" Style="width:120px" />
                            <FluentNumberField Id="renumber-step" TValue="int" @bind-Value="_renumberStep" Immediate="true"
                                               Label="@L["Map_RowStep"]" Style="width:100px" />
                        </FluentStack>
                        <FluentCheckbox @bind-Value="_renumberReverse">@L["Map_RenumberReverse"]</FluentCheckbox>
                        <FluentButton Id="map-renumber" Appearance="Appearance.Outline" OnClick="RenumberAsync">@L["Map_RenumberRun"]</FluentButton>
                    </div>
                }
                else
                {
                    <div class="admin-panel map-panel">
                        <FluentLabel Typo="Typography.Subject">@L["Map_Properties"]</FluentLabel>
                        <FluentTextField Immediate="true" @bind-Value="_editName" Label="@L["Map_Name"]" />
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Bottom">
                            <FluentNumberField TValue="int" @bind-Value="_editWidth" Min="@LotMap.MinDimension.ToString()" Label="@L["Map_Width"]" Style="width:110px" />
                            <FluentNumberField TValue="int" @bind-Value="_editHeight" Min="@LotMap.MinDimension.ToString()" Label="@L["Map_Height"]" Style="width:110px" />
                        </FluentStack>
                        <FluentButton Appearance="Appearance.Accent" OnClick="SaveMapAsync">@L["Map_Save"]</FluentButton>

                        <hr class="map-panel__rule" />
                        <FluentLabel Typo="Typography.Subject">@L["Map_Background"]</FluentLabel>
                        <InputFile id="map-background-file" OnChange="OnBackgroundSelectedAsync" accept="@ImageContentType.AcceptAttribute" class="parking-input" />
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Bottom">
                            <FluentNumberField TValue="int" Value="@_map.BackgroundOpacity" ValueChanged="SetOpacityAsync" Immediate="true"
                                               Min="0" Max="100" Label="@L["Map_Opacity"]" Style="width:110px" />
                            @if (_map.HasBackground)
                            {
                                <FluentButton Appearance="Appearance.Stealth" OnClick="ClearBackgroundAsync">@L["Map_BackgroundClear"]</FluentButton>
                            }
                        </FluentStack>
                        @if (_map.HasBackground)
                        {
                            @* The underlay is stretched onto whatever coordinate space the map was
                               created with, and nothing on screen says what that should have been.
                               This reads the scan's own pixels and makes the map match. *@
                            <FluentButton Id="map-match" Appearance="Appearance.Accent" OnClick="MatchBackgroundAsync">
                                @L["Map_MatchBackground"]
                            </FluentButton>
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">@L["Map_MatchBackgroundHint"]</FluentLabel>
                        }
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">@L["Map_BackgroundHint"]</FluentLabel>

                        @* Import of an exported plan. The file is parsed and thrown away — that is
                           why SVG is welcome here and refused as an underlay, where it would be
                           served back from this origin as a document that can carry script. *@
                        <hr class="map-panel__rule" />
                        <FluentLabel Typo="Typography.Subject">@L["Map_Svg"]</FluentLabel>
                        <FluentSelect TOption="MapShapeKind"
                                      Items="@ShapeKinds"
                                      OptionValue="@(k => k.ToString())"
                                      OptionText="@(k => L[$"Map_Kind_{k}"].Value)"
                                      @bind-SelectedOption="_svgKind"
                                      Label="@L["Map_SvgKind"]" />
                        <InputFile id="map-svg-file" OnChange="OnSvgSelectedAsync" accept="image/svg+xml,.svg" class="parking-input" />
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">@L["Map_SvgHint"]</FluentLabel>
                        @if (_svgReport is { } imported)
                        {
                            <div class="batch-preview">
                                <span><span class="count-chip">@imported.Created</span> @string.Format(L["Map_Svg_Created"], imported.Labelled)</span>
                                @if (imported.Warnings.NotRectangles > 0)
                                {
                                    <span class="batch-preview__dup">@string.Format(L["Map_Svg_NotRectangles"], imported.Warnings.NotRectangles)</span>
                                }
                                @if (imported.Warnings.OrphanLabels > 0)
                                {
                                    <span class="batch-preview__dup">@string.Format(L["Map_Svg_OrphanLabels"], imported.Warnings.OrphanLabels)</span>
                                }
                                @if (imported.Warnings.UnsupportedTransforms > 0)
                                {
                                    <span class="batch-preview__bad">@string.Format(L["Map_Svg_Unsupported"], imported.Warnings.UnsupportedTransforms)</span>
                                }
                                @if (imported.Warnings.Degenerate > 0)
                                {
                                    <span class="batch-preview__dup">@string.Format(L["Map_Svg_Degenerate"], imported.Warnings.Degenerate)</span>
                                }
                                @if (imported.Warnings.Duplicates > 0)
                                {
                                    <span class="batch-preview__dup">@string.Format(L["Map_Svg_Duplicates"], imported.Warnings.Duplicates)</span>
                                }
                            </div>
                        }

                        <hr class="map-panel__rule" />
                        <FluentLabel Typo="Typography.Subject">@L["Map_Linking"]</FluentLabel>
                        <FluentButton Appearance="Appearance.Accent" OnClick="AutoLinkAsync">@L["Map_AutoLink"]</FluentButton>
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Style="font-size:12px">@L["Map_AutoLinkHint"]</FluentLabel>
                        @if (_autoLink is { } report)
                        {
                            <div class="batch-preview">
                                <span><span class="count-chip">@report.Linked</span> @L["Map_AutoLink_Linked"]</span>
                                @if (report.UnmatchedLabels.Count > 0)
                                {
                                    @* Clickable: the report used to name what was left over and give
                                       no way to go and look at it. *@
                                    <span class="batch-preview__dup">
                                        @string.Format(L["Map_AutoLink_NoSpot"], report.UnmatchedLabels.Count, string.Empty)
                                        @foreach (var label in report.UnmatchedLabels.Take(12))
                                        {
                                            <button type="button" class="map-find-link" @onclick="() => FindLabelAsync(label)">@label</button>
                                        }
                                    </span>
                                }
                                @if (report.UnmatchedCodes.Count > 0)
                                {
                                    <span class="batch-preview__bad">@string.Format(L["Map_AutoLink_NoShape"], report.UnmatchedCodes.Count, Sample(report.UnmatchedCodes))</span>
                                }
                            </div>
                        }
                    </div>
                }

                @if (_selected.Count > 0)
                {
                    <FluentButton Appearance="Appearance.Stealth" OnClick="DeleteSelectedAsync">@L["Map_DeleteShapes"]</FluentButton>
                }

                @if (_exported is not null)
                {
                    <div class="admin-panel map-panel">
                        <FluentLabel Typo="Typography.Subject">@L["Map_Export"]</FluentLabel>
                        <FluentTextArea Value="@_exported" ReadOnly="true" Rows="8" Style="width:100%" />
                    </div>
                }
            </aside>
        </div>
    }
</FluentStack>

@code {
    [Parameter]
    public Guid? MapId { get; set; }

    private static readonly string[] Tools = ["select", "draw", "pan"];
    private static readonly MapShapeKind[] ShapeKinds = Enum.GetValues<MapShapeKind>();
    private static readonly RowDirection[] Directions = Enum.GetValues<RowDirection>();
    private static readonly ParkingSpotType[] SpotTypes = Enum.GetValues<ParkingSpotType>();

    private IReadOnlyList<LotMapSummaryDto> _maps = [];
    private LotMapDetailDto? _map;
    private IReadOnlyList<ParkingSpotDto> _spots = [];

    private readonly HashSet<Guid> _selected = [];
    private string _tool = "select";
    private MapShapeKind _drawKind = MapShapeKind.Spot;

    private int _rowCount = 10;
    private double _rowGap = 1;
    private int _rowStep = 1;
    private RowDirection _rowDirection = RowDirection.Right;
    private ParkingSpotType _bulkType = ParkingSpotType.Standard;

    private string? _find;
    private MapShapeKind _svgKind = MapShapeKind.Spot;
    private MapSvgImportResult? _svgReport;
    private MapShapeKind _bulkKind = MapShapeKind.Spot;

    /// <summary>The alignment buttons, in the order they read on the panel.</summary>
    private static readonly (MapAlignment Mode, string Key)[] Alignments =
    [
        (MapAlignment.Left, "Map_Align_Left"),
        (MapAlignment.CentreX, "Map_Align_CentreX"),
        (MapAlignment.Right, "Map_Align_Right"),
        (MapAlignment.DistributeX, "Map_Align_DistributeX"),
        (MapAlignment.Top, "Map_Align_Top"),
        (MapAlignment.MiddleY, "Map_Align_MiddleY"),
        (MapAlignment.Bottom, "Map_Align_Bottom"),
        (MapAlignment.DistributeY, "Map_Align_DistributeY"),
    ];

    private string _renumberFrom = "1";
    private int _renumberStep = 1;
    private bool _renumberReverse;

    private string? _newName;
    private int _newWidth = 1600;
    private int _newHeight = 900;
    private string? _editName;
    private int _editWidth;
    private int _editHeight;
    private string? _importJson;
    private string? _importName;
    private string? _exported;
    private MapAutoLinkResult? _autoLink;

    /// <summary>Bumped on every background change so the browser refetches rather than showing the old scan.</summary>
    private int _backgroundVersion;

    private string? _error;
    private string? _info;

    private ElementReference _canvasRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<LotMapEditor>? _selfRef;

    /// <summary>Set once the module is attached to this canvas, so a re-render syncs instead of re-attaching.</summary>
    private Guid _attachedTo;

    private MapShapeDto? SelectedShape =>
        _selected.Count == 1 ? _map?.Shapes.FirstOrDefault(s => s.Id == _selected.First()) : null;

    private IEnumerable<string> SpotOptions => new[] { string.Empty }.Concat(_spots.Select(s => s.Id.ToString()));

    /// <summary>Invariant formatting. SVG parses "12.5", never the "12,5" a Czech UI culture would write.</summary>
    private static string Inv(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Inv(int value) => value.ToString(CultureInfo.InvariantCulture);

    private static string? RotateAbout(MapShapeDto shape) =>
        shape.Rotation == 0
            ? null
            : $"rotate({Inv(shape.Rotation)} {Inv(shape.Rect.CentreX)} {Inv(shape.Rect.CentreY)})";

    private static string Sample(IReadOnlyList<string> values) =>
        values.Count <= 9 ? string.Join(", ", values) : string.Join(", ", values.Take(8)) + " … " + values[^1];

    private string SpotLabel(string id)
    {
        if (string.IsNullOrEmpty(id))
        {
            return L["Map_NoSpot"];
        }

        var spot = _spots.FirstOrDefault(s => s.Id.ToString() == id);
        return spot is null ? id : spot.Code;
    }

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (MapId is { } id)
        {
            _map = await Maps.GetAsync(id);
            if (_map is null)
            {
                // The map was deleted in another tab; the chooser is the only honest place to land.
                Navigation.NavigateTo("/admin/parking/map");
                return;
            }

            if (_undoMapId != _map.Id)
            {
                // The history is a session over one drawing; carrying it across maps would let an
                // undo delete shapes on a map that never created them.
                _undo.Clear();
                _undoMapId = _map.Id;
            }

            _editName = _map.Name;
            _editWidth = _map.Width;
            _editHeight = _map.Height;
            if (_spots.Count == 0)
            {
                _spots = await Spots.ListAsync();
            }

            // A shape that is gone must not stay selected — the panel would edit a ghost.
            _selected.RemoveWhere(s => _map.Shapes.All(shape => shape.Id != s));
        }
        else
        {
            _map = null;
            _maps = await Maps.ListAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_map is null)
        {
            // Left the editor for the chooser: the module still holds the old canvas element.
            if (_attachedTo != Guid.Empty)
            {
                await InvokeModuleAsync("detach");
                _attachedTo = Guid.Empty;
            }

            return;
        }

        // Absolute, not "./": the specifier resolves against the current document URL, and this page
        // is also served at /admin/parking/map/{id}, where a relative path points at a directory that
        // does not exist. The route with an id is the one the editor actually runs on.
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/lot-map-editor.js");
        _selfRef ??= DotNetObjectReference.Create(this);

        if (_attachedTo != _map.Id)
        {
            _attachedTo = _map.Id;
            await _module.InvokeVoidAsync("attach", _canvasRef, _selfRef,
                new { width = _map.Width, height = _map.Height, tool = _tool, grid = _map.GridSize });
        }
        else
        {
            // Every render: the shape nodes were just replaced, so the handles have to be drawn over
            // the new ones and the tool/grid the module caches may have changed under it.
            await _module.InvokeVoidAsync("sync",
                new { width = _map.Width, height = _map.Height, tool = _tool, grid = _map.GridSize });
        }
    }

    private async Task InvokeModuleAsync(string method, params object?[] args)
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync(method, args);
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away mid-call; there is no canvas left to talk to.
        }
    }

    // --- callbacks from the editor module ---
    //
    // Every one of these can land after the editor has moved on: a gesture finishing while the admin
    // navigates back to the list leaves the call in flight with no map behind it. They all check, so
    // a late callback is a no-op rather than a NullReferenceException that takes the circuit down.

    [JSInvokable]
    public async Task OnShapeDrawn(double x, double y, double width, double height)
    {
        if (_map is not { } map)
        {
            return;
        }

        _error = _info = null;
        var result = await Maps.AddShapeAsync(map.Id, _drawKind, new MapRect(x, y, width, height, 0), null);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
        }
        else
        {
            // Selected straight away: the next thing anyone does with a fresh rectangle is name it
            // or repeat it into a row, and both live in the panel that selection opens.
            _selected.Clear();
            foreach (var shape in result.Shapes)
            {
                _selected.Add(shape.Id);
            }

            Remember(UndoStep.ForCreated(result.Shapes.Select(sh => sh.Id).ToList()));
        }

        await ReloadAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnShapesMoved(ShapeGeometryUpdate[] updates)
    {
        if (_map is not { } map)
        {
            return;
        }

        // Captured before the write: this is what undo puts back, and it is the only moment the old
        // geometry still exists anywhere.
        var previous = GeometryOf(updates.Select(u => u.ShapeId));

        var result = await Maps.MoveShapesAsync(map.Id, updates);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
            // The browser is showing a position the server refused; only a re-read tells the truth.
            await ReloadAsync();
            StateHasChanged();
            return;
        }

        if (previous.Count > 0)
        {
            Remember(UndoStep.ForMoved(previous));
        }

        // Patched in place rather than re-read: a drag on a five-hundred-shape plan would otherwise
        // re-query and re-render the whole drawing every time a rectangle is nudged. The values come
        // from the service, so this still shows what was stored — clamping included — not what the
        // browser proposed.
        ApplyGeometry(result.Stored);
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnSelectionChanged(Guid[] ids)
    {
        _selected.Clear();
        foreach (var id in ids)
        {
            _selected.Add(id);
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Deletes what is selected. The module deliberately sends no ids: the selection exists both as
    /// classes in the DOM and as <see cref="_selected"/> here, and reading it from the DOM at keypress
    /// time can catch nodes Blazor is part-way through re-rendering. Circuit messages arrive in
    /// order, so this copy is the selection as it stood when the key went down.
    /// </summary>
    [JSInvokable]
    public async Task OnDeleteRequested()
    {
        await DeleteShapesAsync(_selected.ToArray());
    }

    [JSInvokable]
    public async Task OnUndoRequested()
    {
        await UndoAsync();
    }

    /// <summary>Duplicates what is selected. Takes its ids from the server's copy, like the delete above.</summary>
    [JSInvokable]
    public async Task OnDuplicateRequested()
    {
        await DuplicateAsync(_selected.ToArray());
    }

    // --- undo ---
    //
    // Bounded and in-memory: it is the tracing session's safety net, not a document history. It
    // covers the three things that lose work — a drag, a shape or row appearing, and a deletion —
    // because those are the ones that take a plan apart faster than they can be put back by hand.
    // Editing a label or a link is one visible field on one shape and is left out on purpose.

    private const int MaxUndoSteps = 50;

    private readonly List<UndoStep> _undo = [];

    /// <summary>Which map the history belongs to, so opening another one starts a fresh one.</summary>
    private Guid _undoMapId;

    private sealed record UndoStep(
        IReadOnlyList<ShapeGeometryUpdate> Geometry,
        IReadOnlyList<Guid> Created,
        IReadOnlyList<MapShapeRestore> Deleted,
        IReadOnlyList<MapShapeLabel> Labels)
    {
        public static UndoStep ForMoved(IReadOnlyList<ShapeGeometryUpdate> previous) => new(previous, [], [], []);

        public static UndoStep ForCreated(IReadOnlyList<Guid> ids) => new([], ids, [], []);

        public static UndoStep ForDeleted(IReadOnlyList<MapShapeRestore> shapes) => new([], [], shapes, []);

        /// <summary>A bulk relabelling. One shape's label is a visible field; a whole row's is work.</summary>
        public static UndoStep ForRelabelled(IReadOnlyList<MapShapeLabel> previous) => new([], [], [], previous);
    }

    private void Remember(UndoStep step)
    {
        _undo.Add(step);
        if (_undo.Count > MaxUndoSteps)
        {
            _undo.RemoveAt(0);
        }
    }

    private async Task UndoAsync()
    {
        if (_map is not { } map || _undo.Count == 0)
        {
            return;
        }

        _error = _info = null;
        var step = _undo[^1];
        _undo.RemoveAt(_undo.Count - 1);

        if (step.Geometry.Count > 0)
        {
            var result = await Maps.MoveShapesAsync(map.Id, step.Geometry);
            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault();
            }
        }

        if (step.Created.Count > 0)
        {
            var result = await Maps.DeleteShapesAsync(map.Id, step.Created);
            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault();
            }
        }

        if (step.Deleted.Count > 0)
        {
            var result = await Maps.RestoreShapesAsync(map.Id, step.Deleted);
            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault();
            }
        }

        if (step.Labels.Count > 0)
        {
            var result = await Maps.SetLabelsAsync(map.Id, step.Labels);
            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault();
            }
        }

        _selected.Clear();
        await ReloadAsync();
        await InvokeModuleAsync("select", Array.Empty<Guid>());
        StateHasChanged();
    }

    /// <summary>The geometry the named shapes have right now — the "before" an undo step restores.</summary>
    private List<ShapeGeometryUpdate> GeometryOf(IEnumerable<Guid> ids)
    {
        if (_map is not { } map)
        {
            return [];
        }

        var wanted = ids.ToHashSet();
        return map.Shapes
            .Where(s => wanted.Contains(s.Id))
            .Select(s => new ShapeGeometryUpdate(s.Id, s.X, s.Y, s.Width, s.Height, s.Rotation))
            .ToList();
    }

    /// <summary>
    /// Rewrites the geometry of the named shapes on the in-memory board. Cheaper than a re-read and
    /// exact, because the values are the ones the service just stored.
    /// </summary>
    private void ApplyGeometry(IReadOnlyList<ShapeGeometryUpdate> stored)
    {
        if (_map is not { } map || stored.Count == 0)
        {
            return;
        }

        var byId = stored.ToDictionary(s => s.ShapeId);
        var shapes = map.Shapes
            .Select(s => byId.TryGetValue(s.Id, out var moved)
                ? s with { X = moved.X, Y = moved.Y, Width = moved.Width, Height = moved.Height, Rotation = moved.Rotation }
                : s)
            .ToList();
        _map = map with { Shapes = shapes };
    }

