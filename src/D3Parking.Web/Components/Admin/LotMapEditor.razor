    private async Task DeleteMapAsync(Guid id)
    {
        _error = _info = null;

        // The only irreversible action in the editor: the shapes go with the map by cascade and undo
        // does not reach across a deleted drawing. Everything else is a keystroke away from coming
        // back, so this is the one place worth interrupting for.
        var summary = _maps.FirstOrDefault(m => m.Id == id);
        if (summary is { ShapeCount: > 0 })
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                string.Format(L["Map_DeleteConfirm"], summary.Name, summary.ShapeCount));
            if (!confirmed)
            {
                return;
            }
        }

        var result = await Maps.DeleteAsync(id);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
        }

        await ReloadAsync();
    }

