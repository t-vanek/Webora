    private string RowPreview(MapShapeDto shape)
    {
        var expansion = MapRowPlan.Expand(shape.Rect, shape.Label, _rowCount, _rowGap, _rowDirection, _rowStep);
        if (!expansion.Succeeded)
        {
            return L[expansion.ErrorKey!];
        }

        var labels = expansion.Shapes.Select(s => s.Label).Where(l => !string.IsNullOrEmpty(l)).ToList();
        return labels.Count == 0
            ? L["Map_RowNoLabels"]
            : string.Format(L["Map_RowPreview"], expansion.Shapes.Count - 1, Sample(labels!));
    }

    private async Task AddRowAsync(MapShapeDto shape)
    {
        _error = _info = null;
        var result = await Maps.AddRowAsync(
            _map!.Id, new MapRowRequest(shape.Id, _rowCount, _rowGap, _rowDirection, _rowStep));
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
            return;
        }

        _info = string.Format(L["Map_RowCreated"], result.Shapes.Count);
        Remember(UndoStep.ForCreated(result.Shapes.Select(sh => sh.Id).ToList()));
        // Selecting the last of the new row leaves the tool aimed at continuing it, which is what
        // tracing a plan actually looks like: draw one, repeat, move on to the next row.
        _selected.Clear();
        if (result.Shapes.Count > 0)
        {
            _selected.Add(result.Shapes[^1].Id);
        }

        await ReloadAsync();
        await InvokeModuleAsync("select", _selected.ToArray());
    }

    private async Task FindAsync()
    {
        if (_map is not { } map)
        {
            return;
        }

        var term = _find?.Trim();
        if (string.IsNullOrEmpty(term))
        {
            return;
        }

        // Exact match first, then anything containing the term: typing "43" while looking for 43
        // should land on 43 rather than on the first of 430–439.
        var hits = map.Shapes
            .Where(sh => string.Equals(sh.Label, term, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (hits.Count == 0)
        {
            hits = map.Shapes
                .Where(sh => sh.Label is not null && sh.Label.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        if (hits.Count == 0)
        {
            _info = string.Format(L["Map_FindNothing"], term);
            return;
        }

        _info = null;
        _selected.Clear();
        foreach (var shape in hits)
        {
            _selected.Add(shape.Id);
        }

        var ids = _selected.ToArray();
        await InvokeModuleAsync("select", ids);
        await InvokeModuleAsync("reveal", ids);
        StateHasChanged();
    }

    private async Task FindLabelAsync(string label)
    {
        _find = label;
        await FindAsync();
    }

    private async Task AlignAsync(MapAlignment mode)
    {
        if (_map is not { } map || _selected.Count < 2)
        {
            return;
        }

        var selected = map.Shapes.Where(sh => _selected.Contains(sh.Id)).ToList();
        var moved = MapAlign.Apply(selected, sh => sh.Rect, mode);
        if (moved.Count == 0)
        {
            return;
        }

        // Down the same path a drag takes: MoveShapesAsync clamps, stores and hands back the result,
        // and OnShapesMoved records the undo step. Alignment needs none of that a second time.
        await OnShapesMoved(moved
            .Select(m => new ShapeGeometryUpdate(m.Shape.Id, m.Rect.X, m.Rect.Y, m.Rect.Width, m.Rect.Height, m.Rect.Rotation))
            .ToArray());
    }

    private async Task SetKindAsync()
    {
        if (_map is not { } map || _selected.Count == 0)
        {
            return;
        }

        _error = _info = null;
        var result = await Maps.SetKindAsync(map.Id, _selected.ToArray(), _bulkKind);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
            return;
        }

        _info = result.Unlinked > 0
            ? string.Format(L["Map_BulkKindDoneUnlinked"], result.Changed, result.Unlinked)
            : string.Format(L["Map_BulkKindDone"], result.Changed);
        await ReloadAsync();
    }

    private Task DuplicateSelectedAsync() => DuplicateAsync(_selected.ToArray());

    private async Task DuplicateAsync(Guid[] ids)
    {
        if (_map is not { } map || ids.Length == 0)
        {
            return;
        }

        _error = _info = null;
        var result = await Maps.DuplicateShapesAsync(map.Id, ids);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
            return;
        }

        // The copies become the selection: they are what gets dragged into place next, and leaving
        // the originals selected would move the wrong row.
        _selected.Clear();
        foreach (var shape in result.Shapes)
        {
            _selected.Add(shape.Id);
        }

        Remember(UndoStep.ForCreated(result.Shapes.Select(sh => sh.Id).ToList()));
        await ReloadAsync();
        await InvokeModuleAsync("select", _selected.ToArray());
        StateHasChanged();
    }

    private async Task RenumberAsync()
    {
        if (_map is not { } map || _selected.Count == 0)
        {
            return;
        }

        _error = _info = null;
        // Captured first: after the write there is no record of what the row used to be called.
        var previous = map.Shapes
            .Where(sh => _selected.Contains(sh.Id))
            .Select(sh => new MapShapeLabel(sh.Id, sh.Label))
            .ToList();

        var result = await Maps.RenumberShapesAsync(
            map.Id, _selected.ToArray(), _renumberFrom, _renumberStep, _renumberReverse);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
            return;
        }

        Remember(UndoStep.ForRelabelled(previous));
        _info = result.Labels.Count == 0
            ? L["Map_RenumberNothing"]
            : string.Format(L["Map_RenumberDone"], result.Labels.Count, Sample(result.Labels));
        await ReloadAsync();
    }

    private async Task MatchBackgroundAsync()
    {
        if (_map is not { } map || _module is null)
        {
            return;
        }

        _error = _info = null;
        var url = $"/api/parking/maps/{map.Id}/background?v={_backgroundVersion}";
        MeasuredImage? measured;
        try
        {
            measured = await _module.InvokeAsync<MeasuredImage>("measureImage", url);
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        if (measured is not { Width: > 0, Height: > 0 })
        {
            _error = "Map_Error_BackgroundSizeUnknown";
            return;
        }

        var result = await Maps.MatchToBackgroundAsync(map.Id, measured.Width, measured.Height);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
            return;
        }

        await ReloadAsync();
        // The coordinate space changed under the module, so its view has to be rebuilt around it.
        await InvokeModuleAsync("sync", new { width = _map!.Width, height = _map.Height, tool = _tool, grid = _map.GridSize });
        _info = string.Format(L["Map_MatchBackgroundDone"], _map.Width, _map.Height);
    }

    /// <summary>The underlay's natural pixel size, as the browser reports it.</summary>
    private sealed record MeasuredImage(int Width, int Height);

    private Task DeleteSelectedAsync() => DeleteShapesAsync(_selected.ToArray());

    private async Task DeleteShapesAsync(Guid[] ids)
    {
        if (_map is not { } map || ids.Length == 0)
        {
            return;
        }

        _error = _info = null;
        // Snapshotted before the delete: after it, the only copy of those rectangles is this list.
        var wanted = ids.ToHashSet();
        var removed = map.Shapes
            .Where(s => wanted.Contains(s.Id))
            .Select(s => new MapShapeRestore(s.Kind, s.Rect, s.Label, s.ParkingSpotId))
            .ToList();

        var result = await Maps.DeleteShapesAsync(map.Id, ids);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
        }
        else if (removed.Count > 0)
        {
            Remember(UndoStep.ForDeleted(removed));
        }

        _selected.Clear();
        await ReloadAsync();
        StateHasChanged();
    }

    private async Task AutoLinkAsync()
    {
        _error = _info = null;
        _autoLink = await Maps.AutoLinkAsync(_map!.Id);
        await ReloadAsync();
    }

    private async Task CreateSpotsAsync()
    {
        _error = _info = null;
        var result = await Maps.CreateSpotsFromShapesAsync(_map!.Id, _selected.ToArray(), _bulkType);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
            return;
        }

        _info = string.Format(L["Map_SpotsCreated"], result.CreatedCount, result.LinkedToExisting.Count, result.UnlabelledCount);
        if (result.TooLongLabels.Count > 0)
        {
            _info += " " + string.Format(L["Map_SpotsTooLong"], result.TooLongLabels.Count, Sample(result.TooLongLabels));
        }

        _spots = await Spots.ListAsync();
        await ReloadAsync();
    }

    private async Task OnBackgroundSelectedAsync(InputFileChangeEventArgs e)
    {
        _error = _info = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: LotMap.MaxBackgroundBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var result = await Maps.SetBackgroundAsync(_map!.Id, buffer.ToArray());
            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault();
                return;
            }

            _backgroundVersion++;
            await ReloadAsync();
        }
        catch (IOException)
        {
            // Thrown by OpenReadStream when the file is over the cap — the size limit, not a disk error.
            _error = "Map_Error_BackgroundTooLarge";
        }
    }

    private async Task OnSvgSelectedAsync(InputFileChangeEventArgs e)
    {
        if (_map is not { } map)
        {
            return;
        }

        _error = _info = null;
        _svgReport = null;
        string svg;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: MaxSvgBytes);
            using var reader = new StreamReader(stream);
            svg = await reader.ReadToEndAsync();
        }
        catch (IOException)
        {
            // OpenReadStream throws this when the file is over the cap — the size limit, not a disk error.
            _error = "Map_Error_SvgTooLarge";
            return;
        }

        var result = await Maps.ImportSvgAsync(map.Id, svg, _svgKind);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
            return;
        }

        _svgReport = result;
        // One step back: an import lays down hundreds of shapes, and finding out it landed wrong
        // should not mean deleting them by hand.
        Remember(UndoStep.ForCreated(result.CreatedIds));
        await ReloadAsync();
        await InvokeModuleAsync("sync", new { width = _map!.Width, height = _map.Height, tool = _tool, grid = _map.GridSize });
    }

    /// <summary>Upper bound on an imported plan. A site plan of five hundred stalls is well under a megabyte.</summary>
    private const int MaxSvgBytes = 16 * 1024 * 1024;

    private async Task ClearBackgroundAsync()
    {
        _error = _info = null;
        var result = await Maps.ClearBackgroundAsync(_map!.Id);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
        }

        _backgroundVersion++;
        await ReloadAsync();
    }

    private async Task ExportAsync()
    {
        _exported = await Maps.ExportAsync(_map!.Id);
    }

    private async Task ImportAsync()
    {
        _error = _info = null;
        var result = await Maps.ImportAsync(_importName ?? string.Empty, _importJson ?? string.Empty);
        if (!result.Succeeded)
        {
            _error = result.Errors.FirstOrDefault();
            return;
        }

        _importJson = _importName = null;
        await ReloadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await InvokeModuleAsync("detach");
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already torn down — the module went with it.
            }
        }

        _selfRef?.Dispose();
    }
}
