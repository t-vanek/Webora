@* The lot drawn as itself, read-only.

   Shared on purpose: the manager's board and (later) the driver's booking screen ask the same
   question of the same drawing — "what is each stall doing today" — and differ only in what a click
   means and which states they colour. Everything specific to either is a parameter.

   The traced-over underlay is deliberately not drawn here. It is a scan of somebody's site plan at
   whatever quality it arrived in; the shapes are the answer it was traced into. *@
@using System.Globalization
@using D3Parking.Application.Parking.Maps
@using D3Parking.Domain.Parking.Maps
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="map-view">
    <div class="map-view__tools">
        <FluentButton Appearance="Appearance.Outline" OnClick="() => ZoomAsync(1.4)" aria-label="@ZoomInLabel">＋</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="() => ZoomAsync(0.7)" aria-label="@ZoomOutLabel">－</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="ResetViewAsync">@FitLabel</FluentButton>
    </div>

    @* role="group" rather than "application": nothing here is a custom widget, it is a set of
       buttons laid out in space, and a screen reader should treat them as such. *@
    <svg class="map-view__canvas" @ref="_canvasRef"
         viewBox="@($"0 0 {Map.Width} {Map.Height}")"
         role="group" aria-label="@AriaLabel">
        @foreach (var shape in Map.Shapes)
        {
            var spotId = shape.ParkingSpotId;
            var state = spotId is { } id ? StateOf(id) : null;

            @if (state is null)
            {
                @* Context: a building, a lane, or a stall that is not ours. Drawn so the ones that
                   are ours can be found — a row of boxes floating in nothing tells a driver nothing
                   about where to walk. Never focusable, never clickable. *@
                <g class="map-view__shape map-view__shape--@shape.Kind" @key="shape.Id" aria-hidden="true">
                    <polygon points="@shape.Rect.ToSvgPoints()" />
                    @if (!string.IsNullOrEmpty(shape.Label))
                    {
                        <SvgLabel X="@Inv(shape.Rect.CentreX)" Y="@Inv(shape.Rect.CentreY)"
                                  Transform="@RotateAbout(shape)" Text="@shape.Label" />
                    }
                </g>
            }
            else
            {
                <g class="map-view__shape map-view__shape--spot map-view__state--@state @(Selected == spotId ? "is-selected" : null)"
                   @key="shape.Id"
                   data-spot="@spotId"
                   role="button" tabindex="0"
                   aria-pressed="@(Selected == spotId ? "true" : "false")"
                   @onclick="() => OnSpotSelected.InvokeAsync(spotId!.Value)"
                   @onkeydown="e => OnKeyAsync(e, spotId!.Value)">
                    @* The accessible name and the hover tooltip in one: an SVG <title> is both. *@
                    <title>@TitleOf(spotId!.Value)</title>
                    <polygon points="@shape.Rect.ToSvgPoints()" />
                    @if (!string.IsNullOrEmpty(shape.Label))
                    {
                        <SvgLabel X="@Inv(shape.Rect.CentreX)" Y="@Inv(shape.Rect.CentreY)"
                                  Transform="@RotateAbout(shape)" Text="@shape.Label" />
                    }
                </g>
            }
        }
    </svg>
</div>

@code {
    [Parameter, EditorRequired]
    public LotMapDetailDto Map { get; set; } = null!;

    /// <summary>
    /// The state class for a spot drawn on this map, or null when the spot is not one this screen
    /// knows about — which is what makes the shape context rather than a control.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<Guid, string?> StateOf { get; set; } = _ => null;

    /// <summary>The accessible name and tooltip for a spot: code, state, whoever is on it.</summary>
    [Parameter, EditorRequired]
    public Func<Guid, string> TitleOf { get; set; } = _ => string.Empty;

    [Parameter]
    public Guid? Selected { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSpotSelected { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? ZoomInLabel { get; set; }

    [Parameter]
    public string? ZoomOutLabel { get; set; }

    [Parameter]
    public string? FitLabel { get; set; }

    private ElementReference _canvasRef;
    private IJSObjectReference? _module;
    private Guid _attachedTo;

    private static string Inv(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string? RotateAbout(MapShapeDto shape) =>
        shape.Rotation == 0
            ? null
            : $"rotate({Inv(shape.Rotation)} {Inv(shape.Rect.CentreX)} {Inv(shape.Rect.CentreY)})";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Read-only mode of the editor's module: it brings wheel zoom and drag-to-pan and leaves
        // every editing gesture switched off. Clicking a stall is an ordinary Blazor click on the
        // element, not a gesture, so nothing has to be routed back through JS.
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/lot-map-editor.js");
        if (_attachedTo == Map.Id)
        {
            return;
        }

        _attachedTo = Map.Id;
        await _module.InvokeVoidAsync("attach", _canvasRef, null,
            new { width = Map.Width, height = Map.Height, readOnly = true });
    }

    private async Task OnKeyAsync(KeyboardEventArgs e, Guid spotId)
    {
        // Enter and Space are what a role="button" promises; without them the tab stops above are a
        // cruel joke.
        if (e.Key is "Enter" or " ")
        {
            await OnSpotSelected.InvokeAsync(spotId);
        }
    }

    private Task ZoomAsync(double factor) => InvokeModuleAsync("zoom", factor);

    private Task ResetViewAsync() => InvokeModuleAsync("resetView");

    private async Task InvokeModuleAsync(string method, params object?[] args)
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync(method, args);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; so is the canvas this was talking to.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        await InvokeModuleAsync("detach");
        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already torn down — the module went with it.
        }
    }
}
