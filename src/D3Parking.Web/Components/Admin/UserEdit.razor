@page "/admin/users/{Id:guid}"
@attribute [HasPermission(Permissions.Users.View)]
@rendermode InteractiveServer
@inject IUserAdminService UserAdmin
@inject IRoleAdminService RoleAdmin
@inject IAccountService AccountService
@inject IUserLocationService UserLocation
@inject UserManager<ApplicationUser> UserManager
@inject ISiteSettingsService SiteSettings
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Admin_UserEdit_Title"]</PageTitle>

<FluentStack Class="page-shell user-detail-page" Orientation="Orientation.Vertical" VerticalGap="16">
    <div class="user-detail-nav">
        <FluentAnchor Href="admin/users" Appearance="Appearance.Hypertext">
            <FluentIcon Value="@(new Icons.Regular.Size20.ArrowLeft())" />
            <span>@L["Admin_Users_Title"]</span>
        </FluentAnchor>
    </div>

    @if (_detail is null)
    {
        @if (_loaded)
        {
            <FluentLabel Typo="Typography.Body">@L["Admin_Users_NotFound"]</FluentLabel>
        }
        else
        {
            <div class="loading"><FluentProgressRing /></div>
        }
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar">@_message</FluentMessageBar>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@_error</FluentMessageBar>
        }

        <section class="user-detail-hero" aria-label="@L["Admin_UserEdit_Identity"]">
            <div class="profile-avatar">@Initials()</div>
            <div class="user-detail-hero__identity">
                <span class="user-detail-hero__eyebrow">@L["Admin_UserEdit_Title"]</span>
                <h1>@(string.IsNullOrWhiteSpace(_detail.DisplayName) ? _detail.Email : _detail.DisplayName)</h1>
                <span>@_detail.Email</span>
            </div>
            <div class="user-detail-hero__facts">
                <StatusBadge Status="_detail.Status" />
                <span class="user-source-pill">@(_detail.IsFederated ? _detail.ExternalProvider : L["Admin_Users_Source_Local"])</span>
                @if (!_detail.EmailConfirmed)
                {
                    <span class="user-warning-pill">@L["Admin_Users_EmailUnconfirmed"]</span>
                }
            </div>
        </section>

        <nav class="user-detail-tabs" aria-label="@L["Admin_UserEdit_Tabs"]">
            @DetailTabButton(OverviewTab, L["Admin_UserEdit_TabOverview"])
            @DetailTabButton(AccessTab, L["Admin_UserEdit_TabAccess"])
            @DetailTabButton(ActivityTab, L["Admin_UserEdit_TabActivity"], _auditTotal)
        </nav>

        @if (_activeTab == OverviewTab)
        {
            <div class="user-detail-overview">
                <section class="admin-panel user-detail-section">
                    <div class="user-detail-section__head">
                        <div>
                            <h2>@L["Admin_UserEdit_Identity"]</h2>
                            <p>@L["Admin_UserEdit_IdentityHint"]</p>
                        </div>
                    </div>
                    <dl class="user-facts-grid">
                        @DetailFact(L["Admin_Users_Name"], string.IsNullOrWhiteSpace(_detail.DisplayName) ? "—" : _detail.DisplayName)
                        @DetailFact(L["Admin_Users_Email"], _detail.Email)
                        @DetailFact(L["Admin_Users_Phone"], _detail.PhoneNumber ?? "—")
                        @DetailFact(L["Admin_UserEdit_EmailState"], _detail.EmailConfirmed ? L["Admin_Users_EmailConfirmed"] : L["Admin_Users_EmailUnconfirmed"])
                        @DetailFact(L["Admin_UserEdit_Source"], _detail.IsFederated ? _detail.ExternalProvider! : L["Admin_Users_Source_Local"])
                        @DetailFact(L["Admin_UserEdit_StatusChanged"], _detail.StatusChangedAtUtc is { } changed ? Fmt(changed) : "—")
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_detail.StatusReason))
                    {
                        <div class="user-detail-reason"><strong>@L["Admin_UserEdit_StatusReason"]</strong><span>@_detail.StatusReason</span></div>
                    }
                </section>

                <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.VerifyResidency)" Context="commute">
                    <section class="admin-panel user-detail-section">
                        <div class="user-detail-section__head">
                            <div>
                                <h2>@L["Admin_UserEdit_Commute"]</h2>
                                <p>@L["Admin_UserEdit_CommuteHint"]</p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_home.Address))
                            {
                                <FluentBadge Appearance="Appearance.Accent" Fill="@(_home.Verified ? "success" : "warning")">
                                    @(_home.Verified ? L["Admin_UserEdit_HomeVerified"] : L["Admin_UserEdit_HomeUnverified"])
                                </FluentBadge>
                            }
                        </div>
                        <div class="user-commute-value">
                            <strong>@(string.IsNullOrWhiteSpace(_home.Address) ? L["Admin_UserEdit_NoHome"] : _home.Address)</strong>
                            @if (_home.DistanceKm is { } km)
                            {
                                <span>@L["Admin_UserEdit_Distance", km.ToString("0.0")]</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_home.Address))
                        {
                            <FluentButton OnClick="() => SetVerifiedAsync(!_home.Verified)" Appearance="Appearance.Outline">
                                @(_home.Verified ? L["Admin_UserEdit_HomeUnverify"] : L["Admin_UserEdit_HomeVerify"])
                            </FluentButton>
                        }
                    </section>
                </AuthorizeView>
            </div>
        }
        else if (_activeTab == AccessTab)
        {
            <div class="user-access-layout">
                <section class="admin-panel user-detail-section user-roles-section">
                    <div class="user-detail-section__head">
                        <div>
                            <h2>@L["Admin_UserEdit_Roles"]</h2>
                            <p>@L["Admin_UserEdit_RolesHint"]</p>
                        </div>
                        @if (HasRoleChanges)
                        {
                            <span class="user-unsaved-pill">@L["Admin_UserEdit_Unsaved"]</span>
                        }
                    </div>
                    <div class="user-role-grid">
                        @foreach (var role in _allRoles)
                        {
                            <label class="user-role-option @(_selectedRoles.Contains(role) ? "is-selected" : null)">
                                <FluentCheckbox Label="@RoleName(role)"
                                                Value="@_selectedRoles.Contains(role)"
                                                ValueChanged="@(selected => ToggleRole(role, selected))"
                                                Disabled="@(!_canAssignRoles || IsPinned(role))" />
                            </label>
                        }
                    </div>
                    @if (_detail.IsFederated)
                    {
                        <FluentMessageBar Intent="MessageIntent.Info" Type="MessageType.MessageBar" AllowDismiss="false">
                            @L["Admin_UserEdit_FederatedRoles", _detail.ExternalProvider!]
                        </FluentMessageBar>
                    }
                    @if (_detail.IsLastAdministrator)
                    {
                        <FluentMessageBar Intent="MessageIntent.Info" Type="MessageType.MessageBar" AllowDismiss="false">
                            @L["Admin_UserEdit_LastAdministrator"]
                        </FluentMessageBar>
                    }
                    @if (_canAssignRoles)
                    {
                        <div class="user-detail-actions">
                            <FluentButton OnClick="SaveRolesAsync" Appearance="Appearance.Accent" Disabled="@(!HasRoleChanges)">@L["Admin_Save"]</FluentButton>
                            @if (HasRoleChanges)
                            {
                                <FluentButton OnClick="ResetRoles" Appearance="Appearance.Outline">@L["Admin_Cancel"]</FluentButton>
                            }
                        </div>
                    }
                </section>

                <div class="user-access-side">
                    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Users.Edit)" Context="status">
                        <section class="admin-panel user-detail-section">
                            <div class="user-detail-section__head">
                                <div><h2>@L["Admin_UserEdit_StatusActions"]</h2><p>@L["Admin_UserEdit_StatusHint"]</p></div>
                                <StatusBadge Status="_detail.Status" />
                            </div>
                            @if (_isSelf)
                            {
                                <p class="user-detail-note">@L["Admin_UserEdit_SelfNoStatus"]</p>
                            }
                            else if (_detail.Status == AccountStatus.Blocked)
                            {
                                <FluentButton OnClick="UnblockAsync" Appearance="Appearance.Accent">@L["Admin_UserEdit_Unblock"]</FluentButton>
                            }
                            else
                            {
                                <FluentTextField @bind-Value="_blockReason" Placeholder="@L["Admin_UserEdit_BlockReason"]"
                                                 Style="width:100%" Maxlength="512" />
                                <FluentButton OnClick="BlockAsync" Appearance="Appearance.Outline" Class="user-danger-button">
                                    @L["Admin_UserEdit_Block"]
                                </FluentButton>
                            }
                        </section>
                    </AuthorizeView>

                    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Users.Delete)" Context="delete">
                        @if (!_isSelf)
                        {
                            <section class="danger-zone user-delete-zone">
                                <div class="danger-zone__title">@L["Admin_UserEdit_DangerZone"]</div>
                                <p class="danger-zone__note">@L["Admin_UserEdit_DangerHint"]</p>
                                @if (_confirmDelete)
                                {
                                    <div class="user-delete-confirm">
                                        <div class="user-delete-confirm__head">
                                            <strong>@L["Admin_UserEdit_DeleteConfirm"]</strong>
                                            <span>@L["Admin_UserEdit_DeleteImpactIntro"]</span>
                                        </div>
                                        @if (_deletionImpact is { } impact)
                                        {
                                            <div class="user-delete-impact">
                                                @DeleteImpactFact(L["Admin_UserEdit_DeleteSpots"], impact.OwnedSpots)
                                                @DeleteImpactFact(L["Admin_UserEdit_DeleteVehicles"], impact.PairedVehicles)
                                                @DeleteImpactFact(L["Admin_UserEdit_DeleteReservations"], impact.ActiveReservations)
                                                @DeleteImpactFact(L["Admin_UserEdit_DeleteQueue"], impact.ActiveQueueEntries)
                                                @DeleteImpactFact(L["Admin_UserEdit_DeleteVisitors"], impact.UpcomingVisitorBookings)
                                                @DeleteImpactFact(L["Admin_UserEdit_DeleteMessages"], impact.PersonalMessages)
                                                @DeleteImpactFact(L["Admin_UserEdit_DeleteCases"], impact.AssignedOversightCases)
                                            </div>
                                            <div class="user-delete-history">
                                                <FluentIcon Value="@(new Icons.Regular.Size20.ShieldCheckmark())" />
                                                <span>@L["Admin_UserEdit_DeleteHistory", impact.HistoricalRecords]</span>
                                            </div>
                                        }
                                        <FluentTextField @bind-Value="_deleteConfirmation"
                                                         Label="@L["Admin_UserEdit_DeleteTypeEmail", _detail.Email]"
                                                         AutoComplete="off" Style="width:100%" />
                                        <div class="user-detail-actions">
                                            <FluentButton OnClick="DeleteAsync" Appearance="Appearance.Accent"
                                                          Disabled="@(!DeleteConfirmed || _deleteBusy)">@L["Admin_UserEdit_DeleteYes"]</FluentButton>
                                            <FluentButton OnClick="CloseDelete" Appearance="Appearance.Outline" Disabled="@_deleteBusy">@L["Admin_Cancel"]</FluentButton>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <FluentButton OnClick="OpenDeleteAsync" Appearance="Appearance.Outline"
                                                  Disabled="@_deleteBusy">@L["Admin_UserEdit_Delete"]</FluentButton>
                                }
                            </section>
                        }
                    </AuthorizeView>
                </div>
            </div>
        }
        else
        {
            <section class="user-activity-section">
                <div class="user-detail-section__head">
                    <div><h2>@L["Admin_UserEdit_Audit"]</h2><p>@L["Admin_UserEdit_AuditHint"]</p></div>
                    @if (_auditTotal > 0) { <span class="count-chip">@_auditTotal</span> }
                </div>
                @if (_audit.Count == 0)
                {
                    <div class="empty-state">@L["Admin_UserEdit_NoAudit"]</div>
                }
                else
                {
                    <div class="admin-panel user-audit-table-wrap">
                        <table class="user-audit-table">
                            <thead><tr><th>@L["Admin_UserEdit_AuditWhen"]</th><th>@L["Admin_UserEdit_AuditEvent"]</th><th>@L["Admin_UserEdit_AuditActor"]</th><th>@L["Admin_UserEdit_AuditDetail"]</th></tr></thead>
                            <tbody>
                                @foreach (var entry in _audit)
                                {
                                    <tr><td>@Fmt(entry.OccurredAtUtc)</td><td><strong>@L[$"Audit_Type_{entry.Type}"]</strong></td><td>@ActorLabel(entry.Actor)</td><td>@(entry.Detail ?? "—")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_auditTotal > AuditPageSize)
                    {
                        <div class="pager">
                            <FluentButton Appearance="Appearance.Outline" Disabled="@(_auditPageIndex == 0)" OnClick="() => GoToAuditPageAsync(_auditPageIndex - 1)">@L["Common_PrevPage"]</FluentButton>
                            <span>@L["Common_PageOf", _auditPageIndex + 1, AuditPageCount]</span>
                            <FluentButton Appearance="Appearance.Outline" Disabled="@(_auditPageIndex >= AuditPageCount - 1)" OnClick="() => GoToAuditPageAsync(_auditPageIndex + 1)">@L["Common_NextPage"]</FluentButton>
                        </div>
                    }
                }
            </section>
        }
    }
</FluentStack>

@code {
    private const string OverviewTab = "overview";
    private const string AccessTab = "access";
    private const string ActivityTab = "activity";

    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private UserDetail? _detail;
    private bool _loaded;
    private Guid _adminId;
    private bool _isSelf;
    private bool _canAssignRoles;
    private IReadOnlyList<string> _allRoles = [];
    private HashSet<string> _selectedRoles = new(StringComparer.Ordinal);
    // Paged in SQL. The unpaged read had no ceiling at all: every sign-in this account has ever
    // recorded came back, and the grid drew all of them on a screen whose subject is the account,
    // not its history.
    private const int AuditPageSize = 20;
    private IReadOnlyList<AccountAuditEntry> _audit = [];
    private int _auditPageIndex;
    private int _auditTotal;

    private int AuditPageCount => _auditTotal == 0 ? 1 : (_auditTotal + AuditPageSize - 1) / AuditPageSize;
    private UserHomeDto _home = new(null, null, false);
    private string? _blockReason;
    private bool _confirmDelete;
    private bool _deleteBusy;
    private string? _deleteConfirmation;
    private EmployeeDeletionImpact? _deletionImpact;
    private string? _message;
    private string? _error;
    private TimeZoneInfo _tz = TimeZoneInfo.Local;
    private string _activeTab = OverviewTab;

    private Guid _loadedId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        _adminId = Guid.TryParse(UserManager.GetUserId(state.User), out var id) ? id : Guid.Empty;
        _canAssignRoles = state.User.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Users.AssignRoles);
        _allRoles = (await RoleAdmin.ListAsync()).Select(r => r.Name).ToArray();
        _tz = await SiteSettings.GetTimeZoneAsync();
    }

    private string RoleName(string role) => AuthorizationDisplay.RoleName(L, role);

    private bool HasRoleChanges => _detail is not null && !_selectedRoles.SetEquals(_detail.Roles);

    /// <summary>
    /// The Administrator role of the last administrator standing cannot be given up — not to
    /// themselves, not by anyone else, and not by swapping it for a different role.
    /// </summary>
    private bool IsPinned(string role) =>
        _detail?.IsLastAdministrator == true && string.Equals(role, Roles.Administrator, StringComparison.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        // The router reuses this component instance when only the route parameter changes.
        // Without reloading, a link from user A's detail to user B would keep A's data on
        // screen while the save/block/delete actions already target B.
        if (_loadedId != Id)
        {
            _loadedId = Id;
            _message = _error = null;
            _confirmDelete = false;
            _deleteConfirmation = null;
            _deletionImpact = null;
            _activeTab = OverviewTab;
            // The trail belongs to the account, so following a link to another one starts at its
            // first page rather than wherever the previous account was being read.
            _auditPageIndex = 0;
            await LoadAsync();
        }
    }

    private string Fmt(DateTimeOffset utc) => TimeZoneInfo.ConvertTime(utc, _tz).ToString("g");

    private string Initials()
    {
        var name = _detail?.DisplayName;
        if (!string.IsNullOrWhiteSpace(name))
        {
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var initials = parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : parts[0][..Math.Min(2, parts[0].Length)];
            return initials.ToUpperInvariant();
        }

        var email = _detail?.Email;
        return string.IsNullOrEmpty(email) ? "?" : email[..1].ToUpperInvariant();
    }

    private async Task LoadAsync()
    {
        _detail = await UserAdmin.GetAsync(Id);
        _loaded = true;
        if (_detail is not null)
        {
            _isSelf = _detail.Id == _adminId;
            _selectedRoles = _detail.Roles.ToHashSet(StringComparer.Ordinal);
            var audit = await AccountService.GetAuditTrailAsync(Id, _auditPageIndex, AuditPageSize);
            _audit = audit.Items;
            _auditTotal = audit.TotalCount;
            _auditPageIndex = audit.PageIndex;
            _home = await UserLocation.GetHomeAsync(Id);
        }
    }

    private async Task GoToAuditPageAsync(int pageIndex)
    {
        _auditPageIndex = Math.Clamp(pageIndex, 0, AuditPageCount - 1);
        await LoadAsync();
    }

    private async Task SetVerifiedAsync(bool verified)
    {
        _message = _error = null;
        var result = await UserLocation.SetHomeVerifiedAsync(Id, verified);
        if (result.Succeeded)
        {
            _message = L["Admin_UserEdit_HomeSaved"];
            await LoadAsync();
        }
        else
        {
            _error = L[result.Errors.FirstOrDefault() ?? string.Empty];
        }
    }

    private void ToggleRole(string role, bool selected)
    {
        if (selected)
        {
            _selectedRoles.Add(role);
        }
        else
        {
            _selectedRoles.Remove(role);
        }
    }

    private void ResetRoles()
    {
        if (_detail is not null)
        {
            _selectedRoles = _detail.Roles.ToHashSet(StringComparer.Ordinal);
        }
    }

    private RenderFragment DetailTabButton(string tab, string label, int? count = null)
    {
        var selected = _activeTab == tab;
        return @<button type="button" class="user-detail-tab @(selected ? "is-active" : null)"
                        aria-pressed="@selected" @onclick="() => _activeTab = tab">
            <span>@label</span>
            @if (count is > 0)
            {
                <strong>@count</strong>
            }
        </button>;
    }

    private RenderFragment DetailFact(string label, string value) => @<div>
        <dt>@label</dt>
        <dd>@value</dd>
    </div>;

    private RenderFragment DeleteImpactFact(string label, int value) => @<div>
        <span>@label</span>
        <strong>@value</strong>
    </div>;

    private bool DeleteConfirmed => _detail is not null
        && string.Equals(_deleteConfirmation?.Trim(), _detail.Email, StringComparison.OrdinalIgnoreCase);

    private string ActorLabel(string actor)
    {
        if (string.Equals(actor, "self", StringComparison.OrdinalIgnoreCase))
        {
            return L["Admin_UserEdit_ActorSelf"];
        }

        return actor.StartsWith("admin:", StringComparison.OrdinalIgnoreCase)
            ? L["Admin_UserEdit_ActorAdmin"]
            : actor;
    }

    private async Task SaveRolesAsync() =>
        await RunAsync(() => UserAdmin.SetRolesAsync(Id, _selectedRoles.ToArray(), _adminId), L["Admin_UserEdit_RolesSaved"]);

    private async Task BlockAsync() =>
        await RunAsync(() => AccountService.BlockAsync(Id, _adminId, string.IsNullOrWhiteSpace(_blockReason) ? null : _blockReason), L["Admin_UserEdit_Blocked"]);

    private async Task UnblockAsync() =>
        await RunAsync(() => AccountService.UnblockAsync(Id, _adminId), L["Admin_UserEdit_Unblocked"]);

    private async Task DeleteAsync()
    {
        if (!DeleteConfirmed)
        {
            return;
        }

        _deleteBusy = true;
        var result = await UserAdmin.DeleteAsync(Id, _adminId);
        if (result.Succeeded)
        {
            Nav.NavigateTo("admin/users");
            return;
        }

        _deleteBusy = false;
        _confirmDelete = false;
        _error = string.Join(" ", result.Errors);
    }

    private async Task OpenDeleteAsync()
    {
        _deleteBusy = true;
        _error = null;
        _deletionImpact = await UserAdmin.GetDeletionImpactAsync(Id);
        _deleteBusy = false;

        if (_deletionImpact is null)
        {
            _error = L["Admin_Users_NotFound"];
            return;
        }

        _deleteConfirmation = null;
        _confirmDelete = true;
    }

    private void CloseDelete()
    {
        _confirmDelete = false;
        _deleteConfirmation = null;
        _deletionImpact = null;
    }

    private async Task RunAsync(Func<Task<AccountResult>> action, string successMessage)
    {
        _message = _error = null;
        var result = await action();
        if (result.Succeeded)
        {
            _message = successMessage;
            await LoadAsync();
        }
        else
        {
            _error = string.Join(" ", result.Errors);
        }
    }
}
