@page "/admin/users/{Id:guid}"
@attribute [HasPermission(Permissions.Users.View)]
@rendermode InteractiveServer
@inject IUserAdminService UserAdmin
@inject IRoleAdminService RoleAdmin
@inject IAccountService AccountService
@inject IUserLocationService UserLocation
@inject UserManager<ApplicationUser> UserManager
@inject ISiteSettingsService SiteSettings
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Admin_UserEdit_Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.PageTitle">@L["Admin_UserEdit_Title"]</FluentLabel>
    <FluentAnchor Href="admin/users" Appearance="Appearance.Hypertext">&laquo; @L["Admin_Users_Title"]</FluentAnchor>

    @if (_detail is null)
    {
        @if (_loaded)
        {
            <FluentLabel Typo="Typography.Body">@L["Admin_Users_NotFound"]</FluentLabel>
        }
        else
        {
            <div class="loading"><FluentProgressRing /></div>
        }
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar">@_message</FluentMessageBar>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@_error</FluentMessageBar>
        }

        <div class="profile-card">
            <div class="profile-avatar">@Initials()</div>
            <div class="profile-meta">
                <span class="profile-name">@(string.IsNullOrWhiteSpace(_detail.DisplayName) ? _detail.Email : _detail.DisplayName)</span>
                <span class="profile-sub">@_detail.Email@(_detail.EmailConfirmed ? "" : $" · {L["Admin_Users_Unconfirmed"]}")</span>
                <div class="profile-facts">
                    <StatusBadge Status="_detail.Status" />
                    <span class="profile-sub">@L["Admin_Users_Phone"]: @(_detail.PhoneNumber ?? "—")</span>
                    @if (_detail.StatusChangedAtUtc is { } changed)
                    {
                        <span class="profile-sub">@Fmt(changed)</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_detail.StatusReason))
                {
                    <span class="profile-sub">@_detail.StatusReason</span>
                }
            </div>
        </div>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Parking.VerifyResidency)" Context="commute">
            <FluentCard Class="profile-section">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                    <FluentLabel Typo="Typography.Subject">@L["Admin_UserEdit_Commute"]</FluentLabel>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
                        <FluentLabel Typo="Typography.Body">
                            @(string.IsNullOrWhiteSpace(_home.Address) ? L["Admin_UserEdit_NoHome"] : _home.Address)
                            @if (_home.DistanceKm is { } km)
                            {
                                <span> · @km.ToString("0.0") km</span>
                            }
                        </FluentLabel>
                        @if (!string.IsNullOrWhiteSpace(_home.Address))
                        {
                            @if (_home.Verified)
                            {
                                <FluentBadge Appearance="Appearance.Accent" Fill="success">@L["Admin_UserEdit_HomeVerified"]</FluentBadge>
                                <FluentButton OnClick="() => SetVerifiedAsync(false)" Appearance="Appearance.Outline">@L["Admin_UserEdit_HomeUnverify"]</FluentButton>
                            }
                            else
                            {
                                <FluentBadge Appearance="Appearance.Accent" Fill="warning">@L["Admin_UserEdit_HomeUnverified"]</FluentBadge>
                                <FluentButton OnClick="() => SetVerifiedAsync(true)" Appearance="Appearance.Accent">@L["Admin_UserEdit_HomeVerify"]</FluentButton>
                            }
                        }
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </AuthorizeView>

        <FluentCard Class="profile-section">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                <FluentLabel Typo="Typography.Subject">@L["Admin_UserEdit_Roles"]</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="16">
                    @foreach (var role in _allRoles)
                    {
                        @* Checkboxes track the permission that saves them. Leaving them live for a
                           reader would invite edits the missing Save button then throws away. *@
                        <FluentCheckbox Label="@RoleName(role)"
                                        Value="@_selectedRoles.Contains(role)"
                                        ValueChanged="@(c => ToggleRole(role, c))"
                                        Disabled="@(!_canAssignRoles || IsPinned(role))" />
                    }
                </FluentStack>
                @if (_detail.IsFederated)
                {
                    @* Roles this account holds because of the directory are taken back on the next
                       sign-in, so a hand edit here is at best temporary. Say which mapping is at
                       work rather than let it look like the save failed. *@
                    <FluentMessageBar Intent="MessageIntent.Info" Type="MessageType.MessageBar" AllowDismiss="false">
                        @L["Admin_UserEdit_FederatedRoles", _detail.ExternalProvider!]
                    </FluentMessageBar>
                }
                @if (_detail.IsLastAdministrator)
                {
                    @* The service refuses to strip the last administrator — including from oneself,
                       and including by swapping the role for another, which is the same removal.
                       Saying so here beats letting someone uncheck it and find out on save. *@
                    <FluentMessageBar Intent="MessageIntent.Info" Type="MessageType.MessageBar" AllowDismiss="false">
                        @L["Admin_UserEdit_LastAdministrator"]
                    </FluentMessageBar>
                }
                @if (_canAssignRoles)
                {
                    <FluentButton OnClick="SaveRolesAsync" Appearance="Appearance.Accent">@L["Admin_Save"]</FluentButton>
                }
            </FluentStack>
        </FluentCard>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Users.Edit)" Context="status">
            <FluentCard Class="profile-section">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                    <FluentLabel Typo="Typography.Subject">@L["Admin_UserEdit_StatusActions"]</FluentLabel>
                    @if (_isSelf)
                    {
                        <FluentLabel Typo="Typography.Body">@L["Admin_UserEdit_SelfNoStatus"]</FluentLabel>
                    }
                    else if (_detail.Status == AccountStatus.Blocked)
                    {
                        <FluentButton OnClick="UnblockAsync" Appearance="Appearance.Accent">@L["Admin_UserEdit_Unblock"]</FluentButton>
                    }
                    else
                    {
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="max-width:480px">
                            @* Maxlength mirrors StatusReason's nvarchar(512): an oversized reason
                               would otherwise throw in the event handler and take the circuit down. *@
                            <FluentTextField @bind-Value="_blockReason"
                                             Placeholder="@L["Admin_UserEdit_BlockReason"]"
                                             Style="flex:1" Maxlength="512" />
                            <FluentButton OnClick="BlockAsync" Appearance="Appearance.Accent" Style="background:var(--error-rest);color:var(--neutral-fill-rest)">
                                @L["Admin_UserEdit_Block"]
                            </FluentButton>
                        </FluentStack>
                    }
                </FluentStack>
            </FluentCard>
        </AuthorizeView>

        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Users.Delete)" Context="delete">
            @if (!_isSelf)
            {
                <div class="danger-zone">
                    <div class="danger-zone__title">@L["Admin_UserEdit_DangerZone"]</div>
                    @if (_confirmDelete)
                    {
                        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="false">
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                <span>@L["Admin_UserEdit_DeleteConfirm"]</span>
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                                    <FluentButton OnClick="DeleteAsync" Appearance="Appearance.Accent">
                                        @L["Admin_UserEdit_DeleteYes"]
                                    </FluentButton>
                                    <FluentButton OnClick="() => _confirmDelete = false" Appearance="Appearance.Outline">
                                        @L["Admin_Cancel"]
                                    </FluentButton>
                                </FluentStack>
                            </FluentStack>
                        </FluentMessageBar>
                    }
                    else
                    {
                        <FluentButton OnClick="() => _confirmDelete = true" Appearance="Appearance.Outline">
                            @L["Admin_UserEdit_Delete"]
                        </FluentButton>
                    }
                </div>
            }
        </AuthorizeView>

        <div class="admin-head__title-row">
            <FluentLabel Typo="Typography.Subject">@L["Admin_UserEdit_Audit"]</FluentLabel>
            @if (_auditTotal > 0)
            {
                <span class="count-chip">@_auditTotal</span>
            }
        </div>
        @if (_audit.Count == 0)
        {
            <div class="empty-state">@L["Admin_UserEdit_NoAudit"]</div>
        }
        else
        {
            <div class="admin-panel">
                <FluentDataGrid Items="@_audit.AsQueryable()" TGridItem="AccountAuditEntry"
                                GridTemplateColumns="1fr 1fr 1fr 2fr">
                    <TemplateColumn Title="@L["Admin_UserEdit_AuditWhen"]">@Fmt(context.OccurredAtUtc)</TemplateColumn>
                    <PropertyColumn Property="@(e => e.Type)" Title="@L["Admin_UserEdit_AuditEvent"]" />
                    <PropertyColumn Property="@(e => e.Actor)" Title="@L["Admin_UserEdit_AuditActor"]" />
                    <TemplateColumn Title="@L["Admin_UserEdit_AuditDetail"]">@(context.Detail ?? "—")</TemplateColumn>
                </FluentDataGrid>
            </div>
            @if (_auditTotal > AuditPageSize)
            {
                <div class="pager">
                    <FluentButton Appearance="Appearance.Outline" Disabled="@(_auditPageIndex == 0)"
                                  OnClick="() => GoToAuditPageAsync(_auditPageIndex - 1)">@L["Common_PrevPage"]</FluentButton>
                    <span>@L["Common_PageOf", _auditPageIndex + 1, AuditPageCount]</span>
                    <FluentButton Appearance="Appearance.Outline" Disabled="@(_auditPageIndex >= AuditPageCount - 1)"
                                  OnClick="() => GoToAuditPageAsync(_auditPageIndex + 1)">@L["Common_NextPage"]</FluentButton>
                </div>
            }
        }
    }
</FluentStack>

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private UserDetail? _detail;
    private bool _loaded;
    private Guid _adminId;
    private bool _isSelf;
    private bool _canAssignRoles;
    private IReadOnlyList<string> _allRoles = [];
    private HashSet<string> _selectedRoles = new(StringComparer.Ordinal);
    // Paged in SQL. The unpaged read had no ceiling at all: every sign-in this account has ever
    // recorded came back, and the grid drew all of them on a screen whose subject is the account,
    // not its history.
    private const int AuditPageSize = 20;
    private IReadOnlyList<AccountAuditEntry> _audit = [];
    private int _auditPageIndex;
    private int _auditTotal;

    private int AuditPageCount => _auditTotal == 0 ? 1 : (_auditTotal + AuditPageSize - 1) / AuditPageSize;
    private UserHomeDto _home = new(null, null, false);
    private string? _blockReason;
    private bool _confirmDelete;
    private string? _message;
    private string? _error;
    private TimeZoneInfo _tz = TimeZoneInfo.Local;

    private Guid _loadedId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        _adminId = Guid.TryParse(UserManager.GetUserId(state.User), out var id) ? id : Guid.Empty;
        _canAssignRoles = state.User.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Users.AssignRoles);
        _allRoles = (await RoleAdmin.ListAsync()).Select(r => r.Name).ToArray();
        _tz = await SiteSettings.GetTimeZoneAsync();
    }

    private string RoleName(string role) => AuthorizationDisplay.RoleName(L, role);

    /// <summary>
    /// The Administrator role of the last administrator standing cannot be given up — not to
    /// themselves, not by anyone else, and not by swapping it for a different role.
    /// </summary>
    private bool IsPinned(string role) =>
        _detail?.IsLastAdministrator == true && string.Equals(role, Roles.Administrator, StringComparison.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        // The router reuses this component instance when only the route parameter changes.
        // Without reloading, a link from user A's detail to user B would keep A's data on
        // screen while the save/block/delete actions already target B.
        if (_loadedId != Id)
        {
            _loadedId = Id;
            _message = _error = null;
            _confirmDelete = false;
            // The trail belongs to the account, so following a link to another one starts at its
            // first page rather than wherever the previous account was being read.
            _auditPageIndex = 0;
            await LoadAsync();
        }
    }

    private string Fmt(DateTimeOffset utc) => TimeZoneInfo.ConvertTime(utc, _tz).ToString("g");

    private string Initials()
    {
        var name = _detail?.DisplayName;
        if (!string.IsNullOrWhiteSpace(name))
        {
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var initials = parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : parts[0][..Math.Min(2, parts[0].Length)];
            return initials.ToUpperInvariant();
        }

        var email = _detail?.Email;
        return string.IsNullOrEmpty(email) ? "?" : email[..1].ToUpperInvariant();
    }

    private async Task LoadAsync()
    {
        _detail = await UserAdmin.GetAsync(Id);
        _loaded = true;
        if (_detail is not null)
        {
            _isSelf = _detail.Id == _adminId;
            _selectedRoles = _detail.Roles.ToHashSet(StringComparer.Ordinal);
            var audit = await AccountService.GetAuditTrailAsync(Id, _auditPageIndex, AuditPageSize);
            _audit = audit.Items;
            _auditTotal = audit.TotalCount;
            _auditPageIndex = audit.PageIndex;
            _home = await UserLocation.GetHomeAsync(Id);
        }
    }

    private async Task GoToAuditPageAsync(int pageIndex)
    {
        _auditPageIndex = Math.Clamp(pageIndex, 0, AuditPageCount - 1);
        await LoadAsync();
    }

    private async Task SetVerifiedAsync(bool verified)
    {
        _message = _error = null;
        var result = await UserLocation.SetHomeVerifiedAsync(Id, verified);
        if (result.Succeeded)
        {
            _message = L["Admin_UserEdit_HomeSaved"];
            await LoadAsync();
        }
        else
        {
            _error = L[result.Errors.FirstOrDefault() ?? string.Empty];
        }
    }

    private void ToggleRole(string role, bool selected)
    {
        if (selected)
        {
            _selectedRoles.Add(role);
        }
        else
        {
            _selectedRoles.Remove(role);
        }
    }

    private async Task SaveRolesAsync() =>
        await RunAsync(() => UserAdmin.SetRolesAsync(Id, _selectedRoles.ToArray(), _adminId), L["Admin_UserEdit_RolesSaved"]);

    private async Task BlockAsync() =>
        await RunAsync(() => AccountService.BlockAsync(Id, _adminId, string.IsNullOrWhiteSpace(_blockReason) ? null : _blockReason), L["Admin_UserEdit_Blocked"]);

    private async Task UnblockAsync() =>
        await RunAsync(() => AccountService.UnblockAsync(Id, _adminId), L["Admin_UserEdit_Unblocked"]);

    private async Task DeleteAsync()
    {
        var result = await UserAdmin.DeleteAsync(Id, _adminId);
        if (result.Succeeded)
        {
            Nav.NavigateTo("admin/users");
            return;
        }

        _confirmDelete = false;
        _error = string.Join(" ", result.Errors);
    }

    private async Task RunAsync(Func<Task<AccountResult>> action, string successMessage)
    {
        _message = _error = null;
        var result = await action();
        if (result.Succeeded)
        {
            _message = successMessage;
            await LoadAsync();
        }
        else
        {
            _error = string.Join(" ", result.Errors);
        }
    }
}
