@page "/admin/directory"
@attribute [HasPermission(Permissions.Roles.View)]
@rendermode InteractiveServer
@using D3Parking.Application.Identity
@inject IExternalRoleMappingService Mappings
@inject IRoleAdminService RoleAdmin
@inject UserManager<ApplicationUser> UserManager
@inject IEntraSettingsService EntraSettings
@inject IStringLocalizer<SharedResource> L

@* The directory decides who holds "ParkingLotManager"; this page decides what that means here.
   Keeping the translation visible and audited beats burying it in configuration nobody reads. *@

<PageTitle>@L["Admin_Directory_Title"]</PageTitle>

<FluentStack Class="page-shell directory-page" Orientation="Orientation.Vertical" VerticalGap="20">
    <div class="admin-head">
        <div class="admin-head__titles">
            <div class="admin-head__title-row">
                <FluentLabel Typo="Typography.PageTitle">@L["Admin_Directory_Title"]</FluentLabel>
                @if (_mappings is not null)
                {
                    <span class="count-chip">@Visible.Count</span>
                }
            </div>
            <p class="admin-head__intro">@L["Admin_Directory_Intro"]</p>
        </div>
        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Edit)" Context="addAction">
            <FluentButton Id="directory-open-add" Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Add())"
                          Disabled="@_addOpen" OnClick="() => _addOpen = true">
                @L["Admin_Directory_Add"]
            </FluentButton>
        </AuthorizeView>
    </div>

    @if (_mappings is not null)
    {
        <section class="directory-overview" aria-label="@L["Admin_Directory_Overview"]">
            <div class="directory-metric directory-metric--mappings"><span>@L["Admin_Directory_Mappings"]</span><strong>@_mappings.Count</strong></div>
            <div class="directory-metric directory-metric--people"><span>@L["Admin_Directory_AssignedUsers"]</span><strong>@_mappings.Sum(mapping => mapping.AssignedUserCount)</strong></div>
            <div class="directory-metric directory-metric--roles"><span>@L["Admin_Directory_AvailableRoles"]</span><strong>@_roles.Count</strong></div>
            <div class="directory-integration-state">
                <span class="state-pill state-pill--@(_entra.IsSignInConfigured ? "on" : "off")">@L[_entra.IsSignInConfigured ? "Admin_Directory_SignInOn" : "Admin_Directory_SignInOff"]</span>
                <span class="state-pill state-pill--@(_entra.Scim.IsConfigured ? "on" : "off")">@L[_entra.Scim.IsConfigured ? "Admin_Directory_ScimOn" : "Admin_Directory_ScimOff"]</span>
            </div>
        </section>
    }

    @if (!_entra.Enabled && !_entra.Scim.Enabled)
    {
        @* Mapping without a configured tenant is not wrong — it is how an installation prepares
           before the tenant is wired up — but pretending it is live would be. *@
        <FluentMessageBar Intent="MessageIntent.Info" Type="MessageType.MessageBar" AllowDismiss="false">
            @L["Admin_Directory_NotConfigured"]
        </FluentMessageBar>
        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Settings.Edit)" Context="configure">
            <FluentAnchor Href="/admin/settings?tab=entra" Appearance="Appearance.Hypertext">@L["Admin_Directory_ConfigureLink"]</FluentAnchor>
        </AuthorizeView>
    }
    else if (_entra.Scim.IsConfigured)
    {
        <div class="directory-endpoint"><span>@L["Admin_Directory_ScimEndpoint"]</span><code class="perm-row__id">@_scimUrl</code></div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar">@_message</FluentMessageBar>
    }
    @if (!string.IsNullOrEmpty(_error) && !_addOpen)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@_error</FluentMessageBar>
    }

    @* One row per app role the tenant publishes — a set the directory writes and this page only
       translates, so it is bounded by the tenant and read whole. No pager; a filter, because the
       app-role names are long dotted strings that all start alike. *@
    @if (_mappings is { Count: > 0 })
    {
        <div class="directory-commandbar">
            <FluentSearch Id="directory-search" @bind-Value="_filter" @bind-Value:after="StateHasChanged"
                          Immediate="true" ImmediateDelay="150"
                          Placeholder="@L["Admin_Directory_SearchHint"]" Class="directory-search" />
            <span>@L["Admin_Directory_Results", Visible.Count]</span>
        </div>
    }

    @if (_mappings is null)
    {
        <div class="loading"><FluentProgressRing /></div>
    }
    else if (_mappings.Count == 0)
    {
        <div class="empty-state">@L["Admin_Directory_Empty"]</div>
    }
    else if (Visible.Count == 0)
    {
        <div class="empty-state">@L["Admin_Directory_NoMatch"]</div>
    }
    else
    {
        <div class="admin-panel directory-desktop-list">
            <FluentDataGrid Items="@Visible.AsQueryable()" TGridItem="ExternalRoleMappingSummary"
                            GridTemplateColumns="1.4fr 1.2fr 0.8fr auto">
                <TemplateColumn Title="@L["Admin_Directory_AppRole"]">
                    <code class="perm-row__id">@context.ExternalRole</code>
                </TemplateColumn>
                <TemplateColumn Title="@L["Admin_Directory_LocalRole"]">
                    <a href="@($"admin/roles/{context.RoleId}")">@AuthorizationDisplay.RoleName(L, context.RoleName)</a>
                </TemplateColumn>
                <TemplateColumn Title="@L["Admin_Directory_Assigned"]">
                    @PluralText.For(L, "Admin_Roles_MemberCount", context.AssignedUserCount)
                </TemplateColumn>
                <TemplateColumn Align="Align.End">
                    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Edit)" Context="remove">
                        <FluentButton OnClick="() => RemoveAsync(context.Id)" Appearance="Appearance.Outline">
                            @L["Admin_Directory_Remove"]
                        </FluentButton>
                    </AuthorizeView>
                </TemplateColumn>
            </FluentDataGrid>
        </div>
        <div class="directory-mobile-list">
            @foreach (var mapping in Visible)
            {
                <article class="directory-mobile-row">
                    <code>@mapping.ExternalRole</code>
                    <a href="@($"admin/roles/{mapping.RoleId}")">@AuthorizationDisplay.RoleName(L, mapping.RoleName)</a>
                    <div><span>@PluralText.For(L, "Admin_Roles_MemberCount", mapping.AssignedUserCount)</span>
                        <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Edit)" Context="removeMobile">
                            <FluentButton OnClick="() => RemoveAsync(mapping.Id)" Appearance="Appearance.Stealth">@L["Admin_Directory_Remove"]</FluentButton>
                        </AuthorizeView>
                    </div>
                </article>
            }
        </div>
    }
</FluentStack>

@if (_addOpen)
{
    <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Edit)" Context="addDialog">
        <AdminDialog Title="@L["Admin_Directory_Add"]" Eyebrow="@L["Admin_Directory_Title"]"
                     Size="small" Class="directory-add" BackdropClass="directory-add-backdrop"
                     OnClose="CloseAdd">
            <div class="directory-dialog-form">
                <p class="admin-head__intro">@L["Admin_Directory_AddIntro"]</p>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@_error</FluentMessageBar>
                }
                <div class="directory-add__field">
                    <FluentTextField Id="directory-external-role" autofocus @bind-Value="_newExternalRole"
                                     Label="@L["Admin_Directory_AppRole"]" Placeholder="Parking.LotManager" />
                </div>
                <div class="directory-add__field">
                    <FluentSelect TOption="RoleSummary" Items="@_roles"
                                  OptionValue="@(r => r.Id.ToString())"
                                  OptionText="@(r => AuthorizationDisplay.RoleName(L, r.Name))"
                                  Position="SelectPosition.Below"
                                  @bind-SelectedOption="_newRole" Label="@L["Admin_Directory_LocalRole"]" />
                </div>
                <div class="admin-dialog__actions">
                    <FluentButton Appearance="Appearance.Outline" OnClick="CloseAdd">@L["Common_Cancel"]</FluentButton>
                    <FluentButton Id="directory-add-submit" OnClick="AddAsync" Appearance="Appearance.Accent">@L["Admin_Directory_AddAction"]</FluentButton>
                </div>
            </div>
        </AdminDialog>
    </AuthorizeView>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<ExternalRoleMappingSummary>? _mappings;
    private string? _filter;
    private IReadOnlyList<RoleSummary> _roles = [];
    private RoleSummary? _newRole;
    private string? _newExternalRole;
    private Guid _actorId;
    private EntraIdOptions _entra = new();
    private string _scimUrl = string.Empty;
    private string? _message;
    private string? _error;
    private bool _addOpen;

    private const string Provider = ExternalProviders.EntraId;

    private void CloseAdd()
    {
        _addOpen = false;
        _error = null;
    }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        _actorId = Guid.TryParse(UserManager.GetUserId(state.User), out var id) ? id : Guid.Empty;

        // Shown so whoever configures the Enterprise Application can copy it rather than guess.
        _scimUrl = new Uri(new Uri(Nav.BaseUri), "scim/v2").ToString();

        await LoadAsync();
    }

    private IReadOnlyList<ExternalRoleMappingSummary> Visible => _mappings is null
        ? []
        : string.IsNullOrWhiteSpace(_filter)
            ? _mappings
            : _mappings.Where(Matches).ToList();

    private bool Matches(ExternalRoleMappingSummary mapping)
    {
        var term = _filter!.Trim();
        return Has(mapping.ExternalRole)
            || Has(mapping.RoleName)
            || Has(AuthorizationDisplay.RoleName(L, mapping.RoleName));

        bool Has(string value) => value.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadAsync()
    {
        _entra = await EntraSettings.GetEffectiveAsync();
        _roles = await RoleAdmin.ListAsync();
        _mappings = await Mappings.ListAsync(Provider);
    }

    private async Task AddAsync()
    {
        _message = _error = null;
        if (_newRole is null)
        {
            _error = L["Admin_Directory_PickRole"];
            return;
        }

        var result = await Mappings.CreateAsync(Provider, _newExternalRole ?? string.Empty, _newRole.Id, _actorId);
        if (result.Succeeded)
        {
            _message = L["Admin_Directory_Added"];
            _newExternalRole = null;
            _newRole = null;
            _addOpen = false;
            await LoadAsync();
        }
        else
        {
            _error = string.Join(" ", result.Errors);
        }
    }

    private async Task RemoveAsync(Guid mappingId)
    {
        _message = _error = null;
        var result = await Mappings.DeleteAsync(mappingId, _actorId);
        if (result.Succeeded)
        {
            _message = L["Admin_Directory_Removed"];
            await LoadAsync();
        }
        else
        {
            _error = string.Join(" ", result.Errors);
        }
    }
}
