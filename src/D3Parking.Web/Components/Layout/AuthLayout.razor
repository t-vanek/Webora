@inherits LayoutComponentBase
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject IStringLocalizer<SharedResource> L
@inject ISiteSettingsService SiteSettings

@*  AuthLayout: celoplošný split-screen pro Login a Registraci. Levá polovina je plná plocha
    Sherpa Blue se šikmými pruhy značky (stejné gesto jako hero na landing page), pravá polovina
    nese samotný formulář na neutrální ploše, která se přepíná se světlým/tmavým režimem.

    Hlavička aplikace tu záměrně není: před přihlášením nevede nikam a odkazy Přihlásit/Registrace
    nahrazuje přepínač přímo v kartě (AuthTabs). Zůstávají jen přepínače jazyka a motivu v horním
    pravém rohu formulářové poloviny. Na mobilu se celý brand panel skryje a značku převezme
    kompaktní varianta v horní liště.  *@
<div class="auth-split">
    <aside class="auth-split__aside">
        <a href="" class="auth-brand">
            <span class="auth-brand__ic">
                <FluentIcon Value="@(new Icons.Filled.Size28.VehicleCar())" Color="Color.Custom" CustomColor="#fff" />
            </span>
            <span>@_siteName</span>
        </a>

        <div class="auth-hero">
            <h2 class="auth-hero__headline">@L["Auth_Hero_Headline"]</h2>
            <p class="auth-hero__lead">@L["Auth_Hero_Lead"]</p>
            <ul class="auth-hero__features">
                <li>
                    <span class="auth-hero__feat-ic"><FluentIcon Value="@(new Icons.Regular.Size20.VehicleCar())" Color="Color.Custom" CustomColor="#fff" /></span>
                    @L["Auth_Hero_Feature1"]
                </li>
                <li>
                    <span class="auth-hero__feat-ic"><FluentIcon Value="@(new Icons.Regular.Size20.Money())" Color="Color.Custom" CustomColor="#fff" /></span>
                    @L["Auth_Hero_Feature2"]
                </li>
                <li>
                    <span class="auth-hero__feat-ic"><FluentIcon Value="@(new Icons.Regular.Size20.Trophy())" Color="Color.Custom" CustomColor="#fff" /></span>
                    @L["Auth_Hero_Feature3"]
                </li>
            </ul>
        </div>

        <p class="auth-split__legal">© @DateTime.Now.Year @_siteName</p>
    </aside>

    <main class="auth-split__pane">
        <div class="auth-topbar">
            <a href="" class="auth-brand auth-brand--compact">
                <span class="auth-brand__ic">
                    <FluentIcon Value="@(new Icons.Filled.Size28.VehicleCar())" Color="Color.Custom" CustomColor="#fff" />
                </span>
                <span>@_siteName</span>
            </a>
            <div class="auth-topbar__tools">
                <LanguageSwitcher @rendermode="InteractiveServer" />
                <ThemeToggle @rendermode="InteractiveServer" />
            </div>
        </div>

        <div class="auth-split__center">
            <div class="auth-card">
                @Body
            </div>
        </div>
    </main>
</div>

@* Same provider set as MainLayout so dialogs/toasts/etc. still work from the auth pages. *@
<FluentToastProvider @rendermode="InteractiveServer" />
<FluentDialogProvider @rendermode="InteractiveServer" />
<FluentTooltipProvider @rendermode="InteractiveServer" />
<FluentMessageBarProvider @rendermode="InteractiveServer" />
<FluentMenuProvider @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet>
    @L["Layout_Error"]
    <a href="." class="reload">@L["Layout_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _siteName = "D3Parking";

    protected override async Task OnInitializedAsync() =>
        _siteName = (await SiteSettings.GetIdentityAsync()).Name ?? "D3Parking";
}
