@inherits LayoutComponentBase
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject IStringLocalizer<SharedResource> L
@inject ISiteSettingsService SiteSettings

<FluentLayout>
    @*  FluentHeader paints itself with --accent-fill-rest, so the brand text needs a foreground
        that reads against the accent (not the page neutral). --foreground-on-accent-rest is the
        complementary token Fluent components use for the same purpose.  *@
    @*  FluentHeader is a flex container, but FluentSpacer only reliably pushes content right when
        it sits between exactly two flex children. Group everything that belongs on the right into
        one wrapping FluentStack so the spacer has a clean "brand | (spacer) | tools" split.  *@
    <FluentHeader Class="app-header" Style="padding: 0 1.5rem">
        <a href="" class="brand-link">@_siteName</a>
        <FluentSpacer />
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center" Width="auto">
            <AuthorizeView>
                <NotAuthorized>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" VerticalAlignment="VerticalAlignment.Center" Width="auto">
                        <a href="login" class="header-nav-link">
                            <FluentIcon Value="@(new Icons.Regular.Size20.PersonAccounts())" Color="Color.Custom" CustomColor="currentColor" />
                            @L["Nav_Login"]
                        </a>
                        <a href="register" class="header-nav-link">
                            <FluentIcon Value="@(new Icons.Regular.Size20.PersonAdd())" Color="Color.Custom" CustomColor="currentColor" />
                            @L["Nav_Register"]
                        </a>
                    </FluentStack>
                    <div class="header-divider" aria-hidden="true"></div>
                </NotAuthorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <WalletChip />
                </Authorized>
            </AuthorizeView>
            <NotificationBell @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))" />
            @* One island for the preference corner: the avatar menu when signed in (language and
               theme live inside it), the standalone language/theme buttons when signed out. It
               also owns the page's single FluentDesignTheme instance. *@
            <AccountMenu @rendermode="InteractiveServer" />
        </FluentStack>
    </FluentHeader>

    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%" Style="flex:1; overflow:hidden">
        <NavMenu @rendermode="InteractiveServer" />
        <FluentBodyContent Class="body-content" Style="padding:1.5rem; overflow:auto">
            @Body
        </FluentBodyContent>
    </FluentStack>
</FluentLayout>

@* Fluent UI providers live as interactive islands so dialogs, toasts and menus work even when
   the hosting page is statically rendered. The <AccountMenu /> island in the header owns the
   FluentDesignTheme component that emits the design tokens onto the document. *@
<FluentToastProvider @rendermode="InteractiveServer" />
<FluentDialogProvider @rendermode="InteractiveServer" />
<FluentTooltipProvider @rendermode="InteractiveServer" />
<FluentMessageBarProvider @rendermode="InteractiveServer" />
<FluentMenuProvider @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet>
    @L["Layout_Error"]
    <a href="." class="reload">@L["Layout_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _siteName = "D3Parking";

    protected override async Task OnInitializedAsync() =>
        _siteName = (await SiteSettings.GetIdentityAsync()).Name ?? "D3Parking";
}
