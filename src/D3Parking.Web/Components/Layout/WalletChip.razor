@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject IIncentiveService Incentives
@inject IParkingSettingsService ParkingSettings
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L

@if (_score is not null)
{
    @* The tier collapsed from a text chip to a colour-coded dot; the full tier name stays in the
       tooltip and, larger, on the leaderboard this chip links to. *@
    <a href="parking/leaderboard" class="wallet-chip"
       title="@($"{(_creditsEnabled ? L["Parking_MyCredits"] : L["Parking_MyScore"])} — {L[$"Parking_Tier_{_score.Tier}"]}")">
        @if (_creditsEnabled)
        {
            <FluentIcon Value="@(new Icons.Regular.Size16.Wallet())" Color="Color.Custom" CustomColor="currentColor" />
        }
        else
        {
            <FluentIcon Value="@(new Icons.Regular.Size16.Trophy())" Color="Color.Custom" CustomColor="currentColor" />
        }
        <span class="wallet-chip__credits">
            @(_creditsEnabled ? _score.Credits : _score.Points)
            <small>@(_creditsEnabled ? L["Parking_Credits"] : L["Parking_Points"])</small>
        </span>
        <span class="wallet-chip__dot wallet-chip__dot--@_score.Tier" aria-hidden="true"></span>
    </a>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ParkerScoreDto? _score;
    private bool _creditsEnabled;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
        {
            return;
        }

        var authUser = (await AuthState).User;
        if (!authUser.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Parking.Reserve)
            && !authUser.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Parking.ViewLeaderboard))
        {
            return;
        }

        // Read the id straight from the auth claims rather than UserManager.GetUserAsync:
        // this component lives in the layout, so a DB lookup here races the page's own
        // UserManager call on the circuit-scoped Identity DbContext. GetScoreAsync uses its
        // own pooled context and is safe to call concurrently.
        if (Guid.TryParse(UserManager.GetUserId(authUser), out var userId))
        {
            var score = Incentives.GetScoreAsync(userId);
            var policy = ParkingSettings.GetPolicyAsync();
            await Task.WhenAll(score, policy);
            _score = score.Result;
            _creditsEnabled = policy.Result.CreditsEnabled;
        }
    }
}
