{
  "ConnectionStrings": {
    "SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=D3Parking;Trusted_Connection=True;TrustServerCertificate=True"
  },
  // Microsoft Entra ID. Everything here is off by default: with Enabled false and Scim.Enabled
  // false the application behaves exactly as it did before, with local passwords only.
  //   Enabled  — turns on the "sign in with Microsoft" button (needs TenantId and ClientId).
  //   ClientSecret — keep it in user secrets, an environment variable or a vault, never here.
  //   Scim     — inbound provisioning from an Entra Enterprise Application. The bearer token is
  //              the whole boundary on those endpoints; generate a long random one and rotate it.
  "EntraId": {
    "Enabled": false,
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-entra",
    "DisplayName": "Microsoft",
    "LinkByVerifiedEmail": true,
    "AllowJustInTimeProvisioning": true,
    "DefaultRoles": [],
    "Scim": {
      "Enabled": false,
      "BearerToken": "",
      "BlockOnDeprovision": true
    }
  },
  "Account": {
    "BaseUrl": "https://localhost:7048"
  },
  "Geocoding": {
    "NominatimBaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "D3Parking/1.0 (parking)"
  },
  "Distance": {
    "Provider": "Haversine",
    "OsrmBaseUrl": "https://router.project-osrm.org"
  },
  "ForwardedHeaders": {
    "TrustAllProxies": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 25,
    "Security": "None",
    "Authentication": "None",
    "SenderEmail": "no-reply@d3parking.local",
    "SenderName": "D3Parking",
    "OAuth2": {
      "TokenEndpoint": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scope": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
