<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Charting for the lot dashboard. The Fluent UI Blazor team does not ship chart components and
         points at this wrapper as the compatible option; it bundles its JS as a static web asset, so
         there is nothing to add to the page head. MIT, targets net10.0 directly. -->
    <PackageReference Include="Blazor-ApexCharts" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <ProjectReference Include="..\D3Parking.Web.Client\D3Parking.Web.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D3Parking.Infrastructure\D3Parking.Infrastructure.csproj" />
    <ProjectReference Include="..\D3Parking.Application\D3Parking.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sign-in flow's two pure decisions — which return URL is local, and what a directory
         token actually asserts — are guards worth testing directly rather than through a browser. -->
    <InternalsVisibleTo Include="D3Parking.Application.Tests" />
  </ItemGroup>

</Project>
