@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Localization
@using Webora.Contracts.Notifications
@using Webora.Web.Client.Api
@implements IAsyncDisposable
@inject NotificationsApiClient Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<ClientResource> L

@if (_authenticated)
{
    <div class="dropdown">
        <button class="btn btn-dark position-relative" type="button" @onclick="ToggleOpen" title="@(_muted ? L["Bell_TitleMuted"] : L["Bell_Title"])">
            <span aria-hidden="true">@(_muted ? "🔕" : "🔔")</span>
            @if (_unreadCount > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @_unreadCount
                </span>
            }
        </button>
        @if (_open)
        {
            <div class="dropdown-menu show p-2" style="position:absolute; right:0; min-width:320px; max-height:420px; overflow:auto;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>@L["Bell_Title"]</strong>
                    @if (_unreadCount > 0)
                    {
                        <button class="btn btn-sm btn-link" @onclick="MarkAllRead">@L["Bell_MarkRead"]</button>
                    }
                </div>
                @if (_items.Count == 0)
                {
                    <p class="text-muted small mb-0">@L["Bell_NoNotifications"]</p>
                }
                else
                {
                    @foreach (var n in _items)
                    {
                        <button type="button"
                                class="btn btn-link text-start w-100 p-0 border-0 border-bottom py-1 @(n.IsRead ? "" : "fw-semibold")"
                                @onclick="() => MarkRead(n.Id)"
                                disabled="@n.IsRead">
                            <div class="small">@n.Title</div>
                            <div class="small text-muted">@n.Message</div>
                        </button>
                    }
                }
            </div>
        }
    </div>
}

@code {
    private HubConnection? _hub;
    private bool _authenticated;
    private bool _open;
    private bool _muted;
    private int _unreadCount;
    private List<NotificationDto> _items = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _authenticated = state.User.Identity?.IsAuthenticated == true;
        if (!_authenticated)
        {
            return;
        }

        await RefreshAsync();
        await ConnectAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            _unreadCount = await Api.GetUnreadCountAsync();
            _items = [.. await Api.GetAsync(take: 20)];
            var prefs = await Api.GetPreferencesAsync();
            _muted = prefs?.IsCurrentlyMuted ?? false;
        }
        catch (HttpRequestException)
        {
            // Not reachable / unauthorized — leave the bell empty.
        }
    }

    private async Task ConnectAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/notifications"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<NotificationDto>("ReceiveNotification", notification =>
        {
            _items.Insert(0, notification);
            _unreadCount++;
            return InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hub.StartAsync();
        }
        catch
        {
            // Real-time unavailable; the bell still works via the initial fetch.
        }
    }

    private void ToggleOpen() => _open = !_open;

    private async Task MarkRead(Guid id)
    {
        var index = _items.FindIndex(n => n.Id == id);
        if (index < 0 || _items[index].IsRead)
        {
            return;
        }

        await Api.MarkReadAsync(id);
        _items[index] = _items[index] with { IsRead = true };
        if (_unreadCount > 0)
        {
            _unreadCount--;
        }
    }

    private async Task MarkAllRead()
    {
        await Api.MarkAllReadAsync();
        _unreadCount = 0;
        _items = [.. _items.Select(n => n with { IsRead = true })];
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
