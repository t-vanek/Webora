@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Localization
@using D3Parking.Contracts.Notifications
@using D3Parking.Web.Client.Api
@implements IAsyncDisposable
@inject NotificationsApiClient Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<ClientResource> L
@inject IJSRuntime JS

@if (_authenticated)
{
    <div style="position:relative">
        <FluentButton Appearance="Appearance.Stealth" OnClick="ToggleOpen"
                      Title="@(_muted ? L["Bell_TitleMuted"] : L["Bell_Title"])"
                      Style="position:relative">
            @* Inline SVG rather than <FluentIcon>: pulling in the icon package cost this island
               ~22 MB of the ~47 MB the .NET WASM runtime reads on every page load, to draw two
               glyphs. The path data below is the same Fluent "Alert" / "AlertOff" (Regular, 24)
               copied out of that package, so the bell looks exactly as before. *@
            <svg class="bell-icon" viewBox="0 0 24 24" width="24" height="24"
                 fill="currentColor" aria-hidden="true" focusable="false">
                @((MarkupString)(_muted ? AlertOffPath : AlertPath))
            </svg>
            @if (_unreadCount > 0)
            {
                @* Capped at 9+ so a pile of unread notifications can't stretch the badge out of
                   its corner; the exact number is one click away in the panel. *@
                <span class="bell-badge">@(_unreadCount > 9 ? "9+" : _unreadCount.ToString())</span>
            }
        </FluentButton>

        @if (_open)
        {
            @* A plain styled div, deliberately not FluentCard: fluent-card defaults its height to
               100%, and for an absolutely positioned element that resolves against the ~40px
               button wrapper — the panel opened as a two-line strip with scrollbars. *@
            <div class="bell-panel">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Subject">@L["Bell_Title"]</FluentLabel>
                        @if (_unreadCount > 0)
                        {
                            <FluentSpacer />
                            @* Lightweight, not Hypertext: FluentButton throws on Hypertext since
                               Fluent UI 4.x, which killed the whole bell render when unread > 0. *@
                            <FluentButton Appearance="Appearance.Lightweight" OnClick="MarkAllRead">
                                @L["Bell_MarkRead"]
                            </FluentButton>
                        }
                    </FluentStack>

                    @if (_pushAvailable)
                    {
                        @* Web Push for this device (an installed PWA gets notified even when
                           closed). Only shown when the server has keys and the browser supports it. *@
                        <FluentSwitch Value="@_pushEnabled"
                                      ValueChanged="@(v => OnPushToggleAsync(v))"
                                      Disabled="@(_pushBusy || _pushBlocked)"
                                      Title="@(_pushBlocked ? L["Bell_PushBlocked"] : null)"
                                      Style="font-size:0.85rem">
                            @L["Bell_PushToggle"]
                        </FluentSwitch>
                    }

                    @* The list arrives on first open, so "nothing here" must not be shown while it
                       is still on its way — that would read as an empty inbox. *@
                    @if (_itemsLoading)
                    {
                        <FluentProgressRing Style="width:24px;height:24px" />
                    }
                    else if (_items.Count == 0)
                    {
                        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Bell_NoNotifications"]</FluentLabel>
                    }
                    else
                    {
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                            @foreach (var n in _items)
                            {
                                <FluentButton Appearance="Appearance.Stealth"
                                              OnClick="@(() => MarkRead(n.Id))"
                                              Disabled="@n.IsRead"
                                              Style="@($"width:100%; text-align:left; padding:6px 8px; border-bottom:1px solid var(--neutral-stroke-divider-rest); justify-content:flex-start; {(n.IsRead ? "" : "font-weight:600")}")">
                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="width:100%">
                                        <span style="font-size:0.85rem">@n.Title</span>
                                        <span style="font-size:0.8rem; color:var(--neutral-foreground-hint)">@n.Message</span>
                                    </FluentStack>
                                </FluentButton>
                            }
                        </FluentStack>
                    }
                </FluentStack>
            </div>
        }
    </div>
}

@code {
    private HubConnection? _hub;
    private bool _authenticated;
    private bool _open;
    private bool _muted;
    private int _unreadCount;
    private List<NotificationDto> _items = [];

    // The list is fetched on first open, not on page load. "Loaded" is what tells the panel apart
    // from "genuinely empty" and tells the hub handler whether prepending is meaningful.
    private bool _itemsLoaded;
    private bool _itemsLoading;

    // Fluent "Alert" and "AlertOff" (Regular, 24) path data, lifted from
    // Microsoft.FluentUI.AspNetCore.Components.Icons so this island does not have to reference it.
    // Constant markup from a trusted source, hence MarkupString rather than any escaping concern.
    private const string AlertPath =
        """<path d="M12 2a7.5 7.5 0 0 1 7.5 7.25v4.35l1.38 3.15a1.25 1.25 0 0 1-1.15 1.75H15a3 3 0 0 1-6 .18v-.18H4.27a1.25 1.25 0 0 1-1.14-1.75L4.5 13.6V9.5C4.5 5.35 7.85 2 12 2Zm1.5 16.5h-3a1.5 1.5 0 0 0 3 .15v-.15ZM12 3.5c-3.32 0-6 2.67-6 6v4.4L4.66 17h14.7L18 13.9V9.29a5.99 5.99 0 0 0-6-5.78Z"/>""";

    private const string AlertOffPath =
        """<path d="m5.22 6.28-3-3a.75.75 0 0 1 1.06-1.06l18.5 18.5a.75.75 0 1 1-1.06 1.06l-3.28-3.28H15a3 3 0 0 1-6 .18v-.18H4.27a1.25 1.25 0 0 1-1.14-1.75L4.5 13.6V9.5c0-1.15.26-2.24.72-3.21ZM15.94 17 6.36 7.43A6.02 6.02 0 0 0 6 9.5v4.4L4.66 17h11.28Zm-2.44 1.5h-3a1.5 1.5 0 0 0 3 .15v-.15Zm4.5-4.6.7 1.63 2.2 2.18a1.25 1.25 0 0 0-.02-.96l-1.38-3.16V9.25A7.5 7.5 0 0 0 7.04 3.86l1.07 1.06A5.99 5.99 0 0 1 18 9.28V13.91Z"/>""";

    private IJSObjectReference? _pushModule;
    private string? _pushPublicKey;
    private bool _pushAvailable;
    private bool _pushEnabled;
    private bool _pushBlocked;
    private bool _pushBusy;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _authenticated = state.User.Identity?.IsAuthenticated == true;
        if (!_authenticated)
        {
            return;
        }

        await RefreshHeaderAsync();
        await ConnectAsync();
    }

    /// <summary>
    /// What the closed bell actually shows: the unread count and whether notifications are muted.
    /// The two calls are independent, so they go together rather than one after the other — and the
    /// list itself is not fetched here at all; see <see cref="ToggleOpen"/>.
    /// </summary>
    private async Task RefreshHeaderAsync()
    {
        try
        {
            var count = Api.GetUnreadCountAsync();
            var prefs = Api.GetPreferencesAsync();
            await Task.WhenAll(count, prefs);
            _unreadCount = count.Result;
            _muted = prefs.Result?.IsCurrentlyMuted ?? false;
        }
        catch (Exception ex) when (ex is HttpRequestException or NotSupportedException or JsonException)
        {
            // Not reachable, session expired (401) or an unexpected payload — leave the bell
            // empty rather than letting a background fetch take the whole island down.
        }
    }

    /// <summary>
    /// Fetches the list the panel shows. Deferred until the panel is first opened: on most page
    /// loads nobody opens the bell, and the closed bell only needs its count.
    /// </summary>
    private async Task LoadItemsAsync()
    {
        _itemsLoading = true;
        try
        {
            _items = [.. await Api.GetAsync(take: 20)];
            _itemsLoaded = true;
        }
        catch (Exception ex) when (ex is HttpRequestException or NotSupportedException or JsonException)
        {
            // Same reasoning as above; the panel shows its empty state instead of taking the
            // island down. Not marked loaded, so opening it again retries.
        }
        finally
        {
            _itemsLoading = false;
        }
    }

    private async Task ConnectAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/notifications"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<NotificationDto>("ReceiveNotification", notification =>
        {
            _unreadCount++;
            // Only prepend when the list has actually been fetched. Inserting into a list nobody
            // loaded yet would render that one notification as if it were all of them.
            if (_itemsLoaded)
            {
                _items.Insert(0, notification);
            }

            return InvokeAsync(StateHasChanged);
        });

        // Notifications published while the connection was down were only stored server-side;
        // refetch on reconnect so the bell doesn't silently miss them until the next page load.
        _hub.Reconnected += _ => InvokeAsync(async () =>
        {
            await RefreshHeaderAsync();
            if (_itemsLoaded)
            {
                await LoadItemsAsync();
            }

            StateHasChanged();
        });

        try
        {
            await _hub.StartAsync();
        }
        catch
        {
            // Real-time unavailable; the bell still works via the initial fetch.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_authenticated)
        {
            return;
        }

        // Web Push is a pure progressive enhancement: without server keys, browser support or a
        // secure context the toggle simply never shows up.
        try
        {
            var key = await Api.GetPushPublicKeyAsync();
            if (key is null)
            {
                return;
            }

            _pushModule = await JS.InvokeAsync<IJSObjectReference>("import", "./push.js");
            var state = await _pushModule.InvokeAsync<PushState>("getState");
            if (!state.Supported)
            {
                return;
            }

            _pushPublicKey = key.PublicKey;
            _pushAvailable = true;
            _pushEnabled = state.Subscribed;
            _pushBlocked = state.Permission == "denied";
            StateHasChanged();
        }
        catch
        {
            // Push unavailable (network, old browser) — the bell keeps working without it.
        }
    }

    private async Task OnPushToggleAsync(bool enable)
    {
        if (_pushModule is null || _pushPublicKey is null || _pushBusy)
        {
            return;
        }

        _pushBusy = true;
        try
        {
            if (enable)
            {
                var subscription = await _pushModule.InvokeAsync<PushSubscriptionPayload?>("subscribe", _pushPublicKey);
                if (subscription is null)
                {
                    // The user declined the permission prompt.
                    _pushBlocked = true;
                    _pushEnabled = false;
                }
                else
                {
                    await Api.SubscribePushAsync(new PushSubscriptionDto(subscription.Endpoint, subscription.P256dh, subscription.Auth));
                    _pushEnabled = true;
                }
            }
            else
            {
                var endpoint = await _pushModule.InvokeAsync<string?>("unsubscribe");
                if (endpoint is not null)
                {
                    await Api.UnsubscribePushAsync(endpoint);
                }

                _pushEnabled = false;
            }
        }
        catch
        {
            // Network/server failure — realign the toggle with the browser's actual state.
            try
            {
                var state = await _pushModule.InvokeAsync<PushState>("getState");
                _pushEnabled = state.Subscribed;
                _pushBlocked = state.Permission == "denied";
            }
            catch
            {
                _pushEnabled = false;
            }
        }
        finally
        {
            _pushBusy = false;
        }
    }

    private sealed record PushState(bool Supported, string Permission, bool Subscribed);

    private sealed record PushSubscriptionPayload(string Endpoint, string P256dh, string Auth);

    private async Task ToggleOpen()
    {
        _open = !_open;
        if (_open && !_itemsLoaded && !_itemsLoading)
        {
            await LoadItemsAsync();
        }
    }

    private async Task MarkRead(Guid id)
    {
        var index = _items.FindIndex(n => n.Id == id);
        if (index < 0 || _items[index].IsRead)
        {
            return;
        }

        try
        {
            await Api.MarkReadAsync(id);
        }
        catch (HttpRequestException)
        {
            // Server unreachable or session expired — keep the item unread instead of lying
            // locally (and instead of crashing the island on an unhandled event exception).
            return;
        }

        _items[index] = _items[index] with { IsRead = true };
        if (_unreadCount > 0)
        {
            _unreadCount--;
        }
    }

    private async Task MarkAllRead()
    {
        try
        {
            await Api.MarkAllReadAsync();
        }
        catch (HttpRequestException)
        {
            return;
        }

        _unreadCount = 0;
        _items = [.. _items.Select(n => n with { IsRead = true })];
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }

        if (_pushModule is not null)
        {
            try
            {
                await _pushModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is already gone — nothing to clean up.
            }
        }
    }
}
