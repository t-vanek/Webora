{
  "description": "Prepare the D3Parking development environment for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.ps1\"",
            "timeout": 900,
            "statusMessage": "Preparing D3Parking build, test, and database dependencies",
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
