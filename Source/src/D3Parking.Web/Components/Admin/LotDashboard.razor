@page "/admin/parking/dashboard"
@attribute [HasPermission(Permissions.Parking.ViewAnalytics)]
@rendermode InteractiveServer
@inject ILotDashboardService Dashboard
@inject ISiteSettingsService SiteSettings
@inject IParkingSettingsService ParkingSettings
@inject ILogger<LotDashboard> Logger
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Lot_Title"]</PageTitle>
<main class="planning-analysis">
    <header>
        <h1>@L["Lot_Title"]</h1>
        <p>@L["Analysis_Intro"]</p>
    </header>
    <div class="planning-analysis__toolbar">
        <div>
            <label for="analysis-period">@L["Analysis_Period"]</label>
            <select id="analysis-period" class="parking-input" @bind="_period" @bind:after="LoadAsync" disabled="@_loading">
                <option value="14">@L["Analysis_Next14"]</option>
                <option value="28">@L["Analysis_Next28"]</option>
                <option value="0">@L["Analysis_HorizonPeriod"]</option>
                <option value="-28">@L["Analysis_Last28"]</option>
            </select>
        </div>
        <FluentButton OnClick="LoadAsync" Disabled="@_loading">@L["Analysis_Refresh"]</FluentButton>
    </div>
    @if (_failed)
    {
        <FluentMessageBar Intent="MessageIntent.Error">@L["Parking_Admin_LoadFailed"]</FluentMessageBar>
    }
    @if (_loading)
    {
        <div role="status" aria-label="@L["Parking_Admin_Loading"]"><FluentProgressRing /></div>
    }
    else if (_data is { } data && !_failed)
    {
        <p class="planning-analysis__range">@_from.ToString("d") – @_to.ToString("d") · @L["Analysis_Capacity", data.ActiveSpots]</p>
        @if (data.ActiveSpots == 0)
        {
            <p>@L["Analysis_NoCapacity"]</p>
        }
        else
        {
            <section class="planning-analysis__charts" aria-label="@L["Analysis_Summary"]">
                <article class="planning-chart">
                    <h2>@L["Analysis_LeadChart"]</h2>
                    <p>@L["Analysis_LeadChartHint"]</p>
                    @BucketChart(data.LeadTimes)
                </article>
                <article class="planning-chart">
                    <h2>@L["Analysis_OutcomeChart"]</h2>
                    <p>@L["Analysis_OutcomeChartHint"]</p>
                    @BucketChart(data.Outcomes)
                </article>
                <article class="planning-chart planning-chart--capacity">
                    <h2>@L["Analysis_CapacityChart"]</h2>
                    <p>@L[data.Policy.ReservationTimeMode == ReservationTimeMode.AllDay ? "Analysis_CapacityChartHint" : "Analysis_CapacityTimeHint"]</p>
                    <div class="planning-chart__columns" role="img" aria-label="@L["Analysis_CapacityChart"]">
                        @foreach (var point in _capacityPoints)
                        {
                            <div class="planning-chart__column" title="@($"{point.Label}: {point.Percent:0.#} %")">
                                <span>@point.Percent.ToString("0.#")%</span>
                                <div class="planning-chart__track"><div style="@($"height:{point.Percent.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}%")"></div></div>
                                <small>@point.Label</small>
                            </div>
                        }
                    </div>
                    <small>@L[_capacityWeekly ? "Analysis_WeeklyChart" : "Analysis_DailyChart"]</small>
                </article>
            </section>
            <section class="planning-analysis__daily">
                <h2>@L["Analysis_Daily"]</h2>


                <div class="planning-analysis__scroll" tabindex="0" role="region" aria-label="@L["Analysis_Daily"]">
                    <table>
                        <thead><tr>
                            <th scope="col">@L["Analysis_Day"]</th>
                            @if (!data.IsHistory)
                            {
                                <th scope="col">@L["Analysis_DateRule"]</th>
                            }
                            <th scope="col">@L["Analysis_Booked"]</th>
                            <th scope="col">@L["Analysis_Share"]</th>
                            <th scope="col">@L["Analysis_Unbooked"]</th>
                            @if (!data.IsHistory)
                            {
                                <th scope="col">@L["Analysis_Waiting"]</th>
                            }
                        </tr></thead>
                        <tbody>
                            @foreach (var day in data.Days.Skip(_page * PageSize).Take(PageSize))
                            {
                                <tr class="@(day.WaitingRequests > 0 ? "has-demand" : null)">
                                    <th scope="row">@day.Date.ToString("ddd d. M.")</th>
                                    @if (!data.IsHistory)
                                    {
                                        <td>@L[$"Analysis_Date_{data.Availability(day.Date)}"]</td>
                                    }
                                    <td>@day.BookedSpots</td>
                                    <td><div class="planning-analysis__bar"><progress value="@day.BookedSpots" max="@data.ActiveSpots" aria-label="@L["Analysis_Share"]"></progress><span>@day.BookingPercent(data.ActiveSpots) %</span></div></td>
                                    <td>@(data.ActiveSpots - day.BookedSpots)</td>
                                    @if (!data.IsHistory)
                                    {
                                        <td>@day.WaitingRequests</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <nav class="planning-analysis__pagination" aria-label="@L["Analysis_Pagination"]">
                    <FluentButton Disabled="@(_page == 0)" OnClick="@(() => _page--)">@L["Analysis_Previous"]</FluentButton>
                    <span>@L["Analysis_Page", _page + 1, PageCount]</span>
                    <FluentButton Disabled="@(_page + 1 >= PageCount)" OnClick="@(() => _page++)">@L["Analysis_Next"]</FluentButton>
                </nav>
            </section>
        }
    }
</main>

@code {
    private int _period = -28;
    private const int PageSize = 14;
    private int _page;
    private int PageCount => Math.Max(1, ((_data?.Days.Count ?? 0) + PageSize - 1) / PageSize);
    private bool _capacityWeekly;
    private IReadOnlyList<CapacityPoint> _capacityPoints = [];
    private sealed record CapacityPoint(string Label, double Percent);

    private RenderFragment BucketChart(IReadOnlyList<PlanningChartBucket> buckets) => @<div class="planning-chart__bars">
        @if (buckets.Sum(b => b.Count) == 0)
        {
            <p class="planning-chart__empty">@L["Analysis_ChartEmpty"]</p>
        }
        else
        {
            @foreach (var bucket in buckets)
            {
                <div class="planning-chart__bar-row">
                    <span>@L[$"Analysis_Bucket_{bucket.Key}"]</span>
                    <progress value="@bucket.Count" max="@Math.Max(1, buckets.Max(b => b.Count))" aria-label="@L[$"Analysis_Bucket_{bucket.Key}"]"></progress>
                    <strong>@bucket.Count</strong>
                </div>
            }
        }
    </div>;

    private DateOnly _from;
    private DateOnly _to;
    private bool _loading;
    private bool _failed;
    private PlanningAnalysisDto? _data;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (_loading) return;
        _loading = true;
        _failed = false;
        try
        {
            var zone = await SiteSettings.GetTimeZoneAsync();
            var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, zone).DateTime);
            var policy = await ParkingSettings.GetCurrentPolicyAsync();
            var horizon = Math.Clamp(policy.ReservationHorizonDays, 1, 366);
            _from = _period < 0 ? today.AddDays(_period) : today;
            _to = _period < 0 ? today.AddDays(-1)
                : today.AddDays(_period == 0 ? horizon : Math.Min(_period - 1, horizon));
            _data = await Dashboard.GetPlanningAnalysisAsync(_from, _to);
            _page = 0;
            _capacityWeekly = _data.Days.Count > 28;
            _capacityPoints = _data.Days.Chunk(_capacityWeekly ? 7 : 1)
                .Select(days => new CapacityPoint(days[0].Date.ToString("d.M."),
                    _data.ActiveSpots == 0 ? 0 : days.Average(d => d.BookedSpots) * 100 / _data.ActiveSpots))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load planning analysis");
            _failed = true;
        }
        finally { _loading = false; }
    }
}
