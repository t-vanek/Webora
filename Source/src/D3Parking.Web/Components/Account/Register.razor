@page "/register"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject IAccountService AccountService
@inject ILogger<Register> Logger
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Register_Title"]</PageTitle>

<AuthTabs Active="AuthTabs.AuthTab.Register" />

@if (_registered)
{
    @*  Potvrzení místo formuláře: velký zelený znak (Sherpa symbol na zelené ploše — jediné
        párování, které brandbook u zelené povoluje), titulek a CTA zpět na přihlášení.  *@
    <div class="auth-done">
        <span class="auth-done__ic">
            <FluentIcon Value="@(new Icons.Filled.Size32.CheckmarkCircle())" Color="Color.Custom" CustomColor="#023444" />
        </span>
        <h1 class="auth-done__title">@L["Register_Success_Title"]</h1>
        <p class="auth-done__text">@L["Register_Success"]</p>
        <a class="auth-submit auth-submit--inline" href="login">@L["Register_Success_Cta"]</a>
    </div>
}
else
{
    <header class="auth-head">
        <h1 class="auth-head__title">@L["Register_Heading"]</h1>
        <p class="auth-head__sub">@L["Register_Subtitle"]</p>
    </header>

    @*  Static SSR form — native InputText fields derive their submitted names from the binding
        expressions ("Input.Email"), matching the [SupplyParameterFromForm] property paths.
        The password-reveal buttons and the strength meter are progressive enhancements from
        app.js; without JS the form is still fully usable.  *@
    <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register" class="auth-form">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-alert auth-alert--error" role="alert">
                <FluentIcon Value="@(new Icons.Filled.Size20.ErrorCircle())" Color="Color.Custom" CustomColor="currentColor" />
                <span>@_error</span>
            </div>
        }

        <div class="auth-field">
            <div class="auth-field__labelrow">
                <label class="auth-field__label" for="reg-name">@L["Register_DisplayName"]</label>
                <span class="auth-field__optional">@L["Auth_Optional"]</span>
            </div>
            <div class="auth-field__box">
                <FluentIcon Value="@(new Icons.Regular.Size20.Person())" Color="Color.Custom" CustomColor="currentColor" Class="auth-field__icon" />
                <InputText id="reg-name"
                           @bind-Value="Input.DisplayName"
                           autocomplete="name" />
            </div>
        </div>

        <div class="auth-field">
            <label class="auth-field__label" for="reg-email">@L["Register_Email"]</label>
            <div class="auth-field__box">
                <FluentIcon Value="@(new Icons.Regular.Size20.Mail())" Color="Color.Custom" CustomColor="currentColor" Class="auth-field__icon" />
                <InputText id="reg-email"
                           @bind-Value="Input.Email"
                           type="email"
                           autocomplete="username"
                           required
                           placeholder="email@example.com" />
            </div>
            <ValidationMessage For="() => Input.Email" />
        </div>

        <div class="auth-field">
            <label class="auth-field__label" for="reg-password">@L["Register_Password"]</label>
            <div class="auth-field__box">
                <FluentIcon Value="@(new Icons.Regular.Size20.LockClosed())" Color="Color.Custom" CustomColor="currentColor" Class="auth-field__icon" />
                <InputText id="reg-password"
                           @bind-Value="Input.Password"
                           type="password"
                           autocomplete="new-password"
                           required
                           data-strength />
                <button type="button" class="auth-field__reveal" data-pw-toggle
                        aria-pressed="false" aria-label="@L["Auth_ShowPassword"]"
                        data-label-show="@L["Auth_ShowPassword"]" data-label-hide="@L["Auth_HidePassword"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Eye())" Color="Color.Custom" CustomColor="currentColor" Class="auth-field__eye auth-field__eye--show" />
                    <FluentIcon Value="@(new Icons.Regular.Size20.EyeOff())" Color="Color.Custom" CustomColor="currentColor" Class="auth-field__eye auth-field__eye--hide" />
                </button>
            </div>
            <div class="auth-strength" data-score="0" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <p class="auth-field__hint">@L["Register_PasswordHint"]</p>
            <ValidationMessage For="() => Input.Password" />
        </div>

        <div class="auth-field">
            <label class="auth-field__label" for="reg-confirm">@L["Register_ConfirmPassword"]</label>
            <div class="auth-field__box">
                <FluentIcon Value="@(new Icons.Regular.Size20.LockClosed())" Color="Color.Custom" CustomColor="currentColor" Class="auth-field__icon" />
                <InputText id="reg-confirm"
                           @bind-Value="Input.ConfirmPassword"
                           type="password"
                           autocomplete="new-password"
                           required />
                <button type="button" class="auth-field__reveal" data-pw-toggle
                        aria-pressed="false" aria-label="@L["Auth_ShowPassword"]"
                        data-label-show="@L["Auth_ShowPassword"]" data-label-hide="@L["Auth_HidePassword"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Eye())" Color="Color.Custom" CustomColor="currentColor" Class="auth-field__eye auth-field__eye--show" />
                    <FluentIcon Value="@(new Icons.Regular.Size20.EyeOff())" Color="Color.Custom" CustomColor="currentColor" Class="auth-field__eye auth-field__eye--hide" />
                </button>
            </div>
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>

        <div class="auth-field">
            <div class="auth-field__labelrow">
                <label class="auth-field__label" for="reg-plate">@L["Register_LicensePlate"]</label>
                <span class="auth-field__optional">@L["Auth_Optional"]</span>
            </div>
            <div class="auth-field__box">
                <FluentIcon Value="@(new Icons.Regular.Size20.VehicleCar())" Color="Color.Custom" CustomColor="currentColor" Class="auth-field__icon" />
                <InputText id="reg-plate"
                           @bind-Value="Input.LicensePlate"
                           maxlength="16"
                           autocomplete="off" />
            </div>
            <p class="auth-field__hint">@L["Register_LicensePlateHint"]</p>
            <ValidationMessage For="() => Input.LicensePlate" />
        </div>

        <button type="submit" class="auth-submit">@L["Register_Submit"]</button>
    </EditForm>

    @*  Bez tohohle je registrace pro člověka z firemního adresáře slepá ulička: vyplní e-mail
        a heslo, založí si lokální účet s heslem, o kterém adresář neneví — a přihlášení přes
        Microsoft ho pak odmítne, protože e-mail ještě nepotvrdil. Míří na stejný endpoint jako
        tlačítko na přihlášení, jen to říká jinak. *@
    <ExternalSignInButton LabelKey="Register_External" ReturnUrl="/" />

    <footer class="auth-foot">
        <p>@L["Register_HaveAccount"] <a href="login">@L["Register_SignIn"]</a></p>
    </footer>
}

@code {
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    private bool _registered;
    private string? _error;

    private async Task RegisterUser()
    {
        var result = await AccountService.RegisterAsync(Input.Email, Input.Password, Input.DisplayName, Input.LicensePlate);
        if (result.Succeeded)
        {
            Logger.LogInformation("Registered account {Email}", Input.Email);
            _registered = true;
            return;
        }

        _error = string.Join(" ", result.Errors);
    }

    private sealed class InputModel
    {
        public string? DisplayName { get; set; }

        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Required))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Email_Invalid))]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Required))]
        [StringLength(100, MinimumLength = 8, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Password_Length))]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.ConfirmPassword_Mismatch))]
        public string ConfirmPassword { get; set; } = string.Empty;

        [StringLength(16, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Plate_Length))]
        public string? LicensePlate { get; set; }
    }
}
