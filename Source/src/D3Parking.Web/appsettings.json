// D3Parking: komentáře vysvětlují nastavení a aplikace je ignoruje. Měňte hodnoty za dvojtečkou, ne názvy
// položek. Podrobný návod: docs/CONFIGURATION.md a docs/ADMIN-GUIDE.md.
// Výchozí nastavení serveru v release. V produkci měňte config/appsettings.json a secrets/secrets.json mimo
// releases; tyto sdílené soubory mají přednost. Výchozí localhost, .local a * nejsou hotové produkční
// nastavení.
// Entra ID nastavujte v aplikaci v Nastavení → Entra ID. Sekce EntraId zde záměrně chybí: zadaný konfigurační
// klíč má přednost před DB a uzamkne odpovídající pole v administraci. Přihlašovací ClientSecret a SCIM
// BearerToken patří do secrets, pokud je IT musí vynutit konfigurací. Uložená tajemství vyžadují trvalou
// klíčenku data/keys.
{
  // Vyhledání zeměpisných souřadnic podle adresy. Potřebuje dostupný server této služby.
  "Geocoding": {
    // Základní adresa Nominatim serveru, bez /search. Z tohoto serveru aplikace získává souřadnice.
    // Provozovatel musí použití povolit; pro firemní provoz domluvte vhodnou službu a její limity.
    "NominatimBaseUrl": "https://nominatim.openstreetmap.org",
    // Představení aplikace geokódovací službě, např. D3Parking/1.0 (kontakt: parking@firma.cz). Použijte
    // skutečný kontakt a formát platné HTTP User-Agent hlavičky.
    "UserAgent": "D3Parking/1.0 (parking)"
  },
  // Jak se počítá vzdálenost mezi dvěma body. Nemění cenu rezervace na dynamickou.
  "Distance": {
    // Haversine = vzdálenost vzdušnou čarou, funguje bez internetu. Osrm = vzdálenost po silnici, potřebuje
    // dostupný OSRM server; při chybě použije vzdušnou vzdálenost.
    "Provider": "Haversine",
    // Základní URL směrovací služby OSRM. Použije se jen pro Provider = Osrm. Veřejná ukázková služba není
    // zárukou dostupnosti pro firmu; provoz domluvte s IT.
    "OsrmBaseUrl": "https://router.project-osrm.org"
  },
  // Důvěra k serverům stojícím před aplikací (proxy). Při přímém přístupu na Kestrel ponechte výchozí
  // hodnoty.
  "ForwardedHeaders": {
    // false = nevěřit libovolnému prostředníkovi. Ponechte false; true je v produkci odmítnuté, protože cizí
    // požadavek by mohl tvrdit falešnou adresu nebo protokol.
    "TrustAllProxies": false,
    // Seznam konkrétních IP důvěryhodných proxy, např. ["10.20.0.10"]. Nejsou to IP uživatelů. [] nepřidává
    // další proxy k výchozí místní důvěře.
    "KnownProxies": [],
    // Sítě důvěryhodných proxy v CIDR zápisu, např. ["10.20.0.0/24"]. Rozsah určí IT; všechny jeho adresy
    // dostanou důvěru. [] nepřidává další sítě.
    "KnownNetworks": []
  },
  // Odesílání e-mailů přes poštovní server. Údaje dá správce pošty. Bez dostupného SMTP zprávy zůstávají ve
  // frontě a mohou později selhat.
  "Smtp": {
    // Jméno SMTP serveru, např. smtp.firma.cz, bez https:// a bez portu. localhost znamená poštu na stejném
    // počítači; sama se tím žádná poštovní služba nevytvoří.
    "Host": "localhost",
    // Číslo vstupu do SMTP serveru (1 až 65535). Často 587 pro StartTls, 465 pro SslOnConnect nebo 25 pro
    // firemní relay. Správnou dvojici port + Security určí správce pošty.
    "Port": 25,
    // Jak dlouho čekat na jednu SMTP síťovou operaci, v sekundách. Povoleno 5 až 300; 30 je běžná výchozí
    // hodnota. Není to interval opakování zpráv.
    "TimeoutSeconds": 30,
    // StartTls = spojení se povinně přepne na šifrované; SslOnConnect = šifruje se od začátku; None = bez
    // šifrování.
    // Auto vybírá režim podle serveru/portu a nezaručuje povinné TLS. Produkce s Basic nebo OAuth2 vyžaduje
    // StartTls či SslOnConnect; průvodce Auto nenabízí.
    "Security": "None",
    // None = relay nevyžaduje přihlášení (musí povolit tento server); Basic = UserName + Password; OAuth2 =
    // token získaný pomocí nastavení OAuth2 a schránka UserName.
    "Authentication": "None",
    // E-mail, který příjemce uvidí jako odesílatele, např. parking@firma.cz. SMTP server musí účtu nebo relay
    // dovolit odesílat právě z této adresy.
    "SenderEmail": "no-reply@d3parking.local",
    // Čitelný název odesílatele v poště, např. Firemní parkování. Nemění přihlášení ani oprávnění poštovní
    // schránky.
    "SenderName": "D3Parking",
    // Používá se jen při Authentication = OAuth2. Aplikaci a oprávnění pro automatické odesílání musí předem
    // připravit správce pošty/identity.
    "OAuth2": {
      // HTTPS adresa, kde poskytovatel vydává přístupové tokeny. Dodá správce identity. Nejde o SMTP server
      // ani adresu přihlášení uživatele.
      "TokenEndpoint": "",
      // Identifikátor registrované aplikace od správce identity. Není to e-mail ani heslo. Registrace musí
      // podporovat client_credentials a mít potřebná oprávnění.
      "ClientId": "",
      // Tajný klíč registrované aplikace. Skutečnou hodnotu ukládejte pouze do secrets.json. Sledujte jeho
      // platnost; po expiraci se token nezíská.
      "ClientSecret": "",
      // Rozsah oprávnění, o který aplikace žádá. Přesný text dodá poskytovatel/správce identity; nevymýšlejte
      // ho. Prázdná hodnota parametr scope neposílá.
      "Scope": ""
    }
  },
  // Záznamy o chodu serveru. Pomáhají zjistit, proč něco nefunguje. V instalaci se navíc automaticky zapisuje
  // do logs mimo release.
  "Serilog": {
    // Nejnižší závažnost, která se zapíše. Podrobnější úroveň znamená více řádků a větší logy.
    "MinimumLevel": {
      // Information = běžné provozní zprávy; Warning = upozornění a chyby; Error = chyby. Debug/Verbose
      // používejte jen dočasně při hledání problému.
      "Default": "Information",
      // Výjimky pro konkrétní části systému; omezují velké množství technických zpráv.
      "Override": {
        // Warning zapisuje upozornění/chyby webového frameworku. Information přidá více zpráv o požadavcích.
        "Microsoft.AspNetCore": "Warning",
        // Warning omezuje zprávy databázové knihovny. Information může výrazně zvětšit log kvůli SQL
        // operacím.
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    // Kam log posílat. Tento seznam přidává konzoli; souborový log instalace zapíná také kód aplikace.
    "WriteTo": [
      {
        // Console = vypisovat do konzole procesu. U Windows služby není běžné okno vidět; čtěte soubory v
        // logs.
        "Name": "Console",
        // Doplňující nastavení tohoto výstupu logu. Běžně není nutné měnit.
        "Args": {
          // Vzhled řádku: Timestamp je čas, Level závažnost, Message zpráva, NewLine nový řádek a Exception
          // chyba. Značky ve složených závorkách ponechte.
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    // FromLogContext připojuje kontext operace, pokud jej aplikace poskytne. Ponechte pro snazší hledání
    // souvisejících událostí.
    "Enrich": [
      "FromLogContext"
    ]
  },
  // Obecné úrovně .NET logování. Hlavní serverové logování zde řídí Serilog; klient v prohlížeči používá
  // sekci Logging.
  "Logging": {
    // Filtr zpráv podle závažnosti. Více podrobností může znamenat více provozních údajů v logu.
    "LogLevel": {
      // Information = běžné zprávy a chyby; Warning = jen upozornění a chyby; Error = jen chyby. Pro obvyklý
      // provoz ponechte Information.
      "Default": "Information",
      // Warning omezuje technické zprávy webového frameworku. U klienta se filtr uplatní pouze, pokud zprávy
      // s touto kategorií vznikají.
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Povolená jména serveru, např. parking.firma.cz;127.0.0.1. Bez https://, portu a cesty; oddělujte
  // středníkem. Hvězdička povoluje vše a v produkci je odmítnuta.
  "AllowedHosts": "*"
}
