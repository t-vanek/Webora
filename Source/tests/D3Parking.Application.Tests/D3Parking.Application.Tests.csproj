<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddDefaultTokenProviders/AddDataProtection for the account-security test harness live in
         the ASP.NET Core shared framework, not in any NuGet package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\D3Parking.Application\D3Parking.Application.csproj" />
    <!-- The concurrency tests exercise the real services against SQL Server (see
         ReservationConcurrencyTests); unit tests keep depending on Application/Domain only. -->
    <ProjectReference Include="..\..\src\D3Parking.Infrastructure\D3Parking.Infrastructure.csproj" />
    <!-- The external sign-in guards live with the endpoints that use them, in the web layer.
         Reached here through InternalsVisibleTo (see D3Parking.Web.csproj). -->
    <ProjectReference Include="..\..\src\D3Parking.Web\D3Parking.Web.csproj" />
  </ItemGroup>

</Project>
