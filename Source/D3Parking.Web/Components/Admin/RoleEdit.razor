@page "/admin/roles/{Id:guid}"
@attribute [HasPermission(Permissions.Roles.View)]
@rendermode InteractiveServer
@inject IRoleAdminService RoleAdmin
@inject IPermissionGroupAdminService Groups
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Admin_RoleEdit_Title"]</PageTitle>

<FluentStack Class="page-shell" Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentAnchor Href="admin/roles" Appearance="Appearance.Hypertext">&laquo; @L["Admin_Roles_Title"]</FluentAnchor>

    @if (_detail is null)
    {
        @if (_loaded)
        {
            <FluentLabel Typo="Typography.Body">@L["Admin_Roles_NotFound"]</FluentLabel>
        }
        else
        {
            <div class="loading"><FluentProgressRing /></div>
        }
    }
    else
    {
        <div class="admin-head">
            <div class="admin-head__titles">
                <div class="admin-head__title-row">
                    <FluentLabel Typo="Typography.PageTitle">@AuthorizationDisplay.RoleName(L, _detail.Name)</FluentLabel>
                    @if (_detail.IsDefault)
                    {
                        <FluentBadge Appearance="Appearance.Neutral">@L["Admin_Roles_Default"]</FluentBadge>
                    }
                </div>
                <p class="admin-head__intro">@AuthorizationDisplay.RoleDescription(L, _detail.Name)</p>
            </div>
            <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Create)" Context="duplicate">
                <FluentAnchor Href="@($"admin/roles/create?from={Id}")" Appearance="Appearance.Outline">
                    @L["Admin_RoleEdit_Duplicate"]
                </FluentAnchor>
            </AuthorizeView>
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <FluentMessageBar Intent="MessageIntent.Success" Type="MessageType.MessageBar">@_message</FluentMessageBar>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar">@_error</FluentMessageBar>
        }

        @if (!_detail.IsDefault && _canEdit)
        {
            <FluentCard Class="profile-section">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                    <FluentLabel Typo="Typography.Subject">@L["Admin_RoleEdit_Overview"]</FluentLabel>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Bottom">
                        <FluentTextField @bind-Value="_name" Label="@L["Admin_Roles_Name"]" Style="max-width:480px;flex:1" />
                        <FluentButton OnClick="RenameAsync" Appearance="Appearance.Outline">@L["Admin_RoleEdit_Rename"]</FluentButton>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        }

        @* Composition on the left, the people it applies to on the right. Stacked, the members sat
           below a picker as tall as the group catalog, so "who does this change hit" was off screen
           at exactly the moment the composition was being edited. Side by side both stay in view;
           under 1100px the columns fall back into one, composition first. *@
        <div class="role-split">
            <div class="role-split__main">
                <FluentCard Class="profile-section role-split__card">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                        <FluentLabel Typo="Typography.Subject">@L["Admin_RoleEdit_Composition"]</FluentLabel>
                        <p class="admin-head__intro">@L["Admin_RoleEdit_CompositionIntro"]</p>

                        @if (_detail.IsDefault)
                        {
                            @* Built-in compositions are re-asserted by the seeder on every start, so an edit
                               here would quietly revert. Say that, and point at the way that does stick. *@
                            <FluentMessageBar Intent="MessageIntent.Info" Type="MessageType.MessageBar" AllowDismiss="false">
                                @L["Admin_RoleEdit_BuiltInNote"]
                            </FluentMessageBar>
                        }
                        else if (!_canEdit)
                        {
                            <FluentLabel Typo="Typography.Body" Color="Color.Neutral">@L["Admin_RoleEdit_ReadOnly"]</FluentLabel>
                        }

                        <GroupPicker Groups="_groups"
                                     Selected="_selected"
                                     ReadOnly="_readOnly"
                                     Grantable="_grantable"
                                     SelectionChanged="StateHasChanged" />

                        @if (!_readOnly)
                        {
                            <div class="perm-editor__actions">
                                <FluentButton OnClick="SaveGroupsAsync" Appearance="Appearance.Accent" Disabled="@(!IsDirty)">
                                    @L["Admin_Save"]
                                </FluentButton>
                                <FluentButton OnClick="ResetSelection" Appearance="Appearance.Stealth" Disabled="@(!IsDirty)">
                                    @L["Admin_Cancel"]
                                </FluentButton>
                            </div>
                        }
                    </FluentStack>
                </FluentCard>
            </div>

            <aside class="role-split__side">
                <FluentCard Class="profile-section role-split__card">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                        <FluentLabel Typo="Typography.Subject">
                            @* What the search matched, not what this page draws — with a term typed in,
                               the role's own member count is the one number that would be a lie here. *@
                            @L["Admin_RoleEdit_Members"] <span class="count-chip">@_memberTotal</span>
                        </FluentLabel>

                        @if (_detail.MemberCount == 0)
                        {
                            <div class="empty-state">@L["Admin_RoleEdit_NoMembers"]</div>
                        }
                        else
                        {
                            @* A member count alone cannot answer "who blocks this deletion" or "who is
                               about to gain this permission" — the names have to be one click from the
                               role, and searchable once there are more of them than fit a screen. *@
                            <FluentSearch Id="role-member-search" @bind-Value="_memberSearch" @bind-Value:after="SearchMembersAsync"
                                          Immediate="true" ImmediateDelay="300"
                                          Placeholder="@L["Admin_Users_SearchPlaceholder"]" />

                            @if (_members is null)
                            {
                                <div class="loading"><FluentProgressRing /></div>
                            }
                            else if (_members.Count == 0)
                            {
                                <div class="empty-state">@L["Admin_RoleEdit_NoMemberMatch"]</div>
                            }
                            else
                            {
                                <div class="admin-panel role-split__table">
                                    <FluentDataGrid Items="@_members.AsQueryable()" TGridItem="RoleMember"
                                                    GridTemplateColumns="minmax(0, 1fr) minmax(0, 1fr)">
                                        <TemplateColumn Title="@L["Admin_Users_Name"]">
                                            <a href="@($"admin/users/{context.Id}")">
                                                @(string.IsNullOrWhiteSpace(context.DisplayName) ? context.Email : context.DisplayName)
                                            </a>
                                        </TemplateColumn>
                                        <PropertyColumn Property="@(m => m.Email)" Title="@L["Admin_Users_Email"]" />
                                    </FluentDataGrid>
                                </div>
                                @if (_memberTotal > MemberPageSize)
                                {
                                    <div class="pager">
                                        <FluentButton Appearance="Appearance.Outline" Disabled="@(_memberPage == 0)"
                                                      OnClick="() => GoToMemberPageAsync(_memberPage - 1)">@L["Common_PrevPage"]</FluentButton>
                                        <span>@L["Common_PageOf", _memberPage + 1, MemberPageCount]</span>
                                        <FluentButton Appearance="Appearance.Outline" Disabled="@(_memberPage >= MemberPageCount - 1)"
                                                      OnClick="() => GoToMemberPageAsync(_memberPage + 1)">@L["Common_NextPage"]</FluentButton>
                                    </div>
                                }
                            }
                        }
                    </FluentStack>
                </FluentCard>
            </aside>
        </div>

        @if (!_detail.IsDefault)
        {
            <AuthorizeView Policy="@PermissionPolicies.For(Permissions.Roles.Delete)" Context="delete">
                <div class="danger-zone">
                    <div class="danger-zone__title">@L["Admin_UserEdit_DangerZone"]</div>
                    @* The role's own count, not the page's: a search that hides the last holder must
                       not make a role that cannot be deleted look deletable. *@
                    @if (_detail.MemberCount > 0)
                    {
                        <p class="danger-zone__note">@PluralText.For(L, "Admin_RoleEdit_DeleteBlocked", _detail.MemberCount)</p>
                    }
                    else if (_confirmDelete)
                    {
                        <FluentMessageBar Intent="MessageIntent.Error" Type="MessageType.MessageBar" AllowDismiss="false">
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                <span>@L["Admin_RoleEdit_DeleteConfirm"]</span>
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                                    <FluentButton OnClick="DeleteAsync" Appearance="Appearance.Accent">
                                        @L["Admin_RoleEdit_DeleteYes"]
                                    </FluentButton>
                                    <FluentButton OnClick="() => _confirmDelete = false" Appearance="Appearance.Outline">
                                        @L["Admin_Cancel"]
                                    </FluentButton>
                                </FluentStack>
                            </FluentStack>
                        </FluentMessageBar>
                    }
                    else
                    {
                        <FluentButton OnClick="() => _confirmDelete = true" Appearance="Appearance.Outline">
                            @L["Admin_RoleEdit_Delete"]
                        </FluentButton>
                    }
                </div>
            </AuthorizeView>
        }
    }
</FluentStack>

@code {
    /// <summary>
    /// How many holders the side panel shows at once. Smaller than the account directory's page on
    /// purpose: this is a column beside the composition, not a screen of its own, and a table taller
    /// than the picker beside it would push the save buttons out of view.
    /// </summary>
    private const int MemberPageSize = 10;

    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private RoleDetail? _detail;
    private IReadOnlyList<PermissionGroupSummary> _groups = [];
    private bool _loaded;

    private IReadOnlyList<RoleMember>? _members;
    private int _memberTotal;
    private int _memberPage;
    private string? _memberSearch;

    private string? _name;
    private bool _readOnly;
    private bool _canEdit;
    private Guid _actorId;
    private IReadOnlySet<string>? _grantable;
    private HashSet<Guid> _selected = [];
    private bool _confirmDelete;
    private string? _message;
    private string? _error;

    private Guid _loadedId;

    private bool IsDirty => _detail is not null
        && !_selected.SetEquals(_detail.Groups.Select(g => g.Id));

    private int MemberPageCount => _memberTotal == 0 ? 1 : (_memberTotal + MemberPageSize - 1) / MemberPageSize;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        _actorId = Guid.TryParse(UserManager.GetUserId(state.User), out var id) ? id : Guid.Empty;
        _canEdit = state.User.HasClaim(D3ParkingClaimTypes.Permission, Permissions.Roles.Edit);

        // Mirrors the server's rule so the picker shows what this administrator can actually
        // compose from instead of offering choices the save would reject.
        _grantable = state.User.Claims
            .Where(c => c.Type == D3ParkingClaimTypes.Permission)
            .Select(c => c.Value)
            .ToHashSet(StringComparer.Ordinal);

        _groups = await Groups.ListAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload when the route parameter changes on a reused instance — otherwise the screen
        // would keep showing the previous role while the actions target the new Id.
        if (_loadedId != Id)
        {
            _loadedId = Id;
            _message = _error = null;
            _confirmDelete = false;
            // A term and a page number belong to the role they were typed on, not to the component.
            _memberSearch = null;
            _memberPage = 0;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _detail = await RoleAdmin.GetAsync(Id);
        _loaded = true;
        if (_detail is not null)
        {
            _name = _detail.Name;
            _selected = _detail.Groups.Select(g => g.Id).ToHashSet();
            _readOnly = _detail.IsDefault || !_canEdit;
            await LoadMembersAsync();
        }
    }

    private async Task LoadMembersAsync()
    {
        var page = await RoleAdmin.ListMembersPageAsync(Id, _memberSearch, _memberPage, MemberPageSize);
        _members = page.Items;
        _memberTotal = page.TotalCount;
        // Taken back from the result: the service walks the index back when the page that was asked
        // for no longer exists.
        _memberPage = page.PageIndex;
    }

    private async Task SearchMembersAsync()
    {
        // A new search starts at the front; page 3 of the old result set means nothing in the new one.
        _memberPage = 0;
        await LoadMembersAsync();
    }

    private async Task GoToMemberPageAsync(int pageIndex)
    {
        _memberPage = Math.Clamp(pageIndex, 0, MemberPageCount - 1);
        await LoadMembersAsync();
    }

    private void ResetSelection()
    {
        if (_detail is not null)
        {
            _selected = _detail.Groups.Select(g => g.Id).ToHashSet();
        }
    }

    private async Task RenameAsync() =>
        await RunAsync(() => RoleAdmin.RenameAsync(Id, _name ?? string.Empty), L["Admin_RoleEdit_Renamed"]);

    private async Task SaveGroupsAsync() =>
        await RunAsync(() => RoleAdmin.SetGroupsAsync(Id, _selected.ToArray(), _actorId), L["Admin_RoleEdit_PermsSaved"]);

    private async Task DeleteAsync()
    {
        var result = await RoleAdmin.DeleteAsync(Id, _actorId);
        if (result.Succeeded)
        {
            Nav.NavigateTo("admin/roles");
            return;
        }

        _confirmDelete = false;
        _error = string.Join(" ", result.Errors);
    }

    private async Task RunAsync(Func<Task<AccountResult>> action, string successMessage)
    {
        _message = _error = null;
        var result = await action();
        if (result.Succeeded)
        {
            _message = successMessage;
            await LoadAsync();
        }
        else
        {
            _error = string.Join(" ", result.Errors);
        }
    }
}
