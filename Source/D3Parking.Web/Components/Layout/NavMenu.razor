@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@implements IDisposable
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav
@inject ProtectedLocalStorage Storage

@* Interactive island (render mode set at the call site in MainLayout). The sidebar is our own
   markup on plain NavLinks — deliberately not FluentNavMenu, whose internals fought every step
   of this app's styling (content-sized tabs host, the broken built-in collapse, icon-less group
   rails). Owning the markup gives us both states cheaply and predictably.

   Desktop (>768px): two states the user switches at the bottom and the choice persists.
   Expanded (~220px): flat sections with headers, an icon on every item, the active item as a
   violet fill. Rail (~76px): icon with a SHORT label underneath — with Czech labels an unlabelled
   icon strip is a guessing game. Sections shrink to separators.

   Mobile (≤768px): the off-canvas drawer, always in the expanded look (there is no reason to
   save width on an overlay). Toggle bar under the header opens it; backdrop or navigation closes
   it. Account and sign-out live in the header's avatar menu.

   Anonymous visitors get no menu at all — the landing page is the only destination and the
   header already carries the login/register links, so a sidebar with a single "Home" item was
   dead weight. Rendering nothing also hands the landing the full content width. *@

@if (!_authenticated)
{
    return;
}

<button type="button"
        class="nav-drawer-toggle"
        aria-expanded="@_drawerOpen"
        aria-controls="app-nav-drawer"
        @onclick="ToggleDrawer">
    <FluentIcon Value="@(new Icons.Regular.Size20.LineHorizontal3())" Color="Color.Custom" CustomColor="currentColor" />
    @L["Nav_Menu"]
</button>

@if (_drawerOpen)
{
    <div class="nav-drawer-backdrop" @onclick="CloseDrawer" aria-hidden="true"></div>
}

<div id="app-nav-drawer" class="nav-drawer @(_drawerOpen ? "nav-drawer--open" : string.Empty)">
    <nav class="side-nav @(_rail ? "side-nav--rail" : string.Empty)" aria-label="@L["Nav_Menu"]">
        <NavLink href="" Match="NavLinkMatch.All" class="side-nav__item" ActiveClass="side-nav__item--active"
                 aria-label="@L["Nav_Home"]">
            <FluentIcon Value="@(new Icons.Regular.Size20.Home())" Color="Color.Custom" CustomColor="currentColor" />
            <span class="side-nav__label">@L["Nav_Home"]</span>
            <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Home"]</span>
        </NavLink>

        @if (_canReserve || _canAchievements)
        {
            <div class="side-nav__section">
                <span class="side-nav__section-title">@L["Nav_Parking"]</span>
            </div>
            @* Exact match, unlike everywhere else: /parking is the parent path of achievements
               and the reports, so NavLink's default prefix matching lit the reservation entry on
               those pages too — two items filled violet at once, and neither one telling the truth
               about where you are. Nothing lives below /parking that lacks its own entry, so there
               is no child page left needing the parent lit for it. *@
            @if (_canReserve)
            {
                <NavLink href="parking" Match="NavLinkMatch.All" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_ParkingReserve"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.VehicleCar())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_ParkingReserve"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Reserve"]</span>
                </NavLink>
            }
            @if (_canAchievements)
            {
                <NavLink href="parking/achievements" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_ParkingAchievements"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Trophy())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_ParkingAchievements"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Achievements"]</span>
                </NavLink>
            }

            @* Vedle rezervací: hlášení o zablokovaném místě vzniká přímo z nich a tady se člověk
               dozví, jak dopadlo. *@
            @if (_canReserve)
            {
                <NavLink href="parking/reports" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_MyReports"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ClipboardTextEdit())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_MyReports"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_MyReports"]</span>
                </NavLink>
            }

            @* Nápověda vysvětluje parkovací pravidla, takže patří do stejné sekce. *@
            <NavLink href="help" class="side-nav__item" ActiveClass="side-nav__item--active"
                     aria-label="@L["Nav_Help"]">
                <FluentIcon Value="@(new Icons.Regular.Size20.QuestionCircle())" Color="Color.Custom" CustomColor="currentColor" />
                <span class="side-nav__label">@L["Nav_Help"]</span>
                <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Help"]</span>
            </NavLink>
        }

        @* Administration outgrew a single heading: thirteen items under one "ADMINISTRACE" label
           read as a pile rather than a menu. They fall into three plain groups — who may do what,
           the lot itself, and the site — so each gets its own heading. Headings rather than
           collapsible groups on purpose: the rail state already shrinks a section to a separator,
           and a second collapse mechanism would fight it for no gain at this list length. *@
        @if (_canAnyAccess)
        {
            <div class="side-nav__section">
                <span class="side-nav__section-title">@L["Nav_Section_Access"]</span>
            </div>
            @if (_canAdminUsers)
            {
                <NavLink href="admin/users" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_AdminUsers"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.People())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_AdminUsers"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Users"]</span>
                </NavLink>
            }
            @* One entry for both catalogs. Since roles and groups became two tabs of one screen,
               a second entry pointing at the same page only asked the reader to guess which of the
               two names holds what they came for — the tab strip answers that in place. *@
            @if (_canAdminRoles)
            {
                <NavLink href="admin/roles" class="@RolesItemClass" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_AdminRoles"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ShieldKeyhole())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_AdminRoles"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Roles"]</span>
                </NavLink>
            }
            @if (_canAdminRoles)
            {
                <NavLink href="admin/directory" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_AdminDirectory"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Building())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_AdminDirectory"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Directory"]</span>
                </NavLink>
            }
            @if (_canAudit)
            {
                <NavLink href="admin/audit" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_AdminAudit"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.History())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_AdminAudit"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Audit"]</span>
                </NavLink>
            }
        }

        @if (_canAnyLot)
        {
            <div class="side-nav__section">
                <span class="side-nav__section-title">@L["Nav_Section_Lot"]</span>
            </div>
            @if (_canViewAnalytics)
            {
                <NavLink href="admin/parking/dashboard" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_AdminLot"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.DataTrending())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_AdminLot"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Lot"]</span>
                </NavLink>
            }
            @if (_canManageSpots)
            {
                <NavLink href="admin/parking/spots" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_AdminParking"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Map())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_AdminParking"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Spots"]</span>
                </NavLink>
            }
            @if (_canManageFleet)
            {
                <NavLink href="admin/parking/fleet" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_AdminFleet"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.VehicleCar())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_AdminFleet"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Fleet"]</span>
                </NavLink>
            }
            @* The review queues used to be reachable only by deep link from another admin page — a
               reviewer who landed on the home screen had no way to find their work. One entry now,
               because the queues are one screen; it shows for either permission and the page opens
               on whichever queue the reviewer can act on. *@
            @if (_canReviewMismatches || _canReviewCollusion)
            {
                <NavLink href="admin/parking/oversight" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_AdminOversight"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ShieldTask())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_AdminOversight"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Oversight"]</span>
                </NavLink>
            }
            @if (_canManageVisitors)
            {
                <NavLink href="admin/parking/visitors" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_AdminVisitors"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.People())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_AdminVisitors"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Visitors"]</span>
                </NavLink>
            }
            @if (_canManageIncentives)
            {
                <NavLink href="admin/parking/settings" class="side-nav__item" ActiveClass="side-nav__item--active"
                         aria-label="@L["Nav_AdminParkingSettings"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Options())" Color="Color.Custom" CustomColor="currentColor" />
                    <span class="side-nav__label">@L["Nav_AdminParkingSettings"]</span>
                    <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Rules"]</span>
                </NavLink>
            }
        }

        @* Its own heading even though it holds one item: without it, site-wide settings sit under
           the lot heading and read as one more parking screen. *@
        @if (_canSettings)
        {
            <div class="side-nav__section">
                <span class="side-nav__section-title">@L["Nav_Section_System"]</span>
            </div>
            <NavLink href="admin/notifications" class="side-nav__item" ActiveClass="side-nav__item--active"
                     aria-label="@L["Nav_AdminNotifications"]">
                <FluentIcon Value="@(new Icons.Regular.Size20.Mail())" Color="Color.Custom" CustomColor="currentColor" />
                <span class="side-nav__label">@L["Nav_AdminNotifications"]</span>
                <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Notifications"]</span>
            </NavLink>
            <NavLink href="admin/settings" class="side-nav__item" ActiveClass="side-nav__item--active"
                     aria-label="@L["Nav_AdminSettings"]">
                <FluentIcon Value="@(new Icons.Regular.Size20.Settings())" Color="Color.Custom" CustomColor="currentColor" />
                <span class="side-nav__label">@L["Nav_AdminSettings"]</span>
                <span class="side-nav__short" aria-hidden="true">@L["Nav_Short_Settings"]</span>
            </NavLink>
        }

        <button type="button" class="side-nav__collapse" @onclick="ToggleRailAsync"
                title="@(_rail ? L["Nav_Expand"] : L["Nav_Collapse"])">
            <FluentIcon Value="@(_rail
                ? (Icon)new Icons.Regular.Size20.ChevronDoubleRight()
                : new Icons.Regular.Size20.ChevronDoubleLeft())" Color="Color.Custom" CustomColor="currentColor" />
            <span class="side-nav__label">@L["Nav_Collapse"]</span>
        </button>
    </nav>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private const string RailStorageKey = "nav-rail";

    private bool _drawerOpen;
    private bool _rail;
    private bool _authenticated;

    /// <summary>
    /// Whether the groups half of the authorization screen is the one on show. The roles entry
    /// stands for both catalogs, but the groups tab keeps its own route, and NavLink only ever
    /// matches the href it was handed — without this the menu would show nothing selected on the
    /// very page it navigated to.
    /// </summary>
    private bool _onGroupsRoute;

    private bool _canAdminUsers;
    private bool _canAdminRoles;
    private bool _canAudit;
    private bool _canSettings;
    private bool _canReserve;
    private bool _canAchievements;
    private bool _canManageSpots;
    private bool _canManageFleet;
    private bool _canReviewMismatches;
    private bool _canViewAnalytics;
    private bool _canManageVisitors;
    private bool _canManageIncentives;
    private bool _canReviewCollusion;

    // One flag per heading: a heading with nothing under it is a label for an empty list, which is
    // exactly what a permission-filtered menu produces if nobody checks.
    private bool _canAnyAccess;
    private bool _canAnyLot;

    /// <summary>
    /// Adds the active fill by hand on the groups route, where NavLink cannot supply it, and leaves
    /// it to NavLink everywhere else so the class is never written twice onto the same element.
    /// </summary>
    private string RolesItemClass =>
        _onGroupsRoute ? "side-nav__item side-nav__item--active" : "side-nav__item";

    private bool IsGroupsRoute() =>
        Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/')
            .EndsWith("permission-groups", StringComparison.OrdinalIgnoreCase);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void CloseDrawer() => _drawerOpen = false;

    private async Task ToggleRailAsync()
    {
        _rail = !_rail;
        await Storage.SetAsync(RailStorageKey, _rail);
    }

    protected override async Task OnInitializedAsync()
    {
        // The island persists across enhanced navigations, so the drawer has to close itself
        // when a link inside it navigates — otherwise it would still cover the new page.
        Nav.LocationChanged += OnLocationChanged;
        _onGroupsRoute = IsGroupsRoute();

        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _authenticated = user.Identity?.IsAuthenticated == true;

            bool Can(string permission) => user.HasClaim(D3ParkingClaimTypes.Permission, permission);

            _canAdminUsers = Can(Permissions.Users.View);
            _canAdminRoles = Can(Permissions.Roles.View);
            _canAudit = Can(Permissions.Audit.View);
            _canSettings = Can(Permissions.Settings.View);
            _canReserve = Can(Permissions.Parking.Reserve);
            _canAchievements = Can(Permissions.Parking.ViewAchievements);
            _canManageSpots = Can(Permissions.Parking.ManageSpots);
            _canManageFleet = Can(Permissions.Parking.ManageFleet);
            _canReviewMismatches = Can(Permissions.Parking.ReviewMismatches);
            _canViewAnalytics = Can(Permissions.Parking.ViewAnalytics);
            _canManageVisitors = Can(Permissions.Parking.ManageVisitors);
            _canManageIncentives = Can(Permissions.Parking.ManageIncentives);
            _canReviewCollusion = Can(Permissions.Parking.ReviewCollusion);

            // PermissionGroups.View is not asked about: the catalog it opens is gated on Roles.View,
            // so it can never be the one permission that earns somebody this heading.
            _canAnyAccess = _canAdminUsers || _canAdminRoles || _canAudit;
            _canAnyLot = _canManageSpots || _canManageFleet || _canReviewMismatches
                || _canViewAnalytics || _canManageVisitors || _canManageIncentives || _canReviewCollusion;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // ProtectedLocalStorage needs JS, so the stored rail preference can only be read after
        // the first render; the expanded default flashes for one frame at most.
        try
        {
            var stored = await Storage.GetAsync<bool>(RailStorageKey);
            if (stored.Success && stored.Value != _rail)
            {
                _rail = stored.Value;
                StateHasChanged();
            }
        }
        catch
        {
            // A cosmetic preference must never take the circuit down. GetAsync throws when the
            // payload can't be unprotected (Data Protection key ring rotated after a redeploy) or
            // when the value is corrupt — drop the stored value so the next visit reads cleanly.
            try
            {
                await Storage.DeleteAsync(RailStorageKey);
            }
            catch
            {
                // Even the cleanup is best-effort (e.g. the circuit is already disconnecting).
            }
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // NavLink redraws itself, so the menu only needs a render when something it owns changed:
        // the drawer covering the new page, or the roles entry's stand-in highlight.
        var onGroups = IsGroupsRoute();
        if (!_drawerOpen && onGroups == _onGroupsRoute)
        {
            return;
        }

        _drawerOpen = false;
        _onGroupsRoute = onGroups;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
