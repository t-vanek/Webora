@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject IStringLocalizer<SharedResource> L

@* FluentDesignTheme has no visible output — it emits the design tokens onto the document so any
   Fluent component on the page resolves them. The button toggles its Mode between Light and Dark;
   StorageName="theme" persists the choice to localStorage so it survives reloads and navigations.

   CustomColor feeds the brand's violet (#884DFF, brand book p. 60) in as the accent seed, so Fluent
   derives its whole accent ramp — buttons, focus rings, links, selection — from the brand instead
   of its default blue. Sherpa Blue and the lawn green are applied as surfaces in app.css. *@
<FluentDesignTheme StorageName="theme" @bind-Mode="_mode" CustomColor="#884DFF" />

<FluentButton Appearance="Appearance.Stealth"
              Title="@(_mode == DesignThemeModes.Dark ? L["Layout_ThemeSwitchToLight"] : L["Layout_ThemeSwitchToDark"])"
              OnClick="Toggle">
    <FluentIcon Value="@(_mode == DesignThemeModes.Dark
        ? (Icon)new Icons.Regular.Size20.WeatherSunny()
        : new Icons.Regular.Size20.WeatherMoon())" />
</FluentButton>

@code {
    private DesignThemeModes _mode = DesignThemeModes.System;

    private void Toggle() =>
        _mode = _mode == DesignThemeModes.Dark ? DesignThemeModes.Light : DesignThemeModes.Dark;
}
